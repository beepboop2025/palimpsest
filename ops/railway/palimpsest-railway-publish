origin_release_sha() {
  local origin="$1" cache_buster
  cache_buster="$(date +%s%N)"
  curl -fsS --proto '=https' --max-redirs 0 --max-time 30 \
    "$origin/railway-release.json?edition=$cache_buster" \
    | jq -r '.source_commit // empty' 2>/dev/null \
    || true
}

sha256_file() {
  sha256sum "$1" | awk '{print $1}'
}

validate_installed_transition_artifact() {
  local key="$1" path="$2" mode="$3" expected actual
  [[ -f "$path" && ! -L "$path" \
    && "$(stat -c '%u:%g:%a' "$path")" == "0:0:$mode" ]] || {
    log "installed transition artifact has unsafe metadata: $path" >&2
    return 1
  }
  expected="$(jq -er --arg key "$key" '.installed[$key]' "$PUBLICATION_BASE_FILE")"
  actual="$(sha256_file "$path")"
  [[ "$actual" == "$expected" ]] || {
    log "installed transition artifact differs from the root-owned pin: $path" >&2
    return 1
  }
}

fsync_paths_and_directory() {
  "$PYTHON_BIN" - "$@" <<'PY'
import os
import sys

for raw_path in sys.argv[1:-1]:
    descriptor = os.open(raw_path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
directory = os.open(sys.argv[-1], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY
}

archive_predecessor_receipt() {
  mkdir -p "$RECEIPT_ARCHIVE_ROOT"
  chmod 0700 "$RECEIPT_ARCHIVE_ROOT"
  fsync_paths_and_directory "$STATE_ROOT"
  receipt_archive_path="$RECEIPT_ARCHIVE_ROOT/$receipt_sha256.json"
  if [[ -e "$receipt_archive_path" || -L "$receipt_archive_path" ]]; then
    [[ -f "$receipt_archive_path" && ! -L "$receipt_archive_path" \
      && "$(stat -c '%a' "$receipt_archive_path")" == 600 \
      && "$(sha256_file "$receipt_archive_path")" == "$receipt_sha256" ]] || {
      log "predecessor receipt archive conflicts with its digest" >&2
      return 1
    }
  else
    # latest-success and its immutable archive live on the same private state
    # filesystem, so a hard link preserves the exact predecessor inode without
    # a copy/replace window.
    ln "$SUCCESS_RECEIPT" "$receipt_archive_path"
  fi
  fsync_paths_and_directory "$receipt_archive_path" "$RECEIPT_ARCHIVE_ROOT"
}

archive_candidate_journal() {
  mkdir -p "$CANDIDATE_ARCHIVE_ROOT"
  chmod 0700 "$CANDIDATE_ARCHIVE_ROOT"
  candidate_archive_path="$CANDIDATE_ARCHIVE_ROOT/$candidate_journal_sha256.json"
  [[ ! -e "$candidate_archive_path" && ! -L "$candidate_archive_path" ]] || {
    log "candidate journal archive unexpectedly already exists" >&2
    return 1
  }
  ln "$PENDING_CANDIDATE" "$candidate_archive_path"
  [[ "$(stat -c '%a' "$candidate_archive_path")" == 600 \
    && "$(sha256_file "$candidate_archive_path")" == "$candidate_journal_sha256" ]] || {
    log "candidate journal archive identity changed" >&2
    return 1
  }
  fsync_paths_and_directory "$candidate_archive_path" "$CANDIDATE_ARCHIVE_ROOT"
}

persist_release_manifest_anchor() {
  local source_manifest="$release/railway-release.json"
  mkdir -p "$RELEASE_MANIFEST_ROOT"
  chmod 0700 "$RELEASE_MANIFEST_ROOT"
  release_manifest_path="$RELEASE_MANIFEST_ROOT/$release_sha.json"
  [[ -f "$source_manifest" && ! -L "$source_manifest" \
    && ! -e "$release_manifest_path" && ! -L "$release_manifest_path" ]] || {
    log "release manifest anchor source/destination is unsafe" >&2
    return 1
  }
  release_manifest_tmp="$(mktemp "$RELEASE_MANIFEST_ROOT/.release-manifest.XXXXXX")"
  cp "$source_manifest" "$release_manifest_tmp"
  chmod 0600 "$release_manifest_tmp"
  "$PYTHON_BIN" -I -S - "$release_manifest_tmp" "$release_sha" <<'PY'
import json
import re
import sys
from datetime import UTC, datetime, timedelta
from pathlib import Path

EXPECTED = {
    "built_at",
    "critical_files",
    "deployment_source",
    "file_count",
    "github_required",
    "schema_version",
    "source_commit",
    "state",
    "total_bytes",
    "tree_sha256",
}


def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("release manifest anchor contains a duplicate key")
        value[key] = item
    return value


try:
    document = json.loads(
        Path(sys.argv[1]).read_bytes().decode("utf-8", "strict"),
        object_pairs_hook=strict_object,
        parse_constant=lambda value: (_ for _ in ()).throw(
            ValueError(f"non-finite JSON value: {value}")
        ),
    )
except (UnicodeError, ValueError, json.JSONDecodeError) as exc:
    raise SystemExit("release manifest anchor is not strict JSON") from exc
if not isinstance(document, dict) or set(document) != EXPECTED:
    raise SystemExit("release manifest anchor document is not closed-schema")
try:
    built_at = datetime.fromisoformat(document["built_at"].replace("Z", "+00:00"))
except (AttributeError, ValueError) as exc:
    raise SystemExit("release manifest built_at is invalid") from exc
if (
    built_at.tzinfo is None
    or built_at.utcoffset() is None
    or built_at.astimezone(UTC) > datetime.now(UTC) + timedelta(seconds=120)
    or document["schema_version"] != "palimpsest.railway-static-release.v1"
    or document["source_commit"] != sys.argv[2]
    or document["deployment_source"] != "local-git-archive"
    or document["github_required"] is not False
    or document["state"] != "artifact_ready"
    or not isinstance(document["tree_sha256"], str)
    or re.fullmatch(r"[0-9a-f]{64}", document["tree_sha256"]) is None
    or not isinstance(document["file_count"], int)
    or isinstance(document["file_count"], bool)
    or document["file_count"] < 1
    or not isinstance(document["total_bytes"], int)
    or isinstance(document["total_bytes"], bool)
    or document["total_bytes"] < 1
    or not isinstance(document["critical_files"], dict)
    or not document["critical_files"]
):
    raise SystemExit("release manifest anchor identity is invalid")
PY
  release_manifest_sha256="$(sha256_file "$release_manifest_tmp")"
  release_manifest_bytes="$(stat -c '%s' "$release_manifest_tmp")"
  release_manifest_tree_sha256="$(jq -er --arg release "$release_sha" '
    select(
      .schema_version == "palimpsest.railway-static-release.v1" and
      .source_commit == $release and
      .deployment_source == "local-git-archive" and
      .github_required == false and
      .state == "artifact_ready"
    ) | .tree_sha256 | select(type == "string" and test("^[0-9a-f]{64}$"))
  ' "$release_manifest_tmp")"
  release_manifest_file_count="$(jq -er '.file_count | select(type == "number" and . >= 1 and floor == .)' "$release_manifest_tmp")"
  release_manifest_total_bytes="$(jq -er '.total_bytes | select(type == "number" and . >= 1 and floor == .)' "$release_manifest_tmp")"
  [[ "$release_manifest_sha256" =~ ^[0-9a-f]{64}$ \
    && "$release_manifest_bytes" =~ ^[1-9][0-9]*$ ]] || {
    log "local release manifest anchor identity is invalid" >&2
    return 1
  }
  ln "$release_manifest_tmp" "$release_manifest_path"
  unlink "$release_manifest_tmp"
  release_manifest_tmp=""
  fsync_paths_and_directory "$release_manifest_path" "$RELEASE_MANIFEST_ROOT"
}

recover_abandoned_preparation() {
  local release bundle metadata evidence manifest
  [[ -e "$PENDING_PREPARATION" || -L "$PENDING_PREPARATION" ]] || return 0
  [[ ! -e "$PENDING_CANDIDATE" && ! -L "$PENDING_CANDIDATE" ]] || return 0
  [[ -f "$PENDING_PREPARATION" && ! -L "$PENDING_PREPARATION" \
    && "$(stat -c '%u:%g:%a' "$PENDING_PREPARATION")" == "$(id -u):$(id -g):600" ]] || {
    log "abandoned preparation journal has unsafe metadata" >&2
    return 1
  }
  jq -e '
    type == "object" and
    keys == ["base_sha","bundle_metadata_path","bundle_path","evidence_directory","input_sha256","prepared_at","release_manifest_path","release_sha","schema_version","status","submission_id"] and
    .schema_version == "palimpsest.direct-publication-preparation.v1" and
    .status == "pre_mutation" and
    (.prepared_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
    ([.base_sha,.release_sha] | all(type == "string" and test("^[0-9a-f]{40}$"))) and
    (.input_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    (.submission_id | type == "string" and test("^[0-9a-f]{32}$"))
  ' "$PENDING_PREPARATION" >/dev/null || {
    log "abandoned preparation journal is not closed-schema" >&2
    return 1
  }
  release="$(jq -er '.release_sha' "$PENDING_PREPARATION")"
  bundle="$(jq -er '.bundle_path' "$PENDING_PREPARATION")"
  metadata="$(jq -er '.bundle_metadata_path' "$PENDING_PREPARATION")"
  evidence="$(jq -er '.evidence_directory' "$PENDING_PREPARATION")"
  manifest="$(jq -er '.release_manifest_path' "$PENDING_PREPARATION")"
  [[ "$bundle" == "$RELEASE_BUNDLE_ROOT/$release.bundle" \
    && "$metadata" == "$RELEASE_BUNDLE_ROOT/$release.json" \
    && "$evidence" == "$PREDECESSOR_EVIDENCE_ROOT/$release" \
    && "$manifest" == "$RELEASE_MANIFEST_ROOT/$release.json" ]] || {
    log "abandoned preparation paths escape their canonical release identity" >&2
    return 1
  }
  for orphan in "$bundle" "$metadata" "$manifest"; do
    if [[ -e "$orphan" || -L "$orphan" ]]; then
      [[ -f "$orphan" && ! -L "$orphan" \
        && "$(stat -c '%u:%g:%a' "$orphan")" == "$(id -u):$(id -g):600" ]] || {
        log "abandoned preparation artifact has unsafe metadata: $orphan" >&2
        return 1
      }
      unlink "$orphan"
    fi
  done
  if [[ -e "$evidence" || -L "$evidence" ]]; then
    [[ -d "$evidence" && ! -L "$evidence" \
      && "$(stat -c '%u:%g:%a' "$evidence")" == "$(id -u):$(id -g):700" \
      && -z "$(find "$evidence" -mindepth 1 -maxdepth 1 \
        ! -name 'provider-railway-release.json' \
        ! -name 'public-railway-release.json' \
        ! -name 'railway-status.json' \
        ! -name '.provider.*' ! -name '.public.*' ! -name '.topology.*' -print -quit)" \
      && -z "$(find "$evidence" -type l -print -quit)" ]] || {
      log "abandoned predecessor evidence directory is unsafe" >&2
      return 1
    }
    rm -rf --one-file-system -- "$evidence"
  fi
  unlink "$PENDING_PREPARATION"
  fsync_paths_and_directory "$STATE_ROOT"
  log "recovered an abandoned pre-mutation preparation without touching Railway"
}

write_preparation_journal() {
  preparation_tmp="$(mktemp "$STATE_ROOT/.pending-preparation.XXXXXX")"
  jq -n \
    --arg prepared_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg input_sha256 "$input_sha256" \
    --arg base_sha "$base_sha" \
    --arg release_sha "$release_sha" \
    --arg submission_id "$candidate_submission_id" \
    --arg bundle_path "$RELEASE_BUNDLE_ROOT/$release_sha.bundle" \
    --arg bundle_metadata_path "$RELEASE_BUNDLE_ROOT/$release_sha.json" \
    --arg evidence_directory "$PREDECESSOR_EVIDENCE_ROOT/$release_sha" \
    --arg release_manifest_path "$RELEASE_MANIFEST_ROOT/$release_sha.json" \
    '{schema_version:"palimpsest.direct-publication-preparation.v1",status:"pre_mutation",prepared_at:$prepared_at,input_sha256:$input_sha256,base_sha:$base_sha,release_sha:$release_sha,submission_id:$submission_id,bundle_path:$bundle_path,bundle_metadata_path:$bundle_metadata_path,evidence_directory:$evidence_directory,release_manifest_path:$release_manifest_path}' \
    >"$preparation_tmp"
  chmod 0600 "$preparation_tmp"
  [[ ! -e "$PENDING_PREPARATION" && ! -L "$PENDING_PREPARATION" ]] || {
    log "preparation journal appeared before private artifact staging" >&2
    return 1
  }
  ln "$preparation_tmp" "$PENDING_PREPARATION"
  unlink "$preparation_tmp"
  preparation_tmp=""
  fsync_paths_and_directory "$PENDING_PREPARATION" "$STATE_ROOT"
}

capture_predecessor_rollback_evidence() {
  local provider_tmp public_tmp topology_tmp topology_row

  mkdir -p "$PREDECESSOR_EVIDENCE_ROOT"
  chmod 0700 "$PREDECESSOR_EVIDENCE_ROOT"
  predecessor_evidence_directory="$PREDECESSOR_EVIDENCE_ROOT/$release_sha"
  [[ ! -e "$predecessor_evidence_directory" && ! -L "$predecessor_evidence_directory" ]] || {
    log "candidate-specific predecessor evidence already exists" >&2
    return 1
  }
  mkdir "$predecessor_evidence_directory"
  chmod 0700 "$predecessor_evidence_directory"
  predecessor_provider_manifest_path="$predecessor_evidence_directory/provider-railway-release.json"
  predecessor_public_manifest_path="$predecessor_evidence_directory/public-railway-release.json"
  predecessor_topology_path="$predecessor_evidence_directory/railway-status.json"
  provider_tmp="$(mktemp "$predecessor_evidence_directory/.provider.XXXXXX")"
  public_tmp="$(mktemp "$predecessor_evidence_directory/.public.XXXXXX")"
  topology_tmp="$(mktemp "$predecessor_evidence_directory/.topology.XXXXXX")"
  chmod 0600 "$provider_tmp" "$public_tmp" "$topology_tmp"

  predecessor_capture_nonce="$(date +%s%N)"
  curl -fsS --proto '=https' --max-redirs 0 --max-time 30 --max-filesize 8388608 \
    "$PROVIDER_ORIGIN/railway-release.json?predecessor=$predecessor_capture_nonce" \
    -o "$provider_tmp"
  curl -fsS --proto '=https' --max-redirs 0 --max-time 30 --max-filesize 8388608 \
    "$PUBLIC_ORIGIN/railway-release.json?predecessor=$predecessor_capture_nonce" \
    -o "$public_tmp"
  [[ -s "$provider_tmp" && "$(stat -c '%s' "$provider_tmp")" -le 8388608 \
    && -s "$public_tmp" && "$(stat -c '%s' "$public_tmp")" -le 8388608 ]] || {
    log "predecessor live manifest is empty or oversized" >&2
    return 1
  }
  cmp -s "$provider_tmp" "$public_tmp" || {
    log "predecessor provider and public manifests are not byte-identical" >&2
    return 1
  }
  predecessor_provider_manifest_sha256="$(sha256_file "$provider_tmp")"
  predecessor_public_manifest_sha256="$(sha256_file "$public_tmp")"
  [[ "$predecessor_provider_manifest_sha256" == "$receipt_manifest_sha256" \
    && "$predecessor_public_manifest_sha256" == "$receipt_manifest_sha256" ]] || {
    log "predecessor live manifest bytes differ from the predecessor receipt" >&2
    return 1
  }
  "$PYTHON_BIN" -I -S - "$provider_tmp" "$receipt_release_sha" \
    "$receipt_tree_sha256" <<'PY'
import json
import re
import sys
from pathlib import Path

def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("predecessor manifest contains a duplicate key")
        value[key] = item
    return value

raw = Path(sys.argv[1]).read_bytes()
try:
    document = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=strict_object)
except (UnicodeError, json.JSONDecodeError) as exc:
    raise SystemExit("predecessor manifest is not strict JSON") from exc
if not isinstance(document, dict):
    raise SystemExit("predecessor manifest is not an object")
if (
    document.get("schema_version") != "palimpsest.railway-static-release.v1"
    or document.get("source_commit") != sys.argv[2]
    or document.get("tree_sha256") != sys.argv[3]
    or document.get("deployment_source") != "local-git-archive"
    or document.get("github_required") is not False
    or document.get("state") != "artifact_ready"
    or not isinstance(document.get("file_count"), int)
    or isinstance(document.get("file_count"), bool)
    or document["file_count"] < 1
    or not isinstance(document.get("total_bytes"), int)
    or isinstance(document.get("total_bytes"), bool)
    or document["total_bytes"] < 1
):
    raise SystemExit("predecessor manifest identity is invalid")
PY

  env NODE_OPTIONS="$RAILWAY_NODE_OPTIONS" \
    "$railway_token_name=$railway_token_value" \
    "$RAILWAY_BIN" status --project "$PROJECT_ID" \
    --environment "$ENVIRONMENT_ID" --json >"$topology_tmp"
  [[ -s "$topology_tmp" && "$(stat -c '%s' "$topology_tmp")" -le 2097152 ]] || {
    log "predecessor Railway topology is empty or oversized" >&2
    return 1
  }
  topology_row="$("$PYTHON_BIN" -I -S - "$topology_tmp" "$PROJECT_ID" \
    "$ENVIRONMENT_ID" "$SERVICE_ID" "$receipt_deployment_id" <<'PY'
import json
import re
import sys
from datetime import UTC, datetime
from pathlib import Path

def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("Railway topology contains a duplicate key")
        value[key] = item
    return value

def edges(value, label):
    if not isinstance(value, dict) or set(value) != {"edges"}:
        raise SystemExit(f"Railway {label} edge inventory is invalid")
    rows = value["edges"]
    if not isinstance(rows, list) or len(rows) > 100:
        raise SystemExit(f"Railway {label} edge inventory is invalid")
    if any(not isinstance(row, dict) or not isinstance(row.get("node"), dict) for row in rows):
        raise SystemExit(f"Railway {label} edge is invalid")
    return [row["node"] for row in rows]

def one(rows, key, expected, label):
    matches = [row for row in rows if row.get(key) == expected]
    if len(matches) != 1:
        raise SystemExit(f"Railway {label} is not singular")
    return matches[0]

raw = Path(sys.argv[1]).read_bytes()
try:
    document = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=strict_object)
except (UnicodeError, json.JSONDecodeError) as exc:
    raise SystemExit("Railway topology is not strict JSON") from exc
project_id, environment_id, service_id, deployment_id = sys.argv[2:6]
