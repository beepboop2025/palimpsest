#!/usr/bin/env python3
"""Explicit, incident-only disposition; this is NOT no-mutation reconciliation.

The ordinary reconciler remains unchanged. A privileged operator may accept
the residual possibility of an unregistered provider job only for the pinned
28 September 2026 upload, after fresh repeated provider and origin evidence.
The decision and original gates are durable before either gate is consumed.
"""
from __future__ import annotations

import argparse
import fcntl
import grp
import hashlib
import json
import os
from pathlib import Path
import pwd
import runpy
import subprocess
import sys
import time
from datetime import UTC, datetime

