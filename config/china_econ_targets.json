        "cn.cfets.shibor_1w"
      ]
    },
    {
      "target_id": "cfets-usdcny-parity-next-observation",
      "label": "USD/CNY central parity — next observed fixing",
      "series_id": "cn.cfets.usdcny_parity",
      "source_id": "cfets_benchmarks",
      "unit": "CNY per USD",
      "frequency": "D",
      "geography": "CN",
      "sector": "all",
      "firm_size": "all",
      "ownership": "all",
      "enabled": true,
      "horizon": "next_observed_period",
      "model_ids": [
