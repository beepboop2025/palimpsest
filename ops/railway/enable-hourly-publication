        ) from error


def _fetch_live(
    deadline: Deadline, *, origin: str, path: str, destination: Path, nonce: str
) -> bytes:
    if origin not in {PROVIDER_ORIGIN, PUBLIC_ORIGIN} or path not in {
        "railway-release.json",
        FRESHNESS_PATH,
    }:
        raise ActivationError("refusing an unrecognized live proof target")
    error: ActivationError | None = None
    for attempt in range(3):
        destination.unlink(missing_ok=True)
        try:
            status = _exact_text(
                _bounded_command(
                    deadline,
                    (
                        "curl",
                        "--disable",
                        "--fail",
                        "--silent",
                        "--show-error",
                        "--proto",
                        "=https",
                        "--tlsv1.2",
                        "--connect-timeout",
                        "10",
                        "--max-time",
                        "30",
                        "--max-filesize",
                        str(MAX_JSON_BYTES),
                        "--header",
                        "Accept: application/json",
                        "--header",
                        "Accept-Encoding: identity",
                        "--header",
                        "Cache-Control: no-cache",
                        "--output",
                        str(destination),
                        "--write-out",
                        "%{http_code}",
                        f"{origin}/{path}?steady_state={nonce}",
                    ),
                    label=f"fetch {origin} {path}",
                ),
                label="live proof HTTP status",
            )
            if status != "200":
                raise ActivationError("live proof did not return HTTP 200")
            metadata = destination.lstat()
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or not 0 < metadata.st_size <= MAX_JSON_BYTES
            ):
                raise ActivationError(
                    "live proof response is not a bounded regular file"
                )
            return destination.read_bytes()
        except (ActivationError, OSError) as caught:
            error = ActivationError(str(caught))
            if attempt < 2:
                deadline.sleep(min(5.0, deadline.remaining()))
    assert error is not None
    raise error


def _validate_live_proof(
    deadline: Deadline,
    *,
    temporary_directory: Path,
    expected_sha: str,
    expected_manifest_sha256: str,
    nonce: str,
) -> tuple[str, str, dict[str, Any]]:
    payloads: dict[tuple[str, str], bytes] = {}
    for origin_name, origin in (("provider", PROVIDER_ORIGIN), ("www", PUBLIC_ORIGIN)):
        for file_name, path in (
            ("manifest", "railway-release.json"),
            ("freshness", FRESHNESS_PATH),
        ):
            payloads[(origin_name, file_name)] = _fetch_live(
                deadline,
                origin=origin,
                path=path,
                destination=temporary_directory / f"{origin_name}-{file_name}.json",
                nonce=nonce,
            )
    if payloads[("provider", "manifest")] != payloads[("www", "manifest")]:
        raise ActivationError("provider and www release manifests differ")
    if payloads[("provider", "freshness")] != payloads[("www", "freshness")]:
        raise ActivationError("provider and www freshness attestations differ")
    manifest_raw = payloads[("provider", "manifest")]
    manifest = _strict_json(manifest_raw, label="live Railway manifest")
    manifest = _expect_keys(
        manifest,
        {
            "built_at",
            "critical_files",
            "deployment_source",
            "github_required",
            "schema_version",
            "source_commit",
            "state",
            "tree_sha256",
        },
        label="live Railway manifest",
    )
    manifest_sha = hashlib.sha256(manifest_raw).hexdigest()
    if (
        manifest_sha != expected_manifest_sha256
        or manifest["schema_version"] != "palimpsest.railway-static-release.v1"
        or manifest["source_commit"] != expected_sha
        or manifest["deployment_source"] != "local-git-archive"
        or manifest["github_required"] is not False
        or manifest["state"] != "artifact_ready"
        or not _is_sha256(manifest["tree_sha256"])
        or not isinstance(manifest["critical_files"], dict)
    ):
        raise ActivationError("live Railway manifest authority is invalid")
    _utc(manifest["built_at"], label="live manifest built_at")
    freshness_raw = payloads[("provider", "freshness")]
    critical = manifest["critical_files"].get(FRESHNESS_PATH)
    if (
        not isinstance(critical, dict)
        or set(critical) != {"bytes", "sha256"}
        or critical["bytes"] != len(freshness_raw)
        or critical["sha256"] != hashlib.sha256(freshness_raw).hexdigest()
    ):
        raise ActivationError("live manifest does not bind the freshness bytes")
    freshness = _expect_keys(
        _strict_json(freshness_raw, label="live freshness attestation"),
        {
            "artifacts",
            "attested_at",
            "limitations",
            "mode",
            "publication_allowed",
            "publication_sha",
            "rights_status",
            "schema_version",
        },
        label="live freshness attestation",
    )
    artifacts = _expect_keys(
        freshness["artifacts"],
        {"china_situation", "newswire"},
        label="freshness artifacts",
    )
    newswire = _expect_keys(
        artifacts["newswire"],
        {"canonical_sha256", "generated_at", "path", "schema_version"},
        label="freshness Newswire",
    )
    situation = _expect_keys(
        artifacts["china_situation"],
        {"canonical_sha256", "generated_at", "inputs", "path", "schema_version"},
        label="freshness situation",
    )
    inputs = _expect_keys(
        situation["inputs"],
        {"newswire_canonical_sha256", "newswire_generated_at"},
        label="freshness situation inputs",
    )
    rights = _expect_keys(
        freshness["rights_status"],
        {"bytes", "path", "sha256"},
        label="freshness rights",
    )
    now = _utc_now()
    clocks = [
        _utc(freshness["attested_at"], label="freshness attested_at"),
        _utc(newswire["generated_at"], label="freshness Newswire generated_at"),
        _utc(situation["generated_at"], label="freshness situation generated_at"),
    ]
    if any(
        (now - clock).total_seconds() > 7200 or (clock - now).total_seconds() > 300
        for clock in clocks
    ):
        raise ActivationError("live freshness attestation is stale or future-dated")
    if not (clocks[1] <= clocks[2] <= clocks[0]):
        raise ActivationError("live freshness attestation clocks are not causal")
    if (
        freshness["schema_version"] != "palimpsest.publication-freshness-attestation.v1"
        or freshness["mode"] != "rights-suppressed"
        or freshness["publication_allowed"] is not False
        or freshness["publication_sha"] != expected_sha
        or not _is_sha256(newswire["canonical_sha256"])
        or newswire["path"] != "readings/newswire-latest.json"
        or newswire["schema_version"] != "palimpsest-newswire.v1"
        or not _is_sha256(situation["canonical_sha256"])
        or situation["path"] != "readings/china-situation-latest.json"
        or situation["schema_version"] != "palimpsest-china-situation.v1"
        or inputs
        != {
            "newswire_canonical_sha256": newswire["canonical_sha256"],
            "newswire_generated_at": newswire["generated_at"],
        }
        or not _positive_int(rights["bytes"])
        or rights["path"] != "readings/china-publication-rights-latest.json"
        or not _is_sha256(rights["sha256"])
        or not isinstance(freshness["limitations"], list)
        or len(freshness["limitations"]) != 4
        or any(not isinstance(item, str) for item in freshness["limitations"])
    ):
        raise ActivationError("live freshness attestation semantics are invalid")
    return manifest_sha, hashlib.sha256(freshness_raw).hexdigest(), manifest


def _typed_sha_prompt(deadline: Deadline, expected_sha: str) -> None:
    remaining = min(float(PROMPT_TIMEOUT_SECONDS), deadline.remaining())
    if remaining <= 0:
        raise ActivationError("typed-SHA prompt deadline expired")
    print(
        f"Type the exact final main SHA to open hourly publication:\n{expected_sha}",
        file=sys.stderr,
        flush=True,
    )
    expires = time.monotonic() + remaining
    collected = bytearray()
    while b"\n" not in collected:
        wait = expires - time.monotonic()
        if wait <= 0:
            raise ActivationError("typed-SHA prompt expired")
        ready, _, _ = select.select([sys.stdin.fileno()], [], [], wait)
        if not ready:
            raise ActivationError("typed-SHA prompt expired")
        chunk = os.read(sys.stdin.fileno(), 129 - len(collected))
        if not chunk:
            break
        collected.extend(chunk)
        if len(collected) > 128:
            raise ActivationError("typed-SHA confirmation exceeded its byte ceiling")
    raw = bytes(collected)
    if b"\n" in raw:
        line, remainder = raw.split(b"\n", 1)
        if remainder:
            raise ActivationError("typed-SHA confirmation contained extra input")
    else:
        line = raw
    try:
        value = line.decode("ascii", "strict")
    except UnicodeError as error:
        raise ActivationError("typed-SHA confirmation is not ASCII") from error
    if value != expected_sha:
        raise ActivationError("typed-SHA confirmation did not match final main")


def _probe_live_manifest_digest(
    deadline: Deadline,
    *,
    temporary_directory: Path,
    expected_sha: str,
    nonce: str,
) -> str:
    provider = _fetch_live(
        deadline,
        origin=PROVIDER_ORIGIN,
        path="railway-release.json",
        destination=temporary_directory / "provider-no-change-probe.json",
        nonce=nonce,
    )
    public = _fetch_live(
        deadline,
        origin=PUBLIC_ORIGIN,
        path="railway-release.json",
        destination=temporary_directory / "public-no-change-probe.json",
        nonce=nonce,
    )
    if provider != public:
        raise ActivationError("no-change provider and www manifests differ")
    manifest = _strict_json(provider, label="no-change live Railway manifest")
    if (
        not isinstance(manifest, dict)
        or manifest.get("schema_version") != "palimpsest.railway-static-release.v1"
        or manifest.get("source_commit") != expected_sha
        or manifest.get("deployment_source") != "local-git-archive"
        or manifest.get("github_required") is not False
        or manifest.get("state") != "artifact_ready"
        or not _is_sha256(manifest.get("tree_sha256"))
    ):
        raise ActivationError("no-change live manifest authority is invalid")
    return hashlib.sha256(provider).hexdigest()


def _ack_inventory(raw: str) -> str:
    value = _strict_json_text(raw, label="protected environment variables")
    if not isinstance(value, list):
        return "unproved"
    matches: list[Any] = []
    for item in value:
        if not isinstance(item, dict) or set(item) != {"name", "value"}:
            return "unproved"
        if item.get("name") == ACK_VARIABLE:
            matches.append(item.get("value"))
    if not matches:
        return "absent"
    if matches == [EXCLUSIVE_WRITER_ACK]:
        return "exact"
    return "unexpected"


def _ack_absent(raw: str) -> bool:
    value = _strict_json_text(raw, label="protected environment variable names")
    return isinstance(value, list) and all(
        isinstance(item, dict)
        and set(item) == {"name"}
        and item.get("name") != ACK_VARIABLE
        for item in value
    )


def _cleanup_workflow_authority(repository: str, state: RunState | None) -> str:
    try:
        if state is not None and state.workflows_mutated:
            for spec in WORKFLOWS:
                _cleanup_gh(
                    "workflow",
                    "enable",
                    str(spec.workflow_id),
                    "--repo",
                    repository,
                )
            _cleanup_gh(
                "workflow",
                "enable",
                str(CONTROLLER_WORKFLOW_ID),
                "--repo",
                repository,
            )
        deadline = Deadline.start(COMMAND_TIMEOUT_SECONDS * 8)
        for spec in WORKFLOWS:
            _workflow_state(deadline, repository, spec)
        _controller_workflow_state(deadline, repository)
        _require_no_active_runs(deadline, repository)
        if _workflow_active_count(
            deadline, repository, CONTROLLER_WORKFLOW_ID, "Railway controller"
        ) or _workflow_active_count(
            deadline, repository, RELEASE_WORKFLOW_ID, "Tests release"
        ):
            raise ActivationError(
                "cleanup found an active controller or downstream release"
            )
    except (ActivationError, CommandError) as error:
        print(str(error), file=sys.stderr)
        return "unproved"
    return "active"


def _cleanup_run_authority(repository: str, state: RunState | None) -> str:
    if state is None:
        return "none"
    if state.controller_unbound or state.release_unbound or state.approval_uncertain:
        return "unproved"
    if state.controller_run_id is None and state.release_run_id is None:
        return "none"
    if state.source_sha is None or state.activated_at is None:
        return "unproved"
    try:
        deadline = Deadline.start(COMMAND_TIMEOUT_SECONDS * 4)
        if state.controller_run_id is not None:
            controller = _run_view(deadline, repository, state.controller_run_id)
            _validate_scheduled_run(
                controller,
                run_id=state.controller_run_id,
                expected_sha=state.source_sha,
                not_before=state.activated_at,
            )
            if controller["status"] != "completed":
                return "unproved"
        if state.release_run_id is not None:
            release = _run_view(deadline, repository, state.release_run_id)
            _validate_release_run(
                release,
                run_id=state.release_run_id,
                expected_sha=state.source_sha,
                not_before=state.activated_at,
            )
            if release["status"] != "completed":
                return "unproved"
    except (ActivationError, CommandError):
        return "unproved"
    return "terminal"


def _failure_cleanup(repository: str, state: RunState | None = None) -> dict[str, Any]:
    gate_state = "unproved"
    acknowledgement_state = "unproved"
    try:
        _cleanup_gh(
            "variable",
            "set",
            GATE_VARIABLE,
            "--body",
            "false",
            "--repo",
            repository,
        )
        if (
            _exact_text(
                _cleanup_gh("variable", "get", GATE_VARIABLE, "--repo", repository),
                label="cleanup Railway hourly gate",
            )
            != "false"
        ):
            raise ActivationError("cleanup did not prove hourly publication closed")
        gate_state = "false"
    except ActivationError as error:
        print(str(error), file=sys.stderr)
    try:
        ack_state = _ack_inventory(
            _cleanup_gh(
                "variable",
                "list",
                "--repo",
                repository,
                "--env",
                PRODUCTION_ENVIRONMENT,
                "--json",
                "name,value",
            )
        )
        if ack_state == "exact":
            _cleanup_gh(
                "variable",
                "delete",
                ACK_VARIABLE,
                "--repo",
                repository,
                "--env",
                PRODUCTION_ENVIRONMENT,
            )
        elif ack_state != "absent":
            raise ActivationError(
                "refusing to delete an unfamiliar Railway writer acknowledgement"
            )
        if not _ack_absent(
            _cleanup_gh(
                "variable",
                "list",
                "--repo",
                repository,
                "--env",
                PRODUCTION_ENVIRONMENT,
                "--json",
                "name",
            )
        ):
            raise ActivationError("cleanup did not prove writer acknowledgement absent")
        acknowledgement_state = "absent"
    except ActivationError as error:
        print(str(error), file=sys.stderr)
        if "unfamiliar" in str(error):
            acknowledgement_state = "unexpected"
    workflow_state = _cleanup_workflow_authority(repository, state)
    run_state = _cleanup_run_authority(repository, state)
    if state is not None:
        for label, run_id in (
            ("scheduled controller", state.controller_run_id),
            ("downstream release", state.release_run_id),
        ):
            if run_id is not None:
                print(
                    f"Reconcile {label} run {run_id}; cleanup deliberately did not cancel it.",
                    file=sys.stderr,
                )
    return {
        "acknowledgement": acknowledgement_state,
        "gate": gate_state,
        "proved": (
            gate_state == "false"
            and acknowledgement_state == "absent"
            and workflow_state == "active"
            and run_state in {"none", "terminal"}
        ),
        "runs": run_state,
        "workflows": workflow_state,
    }


def _failure_receipt(
    *,
    repository: str,
    authority: RestoreAuthority | None,
    state: RunState,
    cleanup: dict[str, Any],
    error: BaseException,
    exit_status: int,
) -> dict[str, Any]:
    status = "failed-closed" if cleanup.get("proved") is True else "cleanup-unproved"
    return {
        "authority_cleanup": cleanup,
        "controller_run_id": state.controller_run_id,
        "error": {
            "exit_status": exit_status,
            "message": str(error)[:2048],
            "type": type(error).__name__,
        },
        "failed_at": _utc_now()
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z"),
        "gate_mutated": state.gate_mutated,
        "workflows_mutated": state.workflows_mutated,
        "producer_restore": (
            None
            if authority is None
            else {
                "final_main_sha": authority.final_sha,
                "receipt": str(authority.path),
                "receipt_sha256": authority.digest,
            }
        ),
        "release_run_id": state.release_run_id,
        "repository": repository,
        "schema_version": "palimpsest.railway-hourly-publication-failure.v1",
        "status": status,
    }


def _execute(
    *,
    authority: RestoreAuthority,
    receipt_path: Path,
    state: RunState,
) -> tuple[dict[str, Any], str]:
    quiet_deadline = Deadline.start(QUIET_WAIT_BUDGET_SECONDS)
    _gh(
        quiet_deadline,
        "auth",
        "status",
        "--hostname",
        "github.com",
        label="GitHub authentication",
    )
    _require_gh_transport(quiet_deadline)
    if _load_restore(authority.path, repository=authority.repository) != authority:
        raise ActivationError("producer restore receipt changed before quiet wait")
    before = _wait_for_quiet_arming_window(quiet_deadline, authority)
    source_sha = before["main_sha"]
    lineage = _require_descendant(
        quiet_deadline, authority.repository, authority.final_sha, source_sha
    )
    scheduled_tick = _utc(before["scheduled_tick"], label="scheduled :13 tick")
    if _utc_now() >= scheduled_tick:
        raise ActivationError("the imminent :13 controller window was missed")
    _typed_sha_prompt(quiet_deadline, source_sha)
    if _load_restore(authority.path, repository=authority.repository) != authority:
        raise ActivationError("producer restore receipt changed during confirmation")
    if _utc_now() >= scheduled_tick:
        raise ActivationError("typed confirmation crossed the :13 schedule tick")
    comparable = dict(before)
    comparable.pop("arming_window_started_at")
    comparable.pop("scheduled_tick")
    if _quiet_snapshot(quiet_deadline, authority) != comparable:
        raise ActivationError("live producer authority changed during confirmation")
    controller_before = _run_inventory(
        quiet_deadline,
        authority.repository,
        CONTROLLER_WORKFLOW_ID,
        "Railway controller",
    )
    release_before = _run_inventory(
        quiet_deadline,
        authority.repository,
        RELEASE_WORKFLOW_ID,
        "Tests release",
    )
    initial_environment_contract = _validate_environment_contract(
        quiet_deadline, authority.repository
    )
    producer_before = _producer_run_inventories(quiet_deadline, authority.repository)
    if _quiet_snapshot(quiet_deadline, authority) != comparable:
        raise ActivationError("authority changed at the final gate boundary")
    if _utc_now() >= scheduled_tick:
        raise ActivationError("final authority proof crossed the :13 schedule tick")
    _freeze_producers(
        quiet_deadline,
        authority=authority,
        state=state,
        expected_sha=source_sha,
        expected_inventories=producer_before,
    )
    if _utc_now() >= scheduled_tick:
        raise ActivationError("producer freeze crossed the :13 schedule tick")
    state.gate_mutated = True
    state.controller_unbound = True
    state.source_sha = source_sha
    _gh(
        quiet_deadline,
        "variable",
        "set",
        GATE_VARIABLE,
        "--body",
        "true",
        "--repo",
        authority.repository,
        label="open Railway hourly publication gate",
    )
    activated_at = _utc_now().replace(microsecond=0).isoformat().replace("+00:00", "Z")
    state.activated_at = _utc(activated_at, label="gate activated_at")
    if _gate(quiet_deadline, authority.repository) != "true":
        raise ActivationError("Railway hourly gate did not open exactly once")

    deadline = Deadline.start(RELEASE_PROOF_BUDGET_SECONDS)
    controller_run_id, _controller_initial = _poll_one_new_run(
        deadline,
        repository=authority.repository,
        workflow_id=CONTROLLER_WORKFLOW_ID,
        label="Railway controller",
        before=controller_before,
        validator=_validate_scheduled_run,
        expected_sha=source_sha,
        not_before=_utc(activated_at, label="gate activated_at"),
    )
    _bind_controller_run(state, controller_run_id)
    _set_workflow_state(
        deadline,
        authority.repository,
        workflow_id=CONTROLLER_WORKFLOW_ID,
        filename=CONTROLLER_WORKFLOW,
        display_name=CONTROLLER_NAME,
        state="disabled_manually",
    )
    controller = _wait_success(
        deadline,
        repository=authority.repository,
        run_id=controller_run_id,
        validator=_validate_scheduled_run,
        expected_sha=source_sha,
        not_before=_utc(activated_at, label="gate activated_at"),
    )
    controller_jobs = _validate_controller_jobs(
        deadline, authority.repository, controller_run_id
    )
    temporary_directory = Path(tempfile.mkdtemp(prefix="palimpsest-hourly-activation-"))
    temporary_directory.chmod(0o700)
    temporary_removed = False
    try:
        outcome_directory = temporary_directory / "controller-outcome"
        outcome_artifact = _download_artifact(
            deadline,
            repository=authority.repository,
            run_id=controller_run_id,
            name=f"railway-publication-controller-outcome-{controller_run_id}-1",
            destination=outcome_directory,
        )
        outcome_entries = list(outcome_directory.iterdir())
        if (
            len(outcome_entries) != 1
            or outcome_entries[0].name != "railway-publication-controller-outcome.json"
        ):
            raise ActivationError("scheduled controller outcome contents are not exact")
        controller_outcome = _validate_controller_outcome(
            outcome_entries[0].read_bytes(),
            repository=authority.repository,
            controller_run_id=controller_run_id,
            expected_sha=source_sha,
        )

        request_artifact: dict[str, Any] | None = None
        controller_request: dict[str, Any] | None = None
        release: dict[str, Any] | None = None
        release_jobs: dict[str, str] | None = None
        release_artifact: dict[str, Any] | None = None
        transaction_sha: str | None = None
        verification_sha: str | None = None
        environment_id: int | None = None
        environment_contract = initial_environment_contract
        approved = False
        if controller_outcome["result"] == "dispatched":
            request_directory = temporary_directory / "controller-request"
            request_artifact = _download_artifact(
                deadline,
                repository=authority.repository,
                run_id=controller_run_id,
                name=controller_outcome["request_artifact_name"],
                destination=request_directory,
                expected_id=controller_outcome["request_artifact_id"],
                expected_digest=controller_outcome["request_artifact_digest"],
                expected_size=controller_outcome["request_artifact_size"],
            )
            request_entries = list(request_directory.iterdir())
            if (
                len(request_entries) != 1
                or request_entries[0].name != "railway-publication-request.json"
            ):
                raise ActivationError(
                    "scheduled controller request contents are not exact"
                )
            request_raw = request_entries[0].read_bytes()
            if (
                hashlib.sha256(request_raw).hexdigest()
                != controller_outcome["request_sha256"]
            ):
                raise ActivationError("scheduled request digest is not outcome-bound")
            controller_request = _validate_controller_request(
                request_raw,
                repository=authority.repository,
                controller_run_id=controller_run_id,
                expected_sha=source_sha,
            )
            if controller_request["requested_at"] != controller_outcome["requested_at"]:
                raise ActivationError("scheduled request clock is not outcome-bound")
            controller_dispatch = {
                "activation_canary": False,
                "controller_artifact_digest": controller_outcome[
                    "request_artifact_digest"
                ],
                "controller_artifact_id": controller_outcome["request_artifact_id"],
                "controller_request_sha256": controller_outcome["request_sha256"],
                "controller_run_attempt": 1,
                "controller_run_id": controller_run_id,
                "deploy_railway": True,
                "requested_at": controller_outcome["requested_at"],
                "scope": "complete",
                "sha": source_sha,
            }
            release_run_id, _release_initial = _poll_one_new_run(
                deadline,
                repository=authority.repository,
                workflow_id=RELEASE_WORKFLOW_ID,
                label="Tests release",
                before=release_before,
                validator=_validate_release_run,
                expected_sha=source_sha,
                not_before=_utc(
                    controller["created_at"], label="controller created_at"
                ),
            )
            _bind_release_run(state, release_run_id)
            release, approved, environment_id, environment_contract = (
                _wait_release_with_approval(
                    deadline,
                    authority=authority,
                    state=state,
                    run_id=release_run_id,
                    controller_run_id=controller_run_id,
                    controller_before=controller_before,
                    release_before=release_before,
                    expected_sha=source_sha,
                    not_before=_utc(
                        controller["created_at"], label="controller created_at"
                    ),
                    temporary_directory=temporary_directory,
                )
            )
            release_jobs = _validate_release_jobs(
                deadline, authority.repository, release_run_id
            )
            release_directory = temporary_directory / "release-artifact"
            release_artifact = _download_artifact(
                deadline,
                repository=authority.repository,
                run_id=release_run_id,
                name=(
                    f"railway-continuous-release-{source_sha}-run-"
                    f"{release_run_id}-attempt-1"
                ),
                destination=release_directory,
            )
            transaction_sha, verification_sha, artifact_manifest_sha = (
                _validate_release_artifact(
                    release_directory,
                    repository=authority.repository,
                    run_id=release_run_id,
                    expected_sha=source_sha,
                    controller_dispatch=controller_dispatch,
                )
            )
        else:
            release_run_id = None
            if (
                _run_inventory(
                    deadline,
                    authority.repository,
                    RELEASE_WORKFLOW_ID,
                    "Tests release",
                )
                != release_before
            ):
                raise ActivationError("scheduled no-change created a downstream run")
            artifact_manifest_sha = _probe_live_manifest_digest(
                deadline,
                temporary_directory=temporary_directory,
                expected_sha=source_sha,
                nonce=f"{controller_run_id}-no-change-probe",
            )
            state.release_unbound = False

        controller_after = _run_inventory(
            deadline,
            authority.repository,
            CONTROLLER_WORKFLOW_ID,
            "Railway controller",
        )
        release_after = _run_inventory(
            deadline,
            authority.repository,
            RELEASE_WORKFLOW_ID,
            "Tests release",
        )
        if sorted(set(controller_after) - set(controller_before)) != [
            controller_run_id
        ]:
            raise ActivationError(
                "controller run inventory raced after schedule binding"
            )
        expected_release_additions = [] if release_run_id is None else [release_run_id]
        if (
            sorted(set(release_after) - set(release_before))
            != expected_release_additions
        ):
            raise ActivationError(
                "downstream run inventory raced after release binding"
            )
        if _load_restore(authority.path, repository=authority.repository) != authority:
            raise ActivationError(
                "producer restore receipt changed during release proof"
            )
        final_authority = _live_snapshot(
            deadline,
            repository=authority.repository,
            expected_sha=source_sha,
            expected_gate="true",
            expected_producer_state="disabled_manually",
            expected_controller_state="disabled_manually",
        )
        _exact_run_inventories(
            deadline,
            repository=authority.repository,
            producer_inventories=producer_before,
            controller_inventory=controller_after,
            release_inventory=release_after,
        )
        if (
            _validate_environment_contract(deadline, authority.repository)
            != environment_contract
        ):
            raise ActivationError(
                "protected environment changed before final live proof"
            )
        final_authority, reactivated_at, terminal_cutoff = _reactivate_workflows(
            deadline,
            authority=authority,
            state=state,
            expected_sha=source_sha,
            producer_inventories=producer_before,
            controller_inventory=controller_after,
            release_inventory=release_after,
        )
        final_deadline = _wall_bounded_deadline(deadline, terminal_cutoff)
        if (
            _validate_environment_contract(final_deadline, authority.repository)
            != environment_contract
        ):
            raise ActivationError(
                "protected environment changed during terminal reactivation"
            )
        if _utc_now() >= terminal_cutoff:
            raise ActivationError("terminal live proof crossed the :50 cutoff")
        # These provider/www bytes are the final external observation before
        # local cleanup, receipt construction, and the terminal atomic commit.
        manifest_sha, freshness_sha, live_manifest = _validate_live_proof(
            final_deadline,
            temporary_directory=temporary_directory,
            expected_sha=source_sha,
            expected_manifest_sha256=artifact_manifest_sha,
            nonce=f"{controller_run_id}-{release_run_id or 0}-final",
        )
        if manifest_sha != artifact_manifest_sha:
            raise ActivationError("live manifest does not equal proved release bytes")
        if _utc_now() >= terminal_cutoff:
            raise ActivationError("terminal live proof crossed the :50 cutoff")
        shutil.rmtree(temporary_directory)
        temporary_removed = True
    except BaseException:
        if not temporary_removed:
            try:
                shutil.rmtree(temporary_directory)
            except OSError as cleanup_error:
                try:
                    print(
                        f"failed to remove private hourly temporary directory: {cleanup_error}",
                        file=sys.stderr,
                    )
                except (BrokenPipeError, OSError, ValueError):
                    pass
        raise

    receipt = {
        "activated_at": activated_at,
        "artifact_evidence": {
            "controller_outcome_artifact": outcome_artifact,
            "controller_request_artifact": request_artifact,
            "release_artifact": release_artifact,
            "transaction_receipt_sha256": transaction_sha,
            "verification_receipt_sha256": verification_sha,
        },
        "authority": {
            "exclusive_writer_ack": EXCLUSIVE_WRITER_ACK,
            "hourly_publication_enabled": True,
            "protected_environment": PRODUCTION_ENVIRONMENT,
            "protected_environment_contract": environment_contract,
        },
        "controller": {
            "event": "schedule",
            "jobs": controller_jobs,
            "requested_at": controller_outcome["requested_at"],
            "result": controller_outcome["result"],
            "run_attempt": 1,
            "run_id": controller_run_id,
        },
        "live": {
            "freshness_attestation_sha256": freshness_sha,
            "manifest_sha256": manifest_sha,
            "provider_origin": PROVIDER_ORIGIN,
            "public_origin": PUBLIC_ORIGIN,
            "source_commit": source_sha,
            "tree_sha256": live_manifest["tree_sha256"],
        },
        "no_conflicting_active_runs": True,
        "operator_confirmation": {
            "method": "typed-exact-final-main-sha",
            "source_commit": source_sha,
            "timeout_seconds": PROMPT_TIMEOUT_SECONDS,
        },
        "producer_restore": {
            "final_main_sha": authority.final_sha,
            "initial_main_sha": authority.initial_sha,
            "receipt": str(authority.path),
            "receipt_sha256": authority.digest,
            "terminal_at": authority.terminal_at,
        },
        "release": (
            None
            if release_run_id is None
            else {
                "environment_approved": approved,
                "environment_id": environment_id,
                "jobs": release_jobs,
                "run_attempt": 1,
                "run_id": release_run_id,
            }
        ),
        "repository": authority.repository,
        "schedule": {
            "arming_window_started_at": before["arming_window_started_at"],
            "lineage_from_restore": lineage,
            "scheduled_tick": before["scheduled_tick"],
        },
        "schema_version": "palimpsest.railway-hourly-publication-steady-state.v1",
        "source_commit": source_sha,
        "status": "verified",
        "verified_at": _utc_now()
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z"),
        "workflow_freeze": {
            "controller_disabled_after_binding": True,
            "producers_disabled_before_gate": True,
            "reactivated_at": reactivated_at,
            "terminal_receipt_cutoff": terminal_cutoff.isoformat().replace(
                "+00:00", "Z"
            ),
            "terminal_window_utc_minute_offsets": {
                "admission_end": 30,
                "admission_start": 20,
                "proof_end": 40,
                "receipt_cutoff": 50,
            },
        },
        "workflows": final_authority["workflows"],
    }
    if _utc_now() >= terminal_cutoff:
        raise ActivationError("terminal receipt crossed the :50 cutoff")
    digest = _write_final_receipt(
        receipt_path, receipt, state, not_after=terminal_cutoff
    )
    state.receipt_status = "verified"
    return receipt, digest


def _report_warning_only(path: Path, digest: str, status: str) -> None:
    summary = json.dumps(
        {"receipt": str(path), "receipt_sha256": digest, "status": status},
        separators=(",", ":"),
        sort_keys=True,
    )
    try:
        sys.stdout.write(summary + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, OSError, ValueError) as error:
        try:
            print(
                f"hourly activation receipt committed; stdout failed: {error}",
                file=sys.stderr,
            )
        except (BrokenPipeError, OSError, ValueError):
            pass


def main() -> int:
    if len(sys.argv) != 1:
        print(
            "enable-hourly-publication accepts environment inputs only", file=sys.stderr
        )
        return 2
    repository = os.environ.get("PALIMPSEST_REPOSITORY", DEFAULT_REPOSITORY)
    if REPOSITORY.fullmatch(repository) is None:
        print("PALIMPSEST_REPOSITORY is not an exact repository slug", file=sys.stderr)
        return 2
    state = RunState()
    status = 1
    receipt_path: Path | None = None
    digest = ""
    authority: RestoreAuthority | None = None
    failure_error: BaseException | None = None

    def abort(signum: int, _frame: Any) -> NoReturn:
        raise SignalAbort(signum)

    previous = {
        item: signal.getsignal(item)
        for item in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)
    }
    for item in previous:
        signal.signal(item, abort)
    try:
        restore_path = Path(os.environ.get("PRODUCER_RESTORE_RECEIPT", ""))
        receipt_path = _prepare_output(os.environ.get("HOURLY_ACTIVATION_RECEIPT", ""))
        authority = _load_restore(restore_path, repository=repository)
        _, digest = _execute(
            authority=authority, receipt_path=receipt_path, state=state
        )
        status = 0
    except SignalAbort as error:
        print(str(error), file=sys.stderr)
        status = 128 + error.signum
        failure_error = error
    except KeyboardInterrupt:
        print("hourly activation interrupted", file=sys.stderr)
        status = 130
        failure_error = KeyboardInterrupt("hourly activation interrupted")
    except CommandError as error:
        print(str(error), file=sys.stderr)
        status = error.returncode if 1 <= error.returncode <= 125 else 1
        failure_error = error
    except (ActivationError, KeyError, OSError, TypeError, ValueError) as error:
        print(str(error), file=sys.stderr)
        status = 1
        failure_error = error
    finally:
        previous_mask = signal.pthread_sigmask(
            signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}
        )
        if status != 0 and not state.receipt_committed:
            try:
                cleanup = _failure_cleanup(repository, state)
            except BaseException as cleanup_error:
                cleanup = {
                    "acknowledgement": "unproved",
                    "gate": "unproved",
                    "proved": False,
                    "runs": "unproved",
                    "workflows": "unproved",
                }
                try:
                    print(
                        f"hourly failure cleanup could not complete: {cleanup_error}",
                        file=sys.stderr,
                    )
                except (BrokenPipeError, OSError, ValueError):
                    pass
            if receipt_path is not None:
                try:
                    failure_document = _failure_receipt(
                        repository=repository,
                        authority=authority,
                        state=state,
                        cleanup=cleanup,
                        error=failure_error or ActivationError("unknown failure"),
                        exit_status=status,
                    )
                    digest = _write_final_receipt(receipt_path, failure_document, state)
                except BaseException as receipt_error:
                    try:
                        print(
                            f"hourly failure receipt could not be committed: {receipt_error}",
                            file=sys.stderr,
                        )
                    except (BrokenPipeError, OSError, ValueError):
                        pass
        for item, handler in previous.items():
            signal.signal(item, handler)
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
        if state.receipt_status == "verified":
            status = 0
        elif status == 0:
            status = 1
    if state.receipt_committed:
        assert receipt_path is not None
        _report_warning_only(receipt_path, digest, state.receipt_status or "unknown")
    return status


if __name__ == "__main__":
    raise SystemExit(main())
