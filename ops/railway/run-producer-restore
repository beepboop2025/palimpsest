@dataclass(frozen=True)
class Deadline:
    expires_at: float

    @classmethod
    def start(cls, budget_seconds: int) -> Deadline:
        if budget_seconds <= 0:
            raise RestoreError("producer restoration budget must be positive")
        return cls(time.monotonic() + budget_seconds)

    def remaining(self) -> float:
        return max(0.0, self.expires_at - time.monotonic())

    def command_timeout(self) -> float:
        remaining = self.remaining()
        if remaining <= 0:
            raise RestoreError("producer restoration monotonic deadline expired")
        return min(float(COMMAND_TIMEOUT_SECONDS), remaining)

    def sleep(self) -> None:
        remaining = self.remaining()
        if remaining <= 0:
            raise RestoreError("producer restoration monotonic deadline expired")
        time.sleep(min(POLL_INTERVAL_SECONDS, remaining))


def _reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            raise ValueError(f"duplicate JSON key: {key}")
        value[key] = item
    return value


def _reject_constant(value: str) -> NoReturn:
    raise ValueError(f"non-finite JSON number: {value}")


def _canonical_json(document: object) -> bytes:
    return (
        json.dumps(
            document,
            allow_nan=False,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        ).encode("utf-8")
        + b"\n"
    )


def _strict_json(raw: bytes, *, label: str, maximum: int = MAX_JSON_BYTES) -> Any:
    if not 0 < len(raw) <= maximum:
        raise RestoreError(f"{label} has an invalid byte size")
    try:
        return json.loads(
            raw.decode("utf-8", "strict"),
            object_pairs_hook=_reject_duplicates,
            parse_constant=_reject_constant,
        )
    except (UnicodeError, ValueError) as error:
        raise RestoreError(f"{label} is not strict JSON") from error


def _strict_json_text(text: str, *, label: str) -> Any:
    return _strict_json(text.encode("utf-8"), label=label)


def _utc(value: Any, *, label: str) -> datetime:
    if not isinstance(value, str) or not value.endswith(("Z", "+00:00")):
        raise RestoreError(f"{label} is not an exact UTC timestamp")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise RestoreError(f"{label} is not an exact UTC timestamp") from error
    if parsed.utcoffset() != timedelta(0):
        raise RestoreError(f"{label} is not UTC")
    return parsed


def _now() -> str:
    return datetime.now(UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def _expect_keys(value: Any, keys: set[str], *, label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != keys:
        raise RestoreError(f"{label} does not have its exact closed schema")
    return value


def _positive_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value > 0


def _is_sha40(value: Any) -> bool:
    return isinstance(value, str) and SHA40.fullmatch(value) is not None


def _is_sha256(value: Any) -> bool:
    return isinstance(value, str) and SHA256.fullmatch(value) is not None


def _read_private_canonical(
    path: Path, *, label: str, maximum: int
) -> tuple[bytes, Any]:
    if not path.is_absolute():
        raise RestoreError(f"{label} path must be absolute")
    _private_directory(path.parent, label=f"{label} parent")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as error:
        raise RestoreError(f"cannot open {label} safely: {error}") from error
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.geteuid()
            or before.st_gid != os.getegid()
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) & 0o077
            or not 0 < before.st_size <= maximum
        ):
            raise RestoreError(f"{label} is not an exact private regular file")
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(remaining, 65536))
            if not chunk:
                raise RestoreError(f"{label} changed while being read")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise RestoreError(f"{label} changed while being read")
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ):
            raise RestoreError(f"{label} changed while being read")
    finally:
        os.close(descriptor)
    raw = b"".join(chunks)
    document = _strict_json(raw, label=label, maximum=maximum)
    if raw != _canonical_json(document):
        raise RestoreError(f"{label} is not canonical JSON")
    return raw, document


def _private_directory(path: Path, *, label: str) -> None:
    if not path.is_absolute() or path != Path(os.path.realpath(path)):
        raise RestoreError(f"{label} must be an absolute non-symlink path")
    try:
        details = path.stat()
    except OSError as error:
        raise RestoreError(f"cannot inspect {label}: {error}") from error
    if (
        not stat.S_ISDIR(details.st_mode)
        or details.st_uid != os.geteuid()
        or stat.S_IMODE(details.st_mode) & 0o077
    ):
        raise RestoreError(f"{label} must be a private operator-owned directory")


def _prepare_output(path_text: str, *, label: str) -> Path:
    path = Path(path_text)
    if not path.is_absolute() or path != Path(os.path.realpath(path)):
        raise RestoreError(f"{label} must be an absolute non-symlink path")
    _private_directory(path.parent, label=f"{label} parent")
    try:
        os.lstat(path)
    except FileNotFoundError:
        return path
    except OSError as error:
        raise RestoreError(f"cannot inspect {label}: {error}") from error
    raise RestoreError(f"{label} already exists")


def _prepare_evidence_directory(path_text: str) -> Path:
    path = _prepare_output(path_text, label="producer evidence directory")
    os.mkdir(path, 0o700)
    descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    return path


def _exclusive_receipt(
    path: Path,
    document: dict[str, Any],
    *,
    run_state: RunState | None = None,
    final_receipt: bool = False,
) -> str:
    payload = _canonical_json(document)
    if not 0 < len(payload) <= MAX_RECEIPT_BYTES:
        raise RestoreError("receipt exceeds its byte ceiling")
    temporary = path.parent / f".{path.name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
    descriptor: int | None = None
    linked = False
    blocked: set[signal.Signals] = {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}
    previous_mask: set[signal.Signals] | None = None
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        offset = 0
        while offset < len(payload):
            offset += os.write(descriptor, payload[offset:])
        os.fchmod(descriptor, stat.S_IRUSR)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = None
        previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
        try:
            os.link(temporary, path, follow_symlinks=False)
            linked = True
            temporary.unlink()
            directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
            if run_state is not None and final_receipt:
                run_state.receipt_committed = True
                run_state.committed_status = str(document.get("status"))
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
            previous_mask = None
    except FileExistsError as error:
        raise RestoreError(
            f"receipt destination appeared concurrently: {path}"
        ) from error
    except BaseException:
        if linked and (run_state is None or not run_state.receipt_committed):
            try:
                path.unlink()
            except FileNotFoundError:
                pass
        raise
    finally:
        if descriptor is not None:
            os.close(descriptor)
        if previous_mask is not None:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
        temporary.unlink(missing_ok=True)
    return hashlib.sha256(payload).hexdigest()


def _process_group_exists(process_group_id: int) -> bool:
    try:
        os.killpg(process_group_id, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    process_group_id = process.pid
    try:
        os.killpg(process_group_id, signal.SIGTERM)
    except ProcessLookupError:
        pass
    grace_deadline = time.monotonic() + 5.0
    while _process_group_exists(process_group_id):
        remaining = grace_deadline - time.monotonic()
        if remaining <= 0:
            break
        if process.poll() is None:
            try:
                process.wait(timeout=min(0.05, remaining))
            except subprocess.TimeoutExpired:
                pass
        else:
            time.sleep(min(0.05, remaining))
    if _process_group_exists(process_group_id):
        try:
            os.killpg(process_group_id, signal.SIGKILL)
        except ProcessLookupError:
            pass
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired as error:
        raise RestoreError("bounded command process group survived SIGKILL") from error


def _trusted_executable(name: str) -> str:
    candidate = shutil.which(name)
    if candidate is None:
        raise RestoreError(f"required operator executable is unavailable: {name}")
    path = Path(candidate).resolve(strict=True)
    details = path.stat()
    parent = path.parent.stat()
    if (
        path.name != Path(name).name
        or not stat.S_ISREG(details.st_mode)
        or details.st_uid not in {0, os.geteuid()}
        or stat.S_IMODE(details.st_mode) & 0o022
        or parent.st_uid not in {0, os.geteuid()}
        or stat.S_IMODE(parent.st_mode) & 0o022
    ):
        raise RestoreError(f"operator executable is not trusted: {name}")
    return str(path)


def _command_environment(executable: str) -> dict[str, str]:
    environment: dict[str, str] = {}
    for name in ("LANG", "LC_ALL", "LC_CTYPE"):
        value = os.environ.get(name)
        if value:
            environment[name] = value
    if Path(executable).name == "gh":
        home = os.environ.get("HOME")
        if home:
            environment["HOME"] = home
        for name in (
            "GH_TOKEN",
            "GITHUB_TOKEN",
            "GH_ENTERPRISE_TOKEN",
            "GITHUB_ENTERPRISE_TOKEN",
        ):
            value = os.environ.get(name)
            if value:
                environment[name] = value
        environment.update(
            {"GH_HOST": "github.com", "GH_PROMPT_DISABLED": "1", "NO_COLOR": "1"}
        )
    directories = [
        str(Path(executable).parent),
        "/opt/homebrew/bin",
        "/usr/local/bin",
        "/usr/bin",
        "/bin",
        "/usr/sbin",
        "/sbin",
    ]
    environment["PATH"] = os.pathsep.join(dict.fromkeys(directories))
    return environment


def _bounded_command(
    deadline: Deadline,
    argv: Sequence[str],
    *,
    label: str,
    maximum: int = MAX_JSON_BYTES,
) -> str:
    executable = _trusted_executable(argv[0])
    with tempfile.TemporaryFile() as stdout, tempfile.TemporaryFile() as stderr:
        try:
            process = subprocess.Popen(
                [executable, *argv[1:]],
                stdin=subprocess.DEVNULL,
                stdout=stdout,
                stderr=stderr,
                env=_command_environment(executable),
                start_new_session=True,
            )
        except OSError as error:
            raise RestoreError(f"cannot start {label}: {error}") from error
        try:
            process.wait(timeout=deadline.command_timeout())
        except subprocess.TimeoutExpired as error:
            _terminate_process_group(process)
            raise RestoreError(f"{label} exceeded its bounded timeout") from error
        except BaseException:
            _terminate_process_group(process)
            raise
        if _process_group_exists(process.pid):
            _terminate_process_group(process)
            raise RestoreError(f"{label} left a surviving child process")
        stdout.seek(0, os.SEEK_END)
        stdout_size = stdout.tell()
        stderr.seek(0, os.SEEK_END)
        stderr_size = stderr.tell()
        if stdout_size > maximum or stderr_size > MAX_JSON_BYTES:
            raise RestoreError(f"{label} exceeded its output ceiling")
        stdout.seek(0)
        stderr.seek(0)
        raw_stdout = stdout.read()
        raw_stderr = stderr.read()
    try:
        output = raw_stdout.decode("utf-8", "strict")
        error_output = raw_stderr.decode("utf-8", "replace").strip()
    except UnicodeError as error:
        raise RestoreError(f"{label} returned non-UTF-8 output") from error
    if process.returncode != 0:
        if error_output:
            print(f"{label}: {error_output}", file=sys.stderr)
        raise CommandError(label, process.returncode)
    return output


def _gh(
    deadline: Deadline,
    *arguments: str,
    label: str | None = None,
    maximum: int = MAX_JSON_BYTES,
) -> str:
    return _bounded_command(
        deadline,
        ("gh", *arguments),
        label=label or f"gh {' '.join(arguments[:3])}",
        maximum=maximum,
    )


