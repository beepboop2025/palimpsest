    _validate_directory(
        config.control_root,
        label="rotation control root",
        uid=config.pin_uid,
        gid=config.pin_gid,
        mode=0o750,
    )
    root = _rotation_history_root(config)
    for relative in (
        "",
        "pins",
        "receipts",
        "manifests",
        "manifests/provider",
        "manifests/public",
        "topologies",
        "rotations",
    ):
        path = root / relative if relative else root
        _validate_directory(
            path,
            label=f"base-rotation history {relative or 'root'}",
            uid=config.pin_uid,
            gid=config.pin_gid,
            mode=0o750,
        )
    return root


def _read_rotation_artifact(
    config: LineageConfig,
    *,
    history_root: Path,
    category: str,
    digest: str,
    claimed_path: Any,
    label: str,
    maximum: int,
    origin: str | None = None,
) -> bytes:
    parent = history_root / category
    if origin is not None:
        if origin not in {"provider", "public"}:
            raise WatchdogError(f"{label} origin is invalid")
        parent /= origin
    expected = parent / f"{digest}.json"
    if claimed_path != str(expected):
        raise WatchdogError(f"{label} path is not content-addressed")
    raw = _read_regular(
        expected,
        label=label,
        maximum=maximum,
        uid=config.pin_uid,
        gid=config.pin_gid,
        mode=0o640,
        single_link=True,
    )
    if _sha256(raw) != digest:
        raise WatchdogError(f"{label} digest changed")
    return raw


def _validate_pin_manifest_history(
    config: LineageConfig,
    proof: dict[str, Any],
    *,
    history_root: Path,
    origin: str,
    receipt: dict[str, Any],
) -> bytes:
    _expect_keys(proof, {"bytes", "path", "sha256"}, label=f"{origin} manifest")
    digest = _digest(proof["sha256"], label=f"{origin} manifest digest")
    raw = _read_rotation_artifact(
        config,
        history_root=history_root,
        category="manifests",
        origin=origin,
        digest=digest,
        claimed_path=proof["path"],
        label=f"base-rotation {origin} manifest",
        maximum=MAX_JSON_BYTES,
    )
    if len(raw) != _positive_integer(proof["bytes"], label=f"{origin} bytes"):
        raise WatchdogError(f"base-rotation {origin} manifest byte count changed")
    _validate_live_manifest(config, raw, receipt, pin={})
    return raw


def _validate_pin_rotation_topology(
    config: LineageConfig,
    railway: dict[str, Any],
    *,
    history_root: Path,
    expected_deployment_id: str,
) -> None:
    _expect_keys(
        railway,
        {
            "created_at",
            "deployment_id",
            "environment_id",
            "image_digest",
            "project_id",
            "reason",
            "service_id",
            "topology",
        },
        label="successor Railway proof",
    )
    for key in ("deployment_id", "environment_id", "project_id", "service_id"):
        value = railway[key]
        if not isinstance(value, str) or UUID.fullmatch(value) is None:
            raise WatchdogError(f"successor Railway {key} is invalid")
    if (
        railway["deployment_id"] != expected_deployment_id
        or not isinstance(railway["image_digest"], str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", railway["image_digest"]) is None
        or railway["reason"] not in {"deploy", "deploymentRollback", "rollback"}
        or not isinstance(railway["created_at"], str)
        or len(railway["created_at"]) > 64
    ):
        raise WatchdogError("successor Railway deployment identity is invalid")
    topology = railway.get("topology")
    if not isinstance(topology, dict):
        raise WatchdogError("successor Railway topology proof is invalid")
    _expect_keys(topology, {"bytes", "path", "sha256"}, label="successor topology")
    digest = _digest(topology["sha256"], label="successor topology digest")
    raw = _read_rotation_artifact(
        config,
        history_root=history_root,
        category="topologies",
        digest=digest,
        claimed_path=topology["path"],
        label="successor Railway topology",
        maximum=16 * 1024 * 1024,
    )
    if len(raw) != _positive_integer(topology["bytes"], label="topology bytes"):
        raise WatchdogError("successor Railway topology byte count changed")
    document = _strict_json(raw, label="successor Railway topology")
    if document.get("id") != railway["project_id"]:
        raise WatchdogError("successor Railway project changed")
    service = _one(
        _edges(document.get("services"), label="services"),
        key="id",
        expected=railway["service_id"],
        label="service",
    )
    if service.get("name") != "palimpsest-publication":
        raise WatchdogError("successor Railway service changed")
    environment = _one(
        _edges(document.get("environments"), label="environments"),
        key="id",
        expected=railway["environment_id"],
        label="environment",
    )
    instance = _one(
        _edges(environment.get("serviceInstances"), label="service instances"),
        key="serviceId",
        expected=railway["service_id"],
        label="service instance",
    )
    latest = instance.get("latestDeployment")
    metadata = latest.get("meta") if isinstance(latest, dict) else None
    if (
        not isinstance(latest, dict)
        or latest.get("id") != railway["deployment_id"]
        or latest.get("status") != "SUCCESS"
        or latest.get("createdAt") != railway["created_at"]
        or not isinstance(metadata, dict)
        or metadata.get("imageDigest") != railway["image_digest"]
        or metadata.get("reason") != railway["reason"]
    ):
        raise WatchdogError("successor Railway topology deployment changed")


def _validate_successor_rotation_record(
    config: LineageConfig,
    pin: dict[str, Any],
    raw: bytes,
    *,
    history_root: Path,
) -> None:
    predecessor = pin["predecessor"]
    receipt_digest = predecessor["publication_receipt"]["sha256"]
    expected = history_root / "rotations" / (
        f"{pin['generation']}-{pin['target']['base_sha']}-{receipt_digest}.json"
    )
    if pin["rotation_record_path"] != str(expected):
        raise WatchdogError("successor rotation-record path is not canonical")
    record_raw = _read_regular(
        expected,
        label="successor rotation record",
        maximum=2 * MAX_RECEIPT_BYTES,
        uid=config.pin_uid,
        gid=config.pin_gid,
        mode=0o640,
    )
    record = _strict_json(record_raw, label="successor rotation record")
    _expect_keys(
        record,
        {
            "generation",
            "next_pin",
            "next_pin_sha256",
            "predecessor_pin_sha256",
            "predecessor_receipt_sha256",
            "recorded_at",
            "schema_version",
            "status",
            "target_base_sha",
        },
        label="successor rotation record",
    )
    if (
        record["schema_version"] != ROTATION_SCHEMA
        or record["status"] != "verified"
        or record["generation"] != pin["generation"]
        or record["recorded_at"] != pin["recorded_at"]
        or record["target_base_sha"] != pin["target"]["base_sha"]
        or record["predecessor_pin_sha256"] != predecessor["pin"]["sha256"]
        or record["predecessor_receipt_sha256"] != receipt_digest
        or record["next_pin"] != pin
        or record["next_pin_sha256"] != _sha256(raw)
    ):
        raise WatchdogError("successor rotation record changed")


def _validate_successor_pin_document(
    config: LineageConfig,
    pin: dict[str, Any],
    raw: bytes,
    *,
    history_root: Path,
    active: bool,
    seen: set[str],
) -> dict[str, dict[str, Any]]:
    digest = _sha256(raw)
    if digest in seen:
        raise WatchdogError("publication base pin chain contains a loop")
    seen.add(digest)
    _expect_keys(
        pin,
        {
            "anchor",
            "generation",
            "host",
            "installed",
            "live",
            "origins",
            "predecessor",
            "railway",
            "recorded_at",
            "rotation_record_path",
            "schema_version",
            "status",
            "target",
        },
        label="successor publication base pin",
    )
    generation = pin["generation"]
    if (
        pin["schema_version"] != SUCCESSOR_PIN_SCHEMA
        or pin["status"] != "verified"
        or isinstance(generation, bool)
        or not isinstance(generation, int)
        or generation < 1
        or generation > MAX_PIN_GENERATIONS
    ):
        raise WatchdogError("successor publication base pin identity is invalid")
    parse_timestamp(pin["recorded_at"])
    for key in (
        "anchor",
        "host",
        "installed",
        "live",
        "origins",
        "predecessor",
        "railway",
        "target",
    ):
        if not isinstance(pin[key], dict):
            raise WatchdogError(f"successor publication base {key} is invalid")
    anchor = pin["anchor"]
    host = pin["host"]
    installed = pin["installed"]
    live = pin["live"]
    predecessor = pin["predecessor"]
    target = pin["target"]
    _expect_keys(anchor, {"path", "schema_version", "sha256", "target_sha"}, label="pin anchor")
    if (
        anchor["schema_version"] != PIN_SCHEMA
        or anchor["sha256"] != INCIDENT_PIN_SHA256
        or anchor["target_sha"] != INCIDENT_PIN_TARGET_SHA
    ):
        raise WatchdogError("successor pin changed the incident anchor")
    anchor_raw = _read_rotation_artifact(
        config,
        history_root=history_root,
        category="pins",
        digest=INCIDENT_PIN_SHA256,
        claimed_path=anchor["path"],
        label="incident publication pin anchor",
        maximum=MAX_RECEIPT_BYTES,
    )
    anchor_pin = _strict_json(anchor_raw, label="incident publication pin anchor")
    _validate_legacy_pin_document(
        config,
        anchor_pin,
        anchor_raw,
        active=False,
    )
    anchor_previous = anchor_pin["previous"]
    _expect_keys(host, {"canonical_head", "deployed_commit"}, label="pin host")
    if host != {
        "canonical_head": anchor_previous["canonical_head"],
        "deployed_commit": anchor_previous["deployed_commit"],
    }:
        raise WatchdogError("successor pin changed the protected host identity")
    _validate_installed_pin_proof(
        config,
        installed,
        successor=True,
        active=active,
    )
    _expect_keys(pin["origins"], {"provider", "public"}, label="pin origins")
    if pin["origins"] != {
        "provider": config.provider_origin,
        "public": config.public_origin,
    }:
        raise WatchdogError("successor pin names different origins")
    _expect_keys(target, {"base_sha", "public_main_sha"}, label="pin target")
    target_sha = _sha40(target["base_sha"], label="successor target")
    if target["public_main_sha"] != target_sha:
        raise WatchdogError("successor target is not public main")

    _expect_keys(predecessor, {"pin", "publication_receipt"}, label="pin predecessor")
    pin_proof = predecessor["pin"]
    receipt_proof = predecessor["publication_receipt"]
    if not isinstance(pin_proof, dict) or not isinstance(receipt_proof, dict):
        raise WatchdogError("successor predecessor proof is invalid")
    _expect_keys(
        pin_proof,
        {"generation", "path", "schema_version", "sha256", "target_sha"},
        label="predecessor pin proof",
    )
    prior_generation = pin_proof["generation"]
    prior_digest = _digest(pin_proof["sha256"], label="predecessor pin digest")
    prior_target = _sha40(pin_proof["target_sha"], label="predecessor pin target")
    if (
        isinstance(prior_generation, bool)
        or not isinstance(prior_generation, int)
        or prior_generation != generation - 1
    ):
        raise WatchdogError("successor pin generation is not consecutive")
    prior_raw = _read_rotation_artifact(
        config,
        history_root=history_root,
        category="pins",
        digest=prior_digest,
        claimed_path=pin_proof["path"],
        label="predecessor publication pin",
        maximum=MAX_RECEIPT_BYTES,
    )
    prior_pin = _strict_json(prior_raw, label="predecessor publication pin")
    pins: dict[str, dict[str, Any]]
    if prior_generation == 0:
        if (
            pin_proof["schema_version"] != PIN_SCHEMA
            or prior_digest != INCIDENT_PIN_SHA256
            or prior_target != INCIDENT_PIN_TARGET_SHA
        ):
            raise WatchdogError("first successor does not extend the incident pin")
        _validate_legacy_pin_document(
            config,
            prior_pin,
            prior_raw,
            active=False,
        )
        pins = {prior_digest: prior_pin}
    else:
        if pin_proof["schema_version"] != SUCCESSOR_PIN_SCHEMA:
            raise WatchdogError("predecessor pin schema is unsupported")
        pins = _validate_successor_pin_document(
            config,
            prior_pin,
            prior_raw,
            history_root=history_root,
            active=False,
            seen=seen,
        )
        if (
            prior_pin["generation"] != prior_generation
            or prior_pin["target"]["base_sha"] != prior_target
            or prior_pin["anchor"] != anchor
        ):
            raise WatchdogError("predecessor pin summary changed")

    _run_git(config.source_repository, "cat-file", "-e", f"{target_sha}^{{commit}}")
    _run_git(
        config.source_repository,
        "merge-base",
        "--is-ancestor",
        prior_target,
        target_sha,
    )
    _run_git(
        config.source_repository,
        "merge-base",
        "--is-ancestor",
        target_sha,
        "refs/remotes/origin/main",
    )

    _expect_keys(
        receipt_proof,
        {
            "base_sha",
            "deployment_id",
            "host_deployed_sha",
            "input_sha256",
            "manifest_sha256",
            "path",
            "publication_base_sha256",
            "release_sha",
            "schema_version",
            "sha256",
            "tree_sha256",
            "wire_generated_at",
        },
        label="predecessor receipt proof",
    )
    receipt_digest = _digest(receipt_proof["sha256"], label="predecessor receipt digest")
    receipt_raw = _read_rotation_artifact(
        config,
        history_root=history_root,
        category="receipts",
        digest=receipt_digest,
        claimed_path=receipt_proof["path"],
        label="predecessor publication receipt",
        maximum=MAX_RECEIPT_BYTES,
    )
    receipt = _strict_json(receipt_raw, label="predecessor publication receipt")
    receipt_pin_digest = _digest(
        receipt_proof["publication_base_sha256"],
        label="predecessor receipt publication-base digest",
    )
    receipt_pin = pins.get(receipt_pin_digest)
    if receipt_pin is None:
        raise WatchdogError(
            "successor predecessor receipt pin is outside the authenticated lineage"
        )
    _validate_v2_receipt(
        config,
        receipt,
        pin=receipt_pin,
        pin_sha256=receipt_pin_digest,
        current=False,
        verify_bundle_git=False,
    )
    expected_receipt = {
        "base_sha": receipt["base_sha"],
        "deployment_id": receipt["railway"]["deployment_id"],
        "host_deployed_sha": receipt["host_deployed_sha"],
        "input_sha256": receipt["input_sha256"],
        "manifest_sha256": receipt["live_manifest"]["sha256"],
        "path": receipt_proof["path"],
        "publication_base_sha256": receipt["publication_base"]["sha256"],
        "release_sha": receipt["release_sha"],
        "schema_version": receipt["schema_version"],
        "sha256": receipt_digest,
        "tree_sha256": receipt["live_manifest"]["tree_sha256"],
        "wire_generated_at": receipt["wire_generated_at"],
    }
    if (
        receipt_proof != expected_receipt
        or receipt["base_sha"] != receipt_pin["target"]["base_sha"]
        or receipt["publication_base"]["sha256"] != receipt_pin_digest
        or receipt["host_deployed_sha"] != host["deployed_commit"]
    ):
        raise WatchdogError("successor predecessor receipt projection changed")

    _expect_keys(
        live,
        {
            "file_count",
            "provider_manifest",
            "public_manifest",
            "release_sha",
            "total_bytes",
            "tree_sha256",
        },
        label="successor live proof",
    )
    if not isinstance(live["provider_manifest"], dict) or not isinstance(
        live["public_manifest"], dict
    ):
        raise WatchdogError("successor live manifest proof is invalid")
    provider_raw = _validate_pin_manifest_history(
        config,
        live["provider_manifest"],
        history_root=history_root,
        origin="provider",
        receipt=receipt,
    )
    public_raw = _validate_pin_manifest_history(
        config,
        live["public_manifest"],
        history_root=history_root,
        origin="public",
        receipt=receipt,
    )
    if (
        provider_raw != public_raw
        or live["release_sha"] != receipt["release_sha"]
        or live["tree_sha256"] != receipt["live_manifest"]["tree_sha256"]
        or live["file_count"] != receipt["live_manifest"]["file_count"]
        or live["total_bytes"] != receipt["live_manifest"]["total_bytes"]
        or _sha256(provider_raw) != receipt["live_manifest"]["sha256"]
    ):
        raise WatchdogError("successor live proof differs from predecessor receipt")
    live_deployment_id = receipt["railway"]["deployment_id"]
    if (config.control_root / f"restored-{receipt_digest}.json").exists():
        helper = runpy.run_path(str(config.installed_rotation_helper))
        live_deployment_id = helper["_restored_deployment_id"](config.control_root, receipt_raw, receipt, config.pin_gid)
    _validate_pin_rotation_topology(
        config,
        pin["railway"],
        history_root=history_root,
        expected_deployment_id=live_deployment_id,
    )
    _validate_successor_rotation_record(
        config,
        pin,
        raw,
        history_root=history_root,
    )
    pins[digest] = pin
    return pins


def _validate_pin(
    config: LineageConfig,
) -> tuple[dict[str, Any], bytes, dict[str, dict[str, Any]]]:
    raw = _read_regular(
        config.base_pin,
        label="publication base pin",
        maximum=MAX_RECEIPT_BYTES,
        uid=config.pin_uid,
        gid=config.pin_gid,
        mode=0o640,
    )
    pin = _strict_json(raw, label="publication base pin")
    digest = _sha256(raw)
    if pin.get("schema_version") == PIN_SCHEMA:
        _validate_legacy_pin_document(config, pin, raw, active=True)
        return pin, raw, {digest: pin}
    if pin.get("schema_version") != SUCCESSOR_PIN_SCHEMA:
        raise WatchdogError("publication base pin schema is unsupported")
    history_root = _validate_rotation_history_layout(config)
    pins = _validate_successor_pin_document(
        config,
        pin,
        raw,
        history_root=history_root,
        active=True,
        seen=set(),
    )
    return pin, raw, pins


def _validate_v1_receipt(
    raw: bytes,
    receipt: dict[str, Any],
    *,
    pin: dict[str, Any] | None,
    allow_current_pre_transition: bool,
) -> None:
    _expect_keys(
        receipt,
        {
            "schema_version",
            "status",
            "recorded_at",
            "input_sha256",
            "wire_generated_at",
            "base_sha",
            "release_sha",
            "railway",
            "origins",
            "github_actions_used",
        },
        label="v1 publication receipt",
    )
    if allow_current_pre_transition:
        if pin is not None:
            raise WatchdogError("v1 pre-transition receipt cannot coexist with a pin")
        if _sha256(raw) != INCIDENT_RECEIPT_SHA256:
            raise WatchdogError("v1 receipt is not the exact pre-transition receipt")
    elif pin is None or _sha256(raw) != INCIDENT_RECEIPT_SHA256:
        raise WatchdogError("archived v1 receipt is not the transition predecessor")
    if (
        receipt["schema_version"] != V1_SCHEMA
        or receipt["status"] != "verified"
        or receipt["input_sha256"] != INCIDENT_INPUT_SHA256
        or receipt["base_sha"] != INCIDENT_BASE_SHA
        or receipt["release_sha"] != INCIDENT_RELEASE_SHA
        or receipt["github_actions_used"] is not False
    ):
        raise WatchdogError("v1 receipt identity does not match the incident")
    parse_timestamp(receipt["recorded_at"])
    parse_timestamp(receipt["wire_generated_at"])
    railway = receipt.get("railway")
    origins = receipt.get("origins")
    if not isinstance(railway, dict) or not isinstance(origins, dict):
        raise WatchdogError("v1 receipt proof objects are invalid")
    _expect_keys(railway, {"deployment_id", "status"}, label="v1 Railway proof")
    _expect_keys(origins, {"provider", "public"}, label="v1 origin proof")
    if railway != {"deployment_id": INCIDENT_DEPLOYMENT_ID, "status": "SUCCESS"}:
        raise WatchdogError("v1 receipt names a different deployment")


def _run_git(repository: Path, *arguments: str) -> str:
    environment = {
        "PATH": "/usr/bin:/bin",
        "HOME": "/nonexistent",
        "LANG": "C.UTF-8",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_TERMINAL_PROMPT": "0",
    }
    try:
        result = subprocess.run(
            ["/usr/bin/git", "-C", str(repository), *arguments],
            check=True,
            capture_output=True,
            text=True,
            timeout=30,
            env=environment,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        detail = ""
        if isinstance(exc, subprocess.CalledProcessError):
            detail = exc.stderr.strip()
        suffix = f": {detail}" if detail else ""
        raise WatchdogError(f"Git proof failed ({' '.join(arguments)}){suffix}") from exc
    return result.stdout.strip()


def _validate_bundle(
    config: LineageConfig,
    bundle: dict[str, Any],
    *,
    base_sha: str,
    release_sha: str,
    verify_git: bool,
) -> None:
    _expect_keys(
        bundle,
        {
            "schema_version",
            "path",
            "sha256",
            "bytes",
            "base_sha",
            "release_sha",
            "metadata_path",
            "metadata_sha256",
        },
        label="release bundle receipt",
    )
    expected_root = config.state_root / "release-bundles"
    _validate_directory(
        expected_root,
        label="release bundle directory",
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o700,
    )
    expected_bundle = expected_root / f"{release_sha}.bundle"
    expected_metadata = expected_root / f"{release_sha}.json"
    if bundle["path"] != str(expected_bundle) or bundle["metadata_path"] != str(
        expected_metadata
    ):
        raise WatchdogError("release bundle path escapes its private identity path")
    if (
        bundle["schema_version"] != BUNDLE_SCHEMA
        or bundle["base_sha"] != base_sha
        or bundle["release_sha"] != release_sha
    ):
        raise WatchdogError("release bundle receipt identity is inconsistent")
    expected_bytes = _positive_integer(bundle["bytes"], label="release bundle bytes")
    expected_digest = _digest(bundle["sha256"], label="release bundle digest")
    metadata_digest = _digest(
        bundle["metadata_sha256"], label="release bundle metadata digest"
    )

    raw_bundle = _read_regular(
        expected_bundle,
        label="release bundle",
        maximum=1024 * 1024 * 1024,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    if len(raw_bundle) != expected_bytes or _sha256(raw_bundle) != expected_digest:
        raise WatchdogError("release bundle bytes do not match the receipt")
    raw_metadata = _read_regular(
        expected_metadata,
        label="release bundle metadata",
        maximum=MAX_BUNDLE_METADATA_BYTES,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    if _sha256(raw_metadata) != metadata_digest:
        raise WatchdogError("release bundle metadata digest is invalid")
    metadata = _strict_json(raw_metadata, label="release bundle metadata")
    _expect_keys(
        metadata,
        {
            "schema_version",
            "status",
            "created_at",
            "path",
            "sha256",
            "bytes",
            "base_sha",
            "release_sha",
        },
        label="release bundle metadata",
    )
    parse_timestamp(metadata["created_at"])
    if metadata != {
        "schema_version": BUNDLE_SCHEMA,
        "status": "verified",
        "created_at": metadata["created_at"],
        "path": str(expected_bundle),
        "sha256": expected_digest,
        "bytes": expected_bytes,
        "base_sha": base_sha,
        "release_sha": release_sha,
    }:
        raise WatchdogError("release bundle metadata does not match its bundle")

    if not verify_git:
        return

    repository = config.source_repository
    if (repository / ".git" / "shallow").exists() or (
        repository / ".git" / "info" / "grafts"
    ).exists():
        raise WatchdogError("bundle base repository uses shallow or grafted history")
    if _run_git(repository, "for-each-ref", "--format=%(refname)", "refs/replace"):
        raise WatchdogError("bundle base repository uses replacement objects")
    _run_git(repository, "cat-file", "-e", f"{base_sha}^{{commit}}")

    release_ref = f"refs/palimpsest/releases/{release_sha}"
    heads = _run_git(repository, "bundle", "list-heads", str(expected_bundle))
    if heads != f"{release_sha} {release_ref}":
        raise WatchdogError("release bundle exposes an unexpected head")
    with tempfile.TemporaryDirectory(prefix="palimpsest-watchdog-bundle-") as raw:
        verifier = Path(raw) / "verifier.git"
        verifier.mkdir()
        _run_git(verifier, "init", "--bare")
        base_ref = f"refs/palimpsest/verification-base/{base_sha}"
        _run_git(
            verifier,
            "fetch",
            "--quiet",
            str(repository),
            f"{base_sha}:{base_ref}",
        )
        if (verifier / "objects" / "info" / "alternates").exists():
            raise WatchdogError("bundle verifier unexpectedly uses alternates")
        _run_git(verifier, "bundle", "verify", str(expected_bundle))
        _run_git(
            verifier,
            "fetch",
            "--quiet",
            str(expected_bundle),
            f"{release_ref}:{release_ref}",
        )
        parents = _run_git(verifier, "rev-list", "--parents", "-n", "1", release_ref)
        if parents != f"{release_sha} {base_sha}":
            raise WatchdogError("release bundle is not the exact successor of its base")


def _receipt_manifest_identity(
    receipt: dict[str, Any], *, pin: dict[str, Any]
) -> tuple[str, str]:
    if receipt.get("schema_version") == V1_SCHEMA:
        previous = pin["previous"]
        return previous["live_manifest_sha256"], previous["live_tree_sha256"]
    manifest = receipt.get("live_manifest")
    if not isinstance(manifest, dict):
        raise WatchdogError("v2 receipt has no live manifest proof")
    return (
        _digest(manifest.get("sha256"), label="receipt manifest digest"),
        _digest(manifest.get("tree_sha256"), label="receipt tree digest"),
    )


def _validate_predecessor_reference(
    config: LineageConfig,
    predecessor: dict[str, Any],
) -> tuple[str, Path]:
    _expect_keys(
        predecessor,
        {
            "archive_path",
            "base_sha",
            "deployment_id",
            "input_sha256",
            "manifest_sha256",
            "receipt_sha256",
            "release_sha",
            "schema_version",
            "tree_sha256",
            "wire_generated_at",
        },
        label="publication predecessor",
    )
    receipt_digest = _digest(
        predecessor["receipt_sha256"], label="predecessor receipt digest"
    )
    _sha40(predecessor["base_sha"], label="predecessor base")
    _sha40(predecessor["release_sha"], label="predecessor release")
    _digest(predecessor["input_sha256"], label="predecessor input digest")
    _digest(predecessor["manifest_sha256"], label="predecessor manifest digest")
    _digest(predecessor["tree_sha256"], label="predecessor tree digest")
    parse_timestamp(predecessor["wire_generated_at"])
    if predecessor["schema_version"] not in {V1_SCHEMA, V2_SCHEMA}:
        raise WatchdogError("predecessor receipt schema is unsupported")
    if (
        not isinstance(predecessor["deployment_id"], str)
        or UUID.fullmatch(predecessor["deployment_id"]) is None
    ):
        raise WatchdogError("predecessor deployment ID is invalid")
    archive_root = config.state_root / "receipts"
    _validate_directory(
        archive_root,
        label="receipt archive directory",
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o700,
    )
    archive_path = archive_root / f"{receipt_digest}.json"
    if predecessor["archive_path"] != str(archive_path):
        raise WatchdogError("predecessor receipt path escapes its digest path")
    return receipt_digest, archive_path


def _read_predecessor_archive(
    config: LineageConfig,
    predecessor: dict[str, Any],
    *,
    pin: dict[str, Any],
) -> tuple[str, bytes, dict[str, Any]]:
    receipt_digest, archive_path = _validate_predecessor_reference(
        config, predecessor
    )
    raw = _read_regular(
        archive_path,
        label="predecessor receipt archive",
        maximum=MAX_RECEIPT_BYTES,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    if _sha256(raw) != receipt_digest:
        raise WatchdogError("predecessor archive does not match its digest")
    archived = _strict_json(raw, label="predecessor receipt archive")
    schema = predecessor["schema_version"]
    if archived.get("schema_version") != schema or schema not in {V1_SCHEMA, V2_SCHEMA}:
        raise WatchdogError("predecessor schema does not match its archive")

    railway = archived.get("railway")
    if not isinstance(railway, dict):
        raise WatchdogError("predecessor archive has no Railway proof")
    manifest_sha256, tree_sha256 = _receipt_manifest_identity(archived, pin=pin)
    expected = {
        "archive_path": str(archive_path),
        "base_sha": archived.get("base_sha"),
        "deployment_id": railway.get("deployment_id"),
        "input_sha256": archived.get("input_sha256"),
        "manifest_sha256": manifest_sha256,
        "receipt_sha256": receipt_digest,
        "release_sha": archived.get("release_sha"),
        "schema_version": schema,
        "tree_sha256": tree_sha256,
        "wire_generated_at": archived.get("wire_generated_at"),
    }
    if (
        schema == V2_SCHEMA
        and predecessor["deployment_id"] != expected["deployment_id"]
        and (config.control_root / f"restored-{receipt_digest}.json").exists()
    ):
        # Keep historical links unchanged; resolve only a differing restored ID.
        helper = runpy.run_path(str(config.installed_rotation_helper))
        expected["deployment_id"] = helper["_restored_deployment_id"](
            config.control_root, raw, archived, config.pin_gid
        )
    if predecessor != expected:
        raise WatchdogError("predecessor fields do not match the immutable archive")
    return receipt_digest, raw, archived


def _validate_transition_anchor(
    config: LineageConfig,
    *,
    pin: dict[str, Any],
) -> None:
    previous = pin["previous"]
    digest = previous["publication_receipt_sha256"]
    predecessor = {
        "archive_path": str(config.state_root / "receipts" / f"{digest}.json"),
        "base_sha": previous["deployed_commit"],
        "deployment_id": previous["railway_deployment_id"],
        "input_sha256": previous["publication_input_sha256"],
        "manifest_sha256": previous["live_manifest_sha256"],
        "receipt_sha256": digest,
        "release_sha": previous["live_release_sha"],
        "schema_version": V1_SCHEMA,
        "tree_sha256": previous["live_tree_sha256"],
        "wire_generated_at": "2026-08-30T08:45:26Z",
    }
    receipt_digest, raw, archived = _read_predecessor_archive(
        config,
        predecessor,
        pin=pin,
    )
    _validate_v1_receipt(
        raw,
        archived,
        pin=pin,
        allow_current_pre_transition=False,
    )
    if receipt_digest != INCIDENT_RECEIPT_SHA256:
        raise WatchdogError("transition anchor is not the incident receipt")


def _validate_chain_checkpoint(
    checkpoint: dict[str, Any] | None,
    *,
    authenticated_pins: dict[str, dict[str, Any]],
) -> dict[str, Any] | None:
    if checkpoint is None:
        return None
    schema = checkpoint.get("schema_version")
    common = {
        "anchor_receipt_sha256",
        "generation_count",
        "head_receipt_sha256",
        "head_release_sha",
        "schema_version",
        "validation_mode",
        "verified_at",
    }
    if schema == LEGACY_CHAIN_CHECKPOINT_SCHEMA:
        _expect_keys(
            checkpoint,
            common | {"pin_sha256"},
            label="publication chain checkpoint",
        )
        head_pin_sha256 = checkpoint["pin_sha256"]
    elif schema == CHAIN_CHECKPOINT_SCHEMA:
        _expect_keys(
            checkpoint,
            common | {"head_publication_base_sha256"},
            label="publication chain checkpoint",
        )
        head_pin_sha256 = checkpoint["head_publication_base_sha256"]
    else:
        raise WatchdogError("publication chain checkpoint schema is unsupported")
    if (
        checkpoint["anchor_receipt_sha256"] != INCIDENT_RECEIPT_SHA256
        or head_pin_sha256 not in authenticated_pins
    ):
        raise WatchdogError("publication chain checkpoint has a different anchor")
    _digest(head_pin_sha256, label="checkpoint publication-base digest")
    _digest(checkpoint["head_receipt_sha256"], label="checkpoint head digest")
    _sha40(checkpoint["head_release_sha"], label="checkpoint release")
    _positive_integer(checkpoint["generation_count"], label="checkpoint generation")
    if checkpoint["validation_mode"] not in {
        "bootstrap",
        "checkpoint_extension",
        "checkpoint_same_head",
    }:
        raise WatchdogError("publication chain checkpoint mode is invalid")
    parse_timestamp(checkpoint["verified_at"])
    return {
        "anchor_receipt_sha256": checkpoint["anchor_receipt_sha256"],
        "generation_count": checkpoint["generation_count"],
        "head_publication_base_sha256": head_pin_sha256,
        "head_receipt_sha256": checkpoint["head_receipt_sha256"],
        "head_release_sha": checkpoint["head_release_sha"],
        "schema_version": CHAIN_CHECKPOINT_SCHEMA,
        "validation_mode": checkpoint["validation_mode"],
        "verified_at": checkpoint["verified_at"],
    }


def _receipt_pin(
    receipt: dict[str, Any],
    *,
    authenticated_pins: dict[str, dict[str, Any]],
) -> tuple[dict[str, Any], str]:
    publication_base = receipt.get("publication_base")
    if not isinstance(publication_base, dict):
        raise WatchdogError("v2 receipt has no publication-base proof")
    digest = _digest(
        publication_base.get("sha256"),
        label="receipt publication-base digest",
    )
    pin = authenticated_pins.get(digest)
    if pin is None:
        raise WatchdogError("receipt names an unauthenticated publication base")
    return pin, digest


def _validate_v2_receipt(
    config: LineageConfig,
    receipt: dict[str, Any],
    *,
    pin: dict[str, Any],
    pin_sha256: str,
    current: bool,
    verify_bundle_git: bool,
) -> None:
    _expect_keys(
        receipt,
        {
            "base_sha",
            "candidate",
            "github_actions_used",
            "host_deployed_sha",
            "input_sha256",
            "live_manifest",
            "origins",
            "predecessor",
            "publication_base",
            "railway",
            "recorded_at",
            "release_bundle",
            "release_sha",
            "schema_version",
            "status",
            "wire_generated_at",
        },
        label="v2 publication receipt",
    )
    if (
        receipt["schema_version"] != V2_SCHEMA
        or receipt["status"] != "verified"
        or receipt["github_actions_used"] is not False
    ):
        raise WatchdogError("v2 receipt identity is invalid")
    parse_timestamp(receipt["recorded_at"])
    parse_timestamp(receipt["wire_generated_at"])
    _digest(receipt["input_sha256"], label="publication input digest")
    base_sha = _sha40(receipt["base_sha"], label="publication base")
    release_sha = _sha40(receipt["release_sha"], label="release commit")
    host_deployed_sha = _sha40(
        receipt["host_deployed_sha"], label="host deployed commit"
    )
    if base_sha != pin["target"]["base_sha"]:
        raise WatchdogError("receipt publication base differs from the transition pin")
    if current:
        deployed_raw = _read_regular(
            config.deployed_commit,
            label="host deployed commit",
            maximum=256,
            uid=config.pin_uid,
            gid=config.installed_gid,
            mode=0o644,
        )
        try:
            deployed = deployed_raw.decode("ascii").strip()
        except UnicodeDecodeError as exc:
            raise WatchdogError("host deployed commit is not ASCII") from exc
        if host_deployed_sha != deployed:
            raise WatchdogError("receipt host deployment differs from deployed-commit")

    publication_base = receipt.get("publication_base")
    bundle = receipt.get("release_bundle")
    predecessor = receipt.get("predecessor")
    candidate = receipt.get("candidate")
    manifest = receipt.get("live_manifest")
    railway = receipt.get("railway")
    origins = receipt.get("origins")
    if not all(
        isinstance(value, dict)
        for value in (
            publication_base,
            bundle,
            predecessor,
            candidate,
            manifest,
            railway,
            origins,
        )
    ):
        raise WatchdogError("v2 receipt contains invalid proof objects")
    assert isinstance(publication_base, dict)
    assert isinstance(bundle, dict)
    assert isinstance(predecessor, dict)
    assert isinstance(candidate, dict)
    assert isinstance(manifest, dict)
    assert isinstance(railway, dict)
    assert isinstance(origins, dict)

    _expect_keys(
        publication_base,
        {"kind", "path", "sha256", "target_sha"},
        label="publication base proof",
    )
    if publication_base != {
        "kind": _pin_kind(pin),
        "path": str(config.base_pin),
        "sha256": pin_sha256,
        "target_sha": base_sha,
    }:
        raise WatchdogError("publication base proof does not match the root-owned pin")

    _validate_bundle(
        config,
        bundle,
        base_sha=base_sha,
        release_sha=release_sha,
        verify_git=verify_bundle_git,
    )
    _validate_predecessor_reference(config, predecessor)
    _validate_candidate_archive(
        config,
        candidate,
        receipt=receipt,
        pin=pin,
        pin_sha256=pin_sha256,
    )

    _expect_keys(
        manifest,
        {
            "bytes",
            "file_count",
            "path",
            "sha256",
            "total_bytes",
            "tree_sha256",
        },
        label="live manifest proof",
    )
    _validate_release_manifest_anchor(
        config,
        manifest,
        release_sha=release_sha,
    )

    _expect_keys(railway, {"deployment_id", "status"}, label="Railway proof")
    if (
        not isinstance(railway["deployment_id"], str)
        or UUID.fullmatch(railway["deployment_id"]) is None
        or railway["status"] != "SUCCESS"
    ):
        raise WatchdogError("Railway proof is invalid")
    _expect_keys(origins, {"provider", "public"}, label="origin proof")
    if origins != {
        "provider": config.provider_origin,
        "public": config.public_origin,
    }:
        raise WatchdogError("receipt names different live origins")


def _validate_receipt_chain(
    config: LineageConfig,
    current_raw: bytes,
    current_receipt: dict[str, Any],
    *,
    authenticated_pins: dict[str, dict[str, Any]],
    checkpoint: dict[str, Any] | None,
) -> dict[str, Any]:
    """Prove the append-only receipt chain without a generation-count expiry.

    The checkpoint is an optimization, not release authority: every invocation
    still validates the root-owned transition pin, exact v1 anchor, current
    receipt, current Git bundle, candidate archive, and live bytes.  A new tip
    must reach the prior checkpoint by immutable receipt digests.  During the
    initial bootstrap, ancestor bundles receive byte/metadata verification but
    only the current bundle is reconstructed in a fresh Git object database.
    """

    started = time.monotonic()
    checkpoint = _validate_chain_checkpoint(
        checkpoint,
        authenticated_pins=authenticated_pins,
    )
    current_digest = _sha256(current_raw)
    current_release = current_receipt["release_sha"]
    _current_pin, current_pin_sha256 = _receipt_pin(
        current_receipt,
        authenticated_pins=authenticated_pins,
    )
    if checkpoint is not None and checkpoint["head_receipt_sha256"] == current_digest:
        if checkpoint["head_release_sha"] != current_release:
            raise WatchdogError("chain checkpoint head release changed")
        if checkpoint["head_publication_base_sha256"] != current_pin_sha256:
            raise WatchdogError("chain checkpoint head publication base changed")
        generation_count = checkpoint["generation_count"]
        validation_mode = "checkpoint_same_head"
    else:
        document = current_receipt
        seen = {current_digest}
        new_generations = 1
        validation_mode = "bootstrap" if checkpoint is None else "checkpoint_extension"
        while True:
            if time.monotonic() - started > CHAIN_VALIDATION_BUDGET_SECONDS:
                raise WatchdogError("receipt-chain validation exceeded its 45s budget")
            predecessor = document["predecessor"]
            document_pin, _document_pin_sha256 = _receipt_pin(
                document,
                authenticated_pins=authenticated_pins,
            )
            receipt_digest, raw, archived = _read_predecessor_archive(
                config,
                predecessor,
                pin=document_pin,
            )
            if receipt_digest in seen:
                raise WatchdogError("publication predecessor chain contains a loop")
            seen.add(receipt_digest)

            if (
                checkpoint is not None
                and receipt_digest == checkpoint["head_receipt_sha256"]
            ):
                if archived.get("schema_version") != V2_SCHEMA:
                    raise WatchdogError("chain checkpoint does not name a v2 receipt")
                if archived.get("release_sha") != checkpoint["head_release_sha"]:
                    raise WatchdogError("chain checkpoint archive release changed")
                archived_pin, archived_pin_sha256 = _receipt_pin(
                    archived,
                    authenticated_pins=authenticated_pins,
                )
                if (
                    archived_pin_sha256
                    != checkpoint["head_publication_base_sha256"]
                ):
                    raise WatchdogError(
                        "chain checkpoint archive publication base changed"
                    )
                _validate_v2_receipt(
                    config,
                    archived,
                    pin=archived_pin,
                    pin_sha256=archived_pin_sha256,
                    current=False,
                    verify_bundle_git=False,
                )
                generation_count = checkpoint["generation_count"] + new_generations
                break

            schema = archived.get("schema_version")
            if schema == V1_SCHEMA:
                if checkpoint is not None:
                    raise WatchdogError("chain does not extend the saved checkpoint")
                anchor_pin = authenticated_pins.get(INCIDENT_PIN_SHA256)
                if anchor_pin is None:
                    raise WatchdogError("receipt chain has no incident pin anchor")
                _validate_v1_receipt(
                    raw,
                    archived,
                    pin=anchor_pin,
                    allow_current_pre_transition=False,
                )
                if receipt_digest != INCIDENT_RECEIPT_SHA256:
                    raise WatchdogError("receipt chain ends at a different v1 anchor")
                generation_count = new_generations
                break
            if schema != V2_SCHEMA:
                raise WatchdogError("receipt chain contains an unsupported schema")
            archived_pin, archived_pin_sha256 = _receipt_pin(
                archived,
                authenticated_pins=authenticated_pins,
            )
            _validate_v2_receipt(
                config,
                archived,
                pin=archived_pin,
                pin_sha256=archived_pin_sha256,
                current=False,
                verify_bundle_git=False,
            )
            document = archived
            new_generations += 1

    verified_at = utc_now().replace(microsecond=0).isoformat().replace("+00:00", "Z")
    return {
        "anchor_receipt_sha256": INCIDENT_RECEIPT_SHA256,
        "generation_count": generation_count,
        "head_publication_base_sha256": current_pin_sha256,
        "head_receipt_sha256": current_digest,
        "head_release_sha": current_release,
        "schema_version": CHAIN_CHECKPOINT_SCHEMA,
        "verified_at": verified_at,
        "validation_mode": validation_mode,
    }


def _validate_live_manifest(
    config: LineageConfig,
    raw: bytes,
    receipt: dict[str, Any],
    *,
    pin: dict[str, Any] | None,
) -> dict[str, Any]:
    manifest = _strict_json(raw, label="live release manifest")
    release_sha = receipt.get("release_sha")
    try:
        built_at = parse_timestamp(manifest.get("built_at"))
        receipt_recorded_at = parse_timestamp(receipt.get("recorded_at"))
    except ValueError as exc:
        raise WatchdogError("live manifest/receipt clock is invalid") from exc
    if built_at > receipt_recorded_at + timedelta(
        seconds=MAX_FUTURE_CLOCK_SKEW_SECONDS
    ):
        raise WatchdogError(
            "publication receipt predates the live manifest beyond the allowed "
            f"{MAX_FUTURE_CLOCK_SKEW_SECONDS}s clock skew"
        )
    if (
        manifest.get("schema_version") != "palimpsest.railway-static-release.v1"
        or manifest.get("state") != "artifact_ready"
        or manifest.get("source_commit") != release_sha
    ):
        raise WatchdogError("live release manifest identity is invalid")
    tree_sha256 = _digest(manifest.get("tree_sha256"), label="live tree digest")
    file_count = _positive_integer(manifest.get("file_count"), label="live file count")
    total_bytes = _positive_integer(
        manifest.get("total_bytes"), label="live total bytes"
    )
    if receipt.get("schema_version") == V1_SCHEMA:
        if pin is not None or _sha256(raw) != INCIDENT_MANIFEST_SHA256:
            raise WatchdogError("live v1 manifest is not the exact pre-transition artifact")
        if tree_sha256 != INCIDENT_TREE_SHA256:
            raise WatchdogError("live v1 tree differs from the incident tree")
    else:
        proof = receipt.get("live_manifest")
        if not isinstance(proof, dict):
            raise WatchdogError("v2 receipt has no live manifest anchor")
        anchor_raw, _anchor = _validate_release_manifest_anchor(
            config,
            proof,
            release_sha=_sha40(release_sha, label="live release commit"),
        )
        if raw != anchor_raw:
            raise WatchdogError(
                "live manifest bytes do not match the pre-mutation anchor"
            )
    return {
        "built_at": manifest["built_at"],
        "release_sha": release_sha,
        "tree_sha256": tree_sha256,
        "manifest_sha256": _sha256(raw),
        "file_count": file_count,
        "total_bytes": total_bytes,
    }


def _validate_private_artifact(
    config: LineageConfig,
    proof: dict[str, Any],
    *,
    expected_path: Path,
    label: str,
    maximum: int,
) -> bytes:
    _expect_keys(proof, {"bytes", "path", "sha256"}, label=label)
    if proof["path"] != str(expected_path):
        raise WatchdogError(f"{label} path is outside its evidence directory")
    expected_bytes = _positive_integer(proof["bytes"], label=f"{label} bytes")
    expected_sha256 = _digest(proof["sha256"], label=f"{label} digest")
    raw = _read_regular(
        expected_path,
        label=label,
        maximum=maximum,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    if len(raw) != expected_bytes or _sha256(raw) != expected_sha256:
        raise WatchdogError(f"{label} bytes do not match their candidate proof")
    return raw


def _validate_release_manifest_anchor(
    config: LineageConfig,
    proof: dict[str, Any],
    *,
    release_sha: str,
) -> tuple[bytes, dict[str, Any]]:
    _expect_keys(
        proof,
        {
            "bytes",
            "file_count",
            "path",
            "sha256",
            "total_bytes",
            "tree_sha256",
        },
        label="release manifest anchor",
    )
    anchor_root = config.state_root / "release-manifests"
    _validate_directory(
        anchor_root,
        label="release manifest anchor directory",
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o700,
    )
    anchor_path = anchor_root / f"{release_sha}.json"
    if proof["path"] != str(anchor_path):
        raise WatchdogError("release manifest anchor path is not canonical")
    expected_bytes = _positive_integer(
        proof["bytes"], label="release manifest anchor bytes"
    )
    expected_digest = _digest(
        proof["sha256"], label="release manifest anchor digest"
    )
    expected_tree = _digest(
        proof["tree_sha256"], label="release manifest anchor tree"
    )
    expected_files = _positive_integer(
        proof["file_count"], label="release manifest anchor file count"
    )
    expected_total = _positive_integer(
        proof["total_bytes"], label="release manifest anchor total bytes"
    )
    raw = _read_regular(
        anchor_path,
        label="release manifest anchor",
        maximum=MAX_JSON_BYTES,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    if len(raw) != expected_bytes or _sha256(raw) != expected_digest:
        raise WatchdogError("release manifest anchor bytes changed")
    manifest = _strict_json(raw, label="release manifest anchor")
    _expect_keys(
        manifest,
        {
            "built_at",
            "critical_files",
            "deployment_source",
            "file_count",
            "github_required",
            "schema_version",
            "source_commit",
            "state",
            "total_bytes",
            "tree_sha256",
        },
        label="release manifest anchor document",
    )
    parse_timestamp(manifest["built_at"])
    if (
        manifest["schema_version"] != "palimpsest.railway-static-release.v1"
        or manifest["source_commit"] != release_sha
        or manifest["deployment_source"] != "local-git-archive"
        or manifest["github_required"] is not False
        or manifest["state"] != "artifact_ready"
        or manifest["tree_sha256"] != expected_tree
        or manifest["file_count"] != expected_files
        or manifest["total_bytes"] != expected_total
        or not isinstance(manifest["critical_files"], dict)
        or not manifest["critical_files"]
    ):
        raise WatchdogError("release manifest anchor identity is invalid")
    return raw, manifest


def _edges(document: Any, *, label: str) -> list[dict[str, Any]]:
    if not isinstance(document, dict) or set(document) != {"edges"}:
        raise WatchdogError(f"rollback topology {label} inventory is invalid")
    rows = document["edges"]
    if not isinstance(rows, list) or len(rows) > 100:
        raise WatchdogError(f"rollback topology {label} inventory is invalid")
    nodes: list[dict[str, Any]] = []
    for row in rows:
        node = row.get("node") if isinstance(row, dict) else None
        if not isinstance(node, dict):
            raise WatchdogError(f"rollback topology {label} edge is invalid")
        nodes.append(node)
    return nodes


def _one(
    rows: list[dict[str, Any]],
    *,
    key: str,
    expected: str,
    label: str,
) -> dict[str, Any]:
    matches = [row for row in rows if row.get(key) == expected]
    if len(matches) != 1:
        raise WatchdogError(f"rollback topology {label} is not singular")
    return matches[0]


def _validate_rollback_evidence(
    config: LineageConfig,
    evidence: dict[str, Any],
    *,
    candidate_release_sha: str,
    predecessor: dict[str, Any],
) -> None:
    _expect_keys(
        evidence,
        {
            "captured_at",
            "provider_manifest",
            "public_manifest",
            "schema_version",
            "topology",
        },
        label="candidate rollback evidence",
    )
    if evidence["schema_version"] != ROLLBACK_EVIDENCE_SCHEMA:
        raise WatchdogError("candidate rollback evidence schema is invalid")
    parse_timestamp(evidence["captured_at"])
    provider = evidence.get("provider_manifest")
    public = evidence.get("public_manifest")
    topology = evidence.get("topology")
    if not all(isinstance(value, dict) for value in (provider, public, topology)):
        raise WatchdogError("candidate rollback evidence objects are invalid")
    assert isinstance(provider, dict)
    assert isinstance(public, dict)
    assert isinstance(topology, dict)

    evidence_root = config.state_root / "predecessors"
    release_root = evidence_root / candidate_release_sha
    _validate_directory(
        evidence_root,
        label="predecessor evidence root",
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o700,
    )
    _validate_directory(
        release_root,
        label="candidate predecessor evidence directory",
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o700,
    )
    provider_raw = _validate_private_artifact(
        config,
        provider,
        expected_path=release_root / "provider-railway-release.json",
        label="provider rollback manifest",
        maximum=MAX_JSON_BYTES,
    )
    public_raw = _validate_private_artifact(
        config,
        public,
        expected_path=release_root / "public-railway-release.json",
        label="public rollback manifest",
        maximum=MAX_JSON_BYTES,
    )
    if provider_raw != public_raw:
        raise WatchdogError("rollback provider and public manifests differ")
    if _sha256(provider_raw) != predecessor["manifest_sha256"]:
        raise WatchdogError("rollback manifests do not match the predecessor receipt")
    manifest = _strict_json(provider_raw, label="rollback live manifest")
    if (
        manifest.get("schema_version") != "palimpsest.railway-static-release.v1"
        or manifest.get("source_commit") != predecessor["release_sha"]
        or manifest.get("tree_sha256") != predecessor["tree_sha256"]
        or manifest.get("deployment_source") != "local-git-archive"
        or manifest.get("github_required") is not False
        or manifest.get("state") != "artifact_ready"
    ):
        raise WatchdogError("rollback live manifest identity is invalid")
    _positive_integer(manifest.get("file_count"), label="rollback file count")
    _positive_integer(manifest.get("total_bytes"), label="rollback total bytes")

    _expect_keys(
        topology,
        {
            "bytes",
            "created_at",
            "deployment_id",
            "environment_id",
            "image_digest",
            "path",
            "project_id",
            "reason",
            "service_id",
            "sha256",
        },
        label="rollback topology proof",
    )
    topology_path = release_root / "railway-status.json"
    topology_raw = _read_regular(
        topology_path,
        label="rollback Railway topology",
        maximum=2 * 1024 * 1024,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    if (
        topology["path"] != str(topology_path)
        or len(topology_raw)
        != _positive_integer(topology["bytes"], label="rollback topology bytes")
        or _sha256(topology_raw)
        != _digest(topology["sha256"], label="rollback topology digest")
    ):
        raise WatchdogError("rollback topology bytes do not match their proof")
    for key in ("project_id", "environment_id", "service_id", "deployment_id"):
        if not isinstance(topology[key], str) or UUID.fullmatch(topology[key]) is None:
            raise WatchdogError(f"rollback topology {key} is invalid")
    if topology["deployment_id"] != predecessor["deployment_id"]:
        raise WatchdogError("rollback topology names a different predecessor")
    if (
        not isinstance(topology["image_digest"], str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", topology["image_digest"]) is None
        or topology["reason"] not in {"deploy", "deploymentRollback", "rollback"}
        or not isinstance(topology["created_at"], str)
        or len(topology["created_at"]) > 64
    ):
        raise WatchdogError("rollback topology deployment metadata is invalid")

    document = _strict_json(topology_raw, label="rollback Railway topology")
    if document.get("id") != topology["project_id"]:
        raise WatchdogError("rollback topology project identity changed")
    service = _one(
        _edges(document.get("services"), label="services"),
        key="id",
        expected=topology["service_id"],
        label="service",
    )
    if service.get("name") != "palimpsest-publication":
        raise WatchdogError("rollback topology service name changed")
    environment = _one(
        _edges(document.get("environments"), label="environments"),
        key="id",
        expected=topology["environment_id"],
        label="environment",
    )
    instance = _one(
        _edges(environment.get("serviceInstances"), label="service instances"),
        key="serviceId",
        expected=topology["service_id"],
        label="service instance",
    )
    latest = instance.get("latestDeployment")
    metadata = latest.get("meta") if isinstance(latest, dict) else None
    if (
        not isinstance(latest, dict)
        or latest.get("id") != predecessor["deployment_id"]
        or latest.get("status") != "SUCCESS"
        or latest.get("createdAt") != topology["created_at"]
        or not isinstance(metadata, dict)
        or metadata.get("imageDigest") != topology["image_digest"]
        or metadata.get("reason") != topology["reason"]
    ):
        raise WatchdogError("rollback topology deployment identity changed")


def _validate_candidate_document(
    config: LineageConfig,
    raw: bytes,
    candidate: dict[str, Any],
    *,
    pin: dict[str, Any],
    pin_sha256: str,
    allow_legacy_v1: bool = False,
) -> tuple[str, str, dict[str, Any]]:
    legacy_required = {
        "base_sha",
        "host_deployed_sha",
        "input_sha256",
        "message",
        "predecessor",
        "prepared_at",
        "publication_base",
        "release_bundle",
        "release_manifest",
        "release_sha",
        "rollback_evidence",
        "schema_version",
        "status",
        "submission_id",
        "wire_generated_at",
    }
    required = legacy_required | {
        "news_source_tail",
        "receipt_deadline_at",
        "wire_canonical_sha256",
    }
    schema = candidate.get("schema_version")
    is_legacy = schema == LEGACY_CANDIDATE_SCHEMA
    if is_legacy and not allow_legacy_v1:
        raise WatchdogError("legacy v1 candidate is not accepted as pending")
    if schema not in {CANDIDATE_SCHEMA, LEGACY_CANDIDATE_SCHEMA}:
        raise WatchdogError("candidate journal status is invalid")
    _expect_keys(
        candidate,
        legacy_required if is_legacy else required,
        label="candidate journal",
    )
    if candidate["status"] != "mutation_unresolved":
        raise WatchdogError("candidate journal status is invalid")
    if is_legacy:
        try:
            parse_timestamp(candidate["prepared_at"])
            parse_timestamp(candidate["wire_generated_at"])
        except ValueError as exc:
            raise WatchdogError("legacy candidate clock is invalid") from exc
    else:
        _candidate_receipt_deadline(candidate)
    input_sha256 = _digest(candidate["input_sha256"], label="candidate input digest")
    if not is_legacy:
        _digest(
            candidate["wire_canonical_sha256"],
            label="candidate wire canonical digest",
        )
        news_source_tail = candidate["news_source_tail"]
        if not isinstance(news_source_tail, dict):
            raise WatchdogError("candidate news source tail proof is invalid")
        _expect_keys(
            news_source_tail,
            {"count", "sha256"},
            label="candidate news source tail proof",
        )
        count = news_source_tail["count"]
        if isinstance(count, bool) or not isinstance(count, int) or count < 0:
            raise WatchdogError("candidate news source tail count is invalid")
        _digest(
            news_source_tail["sha256"],
            label="candidate news source tail digest",
        )
    base_sha = _sha40(candidate["base_sha"], label="candidate publication base")
    release_sha = _sha40(candidate["release_sha"], label="candidate release")
    host_deployed_sha = _sha40(
        candidate["host_deployed_sha"], label="candidate host deployment"
    )
    submission_id = candidate["submission_id"]
    if not isinstance(submission_id, str) or SUBMISSION_ID.fullmatch(submission_id) is None:
        raise WatchdogError("candidate submission ID is invalid")
    expected_message = (
        f"palimpsest-hetzner-{release_sha[:12]}-{input_sha256[:12]}-"
        f"{submission_id}"
    )
    if candidate["message"] != expected_message:
        raise WatchdogError("candidate mutation message is not identity-bound")
    if base_sha != pin["target"]["base_sha"]:
        raise WatchdogError("candidate publication base is not transition-pinned")
    deployed_raw = _read_regular(
        config.deployed_commit,
        label="host deployed commit",
        maximum=256,
        uid=config.pin_uid,
        gid=config.installed_gid,
        mode=0o644,
    )
    if deployed_raw.decode("ascii").strip() != host_deployed_sha:
        raise WatchdogError("candidate host deployment differs from deployed-commit")

    publication_base = candidate.get("publication_base")
    bundle = candidate.get("release_bundle")
    release_manifest = candidate.get("release_manifest")
    predecessor = candidate.get("predecessor")
    rollback = candidate.get("rollback_evidence")
    if not all(
        isinstance(value, dict)
        for value in (
            publication_base,
            bundle,
            release_manifest,
            predecessor,
            rollback,
        )
    ):
        raise WatchdogError("candidate journal contains invalid proof objects")
    assert isinstance(publication_base, dict)
    assert isinstance(bundle, dict)
    assert isinstance(release_manifest, dict)
    assert isinstance(predecessor, dict)
    assert isinstance(rollback, dict)
    _expect_keys(
        publication_base,
        {"kind", "path", "sha256"},
        label="candidate publication base",
    )
    if publication_base != {
        "kind": _pin_kind(pin),
        "path": str(config.base_pin),
        "sha256": pin_sha256,
    }:
        raise WatchdogError("candidate publication base proof is invalid")
    _expect_keys(
        bundle,
        {"bytes", "metadata_path", "metadata_sha256", "path", "sha256"},
        label="candidate release bundle",
    )
    _validate_bundle(
        config,
        {
            "schema_version": BUNDLE_SCHEMA,
            "path": bundle["path"],
            "sha256": bundle["sha256"],
            "bytes": bundle["bytes"],
            "base_sha": base_sha,
            "release_sha": release_sha,
            "metadata_path": bundle["metadata_path"],
            "metadata_sha256": bundle["metadata_sha256"],
        },
        base_sha=base_sha,
        release_sha=release_sha,
        verify_git=False,
    )
    _validate_release_manifest_anchor(
        config,
        release_manifest,
        release_sha=release_sha,
    )
    _read_predecessor_archive(config, predecessor, pin=pin)
    _validate_rollback_evidence(
        config,
        rollback,
        candidate_release_sha=release_sha,
        predecessor=predecessor,
    )
    return _sha256(raw), release_sha, bundle


def _validate_candidate_archive(
    config: LineageConfig,
    proof: dict[str, Any],
    *,
    receipt: dict[str, Any],
    pin: dict[str, Any],
    pin_sha256: str,
) -> None:
    _expect_keys(
        proof,
        {"archive_path", "journal_sha256", "message"},
        label="verified candidate proof",
    )
    digest = _digest(proof["journal_sha256"], label="candidate journal digest")
    archive_root = config.state_root / "candidates"
    _validate_directory(
        archive_root,
        label="candidate archive directory",
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o700,
    )
    archive_path = archive_root / f"{digest}.json"
    if proof["archive_path"] != str(archive_path):
        raise WatchdogError("candidate archive path escapes its digest path")
    raw = _read_regular(
        archive_path,
        label="candidate journal archive",
        maximum=MAX_RECEIPT_BYTES,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    if _sha256(raw) != digest:
        raise WatchdogError("candidate journal archive digest changed")
    candidate = _strict_json(raw, label="candidate journal archive")
    _digest_value, release_sha, bundle = _validate_candidate_document(
        config,
        raw,
        candidate,
        pin=pin,
        pin_sha256=pin_sha256,
        allow_legacy_v1=True,
    )
    publication_base = receipt["publication_base"]
    receipt_bundle = receipt["release_bundle"]
    if (
        proof["message"] != candidate["message"]
        or release_sha != receipt["release_sha"]
        or candidate["input_sha256"] != receipt["input_sha256"]
        or candidate["wire_generated_at"] != receipt["wire_generated_at"]
        or candidate["host_deployed_sha"] != receipt["host_deployed_sha"]
        or candidate["base_sha"] != receipt["base_sha"]
        or candidate["release_manifest"] != receipt["live_manifest"]
        or candidate["predecessor"] != receipt["predecessor"]
        or candidate["publication_base"]
        != {
            "kind": publication_base["kind"],
            "path": publication_base["path"],
            "sha256": publication_base["sha256"],
        }
        or bundle["path"] != receipt_bundle["path"]
        or bundle["sha256"] != receipt_bundle["sha256"]
        or bundle["metadata_sha256"] != receipt_bundle["metadata_sha256"]
    ):
        raise WatchdogError("candidate archive does not bind the verified receipt")


def _candidate_status(
    config: LineageConfig,
    receipt: dict[str, Any],
    *,
    pin: dict[str, Any] | None,
    pin_sha256: str,
) -> dict[str, Any]:
    try:
        config.pending_candidate.lstat()
    except FileNotFoundError:
        return {"status": "none"}
    except OSError as exc:
        raise WatchdogError("cannot inspect pending candidate journal") from exc

    raw = _read_regular(
        config.pending_candidate,
        label="pending candidate journal",
        maximum=MAX_RECEIPT_BYTES,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    candidate = _strict_json(raw, label="pending candidate journal")
    if pin is None:
        raise WatchdogError("pending candidate cannot exist before transition")
    digest, release_sha, bundle = _validate_candidate_document(
        config,
        raw,
        candidate,
        pin=pin,
        pin_sha256=pin_sha256,
    )
    receipt_candidate = receipt.get("candidate")
    consumed = (
        isinstance(receipt_candidate, dict)
        and receipt_candidate.get("journal_sha256") == digest
        and receipt_candidate.get("archive_path")
        == str(config.state_root / "candidates" / f"{digest}.json")
        and receipt.get("release_sha") == release_sha
        and receipt.get("base_sha") == candidate.get("base_sha")
        and receipt.get("input_sha256") == candidate.get("input_sha256")
        and isinstance(receipt.get("release_bundle"), dict)
        and receipt["release_bundle"].get("sha256") == bundle["sha256"]
    )
    return {
        "status": "consumed_pending_cleanup" if consumed else "mutation_unresolved",
        "data_hold": True,
        "journal_sha256": digest,
        "release_sha": release_sha,
    }


def validate_data_hold(config: LineageConfig) -> dict[str, Any]:
    raw = _read_regular(
        config.data_hold,
        label="root DATA HOLD marker",
        maximum=MAX_RECEIPT_BYTES,
        uid=config.pin_uid,
        gid=config.pin_gid,
        mode=0o640,
    )
    document = _strict_json(raw, label="root DATA HOLD marker")
    if raw != _canonical_json_bytes(document):
        raise WatchdogError("root DATA HOLD marker is not canonical JSON")
    _expect_keys(
        document,
        {
            "candidate",
            "predecessor",
            "reason_code",
            "recorded_at",
            "rollback",
            "schema_version",
            "status",
        },
        label="root DATA HOLD marker",
    )
    reason_codes = {
        "active_topology_unrelated",
        "candidate_identity_ambiguous",
        "evidence_invalid",
        "reconciliation_failed",
        "rollback_restore_unproven",
    }
    if (
        document["schema_version"] != DATA_HOLD_SCHEMA
        or document["status"] != "DATA HOLD"
        or document["reason_code"] not in reason_codes
    ):
        raise WatchdogError("root DATA HOLD marker identity is invalid")
    parse_timestamp(document["recorded_at"])
    candidate_proof = document.get("candidate")
    predecessor_proof = document.get("predecessor")
    rollback = document.get("rollback")
    if not all(
        isinstance(value, dict)
        for value in (candidate_proof, predecessor_proof, rollback)
    ):
        raise WatchdogError("root DATA HOLD marker proof objects are invalid")
    assert isinstance(candidate_proof, dict)
    assert isinstance(predecessor_proof, dict)
    assert isinstance(rollback, dict)

    _expect_keys(
        candidate_proof,
        {"archive_path", "journal_sha256", "message", "release_sha"},
        label="DATA HOLD candidate",
    )
    candidate_digest = _digest(
        candidate_proof["journal_sha256"], label="DATA HOLD candidate digest"
    )
    candidate_release = _sha40(
        candidate_proof["release_sha"], label="DATA HOLD candidate release"
    )
    candidate_path = (
        config.state_root / "candidates" / f"{candidate_digest}.json"
    )
    if candidate_proof["archive_path"] != str(candidate_path):
        raise WatchdogError("DATA HOLD candidate archive path is not canonical")
    _validate_directory(
        candidate_path.parent,
        label="DATA HOLD candidate archive directory",
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o700,
    )
    candidate_raw = _read_regular(
        candidate_path,
        label="DATA HOLD candidate archive",
        maximum=MAX_RECEIPT_BYTES,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    if _sha256(candidate_raw) != candidate_digest:
        raise WatchdogError("DATA HOLD candidate archive digest changed")
    candidate = _strict_json(candidate_raw, label="DATA HOLD candidate archive")
    pin, pin_raw, _authenticated_pins = _validate_pin(config)
    validated_digest, validated_release, _bundle = _validate_candidate_document(
        config,
        candidate_raw,
        candidate,
        pin=pin,
        pin_sha256=_sha256(pin_raw),
    )
    if (
        validated_digest != candidate_digest
        or validated_release != candidate_release
        or candidate.get("message") != candidate_proof["message"]
        or candidate.get("release_sha") != candidate_release
    ):
        raise WatchdogError("DATA HOLD candidate identity changed")

    _expect_keys(
        predecessor_proof,
        {
            "deployment_id",
            "image_digest",
            "manifest_sha256",
            "receipt_sha256",
            "topology_sha256",
        },
        label="DATA HOLD predecessor",
    )
    predecessor = candidate.get("predecessor")
    evidence = candidate.get("rollback_evidence")
    topology = evidence.get("topology") if isinstance(evidence, dict) else None
    if not isinstance(predecessor, dict) or not isinstance(topology, dict):
        raise WatchdogError("DATA HOLD candidate has no predecessor rollback proof")
    for key in ("manifest_sha256", "receipt_sha256", "topology_sha256"):
        _digest(predecessor_proof[key], label=f"DATA HOLD predecessor {key}")
    if (
        not isinstance(predecessor_proof["deployment_id"], str)
        or UUID.fullmatch(predecessor_proof["deployment_id"]) is None
        or not isinstance(predecessor_proof["image_digest"], str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", predecessor_proof["image_digest"])
        is None
        or predecessor_proof["receipt_sha256"]
        != predecessor.get("receipt_sha256")
        or predecessor_proof["deployment_id"] != predecessor.get("deployment_id")
        or predecessor_proof["manifest_sha256"]
        != predecessor.get("manifest_sha256")
        or predecessor_proof["topology_sha256"] != topology.get("sha256")
        or predecessor_proof["image_digest"] != topology.get("image_digest")
    ):
        raise WatchdogError("DATA HOLD predecessor proof changed")

    _expect_keys(
        rollback,
        {"attempt_path", "attempt_sha256", "attempted"},
        label="DATA HOLD rollback",
    )
    if not isinstance(rollback["attempted"], bool):
        raise WatchdogError("DATA HOLD rollback attempted flag is invalid")
    attempt_root = config.state_root / "rollback-attempts"
    attempt_path = attempt_root / f"{candidate_digest}.json"
    if rollback["attempted"] is False:
        if (
            rollback["attempt_path"] is not None
            or rollback["attempt_sha256"] is not None
        ):
            raise WatchdogError("unattempted DATA HOLD rollback names an attempt")
        try:
            attempt_path.lstat()
        except FileNotFoundError:
            pass
        except OSError as exc:
            raise WatchdogError(
                "cannot inspect canonical DATA HOLD rollback attempt"
            ) from exc
        else:
            raise WatchdogError(
                "DATA HOLD claims no rollback attempt but its durable artifact exists"
            )
    else:
        if not isinstance(rollback["attempt_path"], str):
            raise WatchdogError("DATA HOLD rollback attempt path is invalid")
        _validate_directory(
            attempt_root,
            label="DATA HOLD rollback attempt directory",
            uid=config.state_uid,
            gid=config.state_gid,
            mode=0o700,
        )
        if rollback["attempt_path"] != str(attempt_path):
            raise WatchdogError("DATA HOLD rollback attempt path is not canonical")
        attempt_digest = _digest(
            rollback["attempt_sha256"], label="DATA HOLD rollback attempt digest"
        )
        attempt_raw = _read_regular(
            attempt_path,
            label="DATA HOLD rollback attempt",
            maximum=MAX_RECEIPT_BYTES,
            uid=config.state_uid,
            gid=config.state_gid,
            mode=0o600,
        )
        if _sha256(attempt_raw) != attempt_digest:
            raise WatchdogError("DATA HOLD rollback attempt digest changed")
        attempt = _strict_json(attempt_raw, label="DATA HOLD rollback attempt")
        if attempt_raw != _canonical_json_bytes(attempt):
            raise WatchdogError("DATA HOLD rollback attempt is not canonical JSON")
        _expect_keys(
            attempt,
            {
                "candidate_deployment_id",
                "candidate_journal_sha256",
                "candidate_topology_path",
                "created_at",
                "predecessor_deployment_id",
                "schema_version",
                "status",
                "topology_sha256",
            },
            label="DATA HOLD rollback attempt",
        )
        candidate_deployment = attempt["candidate_deployment_id"]
        if (
            attempt["schema_version"] != ROLLBACK_ATTEMPT_SCHEMA
            or attempt["status"] != "mutation_may_execute"
            or attempt["candidate_journal_sha256"] != candidate_digest
            or attempt["predecessor_deployment_id"]
            != predecessor_proof["deployment_id"]
            or not isinstance(candidate_deployment, str)
            or UUID.fullmatch(candidate_deployment) is None
        ):
            raise WatchdogError("DATA HOLD rollback attempt identity is invalid")
        topology_digest = _digest(
            attempt["topology_sha256"],
            label="DATA HOLD rollback attempt topology digest",
        )
        attempt_recorded_at = parse_fractional_timestamp(
            attempt["created_at"],
            microseconds=True,
        )

        topology_root = config.state_root / "rollback-attempt-topologies"
        topology_path = topology_root / f"{candidate_digest}.json"
        _validate_directory(
            topology_root,
            label="DATA HOLD rollback attempt topology directory",
            uid=config.state_uid,
            gid=config.state_gid,
            mode=0o700,
        )
        if attempt["candidate_topology_path"] != str(topology_path):
            raise WatchdogError(
                "DATA HOLD rollback attempt topology path is not canonical"
            )
        topology_raw = _read_regular(
            topology_path,
            label="DATA HOLD rollback attempt topology",
            maximum=2 * 1024 * 1024,
            uid=config.state_uid,
            gid=config.state_gid,
            mode=0o600,
        )
        if _sha256(topology_raw) != topology_digest:
            raise WatchdogError(
                "DATA HOLD rollback attempt topology digest changed"
            )
        attempt_topology = _strict_json(
            topology_raw,
            label="DATA HOLD rollback attempt topology",
        )
        rollback_topology = candidate["rollback_evidence"]["topology"]
        project_id = rollback_topology["project_id"]
        environment_id = rollback_topology["environment_id"]
        service_id = rollback_topology["service_id"]
        if attempt_topology.get("id") != project_id:
            raise WatchdogError(
                "DATA HOLD rollback attempt topology project changed"
            )
        service = _one(
            _edges(attempt_topology.get("services"), label="services"),
            key="id",
            expected=service_id,
            label="service",
        )
        if service.get("name") != "palimpsest-publication":
            raise WatchdogError(
                "DATA HOLD rollback attempt topology service changed"
            )
        environment = _one(
            _edges(attempt_topology.get("environments"), label="environments"),
            key="id",
            expected=environment_id,
            label="environment",
        )
        instance = _one(
            _edges(
                environment.get("serviceInstances"),
                label="service instances",
            ),
            key="serviceId",
            expected=service_id,
            label="service instance",
        )
        latest = instance.get("latestDeployment")
        metadata = latest.get("meta") if isinstance(latest, dict) else None
        created_at = latest.get("createdAt") if isinstance(latest, dict) else None
        if (
            not isinstance(latest, dict)
            or latest.get("id") != candidate_deployment
            or candidate_deployment == predecessor_proof["deployment_id"]
            or latest.get("status") != "SUCCESS"
            or not isinstance(metadata, dict)
            or not isinstance(metadata.get("imageDigest"), str)
            or re.fullmatch(r"sha256:[0-9a-f]{64}", metadata["imageDigest"])
            is None
            or metadata.get("reason") != "deploy"
        ):
            raise WatchdogError(
                "DATA HOLD rollback attempt topology identity is invalid"
            )
        deployment_created_at = parse_fractional_timestamp(created_at)
        prepared_at = parse_timestamp(candidate["prepared_at"])
        if (
            deployment_created_at < prepared_at - timedelta(seconds=120)
            or deployment_created_at > attempt_recorded_at + timedelta(seconds=120)
        ):
            raise WatchdogError(
                "DATA HOLD rollback attempt topology time is not candidate-bound"
            )

    return {
        "status": "DATA HOLD",
        "reason_code": document["reason_code"],
        "recorded_at": document["recorded_at"],
        "candidate_release_sha": candidate_release,
        "candidate_journal_sha256": candidate_digest,
        "rollback_attempted": rollback["attempted"],
    }


ManifestFetcher = Callable[[str], bytes]


def validate_lineage(
    config: LineageConfig,
    *,
    fetch_manifest: ManifestFetcher,
    chain_checkpoint: dict[str, Any] | None = None,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate the complete direct-publication lineage and live byte proof."""

    _validate_directory(
        config.state_root,
        label="publication state root",
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o700,
    )
    receipt_raw = _read_regular(
        config.publication_receipt,
        label="publication receipt",
        maximum=MAX_RECEIPT_BYTES,
        uid=config.state_uid,
        gid=config.state_gid,
        mode=0o600,
    )
    receipt = _strict_json(receipt_raw, label="publication receipt")
    schema = receipt.get("schema_version")
    pin: dict[str, Any] | None = None
    pin_sha256 = ""
    receipt_pin: dict[str, Any] | None = None
    receipt_pin_sha256 = ""
    authenticated_pins: dict[str, dict[str, Any]] = {}
    base_rotation_bridge = False
    verified_chain: dict[str, Any] | None = None
    if schema == V1_SCHEMA:
        if config.base_pin.exists() or config.base_pin.is_symlink():
            raise WatchdogError("v1 receipt is forbidden after transition pin creation")
        if config.pending_candidate.exists() or config.pending_candidate.is_symlink():
            raise WatchdogError("v1 receipt is not accepted with a candidate journal")
        _validate_v1_receipt(
            receipt_raw,
            receipt,
            pin=None,
            allow_current_pre_transition=True,
        )
        deployed_raw = _read_regular(
            config.deployed_commit,
            label="host deployed commit",
            maximum=256,
            uid=config.pin_uid,
            gid=config.installed_gid,
            mode=0o644,
        )
        if deployed_raw.decode("ascii").strip() != INCIDENT_BASE_SHA:
            raise WatchdogError("v1 receipt is outside the exact pre-transition state")
    elif schema == V2_SCHEMA:
        pin, pin_raw, authenticated_pins = _validate_pin(config)
        pin_sha256 = _sha256(pin_raw)
        anchor_pin = authenticated_pins.get(INCIDENT_PIN_SHA256)
        if anchor_pin is None:
            raise WatchdogError("publication pin chain has no incident anchor")
        _validate_transition_anchor(config, pin=anchor_pin)
        receipt_pin, receipt_pin_sha256 = _receipt_pin(
            receipt,
            authenticated_pins=authenticated_pins,
        )
        if receipt_pin_sha256 != pin_sha256:
            predecessor = pin.get("predecessor")
            prior_receipt = (
                predecessor.get("publication_receipt")
                if isinstance(predecessor, dict)
                else None
            )
            if (
                pin.get("schema_version") != SUCCESSOR_PIN_SCHEMA
                or not isinstance(prior_receipt, dict)
                or receipt_pin_sha256
                != prior_receipt.get("publication_base_sha256")
                or _sha256(receipt_raw) != prior_receipt.get("sha256")
            ):
                raise WatchdogError(
                    "current receipt does not match the active or bridged publication pin"
                )
            base_rotation_bridge = True
        _validate_v2_receipt(
            config,
            receipt,
            pin=receipt_pin,
            pin_sha256=receipt_pin_sha256,
            current=True,
            verify_bundle_git=True,
        )
        verified_chain = _validate_receipt_chain(
            config,
            receipt_raw,
            receipt,
            authenticated_pins=authenticated_pins,
            checkpoint=chain_checkpoint,
        )
    else:
        raise WatchdogError(f"unsupported publication receipt schema {schema!r}")

    provider_raw = fetch_manifest(config.provider_origin)
    public_raw = fetch_manifest(config.public_origin)
    if provider_raw != public_raw:
        raise WatchdogError("provider and public live manifests are not byte-identical")
    live = _validate_live_manifest(config, provider_raw, receipt, pin=pin)
    candidate = _candidate_status(
        config,
        receipt,
        pin=receipt_pin or pin,
        pin_sha256=receipt_pin_sha256 or pin_sha256,
    )
    return (
        {
            "schema_version": schema,
            "receipt_sha256": _sha256(receipt_raw),
            "host_deployed_sha": receipt.get("host_deployed_sha", INCIDENT_BASE_SHA),
            "publication_base_sha": receipt.get("base_sha"),
            "publication_base_pin_sha256": pin_sha256 or None,
            "receipt_publication_base_pin_sha256": receipt_pin_sha256 or None,
            "base_rotation_bridge": base_rotation_bridge,
            "recorded_at": receipt["recorded_at"],
            "release_sha": receipt.get("release_sha"),
            "deployment_id": receipt.get("railway", {}).get("deployment_id"),
            "chain_checkpoint": verified_chain,
            "live": live,
        },
        candidate,
    )


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(
        self,
        req: urllib.request.Request,
        fp: Any,
        code: int,
        msg: str,
        headers: Any,
        newurl: str,
    ) -> None:
        del req, fp, code, msg, headers, newurl
        return None


def fetch_manifest(origin: str) -> bytes:
    parsed = urllib.parse.urlsplit(origin)
    if (
        parsed.scheme != "https"
        or not parsed.hostname
        or parsed.username is not None
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
        or parsed.path not in {"", "/"}
    ):
        raise WatchdogError("live manifest origin is not an exact HTTPS origin")
    nonce = time.time_ns()
    url = origin.rstrip("/") + f"/railway-release.json?watchdog={nonce}"
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "Cache-Control": "no-cache, no-store",
            "User-Agent": "palimpsest-direct-watchdog/2",
        },
    )
    try:
        with urllib.request.build_opener(_NoRedirect()).open(
            request, timeout=12
        ) as response:
            if response.status != 200 or response.geturl() != url:
                raise WatchdogError("live manifest response is not exact")
            declared = response.headers.get("Content-Length")
            if declared is not None and int(declared) > MAX_JSON_BYTES:
                raise WatchdogError("live manifest is too large")
            raw = response.read(MAX_JSON_BYTES + 1)
    except (OSError, ValueError, urllib.error.URLError) as exc:
        if isinstance(exc, WatchdogError):
            raise
        raise WatchdogError(f"cannot fetch live manifest from {origin}") from exc
    if len(raw) > MAX_JSON_BYTES:
        raise WatchdogError("live manifest is too large")
    return raw


def fetch_json_url(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlsplit(url)
    if (
        parsed.scheme != "https"
        or not parsed.hostname
        or parsed.username is not None
        or parsed.password is not None
        or parsed.fragment
    ):
        raise WatchdogError("JSON endpoint is not an exact HTTPS URL")
    separator = "&" if parsed.query else "?"
    exact_url = f"{url}{separator}watchdog={time.time_ns()}"
    request = urllib.request.Request(
        exact_url,
        headers={
            "Accept": "application/json",
            "Cache-Control": "no-cache, no-store",
            "User-Agent": "palimpsest-direct-watchdog/2",
        },
    )
    try:
        with urllib.request.build_opener(_NoRedirect()).open(
            request, timeout=12
        ) as response:
            if response.status != 200 or response.geturl() != exact_url:
                raise WatchdogError("JSON endpoint response is not exact")
            raw = response.read(MAX_JSON_BYTES + 1)
    except (OSError, ValueError, urllib.error.URLError) as exc:
        if isinstance(exc, WatchdogError):
            raise
        raise WatchdogError(f"cannot fetch JSON endpoint {url}") from exc
    if len(raw) > MAX_JSON_BYTES:
        raise WatchdogError("JSON endpoint response is too large")
    return _strict_json(raw, label=f"JSON endpoint {url}")


def load_json(path: Path) -> dict[str, Any]:
    return _strict_json(
        _read_regular(path, label=str(path), maximum=MAX_JSON_BYTES),
        label=str(path),
    )


def command(*args: str) -> str:
    result = subprocess.run(
        args,
        check=True,
        capture_output=True,
        text=True,
        timeout=10,
    )
    return result.stdout.strip()


def add_problem(problems: list[dict[str, Any]], check: str, detail: str) -> None:
    problems.append({"check": check, "detail": detail})


def _clock_age(
    problems: list[dict[str, Any]],
    check: str,
    payload: dict[str, Any],
    field: str,
    now: datetime,
) -> float | None:
    try:
        age = (now - parse_timestamp(payload.get(field))).total_seconds()
    except (TypeError, ValueError) as exc:
        add_problem(problems, check, f"invalid {field}: {exc}")
        return None
    if age < -MAX_FUTURE_CLOCK_SKEW_SECONDS:
        add_problem(
            problems,
            check,
            f"{field} is {math.ceil(-age)}s in the future; maximum clock skew is "
            f"{MAX_FUTURE_CLOCK_SKEW_SECONDS}s",
        )
        return None
    return max(0.0, age)


def check_age(
    problems: list[dict[str, Any]],
    check: str,
    payload: dict[str, Any],
    field: str,
    maximum: int,
    now: datetime,
) -> float | None:
    age = _clock_age(problems, check, payload, field, now)
    if age is None:
        return None
    if age > maximum:
        add_problem(
            problems,
            check,
            f"{field} is {int(age)}s old; maximum is {maximum}s",
        )
    return age


def unit_property(unit: str, name: str) -> str:
    return command("systemctl", "show", unit, f"--property={name}", "--value")


def _write_status(document: dict[str, Any]) -> None:
    OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=OUTPUT_PATH.parent,
        prefix=f".{OUTPUT_PATH.name}.",
        delete=False,
    ) as handle:
        json.dump(document, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write("\n")
        temporary = Path(handle.name)
    os.chmod(temporary, 0o600)
    os.replace(temporary, OUTPUT_PATH)


def _outcome_status(*, problems: list[dict[str, Any]], data_hold: bool) -> str:
    if data_hold:
        return "DATA HOLD"
    return "healthy" if not problems else "degraded"


def _load_prior_chain_checkpoint() -> dict[str, Any] | None:
    try:
        OUTPUT_PATH.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise WatchdogError("cannot inspect prior watchdog status") from exc
    raw = _read_regular(
        OUTPUT_PATH,
        label="prior watchdog status",
        maximum=4 * 1024 * 1024,
        uid=os.geteuid(),
        gid=os.getegid(),
        mode=0o600,
    )
    prior = _strict_json(raw, label="prior watchdog status")
    if prior.get("schema_version") != "palimpsest.direct-watchdog.v2":
        return None
    checks = prior.get("checks")
    publication = checks.get("publication") if isinstance(checks, dict) else None
    checkpoint = (
        publication.get("chain_checkpoint")
        if isinstance(publication, dict)
        else None
    )
    if checkpoint is None:
        return None
    if not isinstance(checkpoint, dict):
        raise WatchdogError("prior publication chain checkpoint is not an object")
    return checkpoint


def _lineage_only() -> int:
    try:
        prior_chain_checkpoint = _load_prior_chain_checkpoint()
        lineage, candidate = validate_lineage(
            default_lineage_config(),
            fetch_manifest=fetch_manifest,
            chain_checkpoint=prior_chain_checkpoint,
        )
    except (OSError, ValueError, WatchdogError) as exc:
        print(f"palimpsest-direct-watchdog lineage refused: {exc}", file=sys.stderr)
        return 1
    print(
        json.dumps(
            {"candidate": candidate, "lineage": lineage},
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        )
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    arguments = sys.argv[1:] if argv is None else argv
    if arguments == ["--lineage-only"]:
        return _lineage_only()
    if arguments:
        print("usage: palimpsest-direct-watchdog [--lineage-only]", file=sys.stderr)
        return 64
    now = utc_now()
    problems: list[dict[str, Any]] = []
    checks: dict[str, Any] = {}
    lineage_config = default_lineage_config()
    data_hold_active = (
        lineage_config.pending_candidate.exists()
        or lineage_config.pending_candidate.is_symlink()
        or lineage_config.data_hold.exists()
        or lineage_config.data_hold.is_symlink()
    )
    try:
        prior_chain_checkpoint = _load_prior_chain_checkpoint()
    except WatchdogError as exc:
        prior_chain_checkpoint = None
        add_problem(problems, "publication/checkpoint", str(exc))

    try:
        wire = load_json(WIRE_PATH)
        wire_age = check_age(
            problems,
            "wire/freshness",
            wire,
            "generated_at",
            WIRE_MAX_AGE_SECONDS,
            now,
        )
        events = wire.get("events")
        event_count = len(events) if isinstance(events, list) else 0
        if event_count < 1:
            add_problem(problems, "wire/events", "wire contains no events")
        checks["wire"] = {
            "generated_at": wire.get("generated_at"),
            "age_seconds": round(wire_age, 3) if wire_age is not None else None,
            "event_count": event_count,
        }
    except (OSError, ValueError, WatchdogError) as exc:
        add_problem(problems, "wire/document", str(exc))

    try:
        measurement = load_json(MEASUREMENT_RECEIPT)
        measurement_age = check_age(
            problems,
            "measurements/freshness",
            measurement,
            "recorded_at",
            MEASUREMENT_MAX_AGE_SECONDS,
            now,
        )
        if int(measurement.get("succeeded", 0)) < 1:
            add_problem(
                problems,
                "measurements/result",
                "no measurement collector succeeded",
            )
        checks["measurements"] = {
            "recorded_at": measurement.get("recorded_at"),
            "age_seconds": (
                round(measurement_age, 3) if measurement_age is not None else None
            ),
            "succeeded": measurement.get("succeeded"),
            "failed": measurement.get("failed"),
            "promoted_files": measurement.get("promoted_files"),
        }
    except (OSError, TypeError, ValueError, WatchdogError) as exc:
        add_problem(problems, "measurements/document", str(exc))

    try:
        lineage, candidate = validate_lineage(
            lineage_config,
            fetch_manifest=fetch_manifest,
            chain_checkpoint=prior_chain_checkpoint,
        )
        live = lineage.get("live")
        if not isinstance(live, dict):
            raise WatchdogError("validated lineage has no live manifest proof")
        publication_age = check_age(
            problems,
            "publication/freshness",
            live,
            "built_at",
            PUBLICATION_MAX_AGE_SECONDS,
            now,
        )
        receipt_age = _clock_age(
            problems,
            "publication/receipt_clock",
            lineage,
            "recorded_at",
            now,
        )
        lineage["age_seconds"] = (
            round(publication_age, 3) if publication_age is not None else None
        )
        lineage["receipt_age_seconds"] = (
            round(receipt_age, 3) if receipt_age is not None else None
        )
        lineage["candidate"] = candidate
        checks["publication"] = lineage
        if lineage.get("base_rotation_bridge") is True:
            add_problem(
                problems,
                "publication/base_rotation_bridge",
                "successor base is waiting for a same-generation publication receipt",
            )
        if candidate["status"] != "none":
            data_hold_active = True
            add_problem(
                problems,
                "publication/candidate",
                f"candidate journal status is {candidate['status']}",
            )
    except (OSError, ValueError, WatchdogError) as exc:
        add_problem(problems, "publication/lineage", str(exc))
        if prior_chain_checkpoint is not None:
            checks["publication"] = {
                "chain_checkpoint": prior_chain_checkpoint,
                "status": "validation_failed; prior checkpoint retained",
            }

    try:
        lineage_config.data_hold.lstat()
    except FileNotFoundError:
        checks["data_hold"] = {"status": "none"}
    except OSError as exc:
        data_hold_active = True
        checks["data_hold"] = {
            "status": "DATA HOLD",
            "validation": "invalid",
        }
        add_problem(problems, "publication/data_hold", str(exc))
    else:
        data_hold_active = True
        try:
            hold = validate_data_hold(lineage_config)
            checks["data_hold"] = hold
            add_problem(
                problems,
                "publication/data_hold",
                "DATA HOLD reason="
                f"{hold['reason_code']} candidate={hold['candidate_release_sha']}",
            )
        except (OSError, ValueError, WatchdogError) as exc:
            checks["data_hold"] = {
                "status": "DATA HOLD",
                "validation": "invalid",
            }
            add_problem(
                problems,
                "publication/data_hold",
                f"invalid root DATA HOLD marker: {exc}",
            )

    unit_states: dict[str, Any] = {}
    for timer in TIMERS:
        try:
            enabled = command("systemctl", "is-enabled", timer)
            active = command("systemctl", "is-active", timer)
            unit_states[timer] = {"enabled": enabled, "active": active}
            if enabled != "enabled" or active != "active":
                add_problem(
                    problems,
                    f"timer/{timer}",
                    f"enabled={enabled}, active={active}",
                )
        except (OSError, subprocess.SubprocessError) as exc:
            add_problem(problems, f"timer/{timer}", str(exc))

    for service in SERVICES:
        try:
            active = unit_property(service, "ActiveState")
            result = unit_property(service, "Result")
            unit_states[service] = {"active": active, "result": result}
            if active == "failed" or result == "failed":
                add_problem(
                    problems,
                    f"service/{service}",
                    f"active={active}, result={result}",
                )
        except (OSError, subprocess.SubprocessError) as exc:
            add_problem(problems, f"service/{service}", str(exc))
    checks["systemd"] = unit_states

    analysis_results: dict[str, Any] = {}
    for route in ANALYSIS_ROUTES:
        try:
            article = fetch_json_url(f"{PUBLIC_ORIGIN}{route}")
            coverage = (
                article.get("coverage")
                if isinstance(article.get("coverage"), dict)
                else {}
            )
            wire_info = (
                article.get("wire") if isinstance(article.get("wire"), dict) else {}
            )
            result = {
                "region": article.get("region"),
                "revision_id": article.get("revision_id"),
                "wire_generated_at": wire_info.get("generated_at"),
                "event_count": coverage.get("event_count"),
                "source_count": coverage.get("source_count"),
            }
            analysis_results[route] = result
            if article.get("schema_version") != "palimpsest.regional-analysis.v1":
                add_problem(problems, f"analysis/{route}", "unexpected schema")
            if not article.get("revision_id"):
                add_problem(problems, f"analysis/{route}", "missing revision ID")
            if int(coverage.get("event_count", 0)) < 1:
                add_problem(
                    problems,
                    f"analysis/{route}",
                    "analysis contains no evidence events",
                )
        except (OSError, TypeError, ValueError, WatchdogError) as exc:
            add_problem(problems, f"analysis/{route}", str(exc))
    checks["analysis"] = analysis_results

    status_value = _outcome_status(
        problems=problems,
        data_hold=data_hold_active,
    )
    document = {
        "schema_version": "palimpsest.direct-watchdog.v2",
        "generated_at": now.isoformat().replace("+00:00", "Z"),
        "status": status_value,
        "data_hold": data_hold_active,
        "problem_count": len(problems),
        "problems": problems,
        "checks": checks,
    }
    _write_status(document)
    print(
        f"palimpsest-direct-watchdog status={status_value} "
        f"problems={len(problems)} "
        f"wire_events={checks.get('wire', {}).get('event_count', 0)}"
    )
    return 2 if data_hold_active or problems else 0


if __name__ == "__main__":
    sys.exit(main())
