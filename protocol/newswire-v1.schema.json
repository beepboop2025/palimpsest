{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.info/protocol/newswire-v1.schema.json",
  "title": "Palimpsest evidence newswire v1",
  "description": "Metadata-only RSS/Atom event dossiers with explicit coverage, evidence independence, limitations, and mutation semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_registry",
    "source_registry_sha256",
    "window",
    "scope",
    "method",
    "mutation_semantics",
    "coverage",
    "n_items",
    "n_events",
    "items",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "palimpsest-newswire.v1"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "source_registry": {"const": "https://palimpsest.info/config/news_sources.json"},
    "source_registry_sha256": {"$ref": "#/$defs/sha256"},
    "window": {"$ref": "#/$defs/window"},
    "scope": {"$ref": "#/$defs/longText"},
    "method": {"$ref": "#/$defs/longText"},
    "mutation_semantics": {"$ref": "#/$defs/longText"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "n_items": {"$ref": "#/$defs/count"},
    "n_events": {"$ref": "#/$defs/count"},
    "items": {
      "type": "array",
      "maxItems": 8192,
      "items": {"$ref": "#/$defs/item"}
    },
    "events": {
      "type": "array",
      "maxItems": 8192,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "oneOf": [
    {
      "properties": {
        "source_registry_sha256": {
          "const": "134ef2c8193731e2d9014d3af9be0b1818e90595c63845021edd0c09bfb6bd80"
        },
        "coverage": {
          "properties": {
            "registry_sources": {"const": 58},
            "sources": {
              "$ref": "#/$defs/activeRegistryReceiptIdentities",
              "minItems": 58,
              "maxItems": 58
            }
          }
        }
      }
    },
    {
      "properties": {
        "source_registry_sha256": {
          "const": "7738ab6e4e275f9eb515593a2a2962de5ec8271c7c1b9cb287eb616932accd14"
        },
        "coverage": {
          "properties": {
            "registry_sources": {"const": 60},
            "sources": {
              "minItems": 60,
              "maxItems": 60,
              "allOf": [
                {"$ref": "#/$defs/activeRegistryReceiptIdentities"},
                {"$ref": "#/$defs/legacyRegistryTombstoneReceipts"}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "activeRegistryReceiptIdentities": {
      "type": "array",
      "description": "Every reviewed active source identity must occur exactly once at its canonical feed endpoint.",
      "allOf": [
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"access-now"},"feed_url":{"const":"https://www.accessnow.org/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"apnic-blog"},"feed_url":{"const":"https://blog.apnic.net/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"article19"},"feed_url":{"const":"https://www.article19.org/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"asia-times-china"},"feed_url":{"const":"https://asiatimes.com/category/china/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"bbc-chinese"},"feed_url":{"const":"https://feeds.bbci.co.uk/zhongwen/trad/rss.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"business-recorder-pakistan"},"feed_url":{"const":"https://www.brecorder.com/feeds/pakistan/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"cecc"},"feed_url":{"const":"https://www.cecc.gov/rss.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"cgtn-china"},"feed_url":{"const":"https://www.cgtn.com/subscribe/rss/section/china.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"china-digital-times"},"feed_url":{"const":"https://chinadigitaltimes.net/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"china-media-project"},"feed_url":{"const":"https://chinamediaproject.org/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"china-news-service-finance"},"feed_url":{"const":"https://www.chinanews.com.cn/rss/finance.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"china-news-service-politics"},"feed_url":{"const":"https://www.chinanews.com.cn/rss/china.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"china-power-csis"},"feed_url":{"const":"https://chinapower.csis.org/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"chrd"},"feed_url":{"const":"https://www.nchrd.org/feed/"}}},"minContains":1,"maxContains":1},
