class ActivationError(RuntimeError):
    """A fail-closed steady-state activation error."""


class QuietWindowBusy(ActivationError):
    """The reviewed producer/controller set has not settled for this hour."""


class CommandError(ActivationError):
    def __init__(self, label: str, returncode: int) -> None:
        super().__init__(f"{label} failed with exit status {returncode}")
        self.returncode = returncode


class SignalAbort(ActivationError):
    def __init__(self, signum: int) -> None:
        super().__init__(f"hourly activation interrupted by signal {signum}")
