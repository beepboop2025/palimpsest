[Unit]
Description=Publish the newest Palimpsest Hetzner edition directly to Railway
Documentation=https://www.palimpsest.info/news/
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/palimpsest/palimpsest/.git
ConditionPathExists=/var/lib/palimpsest/newswire/newswire-latest.json

[Service]
Type=oneshot
User=palimpsest
Group=palimpsest
WorkingDirectory=/home/palimpsest/palimpsest
EnvironmentFile=/etc/palimpsest/railway-publication.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PALIMPSEST_PYTHON_BIN=/opt/palimpsest/collector-venv/bin/python
ExecStart=/usr/local/sbin/palimpsest-railway-publish
TimeoutStartSec=50m
UMask=0077
Nice=12
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TasksMax=256
MemoryMax=4G

ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/palimpsest/palimpsest /var/lib/palimpsest/readings /var/lib/palimpsest/newswire /etc/palimpsest/deployed-commit
ReadOnlyPaths=-/etc/palimpsest/railway-publication-base.json
ReadOnlyPaths=-/etc/palimpsest/railway-publication-data-hold.json
ReadWritePaths=/var/lib/palimpsest/railway-publication
ReadOnlyPaths=/var/lib/palimpsest/railway-control
InaccessiblePaths=-/var/lib/palimpsest/common-crawl/common-crawl.sqlite3
InaccessiblePaths=-/run/docker.sock
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
