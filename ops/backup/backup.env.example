# Optional overrides read by palimpsest-backup.service.
# The defaults match the canonical Hetzner service identity and witness owner.
PALIMPSEST_ROOT=/home/palimpsest/palimpsest
PALIMPSEST_STATE_ROOT=/var/lib/palimpsest
PALIMPSEST_ANALYSIS_ROOT=/var/lib/palimpsest-analysis
PALIMPSEST_NEWSWIRE_ROOT=/var/lib/palimpsest/newswire
PALIMPSEST_WITNESS_ROOT=/home/palimpsest/.palimpsest-witness
PALIMPSEST_BACKUP_DIR=/home/palimpsest/backups/node
PALIMPSEST_BACKUP_RETENTION_DAYS=14
PALIMPSEST_BACKUP_MIN_FREE_MB=1024
PALIMPSEST_COMPOSE_PROJECT=palimpsest

# Off-host copying is deliberately not configured here. The historical copy,
# hook, and encryption-attestation settings are retired. Use the separately
# credentialed palimpsest-node-offsite-backup.service.
