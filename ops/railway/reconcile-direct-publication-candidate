def _instrument_json_item(story: dict[str, Any], section_title: str) -> dict[str, Any]:
    availability = story["claims"][0]["type"] == "availability"
    restricted = story["signal_id"] in RESTRICTED_AVAILABILITY_SIGNALS
    item_type = "availability" if availability else "measurement"
    attachment: dict[str, Any] = {
        "url": story["evidence"]["url"],
        "mime_type": "application/json",
        "title": (
            "china-publication-rights-latest.json"
            if restricted
            else story["evidence"]["input"]["filename"]
        ),
    }
    if story["evidence"]["input"]["bytes"] is not None:
        attachment["size_in_bytes"] = story["evidence"]["input"]["bytes"]
    metadata: dict[str, Any] = {
        "kind": f"instrument_{item_type}",
        "revision_id": _story_revision_id(story),
        "verification_status": (
            "public_value_unavailable"
            if restricted
            else (
                "current_result_unavailable"
                if availability
                else "palimpsest_measurement"
            )
        ),
    }
    if restricted:
        metadata.update(
            {
                "signal_id": story["signal_id"],
                "publication_disposition": "rights-restricted-availability-v1",
                "value_state": "withheld",
            }
        )
    label = "Availability" if availability else "Result"
    title_label = "availability" if availability else "measurement"
    return {
        "id": story["id"] + ":" + story["claim_fingerprint"],
        "url": story["url"],
        "external_url": story["evidence"]["url"],
        "title": f"[Palimpsest {title_label}] {story['headline']}",
        "summary": (
            f"Palimpsest {title_label}"
            + (" notice" if availability else "")
            + f". {story['dek']}"
        ),
        "content_text": "\n\n".join(
            [
                f"ITEM TYPE: PALIMPSEST {title_label.upper()}",
                f"{label}: {story['claims'][0]['statement']}",
                "Limit: " + " ".join(story["limitations"]),
                "Evidence: " + story["evidence"]["url"],
            ]
        ),
        "date_published": story["published_at"],
        "date_modified": story["modified_at"],
        "tags": [
            f"palimpsest-{title_label}",
            section_title,
            story["signal_id"],
            story["status"],
        ],
        "attachments": [attachment],
        "_palimpsest": metadata,
    }


def _rss_clock(value: str) -> str:
    parsed = _deadline_timestamp(value, "RSS publication clock")
    return email.utils.format_datetime(parsed, usegmt=True)


def _xml_record(element: ET.Element) -> tuple[Any, ...]:
    return (
        element.tag,
        tuple(sorted(element.attrib.items())),
        element.text or "",
        tuple(_xml_record(child) for child in element),
    )


def _rss_items(raw: bytes, *, label: str) -> tuple[ET.Element, list[ET.Element]]:
    if b"<!DOCTYPE" in raw.upper() or b"<!ENTITY" in raw.upper():
        raise ReconciliationError(f"{label} contains a prohibited XML declaration")
    try:
        root = ET.fromstring(raw)
    except ET.ParseError as exc:
        raise ReconciliationError(f"{label} is not strict XML") from exc
    if root.tag != "rss" or root.attrib != {"version": "2.0"}:
        raise ReconciliationError(f"{label} RSS root is invalid")
    channels = root.findall("channel")
    if len(channels) != 1:
        raise ReconciliationError(f"{label} channel inventory is invalid")
    return channels[0], channels[0].findall("item")


def _validate_rss_channel(
    channel: ET.Element,
    items: list[ET.Element],
    *,
    label: str,
    title: str,
    link: str,
    description: str,
    self_url: str,
    expected_build_at: datetime,
) -> None:
    channel_title = _only_child(channel, "title", label)
    channel_link = _only_child(channel, "link", label)
    channel_description = _only_child(channel, "description", label)
    language = _only_child(channel, "language", label)
    last_build = _only_child(channel, "lastBuildDate", label)
    atom = channel.findall("{http://www.w3.org/2005/Atom}link")
    try:
        build_at = email.utils.parsedate_to_datetime(last_build.text or "")
    except (TypeError, ValueError) as exc:
        raise ReconciliationError(f"{label} build clock is invalid") from exc
    if build_at.tzinfo is None:
        raise ReconciliationError(f"{label} build clock has no timezone")
    if (
        len(list(channel)) != 6 + len(items)
        or (channel_title.text or "") != title
        or (channel_link.text or "") != link
        or (channel_description.text or "") != description
        or (language.text or "") != "en"
        or build_at.astimezone(UTC) != expected_build_at
        or len(atom) != 1
        or atom[0].attrib
        != {"href": self_url, "rel": "self", "type": "application/rss+xml"}
    ):
        raise ReconciliationError(f"{label} channel identity is invalid")


def _only_child(item: ET.Element, tag: str, label: str) -> ET.Element:
    rows = item.findall(tag)
    if len(rows) != 1:
        raise ReconciliationError(f"{label} has an invalid {tag} inventory")
    return rows[0]


def _validate_instrument_rss_item(
    item: ET.Element, story: dict[str, Any], *, label: str
) -> None:
    availability = story["claims"][0]["type"] == "availability"
    restricted = story["signal_id"] in RESTRICTED_AVAILABILITY_SIGNALS
    item_type = "Palimpsest availability" if availability else "Palimpsest measurement"
    result_label = "Availability" if availability else "Result"
    expected_description = (
        f"Item type: {item_type}. {result_label}: "
        + story["claims"][0]["statement"]
        + " Limit: "
        + " ".join(story["limitations"])
        + " Evidence: "
        + story["evidence"]["url"]
    )
    title = _only_child(item, "title", label)
    link = _only_child(item, "link", label)
    guid = _only_child(item, "guid", label)
    published = _only_child(item, "pubDate", label)
    description = _only_child(item, "description", label)
    categories = item.findall("category")
    source = _only_child(item, "source", label)
    kind = item.findall("{https://palimpsest.info/ns/publication/1.0}kind")
    signal = item.findall("{https://palimpsest.info/ns/publication/1.0}signal")
    disposition = item.findall(
        "{https://palimpsest.info/ns/publication/1.0}publicationDisposition"
    )
    value_state = item.findall(
        "{https://palimpsest.info/ns/publication/1.0}valueState"
    )
    if (
        (title.text or "") != f"[{item_type}] {story['headline']}"
        or (link.text or "") != story["url"]
        or guid.attrib != {"isPermaLink": "false"}
        or (guid.text or "")
        != story["id"] + ":" + story["claim_fingerprint"]
        or (published.text or "") != _rss_clock(story["published_at"])
        or (description.text or "") != expected_description
        or len(categories) != 1
        or (categories[0].text or "") != story["section"]
        or source.attrib != {"url": story["evidence"]["url"]}
        or (source.text or "") != story["signal_id"]
        or (
            [(row.text or "") for row in kind]
            != (["instrument_availability"] if availability else [])
        )
        or (
            [(row.text or "") for row in signal]
            != ([story["signal_id"]] if availability else [])
        )
        or [(row.text or "") for row in disposition]
        != (["rights-restricted-availability-v1"] if restricted else [])
        or [(row.text or "") for row in value_state]
        != (["withheld"] if restricted else [])
    ):
        raise ReconciliationError(f"{label} does not bind its newsroom story")
    expected_children = 7 + (2 if availability else 0) + (2 if restricted else 0)
    if len(list(item)) != expected_children:
        raise ReconciliationError(f"{label} has unexpected RSS fields")


