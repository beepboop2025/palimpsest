prepared, created = map(parse, sys.argv[1:3])
now = datetime.now(UTC)
if created < prepared - timedelta(seconds=120) or created > now + timedelta(seconds=120):
    raise SystemExit("candidate deployment timestamp is outside its journal boundary")
PY
candidate_topology="$work_root/candidate-railway-status.json"
env NODE_OPTIONS="$RAILWAY_NODE_OPTIONS" \
  "$railway_token_name=$railway_token_value" \
  "$RAILWAY_BIN" status --project "$PROJECT_ID" \
  --environment "$ENVIRONMENT_ID" --json >"$candidate_topology"
PYTHONPATH="$checkout" "$PYTHON_BIN" - "$candidate_topology" \
  "$PROJECT_ID" "$ENVIRONMENT_ID" "$SERVICE_ID" "$deployment_id" \
  "$deployment_image_digest" "$deployment_reason" <<'PY'
import sys
from pathlib import Path

from ops.railway.verify_continuous_release import parse_status_topology

parse_status_topology(
