{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.info/protocol/partner-pin-v1.schema.json",
  "title": "Palimpsest partner artifact pin v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "producer",
    "source_url",
    "artifact_id",
    "current",
    "superseded"
  ],
  "properties": {
    "schema": { "const": "palimpsest-partner-pin/v1" },
    "producer": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "current": { "$ref": "#/$defs/current" },
    "superseded": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/superseded" }
    }
  },
  "$defs": {
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_as_of", "sha256", "admitted_at"],
      "properties": {
        "data_as_of": { "type": "string", "format": "date" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "admitted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "superseded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_as_of", "sha256", "admitted_at", "superseded_at"],
      "properties": {
        "data_as_of": { "type": "string", "format": "date" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "admitted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "superseded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    }
  }
}
