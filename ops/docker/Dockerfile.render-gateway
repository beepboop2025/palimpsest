# Disposable, credential-free browser boundary for CensorWatch hostile pages.
FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17

ARG PALIMPSEST_REVISION=unversioned
LABEL org.opencontainers.image.revision=$PALIMPSEST_REVISION

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

RUN groupadd --gid 10002 renderer \
    && useradd --uid 10002 --gid 10002 --no-create-home --home-dir /app \
       --shell /usr/sbin/nologin renderer

WORKDIR /app

COPY requirements-render-gateway.lock .
RUN pip install --require-hashes --requirement requirements-render-gateway.lock \
    && playwright install --with-deps chromium \
    && chown -R renderer:renderer /opt/pw-browsers

COPY --chown=renderer:renderer censorwatch/__init__.py censorwatch/__init__.py
COPY --chown=renderer:renderer censorwatch/source_policy.py censorwatch/source_policy.py
COPY --chown=renderer:renderer censorwatch/render_gateway.py censorwatch/render_gateway.py
COPY --chown=renderer:renderer core/__init__.py core/__init__.py
COPY --chown=renderer:renderer core/safe_fetch.py core/safe_fetch.py

USER renderer

CMD ["uvicorn", "censorwatch.render_gateway:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
