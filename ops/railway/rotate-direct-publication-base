def perform_rotation(args: argparse.Namespace) -> dict[str, Any]:
    if os.geteuid() != 0:
        raise RotationError("base rotation must run as root")
    expected_acknowledgement = (
        RECOVERY_ACKNOWLEDGEMENT
        if args.recover_unpublished_chain
        else ACKNOWLEDGEMENT
    )
    if args.ack != expected_acknowledgement:
        raise RotationError("exact successor-base acknowledgement is required")
    _require_sha(args.target_base_sha, length=40, label="target base SHA")
    for key in ("project_id", "environment_id", "service_id"):
        value = getattr(args, key)
        if value is None:
            raise RotationError(f"{key.replace('_', ' ')} is required")
        _require_uuid(value, key.replace("_", " "))

    publisher_user = pwd.getpwnam(args.publisher_user)
    publisher_group = grp.getgrnam(args.publisher_group)
    if publisher_user.pw_gid != publisher_group.gr_gid:
        raise RotationError("publisher user primary group differs from pin group")
    repository = args.repository.resolve(strict=True)
    if args.state_root.is_symlink():
        raise RotationError("publication state root must not be a symbolic link")
    state_root = args.state_root.resolve(strict=True)
    if state_root != args.state_root.absolute():
        raise RotationError("publication state root path is not canonical")
    control_root = args.control_root.absolute()
    lock_path = _ensure_control_root(
        control_root, group_gid=publisher_group.gr_gid
    )
    history_root = control_root / "base-rotation-history"
    intent_path = control_root / "rotation-intent.json"
    lock_descriptor = _acquire_lock(
        lock_path,
        uid=0,
        gid=publisher_group.gr_gid,
        mode=0o640,
        label="root publication lock",
    )
    legacy_lock_descriptor: int | None = None
    newswire_lock_descriptor: int | None = None
    state_sealed = False
    prepared: tuple[dict[str, Any], bytes] | None = None

    def complete_prepared_transaction() -> None:
        nonlocal state_sealed, prepared
        if prepared is not None:
            _clear_rotation_intent(
                intent_path,
                expected=prepared[1],
                group_gid=publisher_group.gr_gid,
            )
            prepared = None
        if state_sealed:
            _restore_legacy_state_root(
                state_root,
                publisher_uid=publisher_user.pw_uid,
                publisher_gid=publisher_group.gr_gid,
            )
            state_sealed = False

    try:
        _validate_file(args.base_pin, uid=0, gid=publisher_group.gr_gid, mode=0o640, label="publication base pin")
        initial_pin_raw = _read_regular(args.base_pin, max_bytes=MAX_PIN_BYTES)
        initial_pin = _strict_json(initial_pin_raw, "publication base pin")
        initial_generation, _, _, _ = _current_pin_identity(initial_pin)
        prepared = _read_rotation_intent(
            intent_path, group_gid=publisher_group.gr_gid
        )
        prepared_generation = (
            prepared[0]["predecessor"]["generation"]
            if prepared is not None
            else None
        )
        if initial_generation == 0 or prepared_generation == 0:
            if args.legacy_lock.absolute() != state_root / "publish.lock":
                raise RotationError("legacy publication lock path is not canonical")
            legacy_lock_descriptor = _acquire_lock(
                args.legacy_lock,
                uid=publisher_user.pw_uid,
                gid=publisher_group.gr_gid,
                mode=0o600,
                label="legacy publication lock",
            )
            _seal_legacy_state_root(
                state_root,
                publisher_uid=publisher_user.pw_uid,
                publisher_gid=publisher_group.gr_gid,
            )
            state_sealed = True
            _verify_locked_path(
                args.legacy_lock,
                legacy_lock_descriptor,
                label="legacy publication lock",
            )
        else:
            _validate_directory(
                state_root,
                uid=publisher_user.pw_uid,
                gid=publisher_group.gr_gid,
                mode=0o700,
                label="publication state root",
            )

        if _read_regular(args.base_pin, max_bytes=MAX_PIN_BYTES) != initial_pin_raw:
            raise RotationError("publication base pin changed while acquiring locks")

        if (
            not args.newswire_lock.is_absolute()
            or args.newswire_lock.absolute() != args.newswire_lock
        ):
            raise RotationError("newswire lock path is not canonical")
        _validate_directory(
            args.newswire_lock.parent,
            uid=publisher_user.pw_uid,
            gid=publisher_group.gr_gid,
            mode=0o750,
            label="newswire state root",
        )
        newswire_lock_descriptor = _acquire_lock(
            args.newswire_lock,
            uid=publisher_user.pw_uid,
            gid=publisher_group.gr_gid,
            mode=0o600,
            label="newswire attempt lock",
        )

        _require_no_rotation_blockers(
            state_root=state_root,
            data_hold=args.data_hold,
        )
        _require_service_inactive("palimpsest-event-analysis-live.service")

        current_pin_raw = initial_pin_raw
        current_pin = initial_pin
        generation, current_base, expected_head, expected_deployed = _current_pin_identity(current_pin)
        current_pin_sha256 = _sha256(current_pin_raw)
        if generation == 0 and current_pin_sha256 != BOOTSTRAP_PIN_SHA256:
            raise RotationError("bootstrap publication pin is not the immutable reviewed pin")
        authenticated_pins: dict[str, dict[str, Any]] = {}
        if generation > 0:
            _ensure_history_directories(history_root, group_gid=publisher_group.gr_gid)
            authenticated_pins = _validate_v2_pin_archives(
                current_pin,
                current_pin_raw,
                history_root=history_root,
                group_gid=publisher_group.gr_gid,
            )

        _validate_file(args.deployed_commit, uid=0, gid=0, mode=0o644, label="deployed-commit")
        deployed_raw = _read_regular(args.deployed_commit, max_bytes=256)
        deployed = deployed_raw.decode("ascii").strip()
        if deployed != expected_deployed:
            raise RotationError("host deployed-commit differs from the current pin")

        success_receipt = state_root / "latest-success.json"
        _validate_file(success_receipt, uid=publisher_user.pw_uid, gid=publisher_group.gr_gid, mode=0o600, label="latest publication receipt", single_link=False)
        receipt_raw = _read_regular(success_receipt, max_bytes=MAX_RECEIPT_BYTES, single_link=False)
        receipt = _strict_json(receipt_raw, "latest publication receipt")
        _validate_publication_receipt(receipt)
        if generation > 0 and current_base == args.target_base_sha:
            _validate_completed_receipt(
                receipt,
                receipt_raw,
                pin=current_pin,
                pin_path=args.base_pin,
                pin_sha256=current_pin_sha256,
            )

        if _git(repository, ["status", "--porcelain=v1", "--untracked-files=all"], user=publisher_user).stdout:
            raise RotationError("canonical repository is not clean")
        git_directory = repository / ".git"
        if (git_directory / "shallow").exists() or (git_directory / "info" / "grafts").exists() or _git(repository, ["for-each-ref", "--format=%(refname)", "refs/replace"], user=publisher_user).stdout:
            raise RotationError("canonical repository uses shallow, graft, or replacement history")
        canonical_head = _git(repository, ["rev-parse", "HEAD"], user=publisher_user).stdout.strip()
        if canonical_head != expected_head:
            raise RotationError("canonical HEAD differs from the current pin")
        remote_url = _git(repository, ["remote", "get-url", "origin"], user=publisher_user).stdout.strip()
        if remote_url != EXPECTED_REMOTE:
            raise RotationError("origin is not the reviewed public repository")

        _git(repository, ["fetch", "--quiet", "--no-tags", "--force", "origin", "+refs/heads/main:refs/remotes/origin/main"], user=publisher_user)
        remote_rows = _git(repository, ["ls-remote", "--exit-code", "origin", "refs/heads/main"], user=publisher_user).stdout.splitlines()
        if len(remote_rows) != 1:
            raise RotationError("public main does not have one exact identity")
        current_public_main = remote_rows[0].split("\t", 1)[0]
        local_main_sha = _git(repository, ["rev-parse", "refs/remotes/origin/main"], user=publisher_user).stdout.strip()
        if current_public_main != local_main_sha:
            raise RotationError("fetched origin/main differs from public main")
        if prepared is not None:
            intent = prepared[0]
            predecessor = intent["predecessor"]
            if (
                intent["target"]
                != {
                    "base_sha": args.target_base_sha,
                    "public_main_sha": args.target_base_sha,
                }
                or (
                    generation == predecessor["generation"]
                    and (
                        current_pin_sha256 != predecessor["pin_sha256"]
                        or current_base != predecessor["target_sha"]
                    )
                )
                or (
                    generation not in {
                        predecessor["generation"],
                        predecessor["generation"] + 1,
                    }
                )
                or (
                    generation == predecessor["generation"] + 1
                    and current_base != args.target_base_sha
                )
            ):
                raise RotationError("active state does not match the prepared rotation")
            _git(
                repository,
                ["merge-base", "--is-ancestor", args.target_base_sha, current_public_main],
                user=publisher_user,
            )
        elif current_public_main != args.target_base_sha:
            if generation > 0 and current_base == args.target_base_sha:
                _git(
                    repository,
                    ["merge-base", "--is-ancestor", args.target_base_sha, current_public_main],
                    user=publisher_user,
                )
                installed = _validate_installed(args, repository=repository, target=args.target_base_sha, owner=publisher_user)
                if installed != current_pin["installed"]:
                    raise RotationError("installed target proof differs from completed rotation")
                complete_prepared_transaction()
                return current_pin
            raise RotationError("target base is not the exact fetched public main tip")
        public_main_sha = args.target_base_sha
        if current_base == args.target_base_sha:
            if generation < 1:
                raise RotationError("bootstrap pin target cannot be rotated to itself")
            installed = _validate_installed(args, repository=repository, target=args.target_base_sha, owner=publisher_user)
            if installed != current_pin["installed"]:
                raise RotationError("installed target proof differs from completed rotation")
            complete_prepared_transaction()
            return current_pin
        _git(repository, ["merge-base", "--is-ancestor", current_base, args.target_base_sha], user=publisher_user)
        if _git(repository, ["rev-parse", current_base], user=publisher_user).stdout.strip() == args.target_base_sha:
            raise RotationError("successor base must advance the current pin")

        target_digests = _target_blob_digests(
            args,
            repository=repository,
            target=args.target_base_sha,
            owner=publisher_user,
        )
        predecessor_tree_digests = _available_tree_blob_digests(
            args,
            repository=repository,
            target=current_base,
            owner=publisher_user,
        )
        host_tree_digests = _available_tree_blob_digests(
            args,
            repository=repository,
            target=deployed,
            owner=publisher_user,
        )
        if prepared is not None and prepared[0]["installed"] != target_digests:
            raise RotationError("prepared rotation target artifacts changed")
        if args.recover_unpublished_chain:
            if generation < 1 or current_base == args.target_base_sha:
                raise RotationError(
                    "unpublished-chain recovery requires one current "
                    "successor and a strict target advance"
                )
            recovery_digest = _validate_target_blob(
                repository,
                args.target_base_sha,
                "ops/railway/rotate-direct-publication-base",
                args.installed_recovery_helper,
                owner=publisher_user,
            )
            if recovery_digest != target_digests["rotation_helper_sha256"]:
                raise RotationError(
                    "recovery bootstrap is not the exact target rotation helper"
                )
        _validate_install_transition(
            current_pin,
            actual=_installed_blob_digests(args),
            host_tree=host_tree_digests,
            predecessor_tree=predecessor_tree_digests,
            target=target_digests,
        )
        if args.recover_unpublished_chain:
            _validate_unpublished_chain_bridge(
                receipt,
                receipt_raw,
                pin=current_pin,
                authenticated_pins=authenticated_pins,
            )
        else:
            _receipt_matches_pin(
                receipt,
                pin_path=args.base_pin,
                pin_sha256=current_pin_sha256,
                pin_kind=(
                    "verified_transition" if generation == 0 else "verified_successor"
                ),
                base_sha=current_base,
                host_deployed_sha=deployed,
            )

        nonce = time.time_ns()
        provider_raw = _fetch_manifest(PROVIDER_ORIGIN, nonce)
        public_raw = _fetch_manifest(PUBLIC_ORIGIN, nonce)
        if provider_raw != public_raw:
            raise RotationError("provider and public live manifests are not byte-identical")
        manifest = _validate_manifest(provider_raw, receipt=receipt)
        topology_raw = _railway_status(args)
        topology = _validate_topology(
            topology_raw,
            project_id=args.project_id,
            environment_id=args.environment_id,
            service_id=args.service_id,
            deployment_id=receipt["railway"]["deployment_id"],
        )
        prepared_evidence = {
            "provider_manifest_sha256": _sha256(provider_raw),
            "public_manifest_sha256": _sha256(public_raw),
            "topology_sha256": _sha256(topology_raw),
        }
        if (
            prepared is not None
            and generation == prepared[0]["predecessor"]["generation"]
            and (
                prepared[0]["predecessor"]["receipt_sha256"]
                != _sha256(receipt_raw)
                or prepared[0]["evidence"] != prepared_evidence
            )
        ):
            raise RotationError("prepared rotation predecessor evidence changed")

        if prepared is None:
            intent = {
                "evidence": prepared_evidence,
                "installed": target_digests,
                "predecessor": {
                    "generation": generation,
                    "pin_sha256": current_pin_sha256,
                    "receipt_sha256": _sha256(receipt_raw),
                    "target_sha": current_base,
                },
                "schema_version": ROTATION_INTENT_SCHEMA,
                "started_at": (
                    datetime.now(UTC)
                    .replace(microsecond=0)
                    .isoformat()
                    .replace("+00:00", "Z")
                ),
                "status": "prepared",
                "target": {
                    "base_sha": args.target_base_sha,
                    "public_main_sha": public_main_sha,
                },
            }
            intent_raw = _persist_rotation_intent(
                intent_path, intent, group_gid=publisher_group.gr_gid
            )
            prepared = (intent, intent_raw)

        _install_target_artifacts(
            args,
            repository=repository,
            target=args.target_base_sha,
            owner=publisher_user,
        )
        installed = _validate_installed(
            args,
            repository=repository,
            target=args.target_base_sha,
            owner=publisher_user,
        )
        if installed != target_digests:
            raise RotationError("installed target digest projection changed")

        _ensure_history_directories(history_root, group_gid=publisher_group.gr_gid)
        current_pin_archive = _archive_path(history_root, "pins", current_pin_sha256)
        receipt_sha256 = _sha256(receipt_raw)
        receipt_archive = _archive_path(history_root, "receipts", receipt_sha256)
        provider_sha256 = _sha256(provider_raw)
        public_sha256 = _sha256(public_raw)
        provider_archive = _archive_path(history_root, "manifests", provider_sha256, origin="provider")
        public_archive = _archive_path(history_root, "manifests", public_sha256, origin="public")
        topology_sha256 = _sha256(topology_raw)
        topology_archive = _archive_path(history_root, "topologies", topology_sha256)
        for path, raw in (
            (current_pin_archive, current_pin_raw),
            (receipt_archive, receipt_raw),
            (provider_archive, provider_raw),
            (public_archive, public_raw),
            (topology_archive, topology_raw),
        ):
            _archive_bytes(path, raw, group_gid=publisher_group.gr_gid)

        if generation == 0:
            anchor = {
                "path": str(current_pin_archive),
                "schema_version": BOOTSTRAP_SCHEMA,
                "sha256": current_pin_sha256,
                "target_sha": current_base,
            }
        else:
            anchor = current_pin["anchor"]
        next_generation = generation + 1
        record_path = history_root / "rotations" / f"{next_generation}-{args.target_base_sha}-{receipt_sha256}.json"
        existing_record_raw: bytes | None = None
        existing_record: dict[str, Any] | None = None
        if record_path.exists() or record_path.is_symlink():
            _validate_file(
                record_path,
                uid=0,
                gid=publisher_group.gr_gid,
                mode=0o640,
                label="prepared rotation record",
            )
            existing_record_raw = _read_regular(
                record_path, max_bytes=2 * MAX_PIN_BYTES
            )
            existing_record = _strict_json(
                existing_record_raw, "prepared rotation record"
            )
            _require_keys(
                existing_record,
                {
                    "generation",
                    "next_pin",
                    "next_pin_sha256",
                    "predecessor_pin_sha256",
                    "predecessor_receipt_sha256",
                    "recorded_at",
                    "schema_version",
                    "status",
                    "target_base_sha",
                },
                "prepared rotation record",
            )
            if (
                existing_record["schema_version"] != ROTATION_SCHEMA
                or existing_record["status"] != "verified"
                or existing_record["generation"] != next_generation
                or existing_record["target_base_sha"] != args.target_base_sha
                or existing_record["predecessor_pin_sha256"]
                != current_pin_sha256
                or existing_record["predecessor_receipt_sha256"]
                != receipt_sha256
                or not isinstance(existing_record["next_pin"], dict)
            ):
                raise RotationError(
                    "existing rotation record names a different transaction"
                )
            recorded_at = _require_timestamp(
                existing_record["recorded_at"],
                "prepared rotation recorded_at",
            )
            prepared_railway = existing_record["next_pin"].get("railway")
            if not isinstance(prepared_railway, dict) or not isinstance(
                prepared_railway.get("topology"), dict
            ):
                raise RotationError("prepared rotation topology reference is invalid")
            topology_reference = prepared_railway["topology"]
            _validate_reference(topology_reference, "prepared topology reference")
            prepared_topology_raw = _validate_archive(
                Path(topology_reference["path"]),
                expected=_archive_path(
                    history_root, "topologies", topology_reference["sha256"]
                ),
                digest=topology_reference["sha256"],
                group_gid=publisher_group.gr_gid,
                max_bytes=MAX_TOPOLOGY_BYTES,
            )
            if len(prepared_topology_raw) != topology_reference["bytes"]:
                raise RotationError("prepared topology byte count differs")
            if _validate_topology(
                prepared_topology_raw,
                project_id=args.project_id,
                environment_id=args.environment_id,
                service_id=args.service_id,
                deployment_id=receipt["railway"]["deployment_id"],
            ) != topology:
                raise RotationError(
                    "prepared rotation no longer names the active topology"
                )
        else:
            recorded_at = (
                datetime.now(UTC)
                .replace(microsecond=0)
                .isoformat()
                .replace("+00:00", "Z")
            )
            topology_reference = {
                "bytes": len(topology_raw),
                "path": str(topology_archive),
                "sha256": topology_sha256,
            }
        next_pin: dict[str, Any] = {
            "anchor": anchor,
            "generation": next_generation,
            "host": {"canonical_head": canonical_head, "deployed_commit": deployed},
            "installed": installed,
            "live": {
                "file_count": manifest["file_count"],
                "provider_manifest": {"bytes": len(provider_raw), "path": str(provider_archive), "sha256": provider_sha256},
                "public_manifest": {"bytes": len(public_raw), "path": str(public_archive), "sha256": public_sha256},
                "release_sha": manifest["source_commit"],
                "total_bytes": manifest["total_bytes"],
                "tree_sha256": manifest["tree_sha256"],
            },
            "origins": {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN},
            "predecessor": {
                "pin": {
                    "generation": generation,
                    "path": str(current_pin_archive),
                    "schema_version": current_pin["schema_version"],
                    "sha256": current_pin_sha256,
                    "target_sha": current_base,
                },
                "publication_receipt": {
                    "base_sha": receipt["base_sha"],
                    "deployment_id": receipt["railway"]["deployment_id"],
                    "host_deployed_sha": receipt["host_deployed_sha"],
                    "input_sha256": receipt["input_sha256"],
                    "manifest_sha256": receipt["live_manifest"]["sha256"],
                    "path": str(receipt_archive),
                    "publication_base_sha256": receipt["publication_base"]["sha256"],
                    "release_sha": receipt["release_sha"],
                    "schema_version": receipt["schema_version"],
                    "sha256": receipt_sha256,
                    "tree_sha256": receipt["live_manifest"]["tree_sha256"],
                    "wire_generated_at": receipt["wire_generated_at"],
                },
            },
            "railway": {
                "created_at": topology["created_at"],
                "deployment_id": receipt["railway"]["deployment_id"],
                "environment_id": args.environment_id,
                "image_digest": topology["image_digest"],
                "project_id": args.project_id,
                "reason": topology["reason"],
                "service_id": args.service_id,
                "topology": topology_reference,
            },
            "recorded_at": recorded_at,
            "rotation_record_path": str(record_path),
            "schema_version": PIN_SCHEMA,
            "status": "verified",
            "target": {"base_sha": args.target_base_sha, "public_main_sha": public_main_sha},
        }
        _validate_v2_pin_shape(next_pin)
        next_pin_raw = _canonical_bytes(next_pin)
        record = {
            "generation": next_generation,
            "next_pin": next_pin,
            "next_pin_sha256": _sha256(next_pin_raw),
            "predecessor_pin_sha256": current_pin_sha256,
            "predecessor_receipt_sha256": receipt_sha256,
            "recorded_at": recorded_at,
            "schema_version": ROTATION_SCHEMA,
            "status": "verified",
            "target_base_sha": args.target_base_sha,
        }
        record_raw = _canonical_bytes(record)
        if existing_record_raw is not None:
            if (
                existing_record != record
                or existing_record_raw != record_raw
                or existing_record["next_pin_sha256"] != _sha256(next_pin_raw)
            ):
                raise RotationError(
                    "prepared rotation record differs from the retry transaction"
                )
            _validate_v2_pin_archives(
                next_pin,
                next_pin_raw,
                history_root=history_root,
                group_gid=publisher_group.gr_gid,
            )

        final_remote = _git(repository, ["ls-remote", "--exit-code", "origin", "refs/heads/main"], user=publisher_user).stdout.splitlines()
        if len(final_remote) != 1:
            raise RotationError("public main identity changed before rotation")
        final_public_main = final_remote[0].split("\t", 1)[0]
        if final_public_main != args.target_base_sha:
            if prepared is None:
                raise RotationError("public main moved before the rotation boundary")
            _git(
                repository,
                ["merge-base", "--is-ancestor", args.target_base_sha, final_public_main],
                user=publisher_user,
            )
        if _read_regular(args.base_pin, max_bytes=MAX_PIN_BYTES) != current_pin_raw or _read_regular(success_receipt, max_bytes=MAX_RECEIPT_BYTES, single_link=False) != receipt_raw or _read_regular(args.deployed_commit, max_bytes=256) != deployed_raw:
            raise RotationError("local publication identity changed before rotation")
        if _git(repository, ["rev-parse", "HEAD"], user=publisher_user).stdout.strip() != canonical_head or _git(repository, ["status", "--porcelain=v1", "--untracked-files=all"], user=publisher_user).stdout:
            raise RotationError("canonical repository changed before rotation")
        final_provider = _fetch_manifest(PROVIDER_ORIGIN, time.time_ns())
        final_public = _fetch_manifest(PUBLIC_ORIGIN, time.time_ns())
        if final_provider != provider_raw or final_public != public_raw:
            raise RotationError("live manifest bytes changed before rotation")
        final_topology_raw = _railway_status(args)
        final_topology = _validate_topology(final_topology_raw, project_id=args.project_id, environment_id=args.environment_id, service_id=args.service_id, deployment_id=receipt["railway"]["deployment_id"])
        if final_topology != topology:
            raise RotationError("active Railway topology changed before rotation")
        if _validate_installed(args, repository=repository, target=args.target_base_sha, owner=publisher_user) != installed:
            raise RotationError("installed publication lane changed before rotation")
        _require_no_rotation_blockers(
            state_root=state_root,
            data_hold=args.data_hold,
        )
        _require_service_inactive("palimpsest-event-analysis-live.service")
        if newswire_lock_descriptor is None:
            raise RotationError("newswire attempt lock was not retained")
        _verify_locked_path(
            args.newswire_lock,
            newswire_lock_descriptor,
            label="newswire attempt lock",
        )

        _archive_bytes(record_path, record_raw, group_gid=publisher_group.gr_gid)
        _atomic_replace_pin(args.base_pin, next_pin_raw, expected_previous=current_pin_raw, group_gid=publisher_group.gr_gid)
        _validate_file(args.base_pin, uid=0, gid=publisher_group.gr_gid, mode=0o640, label="rotated publication base pin")
        if _read_regular(args.base_pin, max_bytes=MAX_PIN_BYTES) != next_pin_raw:
            raise RotationError("persisted successor publication base pin changed")
        _validate_v2_pin_archives(next_pin, next_pin_raw, history_root=history_root, group_gid=publisher_group.gr_gid)
        complete_prepared_transaction()
        return next_pin
    finally:
        if state_sealed:
            try:
                intent_path.lstat()
            except FileNotFoundError:
                intent_is_present = False
            except OSError:
                intent_is_present = True
            else:
                intent_is_present = True
            if not intent_is_present:
                _restore_legacy_state_root(
                    state_root,
                    publisher_uid=publisher_user.pw_uid,
                    publisher_gid=publisher_group.gr_gid,
                )
        if legacy_lock_descriptor is not None:
            os.close(legacy_lock_descriptor)
        os.close(lock_descriptor)
        if newswire_lock_descriptor is not None:
            os.close(newswire_lock_descriptor)


def main(argv: list[str] | None = None) -> int:
    try:
        document = perform_rotation(_parser().parse_args(argv))
    except (RotationError, KeyError, UnicodeDecodeError) as exc:
        print(f"base rotation refused: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(document, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
