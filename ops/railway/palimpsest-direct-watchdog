def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def parse_timestamp(value: Any) -> datetime:
    if not isinstance(value, str) or UTC_TIMESTAMP.fullmatch(value) is None:
        raise ValueError("timestamp is not whole-second UTC")
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(
        timezone.utc
    )


def parse_fractional_timestamp(value: Any, *, microseconds: bool = False) -> datetime:
    pattern = UTC_TIMESTAMP_MICROSECONDS if microseconds else UTC_TIMESTAMP_FRACTIONAL
    if not isinstance(value, str) or pattern.fullmatch(value) is None:
        precision = "six-digit microsecond" if microseconds else "ISO UTC"
        raise ValueError(f"timestamp is not {precision}")
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(
        timezone.utc
    )


def _candidate_receipt_deadline(candidate: dict[str, Any]) -> datetime:
    """Validate the publisher's persisted post-mutation receipt deadline."""

    timestamps: dict[str, datetime] = {}
    for field in ("prepared_at", "wire_generated_at", "receipt_deadline_at"):
        try:
            timestamps[field] = parse_timestamp(candidate[field])
        except (KeyError, ValueError) as exc:
            raise WatchdogError(f"candidate {field} is invalid") from exc

    prepared_at = timestamps["prepared_at"]
    wire_generated_at = timestamps["wire_generated_at"]
    receipt_deadline_at = timestamps["receipt_deadline_at"]
    if receipt_deadline_at <= prepared_at:
        raise WatchdogError("candidate receipt deadline does not follow preparation")
    if receipt_deadline_at > prepared_at + timedelta(
        seconds=MAX_CANDIDATE_RECEIPT_AFTER_PREPARED_SECONDS
    ):
        raise WatchdogError("candidate receipt deadline exceeds the preparation bound")
    if receipt_deadline_at > wire_generated_at + timedelta(
        seconds=MAX_CANDIDATE_RECEIPT_AFTER_WIRE_SECONDS
    ):
        raise WatchdogError(
            "candidate receipt deadline exceeds the wire freshness bound"
        )
    return receipt_deadline_at


def _sha256(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def _canonical_json_bytes(document: dict[str, Any]) -> bytes:
    return (
        json.dumps(
            document,
            allow_nan=False,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        ).encode("utf-8")
        + b"\n"
    )


def _expect_keys(
    document: dict[str, Any], expected: set[str], *, label: str
) -> None:
    if set(document) != expected:
        raise WatchdogError(f"{label} does not match its closed schema")


def _strict_json(raw: bytes, *, label: str) -> dict[str, Any]:
    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        document: dict[str, Any] = {}
        for key, value in rows:
            if key in document:
                raise WatchdogError(f"{label} contains duplicate key {key!r}")
            document[key] = value
        return document

    try:
        parsed = json.loads(
            raw,
            object_pairs_hook=pairs,
            parse_constant=lambda value: (_ for _ in ()).throw(
                WatchdogError(f"{label} contains non-finite number {value}")
            ),
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise WatchdogError(f"{label} is not strict JSON") from exc
    if not isinstance(parsed, dict):
        raise WatchdogError(f"{label} must be a JSON object")
    return parsed


def _read_regular(
    path: Path,
    *,
    label: str,
    maximum: int,
    uid: int | None = None,
    gid: int | None = None,
    mode: int | None = None,
    single_link: bool = False,
) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise WatchdogError(f"cannot open {label}: {path}") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise WatchdogError(f"{label} is not a regular file")
        if single_link and metadata.st_nlink != 1:
            raise WatchdogError(f"{label} has unsafe link count")
        if uid is not None and metadata.st_uid != uid:
            raise WatchdogError(f"{label} has unsafe owner")
        if gid is not None and metadata.st_gid != gid:
            raise WatchdogError(f"{label} has unsafe group")
        if mode is not None and stat.S_IMODE(metadata.st_mode) != mode:
            raise WatchdogError(f"{label} has unsafe mode")
        if metadata.st_size > maximum:
            raise WatchdogError(f"{label} exceeds {maximum} bytes")
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining:
            chunk = os.read(descriptor, min(remaining, 1024 * 1024))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        try:
            pathname = os.stat(path, follow_symlinks=False)
        except OSError as exc:
            raise WatchdogError(f"{label} pathname changed") from exc
        def identity(item: os.stat_result) -> tuple[int, ...]:
            return (
                item.st_dev,
                item.st_ino,
                item.st_mode,
                item.st_uid,
                item.st_gid,
                item.st_nlink,
                item.st_size,
                item.st_mtime_ns,
            )
        if (
            len(raw) > maximum
            or identity(metadata) != identity(after)
            or metadata.st_dev != pathname.st_dev
            or metadata.st_ino != pathname.st_ino
        ):
            raise WatchdogError(f"{label} exceeds {maximum} bytes")
        return raw
    finally:
        os.close(descriptor)


def _validate_directory(
    path: Path, *, label: str, uid: int, gid: int, mode: int
) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise WatchdogError(f"cannot inspect {label}: {path}") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or path.is_symlink()
        or metadata.st_uid != uid
        or metadata.st_gid != gid
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise WatchdogError(f"{label} ownership or mode is unsafe")


def _sha40(value: Any, *, label: str) -> str:
    if not isinstance(value, str) or SHA40.fullmatch(value) is None:
        raise WatchdogError(f"{label} is not a lowercase commit SHA")
    return value


def _digest(value: Any, *, label: str) -> str:
    if not isinstance(value, str) or SHA256.fullmatch(value) is None:
        raise WatchdogError(f"{label} is not a SHA-256 digest")
    return value


def _positive_integer(value: Any, *, label: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise WatchdogError(f"{label} is not a positive integer")
    return value


def _pin_kind(pin: dict[str, Any]) -> str:
    if pin.get("schema_version") == PIN_SCHEMA:
        return "verified_transition"
    if pin.get("schema_version") == SUCCESSOR_PIN_SCHEMA:
        return "verified_successor"
    raise WatchdogError("publication base pin schema is unsupported")


def _validate_installed_pin_proof(
    config: LineageConfig,
    installed: dict[str, Any],
    *,
    successor: bool,
    active: bool,
) -> None:
    installed_paths = {
        "publisher_sha256": (config.installed_publisher, 0o755),
        "transition_helper_sha256": (config.installed_transition_helper, 0o755),
        "reconciler_sha256": (config.installed_reconciler, 0o755),
        "watchdog_sha256": (config.installed_watchdog, 0o755),
        "publisher_service_sha256": (config.installed_publisher_service, 0o644),
        "watchdog_service_sha256": (config.installed_watchdog_service, 0o644),
        "watchdog_timer_sha256": (config.installed_watchdog_timer, 0o644),
    }
    if successor:
        installed_paths.update(
            {
                "continuity_guard_sha256": (
                    config.installed_continuity_guard,
                    0o755,
                ),
                "continuity_guard_service_sha256": (
                    config.installed_continuity_guard_service,
                    0o644,
                ),
                "continuity_guard_timer_sha256": (
                    config.installed_continuity_guard_timer,
                    0o644,
                ),
                "event_analysis_publish_dropin_sha256": (
                    config.installed_event_analysis_publish_dropin,
                    0o644,
                ),
                "event_analysis_service_sha256": (
                    config.installed_event_analysis_service,
                    0o644,
                ),
                "event_analysis_wrapper_sha256": (
                    config.installed_event_analysis_wrapper,
                    0o755,
                ),
                "rotation_helper_sha256": (
                    config.installed_rotation_helper,
                    0o755,
                ),
            }
        )
    _expect_keys(installed, set(installed_paths), label="installed pin proof")
    for key, (path, expected_mode) in installed_paths.items():
        expected = _digest(installed[key], label=f"installed.{key}")
        if not active:
            continue
        actual_raw = _read_regular(
            path,
            label=f"installed publication artifact {path}",
            maximum=4 * 1024 * 1024,
            uid=config.installed_uid,
            gid=config.installed_gid,
            mode=expected_mode,
            single_link=True,
        )
        if _sha256(actual_raw) != expected:
            raise WatchdogError(f"installed publication artifact changed: {path}")


def _validate_legacy_pin_document(
    config: LineageConfig,
    pin: dict[str, Any],
    raw: bytes,
    *,
    active: bool,
) -> None:
    _expect_keys(
        pin,
        {
            "incident_id",
            "installed",
            "origins",
            "previous",
            "recorded_at",
            "schema_version",
            "status",
            "target",
        },
        label="publication base pin",
    )
    if (
        pin["schema_version"] != PIN_SCHEMA
        or pin["status"] != "verified"
        or pin["incident_id"] != PIN_INCIDENT
    ):
        raise WatchdogError("publication base pin identity is invalid")
    parse_timestamp(pin["recorded_at"])

    installed = pin.get("installed")
    origins = pin.get("origins")
    previous = pin.get("previous")
    target = pin.get("target")
    if not all(isinstance(value, dict) for value in (installed, origins, previous, target)):
        raise WatchdogError("publication base pin contains invalid proof objects")
    assert isinstance(installed, dict)
    assert isinstance(origins, dict)
    assert isinstance(previous, dict)
    assert isinstance(target, dict)
    _validate_installed_pin_proof(
        config,
        installed,
        successor=False,
        active=active,
    )

    _expect_keys(origins, {"provider", "public"}, label="pin origins")
    if origins != {
        "provider": config.provider_origin,
        "public": config.public_origin,
    }:
        raise WatchdogError("publication base pin names different origins")

    _expect_keys(
        previous,
        {
            "canonical_head",
            "deployed_commit",
            "live_manifest_sha256",
            "live_release_sha",
            "live_tree_sha256",
            "publication_input_sha256",
            "publication_receipt_sha256",
            "railway_deployment_id",
        },
        label="pin predecessor",
    )
    if (
        previous["canonical_head"] != INCIDENT_BASE_SHA
        or previous["deployed_commit"] != INCIDENT_BASE_SHA
        or previous["live_release_sha"] != INCIDENT_RELEASE_SHA
        or previous["publication_receipt_sha256"]
        != INCIDENT_RECEIPT_SHA256
        or previous["publication_input_sha256"] != INCIDENT_INPUT_SHA256
        or previous["live_manifest_sha256"] != INCIDENT_MANIFEST_SHA256
        or previous["live_tree_sha256"] != INCIDENT_TREE_SHA256
        or previous["railway_deployment_id"] != INCIDENT_DEPLOYMENT_ID
    ):
        raise WatchdogError("publication base pin does not close the recorded incident")

    _expect_keys(target, {"base_sha", "public_main_sha"}, label="pin target")
    target_sha = _sha40(target["base_sha"], label="pin target base")
    if (
        target["public_main_sha"] != target_sha
        or target_sha != INCIDENT_PIN_TARGET_SHA
        or _sha256(raw) != INCIDENT_PIN_SHA256
    ):
        raise WatchdogError("publication base is not the pinned public main")


