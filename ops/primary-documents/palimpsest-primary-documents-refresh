#!/usr/bin/env bash
# Preserve the existing private archive; refresh its public metadata receipt.
set -Eeuo pipefail
umask 077

readonly SOURCE="${PALIMPSEST_PRIMARY_SOURCE:?immutable source is required}"
readonly COMMIT_FILE="${PALIMPSEST_PRIMARY_COMMIT_FILE:?source marker is required}"
readonly STATE="${PALIMPSEST_PRIMARY_STATE_ROOT:-/var/lib/palimpsest/primary-documents-refresh}"
readonly STORE="${PALIMPSEST_EVIDENCE_DOCUMENT_STORE:?existing private store is required}"
readonly OUTPUT="${PALIMPSEST_PRIMARY_OUTPUT:-/var/lib/palimpsest/readings/primary-documents-latest.json}"
readonly PYTHON="${PALIMPSEST_PYTHON_BIN:-/opt/palimpsest/collector-venv/bin/python}"
export PALIMPSEST_KILLFILE="${PALIMPSEST_KILLFILE:?explicit host halt path is required}"
[[ "$PALIMPSEST_KILLFILE" == /* ]]
[[ -d "$STATE" && ! -L "$STATE" && -f "$STATE/refresh.lock" && ! -L "$STATE/refresh.lock" ]]
base_sha="$(tr -d '[:space:]' < "$COMMIT_FILE")"
[[ "$base_sha" =~ ^[0-9a-f]{40}$ ]]
export GIT_NO_REPLACE_OBJECTS=1 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
[[ "$(git -c safe.directory="$SOURCE" -C "$SOURCE" rev-parse HEAD)" == "$base_sha" ]]
[[ -z "$(git -c safe.directory="$SOURCE" -C "$SOURCE" status --porcelain --untracked-files=no)" ]]
work="$(mktemp -d "$STATE/work.XXXXXX")"
cleanup() { rm -rf --one-file-system -- "$work"; }
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
mkdir "$work/source"
git -c safe.directory="$SOURCE" -C "$SOURCE" archive --format=tar "$base_sha" | tar -xf - -C "$work/source"
cd "$work/source"
export PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$work/source"
timeout --signal=TERM --kill-after=15s 12m "$PYTHON" -B -m scripts.primary_documents_refresh \
  --store "$STORE" --output "$OUTPUT" --lock "$STATE/refresh.lock"
