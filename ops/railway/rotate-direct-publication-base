def _validate_installed(args: argparse.Namespace, *, repository: Path, target: str, owner: pwd.struct_passwd) -> dict[str, str]:
    return {
        key: _validate_target_blob(
            repository,
            target,
            repository_path,
            installed_path,
            owner=owner,
            git_mode=git_mode,
            installed_mode=installed_mode,
        )
        for key, repository_path, installed_path, git_mode, installed_mode in _installed_specifications(args)
    }


def _target_blob_digests(
    args: argparse.Namespace,
    *,
    repository: Path,
    target: str,
    owner: pwd.struct_passwd,
) -> dict[str, str]:
    expected: dict[str, str] = {}
    for key, repository_path, _, git_mode, _ in _installed_specifications(args):
        row = _git(
            repository,
            ["ls-tree", target, "--", repository_path],
            user=owner,
        ).stdout.strip()
        if not row.startswith(f"{git_mode} blob ") or not row.endswith(
            f"\t{repository_path}"
        ):
            raise RotationError(f"target does not contain {repository_path}")
        raw = _git(
            repository,
            ["show", f"{target}:{repository_path}"],
            user=owner,
            text=False,
        ).stdout
        expected[key] = _sha256(raw)
    return expected


def _available_tree_blob_digests(
    args: argparse.Namespace,
    *,
    repository: Path,
    target: str,
    owner: pwd.struct_passwd,
) -> dict[str, str]:
    available: dict[str, str] = {}
    for key, repository_path, _, git_mode, _ in _installed_specifications(args):
        row = _git(
            repository,
            ["ls-tree", target, "--", repository_path],
            user=owner,
        ).stdout.strip()
        if not row:
            continue
        if not row.startswith(f"{git_mode} blob ") or not row.endswith(
            f"\t{repository_path}"
        ):
            raise RotationError(f"predecessor tree entry is unsafe: {repository_path}")
        raw = _git(
            repository,
            ["show", f"{target}:{repository_path}"],
            user=owner,
            text=False,
        ).stdout
        available[key] = _sha256(raw)
    return available


def _installed_blob_digests(args: argparse.Namespace) -> dict[str, str]:
    actual: dict[str, str] = {}
    for key, repository_path, installed_path, _, installed_mode in _installed_specifications(args):
        _validate_file(
            installed_path,
            uid=0,
            gid=0,
            mode=installed_mode,
            label=f"installed {repository_path}",
        )
        actual[key] = _sha256(
            _read_regular(installed_path, max_bytes=4 * 1024 * 1024)
        )
    return actual


def _validate_install_transition(
    current_pin: dict[str, Any],
    *,
    actual: dict[str, str],
    host_tree: dict[str, str],
    predecessor_tree: dict[str, str],
    target: dict[str, str],
) -> None:
    current = current_pin["installed"]
    for key, digest in actual.items():
        allowed = {target[key]}
        if key in current:
            allowed.add(current[key])
        if key in predecessor_tree:
            allowed.add(predecessor_tree[key])
        if key in host_tree:
            allowed.add(host_tree[key])
        if digest not in allowed:
            raise RotationError(
                "installed publication lane is neither current nor exact target"
            )


def _atomic_install_blob(path: Path, raw: bytes, *, mode: int) -> None:
    _validate_directory(
        path.parent,
        uid=0,
        gid=0,
        mode=0o755,
        label=f"installed artifact directory {path.parent}",
    )
    if path.exists() or path.is_symlink():
        _validate_file(
            path,
            uid=0,
            gid=0,
            mode=mode,
            label=f"installed artifact {path}",
        )
        if _read_regular(path, max_bytes=4 * 1024 * 1024) == raw:
            return
    descriptor, temporary = tempfile.mkstemp(prefix=".palimpsest-install.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, 0, 0)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_path, path)
        _fsync_directory(path.parent)
    finally:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


def _install_target_artifacts(
    args: argparse.Namespace,
    *,
    repository: Path,
    target: str,
    owner: pwd.struct_passwd,
) -> None:
    for _, repository_path, installed_path, git_mode, installed_mode in _installed_specifications(args):
        row = _git(
            repository,
            ["ls-tree", target, "--", repository_path],
            user=owner,
        ).stdout.strip()
        if not row.startswith(f"{git_mode} blob ") or not row.endswith(
            f"\t{repository_path}"
        ):
            raise RotationError(f"target does not contain {repository_path}")
        raw = _git(
            repository,
            ["show", f"{target}:{repository_path}"],
            user=owner,
            text=False,
        ).stdout
        _atomic_install_blob(installed_path, raw, mode=installed_mode)

    # Unit replacement is still inside publish.lock.  Reloading does not stop,
    # disable, or start a timer; any timer activation coalesces on this lock.
    _run(["/usr/bin/systemctl", "daemon-reload"])


def _validate_bootstrap_pin(pin: dict[str, Any]) -> None:
    _require_keys(
        pin,
        {"incident_id", "installed", "origins", "previous", "recorded_at", "schema_version", "status", "target"},
        "bootstrap publication base pin",
    )
    if (
        pin["schema_version"] != BOOTSTRAP_SCHEMA
        or pin["status"] != "verified"
        or pin["incident_id"] != BOOTSTRAP_INCIDENT
    ):
        raise RotationError("bootstrap publication base pin identity is invalid")
    _require_timestamp(pin["recorded_at"], "bootstrap pin recorded_at")
    installed = pin.get("installed")
    if not isinstance(installed, dict):
        raise RotationError("bootstrap installed proof is invalid")
    _require_keys(
        installed,
        {"publisher_service_sha256", "publisher_sha256", "reconciler_sha256", "transition_helper_sha256", "watchdog_service_sha256", "watchdog_sha256", "watchdog_timer_sha256"},
        "bootstrap installed proof",
    )
    for key, value in installed.items():
        _require_sha(value, length=64, label=f"bootstrap installed {key}")
    if pin.get("origins") != {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN}:
        raise RotationError("bootstrap origins are invalid")
    previous = pin.get("previous")
    if not isinstance(previous, dict):
        raise RotationError("bootstrap previous proof is invalid")
    _require_keys(
        previous,
        {"canonical_head", "deployed_commit", "live_manifest_sha256", "live_release_sha", "live_tree_sha256", "publication_input_sha256", "publication_receipt_sha256", "railway_deployment_id"},
        "bootstrap previous proof",
    )
    expected = {
        "canonical_head": BOOTSTRAP_HOST_SHA,
        "deployed_commit": BOOTSTRAP_HOST_SHA,
        "live_manifest_sha256": BOOTSTRAP_MANIFEST_SHA256,
        "live_release_sha": BOOTSTRAP_LIVE_SHA,
        "live_tree_sha256": BOOTSTRAP_TREE_SHA256,
        "publication_input_sha256": BOOTSTRAP_INPUT_SHA256,
        "publication_receipt_sha256": BOOTSTRAP_RECEIPT_SHA256,
        "railway_deployment_id": BOOTSTRAP_DEPLOYMENT_ID,
    }
    if previous != expected:
        raise RotationError("bootstrap previous proof is not the reviewed incident")
    target = pin.get("target")
    if not isinstance(target, dict):
        raise RotationError("bootstrap target is invalid")
    _require_keys(target, {"base_sha", "public_main_sha"}, "bootstrap target")
    if target["base_sha"] != target["public_main_sha"]:
        raise RotationError("bootstrap target identities differ")
    _require_sha(target["base_sha"], length=40, label="bootstrap target SHA")
    if target["base_sha"] != BOOTSTRAP_TARGET_SHA:
        raise RotationError("bootstrap target is not the immutable reviewed target")


def _validate_reference(value: Any, label: str) -> None:
    if not isinstance(value, dict):
        raise RotationError(f"{label} is invalid")
    _require_keys(value, {"bytes", "path", "sha256"}, label)
    if not isinstance(value["path"], str) or not value["path"]:
        raise RotationError(f"{label} path is invalid")
    _require_sha(value["sha256"], length=64, label=f"{label} SHA-256")
    if type(value["bytes"]) is not int or value["bytes"] < 2:
        raise RotationError(f"{label} byte count is invalid")


def _validate_v2_pin_shape(pin: dict[str, Any]) -> None:
    _require_keys(
        pin,
        {"anchor", "generation", "host", "installed", "live", "origins", "predecessor", "railway", "recorded_at", "rotation_record_path", "schema_version", "status", "target"},
        "successor publication base pin",
    )
    if pin["schema_version"] != PIN_SCHEMA or pin["status"] != "verified":
        raise RotationError("successor publication base pin identity is invalid")
    if (
        type(pin["generation"]) is not int
        or pin["generation"] < 1
        or pin["generation"] > MAX_PIN_GENERATIONS
    ):
        raise RotationError("successor publication base generation is invalid")
    _require_timestamp(pin["recorded_at"], "successor pin recorded_at")
    if not isinstance(pin["rotation_record_path"], str):
        raise RotationError("successor rotation-record path is invalid")

    anchor = pin.get("anchor")
    if not isinstance(anchor, dict):
        raise RotationError("successor anchor is invalid")
    _require_keys(anchor, {"path", "schema_version", "sha256", "target_sha"}, "successor anchor")
    if (
        anchor["schema_version"] != BOOTSTRAP_SCHEMA
        or anchor["sha256"] != BOOTSTRAP_PIN_SHA256
        or anchor["target_sha"] != BOOTSTRAP_TARGET_SHA
        or not isinstance(anchor["path"], str)
    ):
        raise RotationError("successor anchor identity is invalid")
    _require_sha(anchor["sha256"], length=64, label="successor anchor SHA-256")
    _require_sha(anchor["target_sha"], length=40, label="successor anchor target")

    predecessor = pin.get("predecessor")
    if not isinstance(predecessor, dict):
        raise RotationError("successor predecessor is invalid")
    _require_keys(predecessor, {"pin", "publication_receipt"}, "successor predecessor")
    predecessor_pin = predecessor.get("pin")
    if not isinstance(predecessor_pin, dict):
        raise RotationError("successor predecessor pin is invalid")
    _require_keys(predecessor_pin, {"generation", "path", "schema_version", "sha256", "target_sha"}, "successor predecessor pin")
    if (
        type(predecessor_pin["generation"]) is not int
        or predecessor_pin["generation"] != pin["generation"] - 1
        or predecessor_pin["schema_version"] not in {BOOTSTRAP_SCHEMA, PIN_SCHEMA}
        or not isinstance(predecessor_pin["path"], str)
    ):
        raise RotationError("successor predecessor pin identity is invalid")
    _require_sha(predecessor_pin["sha256"], length=64, label="predecessor pin SHA-256")
    _require_sha(predecessor_pin["target_sha"], length=40, label="predecessor pin target")

    receipt = predecessor.get("publication_receipt")
    if not isinstance(receipt, dict):
        raise RotationError("successor predecessor receipt is invalid")
    _require_keys(
        receipt,
        {"base_sha", "deployment_id", "host_deployed_sha", "input_sha256", "manifest_sha256", "path", "publication_base_sha256", "release_sha", "schema_version", "sha256", "tree_sha256", "wire_generated_at"},
        "successor predecessor receipt",
    )
    if receipt["schema_version"] != PUBLICATION_SCHEMA or not isinstance(receipt["path"], str):
        raise RotationError("successor predecessor receipt identity is invalid")
    for key in ("base_sha", "host_deployed_sha", "release_sha"):
        _require_sha(receipt[key], length=40, label=f"predecessor receipt {key}")
    for key in ("input_sha256", "manifest_sha256", "publication_base_sha256", "sha256", "tree_sha256"):
        _require_sha(receipt[key], length=64, label=f"predecessor receipt {key}")
    _require_uuid(receipt["deployment_id"], "predecessor receipt deployment ID")
    _require_timestamp(receipt["wire_generated_at"], "predecessor receipt wire clock")

    host = pin.get("host")
    if not isinstance(host, dict):
        raise RotationError("successor host proof is invalid")
    _require_keys(host, {"canonical_head", "deployed_commit"}, "successor host proof")
    for key in host:
        _require_sha(host[key], length=40, label=f"successor host {key}")

    installed = pin.get("installed")
    if not isinstance(installed, dict):
        raise RotationError("successor installed proof is invalid")
    _require_keys(
        installed,
        SUCCESSOR_INSTALLED_KEYS,
        "successor installed proof",
    )
    for key, value in installed.items():
        _require_sha(value, length=64, label=f"successor installed {key}")

    if pin.get("origins") != {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN}:
        raise RotationError("successor origins are invalid")
    live = pin.get("live")
    if not isinstance(live, dict):
        raise RotationError("successor live proof is invalid")
    _require_keys(live, {"file_count", "provider_manifest", "public_manifest", "release_sha", "total_bytes", "tree_sha256"}, "successor live proof")
    _validate_reference(live["provider_manifest"], "provider manifest reference")
    _validate_reference(live["public_manifest"], "public manifest reference")
    _require_sha(live["release_sha"], length=40, label="successor live release")
    _require_sha(live["tree_sha256"], length=64, label="successor live tree")
    if any(type(live[key]) is not int or live[key] < 1 for key in ("file_count", "total_bytes")):
        raise RotationError("successor live counts are invalid")

    railway = pin.get("railway")
    if not isinstance(railway, dict):
        raise RotationError("successor Railway proof is invalid")
    _require_keys(railway, {"created_at", "deployment_id", "environment_id", "image_digest", "project_id", "reason", "service_id", "topology"}, "successor Railway proof")
    for key in ("deployment_id", "environment_id", "project_id", "service_id"):
        _require_uuid(railway[key], f"successor Railway {key}")
    if not isinstance(railway["image_digest"], str) or IMAGE.fullmatch(railway["image_digest"]) is None:
        raise RotationError("successor Railway image digest is invalid")
    if railway["reason"] not in {"deploy", "deploymentRollback", "rollback"}:
        raise RotationError("successor Railway reason is invalid")
    _require_timestamp(railway["created_at"], "successor Railway created_at")
    _validate_reference(railway["topology"], "Railway topology reference")

    target = pin.get("target")
    if not isinstance(target, dict):
        raise RotationError("successor target is invalid")
    _require_keys(target, {"base_sha", "public_main_sha"}, "successor target")
    if target["base_sha"] != target["public_main_sha"]:
        raise RotationError("successor target identities differ")
    _require_sha(target["base_sha"], length=40, label="successor target SHA")


def _validate_publication_receipt(receipt: dict[str, Any]) -> None:
    _require_keys(
        receipt,
        {"base_sha", "candidate", "github_actions_used", "host_deployed_sha", "input_sha256", "live_manifest", "origins", "predecessor", "publication_base", "railway", "recorded_at", "release_bundle", "release_sha", "schema_version", "status", "wire_generated_at"},
        "publication receipt",
    )
    if (
        receipt["schema_version"] != PUBLICATION_SCHEMA
        or receipt["status"] != "verified"
        or receipt["github_actions_used"] is not False
        or receipt["origins"] != {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN}
    ):
        raise RotationError("publication receipt identity is invalid")
    _require_timestamp(receipt["recorded_at"], "publication receipt recorded_at")
    _require_timestamp(receipt["wire_generated_at"], "publication receipt wire clock")
    for key in ("base_sha", "host_deployed_sha", "release_sha"):
        _require_sha(receipt[key], length=40, label=f"publication receipt {key}")
    _require_sha(receipt["input_sha256"], length=64, label="publication receipt input")
    publication_base = receipt.get("publication_base")
    if not isinstance(publication_base, dict):
        raise RotationError("publication receipt base proof is invalid")
    _require_keys(publication_base, {"kind", "path", "sha256", "target_sha"}, "publication receipt base proof")
    if not isinstance(publication_base["kind"], str) or not isinstance(publication_base["path"], str):
        raise RotationError("publication receipt base proof is invalid")
    _require_sha(publication_base["sha256"], length=64, label="publication receipt base-pin SHA-256")
    _require_sha(publication_base["target_sha"], length=40, label="publication receipt base target")
    live = receipt.get("live_manifest")
    if not isinstance(live, dict):
        raise RotationError("publication receipt live manifest is invalid")
    _require_keys(live, {"bytes", "file_count", "path", "sha256", "total_bytes", "tree_sha256"}, "publication receipt live manifest")
    if not isinstance(live["path"], str):
        raise RotationError("publication receipt live manifest path is invalid")
    for key in ("bytes", "file_count", "total_bytes"):
        if type(live[key]) is not int or live[key] < 1:
            raise RotationError("publication receipt live manifest counts are invalid")
    for key in ("sha256", "tree_sha256"):
        _require_sha(live[key], length=64, label=f"publication receipt live {key}")
    railway = receipt.get("railway")
    if not isinstance(railway, dict):
        raise RotationError("publication receipt Railway proof is invalid")
    _require_keys(railway, {"deployment_id", "status"}, "publication receipt Railway proof")
    _require_uuid(railway["deployment_id"], "publication receipt deployment ID")
    if railway["status"] != "SUCCESS":
        raise RotationError("publication receipt Railway deployment is not successful")
    for key, expected in (
        ("candidate", {"archive_path", "journal_sha256", "message"}),
        ("predecessor", {"archive_path", "base_sha", "deployment_id", "input_sha256", "manifest_sha256", "receipt_sha256", "release_sha", "schema_version", "tree_sha256", "wire_generated_at"}),
        ("release_bundle", {"base_sha", "bytes", "metadata_path", "metadata_sha256", "path", "release_sha", "schema_version", "sha256"}),
    ):
        value = receipt.get(key)
        if not isinstance(value, dict):
            raise RotationError(f"publication receipt {key} proof is invalid")
        _require_keys(value, expected, f"publication receipt {key} proof")


def _validate_manifest(raw: bytes, *, receipt: dict[str, Any]) -> dict[str, Any]:
    manifest = _strict_json(raw, "live release manifest")
    _require_keys(
        manifest,
        {"built_at", "critical_files", "deployment_source", "file_count", "github_required", "schema_version", "source_commit", "state", "total_bytes", "tree_sha256"},
        "live release manifest",
    )
    live = receipt["live_manifest"]
    if (
        manifest["schema_version"] != "palimpsest.railway-static-release.v1"
        or manifest["state"] != "artifact_ready"
        or manifest["deployment_source"] != "local-git-archive"
        or manifest["github_required"] is not False
        or manifest["source_commit"] != receipt["release_sha"]
        or manifest["tree_sha256"] != live["tree_sha256"]
        or manifest["file_count"] != live["file_count"]
        or manifest["total_bytes"] != live["total_bytes"]
        or not isinstance(manifest["critical_files"], dict)
        or not manifest["critical_files"]
    ):
        raise RotationError("live release manifest differs from the publication receipt")
    _require_timestamp(manifest["built_at"], "live release built_at")
    if _sha256(raw) != live["sha256"] or len(raw) != live["bytes"]:
        raise RotationError("live release manifest bytes differ from the publication receipt")
    return manifest


def _manifest_url(origin: str, nonce: int) -> str:
    parsed = urllib.parse.urlsplit(origin)
    if (
        parsed.scheme != "https"
        or not parsed.hostname
        or parsed.username is not None
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
        or parsed.path not in {"", "/"}
    ):
        raise RotationError("live origin is not an exact HTTPS origin")
    return origin.rstrip("/") + f"/railway-release.json?base_rotation={nonce}"


def _fetch_manifest(origin: str, nonce: int) -> bytes:
    url = _manifest_url(origin, nonce)
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "Cache-Control": "no-cache, no-store",
            "User-Agent": "palimpsest-base-rotation/2",
        },
    )
    opener = urllib.request.build_opener(_NoRedirect())
    try:
        with opener.open(request, timeout=30) as response:
            if response.status != 200 or response.geturl() != url:
                raise RotationError(f"live manifest response is not exact for {origin}")
            declared = response.headers.get("Content-Length")
            if declared is not None and int(declared) > MAX_MANIFEST_BYTES:
                raise RotationError(f"live manifest is too large for {origin}")
            raw = response.read(MAX_MANIFEST_BYTES + 1)
    except (OSError, ValueError, urllib.error.URLError) as exc:
        if isinstance(exc, RotationError):
            raise
        raise RotationError(f"cannot fetch live manifest from {origin}") from exc
    if len(raw) > MAX_MANIFEST_BYTES:
        raise RotationError(f"live manifest is too large for {origin}")
    return raw


def _edges(value: Any, label: str) -> list[dict[str, Any]]:
    if not isinstance(value, dict) or set(value) != {"edges"}:
        raise RotationError(f"Railway {label} edge inventory is invalid")
    edges = value.get("edges")
    if not isinstance(edges, list) or len(edges) > 100:
        raise RotationError(f"Railway {label} edge inventory is invalid")
    if any(not isinstance(row, dict) or not isinstance(row.get("node"), dict) for row in edges):
        raise RotationError(f"Railway {label} edge inventory is invalid")
    return edges


def _one_node(edges: list[dict[str, Any]], *, key: str, expected: str, label: str) -> dict[str, Any]:
    matches = [row["node"] for row in edges if row["node"].get(key) == expected]
    if len(matches) != 1:
        raise RotationError(f"Railway status lacks one exact {label}")
    return matches[0]


def _validate_topology(
    raw: bytes,
    *,
    project_id: str,
    environment_id: str,
    service_id: str,
    deployment_id: str,
) -> dict[str, str]:
    topology = _strict_json(raw, "Railway status topology")
    if topology.get("id") != project_id:
        raise RotationError("Railway project identity differs")
    service = _one_node(_edges(topology.get("services"), "services"), key="id", expected=service_id, label="service")
    if service.get("name") != EXPECTED_SERVICE_NAME:
        raise RotationError("Railway service name differs")
    environment = _one_node(_edges(topology.get("environments"), "environments"), key="id", expected=environment_id, label="environment")
    if environment.get("deletedAt") is not None or environment.get("canAccess") is not True:
        raise RotationError("Railway environment is unavailable")
    if _edges(environment.get("volumeInstances"), "volume instances"):
        raise RotationError("Railway publication service unexpectedly has a volume")
    instance = _one_node(_edges(environment.get("serviceInstances"), "service instances"), key="serviceId", expected=service_id, label="service instance")
    if (
        instance.get("environmentId") != environment_id
        or instance.get("serviceName") != EXPECTED_SERVICE_NAME
    ):
        raise RotationError("Railway service instance identity differs")
    if "source" not in instance:
        raise RotationError("Railway publication source field is missing")
    source = instance["source"]
    if source is not None and source != {"image": None, "repo": None}:
        raise RotationError("Railway publication source attachment is unsafe")
    if (
        "cronSchedule" not in instance
        or "nextCronRunAt" not in instance
        or instance["cronSchedule"] is not None
        or instance["nextCronRunAt"] is not None
    ):
        raise RotationError("Railway publication service unexpectedly has cron")
    latest = instance.get("latestDeployment")
    if not isinstance(latest, dict) or latest.get("id") != deployment_id or latest.get("status") != "SUCCESS" or latest.get("deploymentStopped") is not False:
        raise RotationError("Railway active deployment identity differs")
    running = latest.get("instances")
    if (
        not isinstance(running, list)
        or len(running) != 1
        or not isinstance(running[0], dict)
        or running[0].get("status") != "RUNNING"
    ):
        raise RotationError("Railway active deployment is not singular and running")
    metadata = latest.get("meta")
    if not isinstance(metadata, dict) or metadata.get("buildOnly") is not False:
        raise RotationError("Railway active deployment metadata is invalid")
    reason = metadata.get("reason")
    image = metadata.get("imageDigest")
    if reason not in {"deploy", "deploymentRollback", "rollback"} or not isinstance(image, str) or IMAGE.fullmatch(image) is None or metadata.get("volumeMounts") != []:
        raise RotationError("Railway active deployment image or reason is invalid")
    manifest = metadata.get("serviceManifest")
    if not isinstance(manifest, dict) or not isinstance(manifest.get("build"), dict) or not isinstance(manifest.get("deploy"), dict):
        raise RotationError("Railway active service manifest is invalid")
    build = manifest["build"]
    deploy = manifest["deploy"]
    if build.get("builder") != "DOCKERFILE" or build.get("dockerfilePath") != "ops/railway/Dockerfile.static":
        raise RotationError("Railway active build topology is invalid")
    if (
        deploy.get("healthcheckPath") != "/healthz"
        or deploy.get("numReplicas") != 1
        or "cronSchedule" not in deploy
        or deploy["cronSchedule"] is not None
        or "requiredMountPath" not in deploy
        or deploy["requiredMountPath"] is not None
    ):
        raise RotationError("Railway active deployment topology is invalid")
    created_at = _require_timestamp(latest.get("createdAt"), "Railway deployment createdAt")
    return {"created_at": created_at, "image_digest": image, "reason": reason}


def _railway_status(args: argparse.Namespace) -> bytes:
    token_rows = [(key, os.environ.get(key, "")) for key in ("RAILWAY_TOKEN", "RAILWAY_API_TOKEN")]
    configured = [(key, value) for key, value in token_rows if value]
    if len(configured) != 1:
        raise RotationError("exactly one Railway automation token is required")
    token_name, token_value = configured[0]
    result = _run(
        [str(args.railway_bin), "status", "--project", args.project_id, "--environment", args.environment_id, "--json"],
        environment={token_name: token_value, "NODE_OPTIONS": args.railway_node_options},
        text=False,
    )
    raw = result.stdout
    if not isinstance(raw, bytes) or len(raw) > MAX_TOPOLOGY_BYTES:
        raise RotationError("Railway status topology is too large")
    return raw


def _current_pin_identity(pin: dict[str, Any]) -> tuple[int, str, str, str]:
    if pin.get("schema_version") == BOOTSTRAP_SCHEMA:
        _validate_bootstrap_pin(pin)
        return (
            0,
            pin["target"]["base_sha"],
            pin["previous"]["canonical_head"],
            pin["previous"]["deployed_commit"],
        )
    _validate_v2_pin_shape(pin)
    return (
        pin["generation"],
        pin["target"]["base_sha"],
        pin["host"]["canonical_head"],
        pin["host"]["deployed_commit"],
    )


def _archive_path(root: Path, category: str, digest: str, *, origin: str | None = None) -> Path:
    if origin is not None:
        return root / category / origin / f"{digest}.json"
    return root / category / f"{digest}.json"


def _validate_archive(path: Path, *, expected: Path, digest: str, group_gid: int, max_bytes: int) -> bytes:
    if path != expected:
        raise RotationError("history reference is outside its canonical content-addressed path")
    _validate_file(path, uid=0, gid=group_gid, mode=0o640, label=f"history evidence {path}")
    raw = _read_regular(path, max_bytes=max_bytes)
    if _sha256(raw) != digest:
        raise RotationError(f"history evidence digest differs: {path}")
    return raw


def _validate_v2_pin_archives_once(
    pin: dict[str, Any],
    raw: bytes,
    *,
    history_root: Path,
    group_gid: int,
) -> tuple[dict[str, Any], bytes] | None:
    _validate_v2_pin_shape(pin)
    anchor = pin["anchor"]
    anchor_path = Path(anchor["path"])
    anchor_raw = _validate_archive(anchor_path, expected=_archive_path(history_root, "pins", anchor["sha256"]), digest=anchor["sha256"], group_gid=group_gid, max_bytes=MAX_PIN_BYTES)
    anchor_pin = _strict_json(anchor_raw, "archived bootstrap pin")
    _validate_bootstrap_pin(anchor_pin)
    if anchor_pin["target"]["base_sha"] != anchor["target_sha"]:
        raise RotationError("archived bootstrap pin target differs")

    predecessor_pin = pin["predecessor"]["pin"]
    predecessor_raw = _validate_archive(Path(predecessor_pin["path"]), expected=_archive_path(history_root, "pins", predecessor_pin["sha256"]), digest=predecessor_pin["sha256"], group_gid=group_gid, max_bytes=MAX_PIN_BYTES)
    predecessor_document = _strict_json(predecessor_raw, "archived predecessor pin")
    predecessor_generation, predecessor_target, _, _ = _current_pin_identity(predecessor_document)
    if predecessor_generation != predecessor_pin["generation"] or predecessor_target != predecessor_pin["target_sha"]:
        raise RotationError("archived predecessor pin identity differs")
    if predecessor_generation == 0:
        if predecessor_pin != {
            "generation": 0,
            "path": anchor["path"],
            "schema_version": BOOTSTRAP_SCHEMA,
            "sha256": anchor["sha256"],
            "target_sha": anchor["target_sha"],
        }:
            raise RotationError("successor predecessor is not the immutable bootstrap anchor")
    elif predecessor_document["anchor"] != anchor:
        raise RotationError("successor pin changed the immutable bootstrap anchor")

    receipt_ref = pin["predecessor"]["publication_receipt"]
    receipt_raw = _validate_archive(Path(receipt_ref["path"]), expected=_archive_path(history_root, "receipts", receipt_ref["sha256"]), digest=receipt_ref["sha256"], group_gid=group_gid, max_bytes=MAX_RECEIPT_BYTES)
    receipt = _strict_json(receipt_raw, "archived predecessor publication receipt")
    _validate_publication_receipt(receipt)
    receipt_expected = {
        "base_sha": receipt["base_sha"],
        "deployment_id": receipt["railway"]["deployment_id"],
        "host_deployed_sha": receipt["host_deployed_sha"],
        "input_sha256": receipt["input_sha256"],
        "manifest_sha256": receipt["live_manifest"]["sha256"],
        "path": str(receipt_ref["path"]),
        "publication_base_sha256": receipt["publication_base"]["sha256"],
        "release_sha": receipt["release_sha"],
        "schema_version": receipt["schema_version"],
        "sha256": _sha256(receipt_raw),
        "tree_sha256": receipt["live_manifest"]["tree_sha256"],
        "wire_generated_at": receipt["wire_generated_at"],
    }
    if receipt_ref != receipt_expected:
        raise RotationError("archived predecessor receipt projection differs")

    for origin in ("provider", "public"):
        reference = pin["live"][f"{origin}_manifest"]
        archived = _validate_archive(Path(reference["path"]), expected=_archive_path(history_root, "manifests", reference["sha256"], origin=origin), digest=reference["sha256"], group_gid=group_gid, max_bytes=MAX_MANIFEST_BYTES)
        if len(archived) != reference["bytes"]:
            raise RotationError("archived manifest byte count differs")
    topology = pin["railway"]["topology"]
    archived_topology = _validate_archive(Path(topology["path"]), expected=_archive_path(history_root, "topologies", topology["sha256"]), digest=topology["sha256"], group_gid=group_gid, max_bytes=MAX_TOPOLOGY_BYTES)
    if len(archived_topology) != topology["bytes"]:
        raise RotationError("archived topology byte count differs")

    record_path = Path(pin["rotation_record_path"])
    expected_record = history_root / "rotations" / f"{pin['generation']}-{pin['target']['base_sha']}-{receipt_ref['sha256']}.json"
    _validate_file(record_path, uid=0, gid=group_gid, mode=0o640, label="rotation record")
    if record_path != expected_record:
        raise RotationError("rotation record path is not canonical")
    record = _strict_json(_read_regular(record_path, max_bytes=2 * MAX_PIN_BYTES), "rotation record")
    _require_keys(record, {"generation", "next_pin", "next_pin_sha256", "predecessor_pin_sha256", "predecessor_receipt_sha256", "recorded_at", "schema_version", "status", "target_base_sha"}, "rotation record")
    if (
        record["schema_version"] != ROTATION_SCHEMA
        or record["status"] != "verified"
        or record["generation"] != pin["generation"]
        or record["recorded_at"] != pin["recorded_at"]
        or record["target_base_sha"] != pin["target"]["base_sha"]
        or record["predecessor_pin_sha256"] != predecessor_pin["sha256"]
        or record["predecessor_receipt_sha256"] != receipt_ref["sha256"]
        or record["next_pin"] != pin
        or record["next_pin_sha256"] != _sha256(raw)
    ):
        raise RotationError("append-only rotation record differs from the active pin")
    if predecessor_generation == 0:
        return None
    return predecessor_document, predecessor_raw


def _validate_v2_pin_archives(
    pin: dict[str, Any],
    raw: bytes,
    *,
    history_root: Path,
    group_gid: int,
) -> dict[str, dict[str, Any]]:
    current_pin = pin
    current_raw = raw
    seen: set[str] = set()
    authenticated: dict[str, dict[str, Any]] = {}
    traversed = 0
    while True:
        digest = _sha256(current_raw)
        if digest in seen:
            raise RotationError("successor publication-base lineage contains a cycle")
        seen.add(digest)
        authenticated[digest] = current_pin
        traversed += 1
        if traversed > MAX_PIN_GENERATIONS:
            raise RotationError("successor publication-base lineage is too deep")
        predecessor = _validate_v2_pin_archives_once(
            current_pin,
            current_raw,
            history_root=history_root,
            group_gid=group_gid,
        )
        if predecessor is None:
            return authenticated
        current_pin, current_raw = predecessor


def _receipt_matches_pin(
    receipt: dict[str, Any],
    *,
    pin_path: Path,
    pin_sha256: str,
    pin_kind: str,
    base_sha: str,
    host_deployed_sha: str,
) -> None:
    if (
        receipt["base_sha"] != base_sha
        or receipt["publication_base"] != {
            "kind": pin_kind,
            "path": str(pin_path),
            "sha256": pin_sha256,
            "target_sha": base_sha,
        }
        or receipt["host_deployed_sha"] != host_deployed_sha
    ):
        raise RotationError("latest v2 publication receipt does not match the current base pin")


def _receipt_matches_bridge(
    receipt: dict[str, Any], raw: bytes, *, pin: dict[str, Any]
) -> None:
    reference = pin["predecessor"]["publication_receipt"]
    projected = {
        "base_sha": receipt["base_sha"],
        "deployment_id": receipt["railway"]["deployment_id"],
        "host_deployed_sha": receipt["host_deployed_sha"],
        "input_sha256": receipt["input_sha256"],
        "manifest_sha256": receipt["live_manifest"]["sha256"],
        "path": reference["path"],
        "publication_base_sha256": receipt["publication_base"]["sha256"],
        "release_sha": receipt["release_sha"],
        "schema_version": receipt["schema_version"],
        "sha256": _sha256(raw),
        "tree_sha256": receipt["live_manifest"]["tree_sha256"],
        "wire_generated_at": receipt["wire_generated_at"],
    }
    if projected != reference:
        raise RotationError("latest receipt is not the exact successor-pin bridge")
    archived = _read_regular(Path(reference["path"]), max_bytes=MAX_RECEIPT_BYTES)
    if archived != raw:
        raise RotationError("latest bridge receipt differs from its root-owned archive")


def _validate_unpublished_chain_bridge(
    receipt: dict[str, Any],
    raw: bytes,
    *,
    pin: dict[str, Any],
    authenticated_pins: dict[str, dict[str, Any]],
) -> None:
    """Bind every unpublished pin to the same last published ancestor."""

    _receipt_matches_bridge(receipt, raw, pin=pin)
    publication_base = receipt["publication_base"]
    published_digest = publication_base["sha256"]
    published_pin = authenticated_pins.get(published_digest)
    if published_pin is None:
        raise RotationError(
            "unpublished-chain receipt pin is outside the authenticated lineage"
        )
    if published_pin.get("schema_version") == BOOTSTRAP_SCHEMA:
        published_generation = 0
        published_target = published_pin.get("target", {}).get("base_sha")
    else:
        published_generation = published_pin.get("generation")
        published_target = published_pin.get("target", {}).get("base_sha")
    current_generation = pin["generation"]
    if (
        type(published_generation) is not int
        or published_generation >= current_generation
        or receipt["base_sha"] != published_target
        or publication_base["target_sha"] != published_target
    ):
        raise RotationError(
            "unpublished-chain recovery is not bound to an older published pin"
        )
    bridge = pin["predecessor"]["publication_receipt"]
    for candidate in authenticated_pins.values():
        if candidate.get("schema_version") != PIN_SCHEMA:
            continue
        candidate_generation = candidate.get("generation")
        if (
            type(candidate_generation) is int
            and published_generation < candidate_generation <= current_generation
            and candidate.get("predecessor", {}).get("publication_receipt") != bridge
        ):
            raise RotationError(
                "unpublished-chain pins do not retain one exact bridge receipt"
            )


def _validate_completed_receipt(
    receipt: dict[str, Any],
    raw: bytes,
    *,
    pin: dict[str, Any],
    pin_path: Path,
    pin_sha256: str,
) -> None:
    try:
        _receipt_matches_pin(
            receipt,
            pin_path=pin_path,
            pin_sha256=pin_sha256,
            pin_kind="verified_successor",
            base_sha=pin["target"]["base_sha"],
            host_deployed_sha=pin["host"]["deployed_commit"],
        )
    except RotationError:
        _receipt_matches_bridge(receipt, raw, pin=pin)


