    && -f "$destination" && ! -L "$destination" ]] || {
    log "readings ledger overlay is not a regular-file pair" >&2
    return 1
  }
  source_bytes="$(stat -c '%s' "$source")"
  destination_bytes="$(stat -c '%s' "$destination")"
  [[ "$source_bytes" =~ ^[1-9][0-9]*$ \
    && "$destination_bytes" =~ ^[1-9][0-9]*$ ]] || {
    log "readings ledger overlay contains an empty or invalid file" >&2
    return 1
  }
  if cmp -s "$source" "$destination"; then
    log "readings ledger overlay is already byte-identical"
  elif (( source_bytes > destination_bytes )) \
    && cmp -n "$destination_bytes" "$destination" "$source"; then
    cp -p "$source" "$destination"
    log "admitted the host readings-ledger strict extension"
  elif (( destination_bytes > source_bytes )) \
    && cmp -n "$source_bytes" "$source" "$destination"; then
    log "retained the target readings-ledger over its host strict prefix"
  else
    log "readings ledger overlay diverges from the reviewed target chain" >&2
    return 1
  fi
}

