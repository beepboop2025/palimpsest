def _exact_text(value: str, *, label: str) -> str:
    lines = value.splitlines()
    if len(lines) != 1 or lines[0] != lines[0].strip() or not lines[0]:
        raise RestoreError(f"{label} is not one exact non-empty line")
    return lines[0]


