#!/usr/bin/env bash
# Build and publish one rights-clean Palimpsest edition from the newest
# Hetzner evidence wire. This path deliberately does not use GitHub Actions.

set -Eeuo pipefail
umask 077

# Repository-controlled builders never inherit caller Git configuration.  A
# shell function keeps every Git invocation on the same replacement-free,
# prompt-free configuration without relying on the ambient process.
git() {
  /usr/bin/env -i \
    PATH=/usr/bin:/bin \
    HOME=/nonexistent \
    LANG=C.UTF-8 \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_SYSTEM=/dev/null \
    GIT_NO_REPLACE_OBJECTS=1 \
    GIT_TERMINAL_PROMPT=0 \
    /usr/bin/git "$@"
}

