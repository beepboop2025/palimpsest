        "event_analysis_service_sha256": (
            config.installed_event_analysis_service,
            0o644,
        ),
        "event_analysis_wrapper_sha256": (
            config.installed_event_analysis_wrapper,
            0o755,
        ),
        "publisher_sha256": (config.installed_publisher, 0o755),
        "transition_helper_sha256": (config.installed_transition_helper, 0o755),
        "rotation_helper_sha256": (config.installed_rotation_helper, 0o755),
        "reconciler_sha256": (config.installed_reconciler, 0o755),
        "watchdog_sha256": (config.installed_watchdog, 0o755),
        "publisher_service_sha256": (config.installed_publisher_service, 0o644),
        "watchdog_service_sha256": (config.installed_watchdog_service, 0o644),
        "watchdog_timer_sha256": (config.installed_watchdog_timer, 0o644),
    }
    _exact(installed, set(paths), "publication-base installed proof")
    for key, (path, mode) in paths.items():
        expected = _sha(installed.get(key), f"publication-base installed {key}")
        raw = _read_regular(
            path,
            label=f"installed publication artifact {path}",
            uid=0,
            gid=0,
            mode=mode,
            maximum=4 * 1024 * 1024,
        )
        if hashlib.sha256(raw).hexdigest() != expected:
            raise LiveAnalysisError(f"installed publication artifact changed: {path}")


def _read_history_artifact(
    config: RuntimeConfig,
    *,
    history_root: Path,
    category: str,
    digest: str,
    claimed_path: Any,
    label: str,
    maximum: int = MAX_HISTORY_BYTES,
    origin: str | None = None,
) -> bytes:
    parent = history_root / category
    if origin is not None:
        if origin not in {"provider", "public"}:
            raise LiveAnalysisError(f"{label} origin is invalid")
        parent /= origin
    expected = parent / f"{digest}.json"
    if claimed_path != str(expected):
        raise LiveAnalysisError(f"{label} path is not content-addressed")
    raw = _read_regular(
        expected,
        label=label,
        uid=config.pin_uid,
        gid=os.getegid() if config.pin_gid < 0 else config.pin_gid,
        mode=0o640,
        maximum=maximum,
    )
    if hashlib.sha256(raw).hexdigest() != digest:
        raise LiveAnalysisError(f"{label} digest changed")
    return raw


def _sha(value: Any, label: str) -> str:
    if type(value) is not str or SHA256.fullmatch(value) is None:
        raise LiveAnalysisError(f"{label} is not a SHA-256 digest")
    return value


def _sha40(value: Any, label: str) -> str:
    if type(value) is not str or SHA40.fullmatch(value) is None:
        raise LiveAnalysisError(f"{label} is not a commit SHA")
    return value


def _validate_legacy_pin(
    raw: bytes, *, expected_sha256: str, expected_target_sha: str
) -> dict[str, Any]:
    if hashlib.sha256(raw).hexdigest() != expected_sha256:
        raise LiveAnalysisError("publication-base pin hash is not the reviewed hash")
    pin = _strict_object(raw, "publication-base pin")
    _exact(
        pin,
        {
            "incident_id",
            "installed",
            "origins",
            "previous",
            "recorded_at",
            "schema_version",
            "status",
            "target",
        },
        "publication-base pin",
    )
    if (
        pin["schema_version"] != PIN_SCHEMA
        or pin["status"] != "verified"
        or pin["incident_id"] != INCIDENT_ID
        or type(pin["recorded_at"]) is not str
        or TIMESTAMP.fullmatch(pin["recorded_at"]) is None
    ):
        raise LiveAnalysisError("publication-base pin identity is invalid")

    installed = pin.get("installed")
    origins = pin.get("origins")
    previous = pin.get("previous")
    target = pin.get("target")
    if not all(type(value) is dict for value in (installed, origins, previous, target)):
        raise LiveAnalysisError("publication-base pin proof objects are invalid")
    assert isinstance(installed, dict)
    assert isinstance(origins, dict)
    assert isinstance(previous, dict)
    assert isinstance(target, dict)

    installed_keys = {
        "publisher_service_sha256",
        "publisher_sha256",
        "reconciler_sha256",
        "transition_helper_sha256",
        "watchdog_service_sha256",
        "watchdog_sha256",
        "watchdog_timer_sha256",
    }
    _exact(installed, installed_keys, "publication-base installed proof")
    for key in installed_keys:
        _sha(installed[key], f"publication-base installed {key}")
    _exact(origins, {"provider", "public"}, "publication-base origins")
    if origins != {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN}:
        raise LiveAnalysisError("publication-base origins are not canonical")

    _exact(
        previous,
        {
            "canonical_head",
            "deployed_commit",
            "live_manifest_sha256",
            "live_release_sha",
            "live_tree_sha256",
            "publication_input_sha256",
            "publication_receipt_sha256",
            "railway_deployment_id",
        },
        "publication-base predecessor",
    )
    expected_previous = {
        "canonical_head": INCIDENT_BASE_SHA,
        "deployed_commit": INCIDENT_BASE_SHA,
        "live_manifest_sha256": INCIDENT_MANIFEST_SHA256,
        "live_release_sha": INCIDENT_LIVE_SHA,
        "live_tree_sha256": INCIDENT_TREE_SHA256,
        "publication_input_sha256": INCIDENT_INPUT_SHA256,
        "publication_receipt_sha256": INCIDENT_RECEIPT_SHA256,
        "railway_deployment_id": INCIDENT_DEPLOYMENT_ID,
    }
    if previous != expected_previous:
        raise LiveAnalysisError("publication-base predecessor is not the incident")
    _exact(target, {"base_sha", "public_main_sha"}, "publication-base target")
    target_sha = _sha40(target.get("base_sha"), "publication-base target")
    if (
        target_sha != expected_target_sha
        or target.get("public_main_sha") != target_sha
    ):
        raise LiveAnalysisError("publication-base target is not the reviewed public main")
    return pin


def _validate_manifest_history_proof(
    config: RuntimeConfig,
    proof: Any,
    *,
    history_root: Path,
    release_sha: str,
    tree_sha256: str,
    file_count: int,
    total_bytes: int,
    label: str,
    origin: str,
) -> bytes:
    if type(proof) is not dict:
        raise LiveAnalysisError(f"{label} proof is invalid")
    assert isinstance(proof, dict)
    _exact(proof, {"bytes", "path", "sha256"}, f"{label} proof")
    digest = _sha(proof.get("sha256"), f"{label} digest")
    byte_count = proof.get("bytes")
    if type(byte_count) is not int or byte_count < 1:
        raise LiveAnalysisError(f"{label} byte count is invalid")
    raw = _read_history_artifact(
        config,
        history_root=history_root,
        category="manifests",
        digest=digest,
        claimed_path=proof.get("path"),
        label=label,
        origin=origin,
    )
    if len(raw) != byte_count:
        raise LiveAnalysisError(f"{label} byte count changed")
    manifest = _strict_object(raw, label)
    if (
        manifest.get("schema_version")
        != "palimpsest.railway-static-release.v1"
        or manifest.get("state") != "artifact_ready"
        or manifest.get("source_commit") != release_sha
        or manifest.get("tree_sha256") != tree_sha256
        or manifest.get("file_count") != file_count
        or manifest.get("total_bytes") != total_bytes
        or manifest.get("deployment_source") != "local-git-archive"
        or manifest.get("github_required") is not False
    ):
        raise LiveAnalysisError(f"{label} identity is invalid")
    return raw


def _topology_edges(value: Any, label: str) -> list[dict[str, Any]]:
    if type(value) is not dict or set(value) != {"edges"}:
        raise LiveAnalysisError(f"rotation topology {label} is invalid")
    rows = value.get("edges")
    if type(rows) is not list or len(rows) > 100:
        raise LiveAnalysisError(f"rotation topology {label} is invalid")
    nodes: list[dict[str, Any]] = []
    for row in rows:
        node = row.get("node") if type(row) is dict else None
        if type(node) is not dict:
            raise LiveAnalysisError(f"rotation topology {label} is invalid")
        nodes.append(node)
    return nodes


def _one_topology_node(
    rows: list[dict[str, Any]], *, key: str, expected: str, label: str
) -> dict[str, Any]:
    matches = [row for row in rows if row.get(key) == expected]
    if len(matches) != 1:
        raise LiveAnalysisError(f"rotation topology {label} is not singular")
    return matches[0]


def _validate_rotation_topology(
    config: RuntimeConfig,
    railway: Any,
    *,
    history_root: Path,
    expected_deployment_id: str,
) -> None:
    if type(railway) is not dict:
        raise LiveAnalysisError("publication-base Railway proof is invalid")
    assert isinstance(railway, dict)
    _exact(
        railway,
        {
            "created_at",
            "deployment_id",
            "environment_id",
            "image_digest",
            "project_id",
            "reason",
            "service_id",
            "topology",
        },
        "publication-base Railway proof",
    )
    for key in ("project_id", "environment_id", "service_id", "deployment_id"):
        value = railway.get(key)
        if type(value) is not str or UUID.fullmatch(value) is None:
            raise LiveAnalysisError(f"publication-base Railway {key} is invalid")
    if railway["deployment_id"] != expected_deployment_id:
        raise LiveAnalysisError("publication-base Railway deployment changed")
    if (
        type(railway.get("image_digest")) is not str
        or re.fullmatch(r"sha256:[0-9a-f]{64}", railway["image_digest"]) is None
        or railway.get("reason") not in {"deploy", "deploymentRollback"}
        or type(railway.get("created_at")) is not str
        or len(railway["created_at"]) > 64
    ):
        raise LiveAnalysisError("publication-base Railway metadata is invalid")
    topology = railway.get("topology")
    if type(topology) is not dict:
        raise LiveAnalysisError("publication-base topology proof is invalid")
    assert isinstance(topology, dict)
    _exact(topology, {"bytes", "path", "sha256"}, "publication-base topology")
    digest = _sha(topology.get("sha256"), "publication-base topology digest")
    byte_count = topology.get("bytes")
    if type(byte_count) is not int or byte_count < 1:
        raise LiveAnalysisError("publication-base topology byte count is invalid")
    raw = _read_history_artifact(
        config,
        history_root=history_root,
        category="topologies",
        digest=digest,
        claimed_path=topology.get("path"),
        label="publication-base topology",
        maximum=2 * 1024 * 1024,
    )
    if len(raw) != byte_count:
        raise LiveAnalysisError("publication-base topology byte count changed")
    document = _strict_object(raw, "publication-base topology")
    if document.get("id") != railway["project_id"]:
        raise LiveAnalysisError("publication-base topology project changed")
    service = _one_topology_node(
        _topology_edges(document.get("services"), "services"),
        key="id",
        expected=railway["service_id"],
        label="service",
    )
    if service.get("name") != "palimpsest-publication":
        raise LiveAnalysisError("publication-base topology service changed")
    environment = _one_topology_node(
        _topology_edges(document.get("environments"), "environments"),
        key="id",
        expected=railway["environment_id"],
        label="environment",
    )
    instance = _one_topology_node(
        _topology_edges(environment.get("serviceInstances"), "instances"),
        key="serviceId",
        expected=railway["service_id"],
        label="service instance",
    )
    latest = instance.get("latestDeployment")
    metadata = latest.get("meta") if type(latest) is dict else None
    if (
        type(latest) is not dict
        or latest.get("id") != railway["deployment_id"]
        or latest.get("status") != "SUCCESS"
        or latest.get("createdAt") != railway["created_at"]
        or type(metadata) is not dict
        or metadata.get("imageDigest") != railway["image_digest"]
        or metadata.get("reason") != railway["reason"]
    ):
        raise LiveAnalysisError("publication-base topology deployment changed")


def _validate_archived_publication_receipt(
    config: RuntimeConfig,
    proof: Any,
    *,
    history_root: Path,
    predecessor_pin_sha256: str,
    predecessor_pin_schema: str,
    predecessor_target_sha: str,
    expected_host_sha: str,
) -> tuple[dict[str, Any], bytes]:
    if type(proof) is not dict:
        raise LiveAnalysisError("publication-base predecessor receipt is invalid")
    assert isinstance(proof, dict)
    _exact(
        proof,
        {
            "base_sha",
            "deployment_id",
            "host_deployed_sha",
            "input_sha256",
            "manifest_sha256",
            "path",
            "publication_base_sha256",
            "release_sha",
            "schema_version",
            "sha256",
            "tree_sha256",
            "wire_generated_at",
        },
        "publication-base predecessor receipt",
    )
    digest = _sha(proof.get("sha256"), "predecessor receipt digest")
    raw = _read_history_artifact(
        config,
        history_root=history_root,
        category="receipts",
        digest=digest,
        claimed_path=proof.get("path"),
        label="publication-base predecessor receipt",
        maximum=MAX_PIN_BYTES,
    )
    receipt = _strict_object(raw, "publication-base predecessor receipt")
    _exact(
        receipt,
        {
            "base_sha",
            "candidate",
            "github_actions_used",
            "host_deployed_sha",
            "input_sha256",
            "live_manifest",
            "origins",
            "predecessor",
            "publication_base",
            "railway",
            "recorded_at",
            "release_bundle",
            "release_sha",
            "schema_version",
            "status",
            "wire_generated_at",
        },
        "archived publication receipt",
    )
    publication_base = receipt.get("publication_base")
    live_manifest = receipt.get("live_manifest")
    railway = receipt.get("railway")
    origins = receipt.get("origins")
    if not all(
        type(value) is dict
        for value in (publication_base, live_manifest, railway, origins)
    ):
        raise LiveAnalysisError("archived publication receipt proof is invalid")
    assert isinstance(publication_base, dict)
    assert isinstance(live_manifest, dict)
    assert isinstance(railway, dict)
    assert isinstance(origins, dict)
    _exact(
        publication_base,
        {"kind", "path", "sha256", "target_sha"},
        "archived receipt publication base",
    )
    _exact(
        live_manifest,
        {"bytes", "file_count", "path", "sha256", "total_bytes", "tree_sha256"},
        "archived receipt live manifest",
    )
    _exact(railway, {"deployment_id", "status"}, "archived receipt Railway proof")
    _exact(origins, {"provider", "public"}, "archived receipt origins")
    expected_kind = (
        "verified_transition"
        if predecessor_pin_schema == PIN_SCHEMA
        else "verified_successor"
    )
    for key in (
        "sha256",
        "publication_base_sha256",
        "input_sha256",
        "manifest_sha256",
        "tree_sha256",
    ):
        _sha(proof.get(key), f"predecessor receipt {key}")
    for key in ("base_sha", "host_deployed_sha", "release_sha"):
        _sha40(proof.get(key), f"predecessor receipt {key}")
    if (
        proof.get("schema_version") != PUBLICATION_V2_SCHEMA
        or receipt.get("schema_version") != PUBLICATION_V2_SCHEMA
        or receipt.get("status") != "verified"
        or receipt.get("github_actions_used") is not False
        or proof.get("base_sha") != predecessor_target_sha
        or proof.get("publication_base_sha256") != predecessor_pin_sha256
        or proof.get("host_deployed_sha") != expected_host_sha
        or proof.get("wire_generated_at") != receipt.get("wire_generated_at")
        or type(proof.get("wire_generated_at")) is not str
        or TIMESTAMP.fullmatch(proof["wire_generated_at"]) is None
        or publication_base.get("sha256") != predecessor_pin_sha256
        or publication_base.get("target_sha") != predecessor_target_sha
        or publication_base.get("kind") != expected_kind
        or publication_base.get("path") != str(config.base_pin)
        or receipt.get("base_sha") != predecessor_target_sha
        or receipt.get("host_deployed_sha") != expected_host_sha
        or proof.get("release_sha") != receipt.get("release_sha")
        or proof.get("input_sha256") != receipt.get("input_sha256")
        or proof.get("manifest_sha256") != live_manifest.get("sha256")
        or proof.get("tree_sha256") != live_manifest.get("tree_sha256")
        or proof.get("deployment_id") != railway.get("deployment_id")
        or railway.get("status") != "SUCCESS"
        or origins
        != {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN}
    ):
        raise LiveAnalysisError("publication-base predecessor receipt changed")
    deployment_id = proof.get("deployment_id")
    if type(deployment_id) is not str or UUID.fullmatch(deployment_id) is None:
        raise LiveAnalysisError("predecessor receipt deployment ID is invalid")
    return receipt, raw


def _validate_rotation_record(
    config: RuntimeConfig,
    pin: dict[str, Any],
    pin_raw: bytes,
    *,
    history_root: Path,
    predecessor_pin_sha256: str,
    predecessor_receipt_sha256: str,
) -> None:
    expected = history_root / "rotations" / (
        f"{pin['generation']}-{pin['target']['base_sha']}-"
        f"{predecessor_receipt_sha256}.json"
    )
    if pin.get("rotation_record_path") != str(expected):
        raise LiveAnalysisError("publication-base rotation-record path is not canonical")
    raw = _read_regular(
        expected,
        label="publication-base rotation record",
        uid=config.pin_uid,
        gid=os.getegid() if config.pin_gid < 0 else config.pin_gid,
        mode=0o640,
        maximum=2 * MAX_PIN_BYTES,
    )
    record = _strict_object(raw, "publication-base rotation record")
    _exact(
        record,
        {
            "generation",
            "next_pin",
            "next_pin_sha256",
            "predecessor_pin_sha256",
            "predecessor_receipt_sha256",
            "recorded_at",
            "schema_version",
            "status",
            "target_base_sha",
        },
        "publication-base rotation record",
    )
    if (
        record.get("schema_version")
        != "palimpsest.direct-publication-base-rotation.v1"
        or record.get("status") != "verified"
        or record.get("generation") != pin["generation"]
        or record.get("recorded_at") != pin["recorded_at"]
        or record.get("target_base_sha") != pin["target"]["base_sha"]
        or record.get("predecessor_pin_sha256") != predecessor_pin_sha256
        or record.get("predecessor_receipt_sha256")
        != predecessor_receipt_sha256
        or record.get("next_pin") != pin
        or record.get("next_pin_sha256") != hashlib.sha256(pin_raw).hexdigest()
    ):
        raise LiveAnalysisError("publication-base rotation record changed")


def _validate_successor_pin(
    config: RuntimeConfig,
    raw: bytes,
    *,
    history_root: Path,
    expected_digest: str | None,
    active: bool,
    seen: set[str],
) -> tuple[dict[str, Any], list[str]]:
    digest = hashlib.sha256(raw).hexdigest()
    if expected_digest is not None and digest != expected_digest:
        raise LiveAnalysisError("publication-base pin digest changed")
    if digest in seen:
        raise LiveAnalysisError("publication-base pin chain contains a loop")
    seen.add(digest)
    pin = _strict_object(raw, "publication-base pin")
    _exact(
        pin,
        {
            "anchor",
            "generation",
            "host",
            "installed",
            "live",
            "origins",
            "predecessor",
            "railway",
            "recorded_at",
            "rotation_record_path",
            "schema_version",
            "status",
            "target",
        },
        "publication-base pin",
    )
    generation = pin.get("generation")
    if (
        pin.get("schema_version") != SUCCESSOR_PIN_SCHEMA
        or pin.get("status") != "verified"
        or type(generation) is not int
        or isinstance(generation, bool)
        or generation < 1
        or generation > MAX_PIN_GENERATIONS
        or type(pin.get("recorded_at")) is not str
        or TIMESTAMP.fullmatch(pin["recorded_at"]) is None
    ):
        raise LiveAnalysisError("publication-base successor identity is invalid")

    anchor = pin.get("anchor")
    predecessor = pin.get("predecessor")
    host = pin.get("host")
    installed = pin.get("installed")
    live = pin.get("live")
    origins = pin.get("origins")
    target = pin.get("target")
    if not all(
        type(value) is dict
        for value in (anchor, predecessor, host, installed, live, origins, target)
    ):
        raise LiveAnalysisError("publication-base successor proof is invalid")
    assert isinstance(anchor, dict)
    assert isinstance(predecessor, dict)
    assert isinstance(host, dict)
    assert isinstance(installed, dict)
    assert isinstance(live, dict)
    assert isinstance(origins, dict)
    assert isinstance(target, dict)

    _exact(
        anchor,
        {"path", "schema_version", "sha256", "target_sha"},
        "publication-base anchor",
    )
    if (
        anchor.get("schema_version") != PIN_SCHEMA
        or anchor.get("sha256") != PIN_SHA256
        or anchor.get("target_sha") != PIN_TARGET_SHA
    ):
        raise LiveAnalysisError("publication-base anchor is not the reviewed v1 pin")
    anchor_raw = _read_history_artifact(
        config,
        history_root=history_root,
        category="pins",
        digest=PIN_SHA256,
        claimed_path=anchor.get("path"),
        label="publication-base v1 anchor",
        maximum=MAX_PIN_BYTES,
    )
    anchor_pin = _validate_legacy_pin(
        anchor_raw,
        expected_sha256=PIN_SHA256,
        expected_target_sha=PIN_TARGET_SHA,
    )

    _exact(host, {"canonical_head", "deployed_commit"}, "publication-base host")
    anchor_previous = anchor_pin["previous"]
    if host != {
        "canonical_head": anchor_previous["canonical_head"],
        "deployed_commit": anchor_previous["deployed_commit"],
    }:
        raise LiveAnalysisError("publication-base host identity changed")
    _exact(target, {"base_sha", "public_main_sha"}, "publication-base target")
    target_sha = _sha40(target.get("base_sha"), "publication-base target")
    if target.get("public_main_sha") != target_sha:
        raise LiveAnalysisError("publication-base target is not public main")
    _exact(origins, {"provider", "public"}, "publication-base origins")
    if origins != {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN}:
        raise LiveAnalysisError("publication-base origins are not canonical")
    installed_keys = {
        "continuity_guard_service_sha256",
        "continuity_guard_sha256",
        "continuity_guard_timer_sha256",
        "event_analysis_publish_dropin_sha256",
        "event_analysis_service_sha256",
        "event_analysis_wrapper_sha256",
        "publisher_service_sha256",
        "publisher_sha256",
        "reconciler_sha256",
        "rotation_helper_sha256",
        "transition_helper_sha256",
        "watchdog_service_sha256",
        "watchdog_sha256",
        "watchdog_timer_sha256",
    }
    _exact(installed, installed_keys, "publication-base installed proof")
    for key in installed_keys:
        _sha(installed.get(key), f"publication-base installed {key}")
    if active:
        _validate_installed_artifacts(config, installed)

    _exact(predecessor, {"pin", "publication_receipt"}, "pin predecessor")
    pin_proof = predecessor.get("pin")
    if type(pin_proof) is not dict:
        raise LiveAnalysisError("publication-base predecessor pin is invalid")
    assert isinstance(pin_proof, dict)
    _exact(
        pin_proof,
        {"generation", "path", "schema_version", "sha256", "target_sha"},
        "publication-base predecessor pin",
    )
    prior_digest = _sha(pin_proof.get("sha256"), "predecessor pin digest")
    prior_target = _sha40(pin_proof.get("target_sha"), "predecessor pin target")
    prior_generation = pin_proof.get("generation")
    if (
        type(prior_generation) is not int
        or isinstance(prior_generation, bool)
        or prior_generation != generation - 1
    ):
        raise LiveAnalysisError("publication-base pin generation is not consecutive")
    prior_raw = _read_history_artifact(
        config,
        history_root=history_root,
        category="pins",
        digest=prior_digest,
        claimed_path=pin_proof.get("path"),
        label="publication-base predecessor pin",
        maximum=MAX_PIN_BYTES,
    )
    if prior_generation == 0:
        if (
            pin_proof.get("schema_version") != PIN_SCHEMA
            or prior_digest != PIN_SHA256
            or prior_target != PIN_TARGET_SHA
        ):
            raise LiveAnalysisError("first successor does not extend the v1 anchor")
        _validate_legacy_pin(
            prior_raw,
            expected_sha256=PIN_SHA256,
            expected_target_sha=PIN_TARGET_SHA,
        )
        targets = [PIN_TARGET_SHA]
    else:
        if pin_proof.get("schema_version") != SUCCESSOR_PIN_SCHEMA:
            raise LiveAnalysisError("predecessor pin schema is invalid")
        prior_pin, targets = _validate_successor_pin(
            config,
            prior_raw,
            history_root=history_root,
            expected_digest=prior_digest,
            active=False,
            seen=seen,
        )
        if (
            prior_pin.get("generation") != prior_generation
            or prior_pin.get("target", {}).get("base_sha") != prior_target
        ):
            raise LiveAnalysisError("predecessor pin summary changed")

    receipt, _receipt_raw = _validate_archived_publication_receipt(
        config,
        predecessor.get("publication_receipt"),
        history_root=history_root,
        predecessor_pin_sha256=prior_digest,
        predecessor_pin_schema=str(pin_proof["schema_version"]),
        predecessor_target_sha=prior_target,
        expected_host_sha=host["deployed_commit"],
    )
    _exact(
        live,
        {
            "file_count",
            "provider_manifest",
            "public_manifest",
            "release_sha",
            "total_bytes",
            "tree_sha256",
        },
        "publication-base live proof",
    )
    release_sha = _sha40(live.get("release_sha"), "publication-base live release")
    tree_sha256 = _sha(live.get("tree_sha256"), "publication-base live tree")
    file_count = live.get("file_count")
    total_bytes = live.get("total_bytes")
    if (
        type(file_count) is not int
        or isinstance(file_count, bool)
        or file_count < 1
        or type(total_bytes) is not int
        or isinstance(total_bytes, bool)
        or total_bytes < 1
    ):
        raise LiveAnalysisError("publication-base live size proof is invalid")
    provider_raw = _validate_manifest_history_proof(
        config,
        live.get("provider_manifest"),
        history_root=history_root,
        release_sha=release_sha,
        tree_sha256=tree_sha256,
        file_count=file_count,
        total_bytes=total_bytes,
        label="publication-base provider manifest",
        origin="provider",
    )
    public_raw = _validate_manifest_history_proof(
        config,
        live.get("public_manifest"),
        history_root=history_root,
        release_sha=release_sha,
        tree_sha256=tree_sha256,
        file_count=file_count,
        total_bytes=total_bytes,
        label="publication-base public manifest",
        origin="public",
    )
    predecessor_receipt = predecessor["publication_receipt"]
    if (
        provider_raw != public_raw
        or hashlib.sha256(provider_raw).hexdigest()
        != predecessor_receipt["manifest_sha256"]
        or release_sha != predecessor_receipt["release_sha"]
        or tree_sha256 != predecessor_receipt["tree_sha256"]
        or file_count != receipt["live_manifest"].get("file_count")
        or total_bytes != receipt["live_manifest"].get("total_bytes")
    ):
        raise LiveAnalysisError("publication-base live proof differs from predecessor")
    _validate_rotation_topology(
        config,
        pin.get("railway"),
        history_root=history_root,
        expected_deployment_id=predecessor_receipt["deployment_id"],
    )
    _validate_rotation_record(
        config,
        pin,
        raw,
        history_root=history_root,
        predecessor_pin_sha256=prior_digest,
        predecessor_receipt_sha256=predecessor_receipt["sha256"],
    )
    return pin, [*targets, target_sha]


def _validate_active_pin(
    config: RuntimeConfig, raw: bytes, *, pin_gid: int
) -> tuple[dict[str, Any], list[str]]:
    digest = hashlib.sha256(raw).hexdigest()
    document = _strict_object(raw, "publication-base pin")
    schema = document.get("schema_version")
    if schema == PIN_SCHEMA:
        expected_digest = config.expected_pin_sha256 or PIN_SHA256
        expected_target = config.expected_target_sha or PIN_TARGET_SHA
        return (
            _validate_legacy_pin(
                raw,
                expected_sha256=expected_digest,
                expected_target_sha=expected_target,
            ),
            [expected_target],
        )
    if schema != SUCCESSOR_PIN_SCHEMA:
        raise LiveAnalysisError("publication-base pin schema is unsupported")
    if config.expected_pin_sha256 is not None and digest != config.expected_pin_sha256:
        raise LiveAnalysisError("publication-base pin hash is not the expected hash")
    history_root = _validate_history_layout(config, pin_gid=pin_gid)
    pin, targets = _validate_successor_pin(
        config,
        raw,
        history_root=history_root,
        expected_digest=digest,
        active=True,
        seen=set(),
    )
    if (
        config.expected_target_sha is not None
        and pin["target"]["base_sha"] != config.expected_target_sha
    ):
        raise LiveAnalysisError("publication-base target is not the expected target")
    return pin, targets


def _validate_pin(
    raw: bytes, *, expected_sha256: str, expected_target_sha: str
) -> dict[str, Any]:
    """Compatibility entry point for focused v1-anchor tests."""

    return _validate_legacy_pin(
        raw,
        expected_sha256=expected_sha256,
        expected_target_sha=expected_target_sha,
    )


def _validate_deployed_commit(config: RuntimeConfig, expected_host_sha: str) -> None:
    raw = _read_regular(
        config.deployed_commit,
        label="deployed-commit retirement guard",
        uid=config.deployed_uid,
        gid=config.deployed_gid,
        mode=0o644,
        maximum=41,
    )
    expected = (expected_host_sha + "\n").encode("ascii")
    if raw != expected:
        raise LiveAnalysisError("deployed-commit no longer names the pinned host")


def _git_environment() -> dict[str, str]:
    return {
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null",
        "GIT_LITERAL_PATHSPECS": "1",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_OPTIONAL_LOCKS": "0",
        "HOME": "/nonexistent",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": "/usr/bin:/bin",
    }


def _git(
    repository: Path, arguments: list[str], *, text: bool = True
) -> subprocess.CompletedProcess[Any]:
    try:
        return subprocess.run(
            ["/usr/bin/git", "-C", str(repository), *arguments],
            check=True,
            capture_output=True,
            env=_git_environment(),
            text=text,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        detail = ""
        if isinstance(exc, subprocess.CalledProcessError):
            stderr = exc.stderr
            if isinstance(stderr, bytes):
                stderr = stderr.decode("utf-8", "replace")
            detail = str(stderr).strip()[:500]
        raise LiveAnalysisError(
            f"read-only Git proof failed: {' '.join(arguments)}"
            + (f": {detail}" if detail else "")
        ) from exc


def _validate_repository(
    config: RuntimeConfig,
    target_sha: str,
    *,
    expected_host_sha: str | None = None,
    ancestry_targets: list[str] | None = None,
) -> dict[str, int]:
    if expected_host_sha is None:
        expected_host_sha = config.expected_predecessor_sha
    if ancestry_targets is None:
        ancestry_targets = [target_sha]
    repository = config.repository
    try:
        metadata = repository.lstat()
        git_metadata = (repository / ".git").lstat()
    except OSError as exc:
        raise LiveAnalysisError("canonical repository is unavailable") from exc
    if (
        not repository.is_absolute()
        or repository.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or metadata.st_gid != os.getegid()
        or stat.S_IMODE(metadata.st_mode) & 0o022
        or not stat.S_ISDIR(git_metadata.st_mode)
        or (repository / ".git").is_symlink()
        or git_metadata.st_uid != os.geteuid()
        or git_metadata.st_gid != os.getegid()
        or stat.S_IMODE(git_metadata.st_mode) & 0o022
    ):
        raise LiveAnalysisError("canonical repository metadata is unsafe")
    for relative in ("shallow", "info/grafts", "objects/info/alternates"):
        path = repository / ".git" / relative
        if path.exists() or path.is_symlink():
            raise LiveAnalysisError("canonical repository has noncanonical object history")
    if _git(repository, ["for-each-ref", "--format=%(refname)", "refs/replace"]).stdout:
        raise LiveAnalysisError("canonical repository has replacement refs")
    remote = _git(repository, ["remote", "get-url", "origin"]).stdout.strip()
    if remote != config.expected_remote:
        raise LiveAnalysisError("origin is not the reviewed public repository")
    canonical_head = _git(
        repository, ["rev-parse", "--verify", "HEAD^{commit}"]
    ).stdout.strip()
    if canonical_head != expected_host_sha:
        raise LiveAnalysisError("canonical HEAD no longer names the pinned host")
    local_target = _git(
        repository, ["rev-parse", "--verify", f"{target_sha}^{{commit}}"]
    ).stdout.strip()
    if local_target != target_sha:
        raise LiveAnalysisError("publication-base target is not a local commit")
    public_main = _git(
        repository, ["rev-parse", "--verify", "refs/remotes/origin/main^{commit}"]
    ).stdout.strip()
    _sha40(public_main, "local origin/main")
    _git(
        repository,
        ["merge-base", "--is-ancestor", target_sha, "refs/remotes/origin/main"],
    )
    _git(
        repository,
        ["merge-base", "--is-ancestor", expected_host_sha, target_sha],
    )
    if not ancestry_targets or ancestry_targets[-1] != target_sha:
        raise LiveAnalysisError("publication-base ancestry proof is incomplete")
    for predecessor, successor in zip(ancestry_targets, ancestry_targets[1:]):
        _sha40(predecessor, "publication-base predecessor target")
        _sha40(successor, "publication-base successor target")
        _git(repository, ["merge-base", "--is-ancestor", predecessor, successor])

    rows = _git(
        repository,
        ["ls-tree", "-rlz", "--full-tree", target_sha, "--", *RUNTIME_PATHS],
        text=False,
    ).stdout
    expected: dict[str, int] = {}
    total = 0
    for raw_row in rows.split(b"\0"):
        if not raw_row:
            continue
        try:
            header, raw_path = raw_row.split(b"\t", 1)
            mode, kind, _object, raw_size = header.split(b" ", 3)
            path = raw_path.decode("utf-8", "strict")
            size = int(raw_size)
        except (UnicodeDecodeError, ValueError) as exc:
            raise LiveAnalysisError("target runtime tree is malformed") from exc
        if (
            mode not in {b"100644", b"100755"}
            or kind != b"blob"
            or not _safe_relative(path)
            or path in expected
            or size < 0
            or size > MAX_MEMBER_BYTES
        ):
            raise LiveAnalysisError("target runtime tree contains an unsafe entry")
        expected[path] = int(mode, 8)
        total += size
    if (
        not REQUIRED_FILES.issubset(expected)
        or len(expected) > MAX_FILES
        or total > MAX_MATERIALIZED_BYTES
    ):
        raise LiveAnalysisError("target runtime tree exceeds its closed bounds")
    return expected


def _safe_relative(value: str) -> bool:
    path = PurePosixPath(value)
    return (
        value == path.as_posix()
        and not path.is_absolute()
        and len(path.parts) >= 1
        and path.parts[0] in RUNTIME_PATHS
        and all(part not in {"", ".", ".."} for part in path.parts)
    )


def _archive_bytes(repository: Path, target_sha: str) -> bytes:
    raw = _git(
        repository,
        ["archive", "--format=tar", target_sha, "--", *RUNTIME_PATHS],
        text=False,
    ).stdout
    if not raw or len(raw) > MAX_ARCHIVE_BYTES:
        raise LiveAnalysisError("target runtime archive exceeds its closed bound")
    return raw


def _extract_archive(
    raw: bytes, destination: Path, expected: dict[str, int]
) -> None:
    metadata = destination.lstat()
    if (
        destination.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise LiveAnalysisError("private materialization directory is unsafe")
    extracted: set[str] = set()
    total = 0
    try:
        archive = tarfile.open(fileobj=io.BytesIO(raw), mode="r:")
    except (tarfile.TarError, OSError) as exc:
        raise LiveAnalysisError("target runtime archive is invalid") from exc
    with archive:
        for member in archive:
            name = member.name.removesuffix("/")
            if not name or not _safe_relative(name):
                raise LiveAnalysisError("target runtime archive contains an unsafe path")
            relative = PurePosixPath(name)
            target = destination.joinpath(*relative.parts)
            if member.isdir():
                target.mkdir(mode=0o700, parents=True, exist_ok=True)
                target.chmod(0o700)
                continue
            if not member.isreg() or name not in expected or name in extracted:
                raise LiveAnalysisError("target runtime archive contains an unsafe member")
            expected_executable = bool(expected[name] & 0o111)
            if bool(member.mode & 0o111) != expected_executable:
                raise LiveAnalysisError("target runtime archive mode differs from Git")
            if member.size < 0 or member.size > MAX_MEMBER_BYTES:
                raise LiveAnalysisError("target runtime archive member is too large")
            total += member.size
            if total > MAX_MATERIALIZED_BYTES:
                raise LiveAnalysisError("target runtime archive expands beyond its bound")
            target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            source = archive.extractfile(member)
            if source is None:
                raise LiveAnalysisError("target runtime archive member cannot be read")
            try:
                with target.open("xb") as output:
                    shutil.copyfileobj(source, output, length=65536)
            except OSError as exc:
                raise LiveAnalysisError("cannot materialize target runtime") from exc
            target.chmod(0o600)
            extracted.add(name)
    if extracted != set(expected):
        raise LiveAnalysisError("target runtime archive differs from the Git tree")


def _file_identity(item: os.stat_result) -> tuple[int, ...]:
    return (
        item.st_dev,
        item.st_ino,
        item.st_mode,
        item.st_uid,
        item.st_gid,
        item.st_nlink,
        item.st_size,
        item.st_mtime_ns,
        item.st_ctime_ns,
    )


def _read_wire_clock(config: RuntimeConfig) -> str:
    raw = _read_regular(
        config.wire,
        label="live evidence wire",
        uid=os.geteuid(),
        gid=None,
        mode=None,
        maximum=MAX_WIRE_BYTES,
        forbid_group_other_write=True,
    )
    wire = _strict_object(raw, "live evidence wire")
    generated_at = wire.get("generated_at")
    if type(generated_at) is not str or TIMESTAMP.fullmatch(generated_at) is None:
        raise LiveAnalysisError("live evidence wire has no valid generated_at clock")
    return generated_at


def _validate_runtime_paths(
    config: RuntimeConfig,
) -> tuple[str, tuple[int, ...] | None]:
    for path, label in (
        (config.wire, "wire"),
        (config.readings, "readings"),
        (config.output, "output"),
        (config.python, "Python interpreter"),
    ):
        if not path.is_absolute():
            raise LiveAnalysisError(f"{label} path is not absolute")
    try:
        wire = config.wire.lstat()
        readings = config.readings.lstat()
        output_parent = config.output.parent.lstat()
        python = config.python.resolve(strict=True).stat()
    except OSError as exc:
        raise LiveAnalysisError("live-analysis runtime path is unavailable") from exc
    if (
        config.wire.is_symlink()
        or not stat.S_ISREG(wire.st_mode)
        or wire.st_uid != os.geteuid()
        or stat.S_IMODE(wire.st_mode) & 0o022
        or config.readings.is_symlink()
        or not stat.S_ISDIR(readings.st_mode)
        or config.readings.stat().st_uid != os.geteuid()
        or config.output.parent.is_symlink()
        or not stat.S_ISDIR(output_parent.st_mode)
        or output_parent.st_uid != os.geteuid()
        or stat.S_IMODE(output_parent.st_mode) & 0o022
        or config.python.resolve(strict=True).is_symlink()
        or not stat.S_ISREG(python.st_mode)
        or python.st_uid != config.python_uid
        or stat.S_IMODE(python.st_mode) & 0o022
        or not os.access(config.python, os.X_OK)
    ):
        raise LiveAnalysisError("live-analysis runtime path metadata is unsafe")
    output_identity: tuple[int, ...] | None = None
    if config.output.exists() or config.output.is_symlink():
        output = config.output.lstat()
        if (
            config.output.is_symlink()
            or not stat.S_ISREG(output.st_mode)
            or output.st_uid != os.geteuid()
            or output.st_nlink != 1
            or stat.S_IMODE(output.st_mode) & 0o022
        ):
            raise LiveAnalysisError("live-analysis output metadata is unsafe")
        output_identity = _file_identity(output)
    return _read_wire_clock(config), output_identity


@dataclass
class OutputStage:
    parent_descriptor: int
    descriptor: int
    name: str
    path: Path
    device: int
    inode: int


def _create_output_stage(config: RuntimeConfig) -> OutputStage:
    parent_flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_DIRECTORY"):
        parent_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        parent_flags |= os.O_NOFOLLOW
    try:
        parent_descriptor = os.open(config.output.parent, parent_flags)
    except OSError as exc:
        raise LiveAnalysisError("cannot open live-analysis output directory") from exc
    try:
        parent = os.fstat(parent_descriptor)
        named_parent = config.output.parent.lstat()
        if (
            not stat.S_ISDIR(parent.st_mode)
            or parent.st_dev != named_parent.st_dev
            or parent.st_ino != named_parent.st_ino
            or parent.st_uid != os.geteuid()
            or stat.S_IMODE(parent.st_mode) & 0o022
        ):
            raise LiveAnalysisError("live-analysis output directory changed")
        stage_flags = os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            stage_flags |= os.O_NOFOLLOW
        descriptor = -1
        name = ""
        for _attempt in range(16):
            name = f".{config.output.name}.stage-{secrets.token_hex(16)}"
            try:
                descriptor = os.open(
                    name,
                    stage_flags,
                    0o600,
                    dir_fd=parent_descriptor,
                )
                break
            except FileExistsError:
                continue
        if descriptor < 0:
            raise LiveAnalysisError("cannot allocate an exclusive output stage")
        try:
            os.fchmod(descriptor, 0o600)
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != os.geteuid()
                or metadata.st_gid != os.getegid()
                or stat.S_IMODE(metadata.st_mode) != 0o600
                or metadata.st_nlink != 1
                or metadata.st_size != 0
            ):
                raise LiveAnalysisError("exclusive output stage metadata is unsafe")
            return OutputStage(
                parent_descriptor=parent_descriptor,
                descriptor=descriptor,
                name=name,
                path=config.output.parent / name,
                device=metadata.st_dev,
                inode=metadata.st_ino,
            )
        except Exception:
            created = os.fstat(descriptor)
            os.close(descriptor)
            try:
                named = os.stat(
                    name,
                    dir_fd=parent_descriptor,
                    follow_symlinks=False,
                )
                if named.st_dev == created.st_dev and named.st_ino == created.st_ino:
                    os.unlink(name, dir_fd=parent_descriptor)
            except OSError:
                pass
            raise
    except Exception:
        os.close(parent_descriptor)
        raise


def _stage_path_matches(stage: OutputStage) -> bool:
    try:
        metadata = os.stat(
            stage.name,
            dir_fd=stage.parent_descriptor,
            follow_symlinks=False,
        )
    except FileNotFoundError:
        return False
    except OSError as exc:
        raise LiveAnalysisError("cannot inspect the exclusive output stage") from exc
    return metadata.st_dev == stage.device and metadata.st_ino == stage.inode


def _remove_owned_stage(stage: OutputStage) -> None:
    if not _stage_path_matches(stage):
        return
    try:
        os.unlink(stage.name, dir_fd=stage.parent_descriptor)
        os.fsync(stage.parent_descriptor)
    except OSError as exc:
        raise LiveAnalysisError("cannot remove the owned output stage") from exc


def _read_stage(stage: OutputStage) -> bytes:
    if not _stage_path_matches(stage):
        raise LiveAnalysisError("exclusive output stage pathname changed")
    before = os.fstat(stage.descriptor)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_dev != stage.device
        or before.st_ino != stage.inode
        or before.st_uid != os.geteuid()
        or before.st_gid != os.getegid()
        or stat.S_IMODE(before.st_mode) != 0o600
        or before.st_nlink != 1
        or before.st_size <= 0
        or before.st_size > MAX_OUTPUT_BYTES
    ):
        raise LiveAnalysisError("event-analysis output stage metadata is unsafe")
    try:
        os.lseek(stage.descriptor, 0, os.SEEK_SET)
        chunks: list[bytes] = []
        remaining = MAX_OUTPUT_BYTES + 1
        while remaining:
            chunk = os.read(stage.descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
    except OSError as exc:
        raise LiveAnalysisError("cannot read event-analysis output stage") from exc
    raw = b"".join(chunks)
    after = os.fstat(stage.descriptor)
    if (
        len(raw) > MAX_OUTPUT_BYTES
        or _file_identity(before) != _file_identity(after)
        or not _stage_path_matches(stage)
    ):
        raise LiveAnalysisError("event-analysis output stage changed while reading")
    return raw


def _validate_output_bundle(
    raw: bytes, *, config: RuntimeConfig, wire_clock: str
) -> None:
    bundle = _strict_object(raw, "event-analysis output stage")
    _exact(bundle, OUTPUT_KEYS, "event-analysis output stage")
    analyses = bundle.get("analyses")
    n_events = bundle.get("n_events")
    if (
        bundle.get("schema") != OUTPUT_SCHEMA
        or bundle.get("generated_at") != wire_clock
        or bundle.get("wire_generated_at") != wire_clock
        or bundle.get("wire_path") != str(config.wire)
        or type(n_events) is not int
        or n_events < 0
        or type(analyses) is not dict
        or len(analyses) != n_events
        or not all(
            type(event_id) is str
            and bool(event_id)
            and type(analysis) is dict
            for event_id, analysis in analyses.items()
        )
        or bundle.get("newsroom_feed") not in {"missing", "present"}
        or bundle.get("automatic_publication") is not False
    ):
        raise LiveAnalysisError(
            "event-analysis output does not bind to the admitted wire"
        )


def _assert_output_unchanged(
    stage: OutputStage,
    *,
    output_name: str,
    expected_identity: tuple[int, ...] | None,
) -> None:
    try:
        current = os.stat(
            output_name,
            dir_fd=stage.parent_descriptor,
            follow_symlinks=False,
        )
    except FileNotFoundError:
        current = None
    except OSError as exc:
        raise LiveAnalysisError("cannot recheck live-analysis output") from exc
    if expected_identity is None:
        if current is not None:
            raise LiveAnalysisError("live-analysis output appeared during the run")
    elif current is None or _file_identity(current) != expected_identity:
        raise LiveAnalysisError("live-analysis output changed during the run")


def _publish_stage(
    stage: OutputStage,
    *,
    config: RuntimeConfig,
    wire_clock: str,
    expected_output_identity: tuple[int, ...] | None,
) -> None:
    raw = _read_stage(stage)
    _validate_output_bundle(raw, config=config, wire_clock=wire_clock)
    _assert_output_unchanged(
        stage,
        output_name=config.output.name,
        expected_identity=expected_output_identity,
    )
    try:
        os.fchmod(stage.descriptor, 0o640)
        admitted = os.fstat(stage.descriptor)
        if (
            admitted.st_dev != stage.device
            or admitted.st_ino != stage.inode
            or admitted.st_uid != os.geteuid()
            or admitted.st_gid != os.getegid()
            or admitted.st_nlink != 1
            or stat.S_IMODE(admitted.st_mode) != 0o640
        ):
            raise LiveAnalysisError("admitted event-analysis output metadata is unsafe")
        os.fsync(stage.descriptor)
        os.replace(
            stage.name,
            config.output.name,
            src_dir_fd=stage.parent_descriptor,
            dst_dir_fd=stage.parent_descriptor,
        )
        os.fsync(stage.parent_descriptor)
    except OSError as exc:
        raise LiveAnalysisError("cannot atomically publish event-analysis output") from exc


def _invoke_analysis(
    config: RuntimeConfig, materialized: Path, output: Path
) -> None:
    environment = {
        "HOME": "/nonexistent",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": "/usr/bin:/bin",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": str(materialized),
    }
    command = [
        str(config.python),
        "-B",
        "-m",
        "scripts.event_analysis_live",
        "--wire",
        str(config.wire),
        "--readings",
        str(config.readings),
        "--output",
        str(output),
    ]
    try:
        subprocess.run(
            command,
            check=True,
            cwd=materialized,
            env=environment,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        raise LiveAnalysisError("pinned event analysis failed") from exc


def run(config: RuntimeConfig) -> str:
    if os.geteuid() == 0:
        raise LiveAnalysisError("live event analysis must not run as root")
    pin_gid = os.getegid() if config.pin_gid < 0 else config.pin_gid
    raw_pin = _read_pin(config.base_pin, uid=config.pin_uid, gid=pin_gid)
    pin, ancestry_targets = _validate_active_pin(
        config,
        raw_pin,
        pin_gid=pin_gid,
    )
    host = pin.get("host")
    expected_host_sha = (
        str(host["deployed_commit"])
        if isinstance(host, dict)
        else config.expected_predecessor_sha
    )
    _validate_deployed_commit(config, expected_host_sha)
    target_sha = str(pin["target"]["base_sha"])
    expected = _validate_repository(
        config,
        target_sha,
        expected_host_sha=expected_host_sha,
        ancestry_targets=ancestry_targets,
    )
    wire_clock, output_identity = _validate_runtime_paths(config)
    archive = _archive_bytes(config.repository, target_sha)
    temporary_parent = (
        str(config.temporary_parent) if config.temporary_parent is not None else None
    )
    with tempfile.TemporaryDirectory(
        prefix="palimpsest-event-analysis-live-", dir=temporary_parent
    ) as name:
        materialized = Path(name)
        materialized.chmod(0o700)
        _extract_archive(archive, materialized, expected)
        stage = _create_output_stage(config)
        try:
            _invoke_analysis(config, materialized, stage.path)
            boundary = _acquire_publication_boundary(config, pin_gid=pin_gid)
            try:
                if (
                    _read_pin(config.base_pin, uid=config.pin_uid, gid=pin_gid)
                    != raw_pin
                ):
                    raise LiveAnalysisError(
                        "publication-base pin changed during event analysis"
                    )
                _publish_stage(
                    stage,
                    config=config,
                    wire_clock=wire_clock,
                    expected_output_identity=output_identity,
                )
            finally:
                os.close(boundary)
        finally:
            try:
                _remove_owned_stage(stage)
            finally:
                os.close(stage.descriptor)
                os.close(stage.parent_descriptor)
    return target_sha


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--repository", type=Path, default=Path("/home/palimpsest/palimpsest")
    )
    parser.add_argument(
        "--base-pin",
        type=Path,
        default=Path("/etc/palimpsest/railway-publication-base.json"),
    )
    parser.add_argument(
        "--deployed-commit",
        type=Path,
        default=Path("/etc/palimpsest/deployed-commit"),
    )
    parser.add_argument(
        "--state-root",
        type=Path,
        default=Path("/var/lib/palimpsest/railway-publication"),
    )
    parser.add_argument(
        "--control-root",
        type=Path,
        default=Path("/var/lib/palimpsest/railway-control"),
    )
    parser.add_argument(
        "--wire",
        type=Path,
        default=Path("/var/lib/palimpsest/newswire/newswire-latest.json"),
    )
    parser.add_argument(
        "--readings", type=Path, default=Path("/var/lib/palimpsest/readings")
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=Path("/var/lib/palimpsest/newswire/event-analysis-latest.json"),
    )
    parser.add_argument("--python", type=Path, default=Path("/usr/bin/python3"))
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    config = RuntimeConfig(
        repository=args.repository,
        base_pin=args.base_pin,
        deployed_commit=args.deployed_commit,
        wire=args.wire,
        readings=args.readings,
        output=args.output,
        python=args.python,
        state_root=args.state_root,
        control_root=args.control_root,
    )
    try:
        target = run(config)
    except LiveAnalysisError as exc:
        print(f"event-analysis-live wrapper refused: {exc}", file=sys.stderr)
        return 1
    print(f"event-analysis-live wrapper: completed with pinned target {target}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
