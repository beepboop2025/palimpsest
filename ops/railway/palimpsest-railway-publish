[[ -z "$(git status --porcelain=v1 --untracked-files=all)" ]] || {
  log "local release checkout is not clean" >&2
  exit 1
}

log "rights-scrubbing local release $release_sha"
PALIMPSEST_RAILWAY_PYTHON="$PYTHON_BIN" \
  /usr/bin/bash "$checkout/ops/railway/build-static-bundle.sh" "$release_sha" "$release"
release_freshness_attestation="$release/readings/publication-freshness-attestation-latest.json"
wire_canonical_sha256="$(validate_release_freshness_attestation \
  "$snapshot_wire" "$release_freshness_attestation" "$release_sha" \
  "$wire_generated_at")"
[[ "$wire_canonical_sha256" =~ ^[0-9a-f]{64}$ ]] || {
  log "rights-suppressed release lacks the exact private-wire attestation" >&2
  exit 1
}
release_newsroom="$release/readings/newsroom-latest.json"
release_manifest_built_at="$(jq -er '
  .built_at | select(type == "string")
' "$release/railway-release.json")"
IFS=$'\t' read -r newsroom_measurement_count newsroom_availability_count \
  <<<"$(validate_structured_newsroom "$release_newsroom" \
    "$wire_generated_at" "$release_manifest_built_at")"
[[ "$newsroom_measurement_count" =~ ^[0-9]+$ \
  && "$newsroom_availability_count" =~ ^[0-9]+$ \
  && $((newsroom_measurement_count + newsroom_availability_count)) -eq 39 ]] || {
  log "structured newsroom did not return a closed 39-record result inventory" >&2
  exit 1
}
newsroom_manifest_sha256="$(jq -er '
    .critical_files["readings/newsroom-latest.json"].sha256 |
    select(type == "string" and test("^[0-9a-f]{64}$"))
  ' "$release/railway-release.json")"
newsroom_manifest_bytes="$(jq -er '
    .critical_files["readings/newsroom-latest.json"].bytes |
    select(type == "number" and . >= 1 and floor == .)
  ' "$release/railway-release.json")"
release_news_html="$release/news/index.html"
news_html_manifest_sha256="$(jq -er '
    .critical_files["news/index.html"].sha256 |
    select(type == "string" and test("^[0-9a-f]{64}$"))
  ' "$release/railway-release.json")"
news_html_manifest_bytes="$(jq -er '
    .critical_files["news/index.html"].bytes |
    select(type == "number" and . >= 1 and floor == .)
  ' "$release/railway-release.json")"
[[ -f "$release_newsroom" && ! -L "$release_newsroom" \
    && "$(sha256_file "$release_newsroom")" == "$newsroom_manifest_sha256" \
    && "$(stat -c '%s' "$release_newsroom")" == "$newsroom_manifest_bytes" \
    && -f "$release_news_html" && ! -L "$release_news_html" \
    && "$(sha256_file "$release_news_html")" == "$news_html_manifest_sha256" \
    && "$(stat -c '%s' "$release_news_html")" == "$news_html_manifest_bytes" ]] || {
  log "local newsroom JSON or HTML is not bound to the pre-mutation release manifest" >&2
  exit 1
}
validate_newsroom_html "$release_news_html" "$newsroom_measurement_count" \
  "$newsroom_availability_count"
validate_measurement_evidence_local "$release_newsroom" \
  "$release/railway-release.json" "$release" "$newsroom_measurement_count"
for newsroom_feed_relative in \
  news/feed.json news/feed.xml \
  news/instruments/feed.json news/instruments/feed.xml; do
  validate_manifest_bound_local "$release/railway-release.json" \
    "$newsroom_feed_relative" "$release/$newsroom_feed_relative"
done
IFS=$'\t' read -r news_source_tail_count news_source_tail_sha256 \
  <<<"$(validate_newsroom_feeds "$release_newsroom" \
    "$release/news/feed.json" "$release/news/feed.xml" \
    "$release/news/instruments/feed.json" \
    "$release/news/instruments/feed.xml" "$snapshot_wire")"
[[ "$news_source_tail_count" =~ ^[0-9]+$ \
  && "$news_source_tail_sha256" =~ ^[0-9a-f]{64}$ ]] || {
  log "local newsroom feeds did not return a private-wire source-tail proof" >&2
  exit 1
}
for denied_analysis_feed_relative in \
  news/china/analysis/feed.json news/china/analysis/feed.xml; do
  validate_manifest_bound_local "$release/railway-release.json" \
    "$denied_analysis_feed_relative" "$release/$denied_analysis_feed_relative"
done
release_newsroom_generated_at="$(jq -er \
  '.generated_at | select(type == "string")' "$release_newsroom")"
validate_denied_china_analysis_feeds \
  "$release/news/china/analysis/feed.json" \
  "$release/news/china/analysis/feed.xml" "$release_newsroom_generated_at"
log "structured newsroom contains ${newsroom_measurement_count} measurements and ${newsroom_availability_count} availability notices; four newsroom feeds and two denied-analysis feeds are exactly bound"
require_pre_mutation_freshness_reserve "$wire_generated_at"

# The generated Git object must remain recoverable after cleanup. Verify the
# incremental bundle in a fresh object database and durably promote it before
# crossing the Railway mutation boundary.
candidate_submission_id="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
[[ "$candidate_submission_id" =~ ^[0-9a-f]{32}$ ]] || {
  log "cannot generate a high-entropy candidate submission identity" >&2
  exit 1
}
write_preparation_journal
persist_release_manifest_anchor
[[ "$(jq -er '.built_at | select(type == "string")' \
  "$release_manifest_path")" == "$release_manifest_built_at" ]] || {
  log "durable release manifest changed its authenticated build clock" >&2
  exit 1
}
persist_release_bundle

# This is the last read-only boundary before Railway can change.  Preserve the
# exact predecessor bytes and active topology so recovery never has to infer a
# rollback target from a mutable deployment list.
if [[ -e "$CONTROL_ROOT/restored-$receipt_sha256.json" ]]; then
  receipt_deployment_id="$("$PYTHON_BIN" -I -S - "$CONTROL_ROOT" "$SUCCESS_RECEIPT" <<'PYRESTORE'
import grp
import json
import runpy
import sys
from pathlib import Path
helper = runpy.run_path("/usr/local/sbin/palimpsest-rotate-direct-publication-base")
raw = Path(sys.argv[2]).read_bytes()
print(helper["_restored_deployment_id"](Path(sys.argv[1]), raw, json.loads(raw), grp.getgrnam("palimpsest").gr_gid))
PYRESTORE
  )"
fi
capture_predecessor_rollback_evidence

# Preparation, durable bundle creation, and predecessor capture can take a
# material fraction of the wire budget. Compute the final absolute deadline at
# the last read-only boundary and persist that exact value in the candidate so
# a later reconciler can enforce the same window without inventing clock skew.
require_pre_mutation_freshness_reserve "$wire_generated_at"
receipt_deadline_at="$("$PYTHON_BIN" -I -S - "$mutation_proof_deadline_epoch" <<'PY'
import sys
from datetime import UTC, datetime

print(
    datetime.fromtimestamp(int(sys.argv[1]), UTC)
    .replace(microsecond=0)
    .isoformat()
    .replace("+00:00", "Z")
)
PY
)"

message="palimpsest-hetzner-${release_sha:0:12}-${input_sha256:0:12}-${candidate_submission_id}"
candidate_prepared_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
candidate_tmp="$(mktemp "$STATE_ROOT/.pending-candidate.XXXXXX")"
jq -n \
  --arg prepared_at "$candidate_prepared_at" \
  --arg receipt_deadline_at "$receipt_deadline_at" \
  --arg message "$message" \
  --arg submission_id "$candidate_submission_id" \
  --arg input_sha256 "$input_sha256" \
  --arg wire_generated_at "$wire_generated_at" \
  --arg wire_canonical_sha256 "$wire_canonical_sha256" \
  --argjson news_source_tail_count "$news_source_tail_count" \
  --arg news_source_tail_sha256 "$news_source_tail_sha256" \
  --arg host_deployed_sha "$host_deployed_sha" \
  --arg base_sha "$base_sha" \
  --arg base_pin_path "$base_pin_path" \
  --arg base_pin_sha256 "$base_pin_sha256" \
  --arg release_sha "$release_sha" \
  --arg release_manifest_path "$release_manifest_path" \
  --arg release_manifest_sha256 "$release_manifest_sha256" \
  --argjson release_manifest_bytes "$release_manifest_bytes" \
  --arg release_manifest_tree_sha256 "$release_manifest_tree_sha256" \
  --argjson release_manifest_file_count "$release_manifest_file_count" \
  --argjson release_manifest_total_bytes "$release_manifest_total_bytes" \
  --arg release_bundle_path "$release_bundle_path" \
  --arg release_bundle_sha256 "$release_bundle_sha256" \
  --argjson release_bundle_bytes "$release_bundle_bytes" \
  --arg predecessor_receipt_sha256 "$receipt_sha256" \
  --arg predecessor_archive_path "$receipt_archive_path" \
  --arg predecessor_schema "$receipt_schema" \
  --arg predecessor_base_sha "$receipt_base_sha" \
  --arg predecessor_release_sha "$receipt_release_sha" \
  --arg predecessor_deployment_id "$receipt_deployment_id" \
  --arg predecessor_input_sha256 "$receipt_input_sha" \
  --arg predecessor_wire_generated_at "$receipt_wire_generated_at" \
  --arg predecessor_manifest_sha256 "$receipt_manifest_sha256" \
  --arg predecessor_tree_sha256 "$receipt_tree_sha256" \
  --arg rollback_captured_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg predecessor_provider_manifest_path "$predecessor_provider_manifest_path" \
  --arg predecessor_provider_manifest_sha256 "$predecessor_provider_manifest_sha256" \
  --argjson predecessor_provider_manifest_bytes "$predecessor_provider_manifest_bytes" \
  --arg predecessor_public_manifest_path "$predecessor_public_manifest_path" \
  --arg predecessor_public_manifest_sha256 "$predecessor_public_manifest_sha256" \
  --argjson predecessor_public_manifest_bytes "$predecessor_public_manifest_bytes" \
  --arg predecessor_topology_path "$predecessor_topology_path" \
  --arg predecessor_topology_sha256 "$predecessor_topology_sha256" \
  --argjson predecessor_topology_bytes "$predecessor_topology_bytes" \
  --arg predecessor_image_digest "$predecessor_image_digest" \
  --arg predecessor_deployment_reason "$predecessor_deployment_reason" \
  --arg predecessor_deployment_created_at "$predecessor_deployment_created_at" \
  --arg project_id "$PROJECT_ID" \
  --arg environment_id "$ENVIRONMENT_ID" \
  --arg service_id "$SERVICE_ID" \
  --arg base_pin_kind "$base_pin_kind" \
  --arg release_bundle_metadata_path "$release_bundle_metadata_path" \
  --arg release_bundle_metadata_sha256 "$release_bundle_metadata_sha256" \
  '{schema_version:"palimpsest.direct-publication-candidate.v2",status:"mutation_unresolved",prepared_at:$prepared_at,receipt_deadline_at:$receipt_deadline_at,message:$message,submission_id:$submission_id,input_sha256:$input_sha256,wire_generated_at:$wire_generated_at,wire_canonical_sha256:$wire_canonical_sha256,news_source_tail:{count:$news_source_tail_count,sha256:$news_source_tail_sha256},host_deployed_sha:$host_deployed_sha,base_sha:$base_sha,publication_base:{path:$base_pin_path,kind:$base_pin_kind,sha256:$base_pin_sha256},release_sha:$release_sha,release_manifest:{path:$release_manifest_path,sha256:$release_manifest_sha256,bytes:$release_manifest_bytes,tree_sha256:$release_manifest_tree_sha256,file_count:$release_manifest_file_count,total_bytes:$release_manifest_total_bytes},release_bundle:{path:$release_bundle_path,sha256:$release_bundle_sha256,bytes:$release_bundle_bytes,metadata_path:$release_bundle_metadata_path,metadata_sha256:$release_bundle_metadata_sha256},predecessor:{receipt_sha256:$predecessor_receipt_sha256,archive_path:$predecessor_archive_path,schema_version:$predecessor_schema,base_sha:$predecessor_base_sha,release_sha:$predecessor_release_sha,deployment_id:$predecessor_deployment_id,input_sha256:$predecessor_input_sha256,wire_generated_at:$predecessor_wire_generated_at,manifest_sha256:$predecessor_manifest_sha256,tree_sha256:$predecessor_tree_sha256},rollback_evidence:{schema_version:"palimpsest.direct-publication-rollback-evidence.v1",captured_at:$rollback_captured_at,provider_manifest:{path:$predecessor_provider_manifest_path,sha256:$predecessor_provider_manifest_sha256,bytes:$predecessor_provider_manifest_bytes},public_manifest:{path:$predecessor_public_manifest_path,sha256:$predecessor_public_manifest_sha256,bytes:$predecessor_public_manifest_bytes},topology:{path:$predecessor_topology_path,sha256:$predecessor_topology_sha256,bytes:$predecessor_topology_bytes,project_id:$project_id,environment_id:$environment_id,service_id:$service_id,deployment_id:$predecessor_deployment_id,image_digest:$predecessor_image_digest,reason:$predecessor_deployment_reason,created_at:$predecessor_deployment_created_at}}}' \
  >"$candidate_tmp"
chmod 0600 "$candidate_tmp"
[[ ! -e "$PENDING_CANDIDATE" && ! -L "$PENDING_CANDIDATE" ]] || {
  log "candidate journal appeared before the Railway mutation boundary" >&2
  exit 1
}
ln "$candidate_tmp" "$PENDING_CANDIDATE"
unlink "$candidate_tmp"
candidate_tmp=""
candidate_journal_sha256="$(sha256_file "$PENDING_CANDIDATE")"
fsync_paths_and_directory "$PENDING_CANDIDATE" "$STATE_ROOT"
archive_candidate_journal
unlink "$PENDING_PREPARATION"
fsync_paths_and_directory "$PENDING_CANDIDATE" "$candidate_archive_path" "$STATE_ROOT"

upload_log="$STATE_ROOT/last-upload.json"
upload_error_log="$STATE_ROOT/last-upload.stderr"
log "submitting one Railway deployment: $message"
(
  cd "$release"
  run_with_deadline "$RAILWAY_UPLOAD_TIMEOUT_SECONDS" \
    "$RECEIPT_COMMIT_RESERVE_SECONDS" \
    env NODE_OPTIONS="$RAILWAY_NODE_OPTIONS" \
    "$railway_token_name=$railway_token_value" \
    "$RAILWAY_BIN" up --detach --json --yes --no-gitignore \
    --project "$PROJECT_ID" \
    --environment "$ENVIRONMENT_ID" \
    --service "$SERVICE_ID" \
    --message "$message"
) >"$upload_log" 2>"$upload_error_log"
chmod 0600 "$upload_log" "$upload_error_log"

deployment_id=""
deployment_status=""
deployment_image_digest=""
deployment_reason=""
deployment_created_at=""
while bounded_deadline_timeout "$RAILWAY_COMMAND_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" >/dev/null; do
  inventory="$(run_with_deadline "$RAILWAY_COMMAND_TIMEOUT_SECONDS" \
    "$RECEIPT_COMMIT_RESERVE_SECONDS" \
    env NODE_OPTIONS="$RAILWAY_NODE_OPTIONS" \
    "$railway_token_name=$railway_token_value" \
    "$RAILWAY_BIN" deployment list --json --limit 30 \
    --project "$PROJECT_ID" \
    --environment "$ENVIRONMENT_ID" \
    --service "$SERVICE_ID")"
  match_count="$(jq --arg message "$message" '[.[] | select(.meta.cliMessage == $message)] | length' <<<"$inventory")"
  if [[ "$match_count" == 1 ]]; then
    deployment_id="$(jq -r --arg message "$message" '.[] | select(.meta.cliMessage == $message) | .id' <<<"$inventory")"
    deployment_status="$(jq -r --arg message "$message" '.[] | select(.meta.cliMessage == $message) | .status' <<<"$inventory")"
    deployment_image_digest="$(jq -r --arg message "$message" '.[] | select(.meta.cliMessage == $message) | .meta.imageDigest // empty' <<<"$inventory")"
    deployment_reason="$(jq -r --arg message "$message" '.[] | select(.meta.cliMessage == $message) | .meta.reason // empty' <<<"$inventory")"
    deployment_created_at="$(jq -r --arg message "$message" '.[] | select(.meta.cliMessage == $message) | .createdAt // empty' <<<"$inventory")"
    case "$deployment_status" in
      SUCCESS) break ;;
      FAILED|CRASHED|REMOVED|CANCELLED|CANCELED|SKIPPED)
        log "Railway deployment $deployment_id ended as $deployment_status" >&2
        exit 1
        ;;
    esac
  elif [[ "$match_count" != 0 ]]; then
    log "Railway returned more than one deployment for the unique message" >&2
    exit 1
  fi
  bounded_deadline_sleep "$POST_MUTATION_POLL_SECONDS" \
    "$RECEIPT_COMMIT_RESERVE_SECONDS" || break
done

[[ "$deployment_status" == SUCCESS && -n "$deployment_id" ]] || {
  log "Railway deployment did not become successful before timeout" >&2
  exit 1
}
[[ "$deployment_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ \
  && "$deployment_image_digest" =~ ^sha256:[0-9a-f]{64}$ \
  && "$deployment_reason" == deploy ]] || {
  log "successful candidate inventory has an invalid deployment identity" >&2
  exit 1
}
run_with_deadline "$RAILWAY_COMMAND_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  "$PYTHON_BIN" -I -S - "$candidate_prepared_at" "$deployment_created_at" <<'PY'
import sys
from datetime import UTC, datetime, timedelta

def parse(value):
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise SystemExit("candidate deployment timestamp has no timezone")
    return parsed.astimezone(UTC)

prepared, created = map(parse, sys.argv[1:3])
now = datetime.now(UTC)
if created < prepared - timedelta(seconds=120) or created > now + timedelta(seconds=120):
    raise SystemExit("candidate deployment timestamp is outside its journal boundary")
PY
candidate_topology="$work_root/candidate-railway-status.json"
run_with_deadline "$RAILWAY_COMMAND_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  env NODE_OPTIONS="$RAILWAY_NODE_OPTIONS" \
  "$railway_token_name=$railway_token_value" \
  "$RAILWAY_BIN" status --project "$PROJECT_ID" \
  --environment "$ENVIRONMENT_ID" --json >"$candidate_topology"
run_with_deadline "$RAILWAY_COMMAND_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  env PYTHONPATH="$checkout" "$PYTHON_BIN" - "$candidate_topology" \
  "$PROJECT_ID" "$ENVIRONMENT_ID" "$SERVICE_ID" "$deployment_id" \
  "$deployment_image_digest" "$deployment_reason" <<'PY'
import sys
from pathlib import Path

from ops.railway.verify_continuous_release import parse_status_topology

parse_status_topology(
    Path(sys.argv[1]).read_bytes(),
    expected_project_id=sys.argv[2],
    expected_environment_id=sys.argv[3],
    expected_service_id=sys.argv[4],
    expected_deployment_id=sys.argv[5],
    expected_image_digest=sys.argv[6],
    expected_deployment_reason=sys.argv[7],
)
PY

live_sha=""
while bounded_deadline_timeout "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" >/dev/null; do
  origin_timeout="$(bounded_deadline_timeout "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
    "$RECEIPT_COMMIT_RESERVE_SECONDS")" || break
  provider_sha="$(origin_release_sha "$PROVIDER_ORIGIN" "$origin_timeout")"
  origin_timeout="$(bounded_deadline_timeout "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
    "$RECEIPT_COMMIT_RESERVE_SECONDS")" || break
  public_sha="$(origin_release_sha "$PUBLIC_ORIGIN" "$origin_timeout")"
  if [[ "$provider_sha" == "$release_sha" && "$public_sha" == "$release_sha" ]]; then
    live_sha="$public_sha"
    break
  fi
  bounded_deadline_sleep "$POST_MUTATION_POLL_SECONDS" \
    "$RECEIPT_COMMIT_RESERVE_SECONDS" || break
done

[[ "$live_sha" == "$release_sha" ]] || {
  log "Railway succeeded but both live origins do not yet prove $release_sha" >&2
  exit 1
}

provider_manifest="$work_root/provider-railway-release.json"
public_manifest="$work_root/public-railway-release.json"
manifest_nonce="$(date +%s%N)"
curl_with_deadline "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  -fsS --proto '=https' --max-redirs 0 \
  "$PROVIDER_ORIGIN/railway-release.json?receipt=$manifest_nonce" \
  -o "$provider_manifest"
curl_with_deadline "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  -fsS --proto '=https' --max-redirs 0 \
  "$PUBLIC_ORIGIN/railway-release.json?receipt=$manifest_nonce" \
  -o "$public_manifest"
cmp -s "$provider_manifest" "$public_manifest" || {
  log "provider and public live manifests are not byte-identical" >&2
  exit 1
}
cmp -s "$provider_manifest" "$release_manifest_path" || {
  log "live manifest bytes differ from the durable pre-mutation release anchor" >&2
  exit 1
}
live_manifest_sha256="$(sha256_file "$provider_manifest")"
live_tree_sha256="$(jq -er \
  --arg release_sha "$release_sha" \
  'select(.schema_version == "palimpsest.railway-static-release.v1" and .source_commit == $release_sha and .state == "artifact_ready") | .tree_sha256 | select(type == "string" and test("^[0-9a-f]{64}$"))' \
  "$provider_manifest")"
live_file_count="$(jq -er '.file_count | select(type == "number" and . >= 1 and floor == .)' "$provider_manifest")"
live_total_bytes="$(jq -er '.total_bytes | select(type == "number" and . >= 1 and floor == .)' "$provider_manifest")"
[[ "$live_manifest_sha256" =~ ^[0-9a-f]{64}$ ]] || {
  log "live manifest digest is invalid" >&2
  exit 1
}
[[ "$live_manifest_sha256" == "$release_manifest_sha256" \
  && "$live_tree_sha256" == "$release_manifest_tree_sha256" \
  && "$live_file_count" == "$release_manifest_file_count" \
  && "$live_total_bytes" == "$release_manifest_total_bytes" ]] || {
  log "live manifest identity differs from the durable release anchor" >&2
  exit 1
}

# Both visitor paths must independently serve an HTTP-200 freshness contract
# bound to this release and this exact wire before latest-success can advance.
provider_freshness="$work_root/provider-freshness.json"
public_freshness="$work_root/public-freshness.json"
provider_live_attestation="$work_root/provider-publication-freshness-attestation.json"
public_live_attestation="$work_root/public-publication-freshness-attestation.json"
freshness_nonce="$(date +%s%N)"
provider_freshness_http="$(curl_with_deadline "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  -sS --proto '=https' --max-redirs 0 \
  --max-filesize 65536 -o "$provider_freshness" \
  -w '%{http_code}' "$PROVIDER_ORIGIN/freshness?receipt=$freshness_nonce")"
public_freshness_http="$(curl_with_deadline "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  -sS --proto '=https' --max-redirs 0 \
  --max-filesize 65536 -o "$public_freshness" \
  -w '%{http_code}' "$PUBLIC_ORIGIN/freshness?receipt=$freshness_nonce")"
[[ "$provider_freshness_http" == 200 && "$public_freshness_http" == 200 \
  && -s "$provider_freshness" && -s "$public_freshness" \
  && "$(stat -c '%s' "$provider_freshness")" -le 65536 \
  && "$(stat -c '%s' "$public_freshness")" -le 65536 ]] || {
  log "provider and public freshness endpoints did not both return bounded HTTP 200 proofs" >&2
  exit 1
}

provider_attestation_http="$(curl_with_deadline "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  -sS --proto '=https' --max-redirs 0 \
  --max-filesize 1048576 -o "$provider_live_attestation" \
  -w '%{http_code}' \
  "$PROVIDER_ORIGIN/readings/publication-freshness-attestation-latest.json?receipt=$freshness_nonce")"
public_attestation_http="$(curl_with_deadline "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
  "$RECEIPT_COMMIT_RESERVE_SECONDS" \
  -sS --proto '=https' --max-redirs 0 \
  --max-filesize 1048576 -o "$public_live_attestation" \
  -w '%{http_code}' \
