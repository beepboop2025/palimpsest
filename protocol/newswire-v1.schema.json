        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"github-government-takedowns"},"feed_url":{"const":"https://github.com/github/gov-takedowns/commits/master.atom"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"github-site-policy"},"feed_url":{"const":"https://github.com/github/site-policy/commits/main.atom"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"global-voices-china"},"feed_url":{"const":"https://globalvoices.org/-/world/east-asia/china/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"guardian-china"},"feed_url":{"const":"https://www.theguardian.com/world/china/rss"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"hk-censtat-releases"},"feed_url":{"const":"https://www.censtatd.gov.hk/data/en/press_release/rss.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"hksar-releases"},"feed_url":{"const":"https://www.info.gov.hk/gia/rss/general_en.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"hong-kong-free-press"},"feed_url":{"const":"https://hongkongfp.com/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"hrc-balochistan"},"feed_url":{"const":"https://hrcbalochistan.com/category/news-reports/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"hrcp-pakistan"},"feed_url":{"const":"https://hrcp-web.org/hrcpweb/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"kachin-news-group"},"feed_url":{"const":"https://kachinnews.com/feed/"}}},"minContains":1,"maxContains":1},
