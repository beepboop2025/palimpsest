[Unit]
Description=Filter mirrored Common Crawl metadata locally for %i
Documentation=file:///usr/local/libexec/palimpsest-common-crawl/current/README.md
After=local-fs.target systemd-tmpfiles-setup.service
RequiresMountsFor=/var/lib/palimpsest/common-crawl /var/lib/palimpsest/network-lane /mnt
ConditionFileIsExecutable=/usr/bin/python3
ConditionFileIsExecutable=/usr/local/bin/duckdb
ConditionPathExists=/etc/palimpsest/duckdb.sha256
ConditionFileIsExecutable=/usr/local/libexec/palimpsest-common-crawl/current/run_duckdb_filter.py
ConditionFileIsExecutable=/usr/local/libexec/palimpsest-common-crawl/current/verify-host-bundle.sh
ConditionPathExists=/usr/local/libexec/palimpsest-common-crawl/current/MANIFEST.sha256
ConditionPathExists=/usr/local/libexec/palimpsest-common-crawl/current/REVISION
ConditionPathExists=/etc/palimpsest/deployed-commit
ConditionPathExists=/etc/palimpsest/common-crawl-mirror/%i.json
ConditionPathIsDirectory=/var/lib/palimpsest/common-crawl
ConditionFileIsExecutable=/usr/local/libexec/palimpsest-network-lane/current/network_lane.py
ConditionFileIsExecutable=/usr/local/libexec/palimpsest-network-lane/current/verify-host-bundle.sh
ConditionPathExists=/usr/local/libexec/palimpsest-network-lane/current/MANIFEST.sha256
ConditionPathExists=/usr/local/libexec/palimpsest-network-lane/current/REVISION
ConditionPathExists=/var/lib/palimpsest/network-lane/dataset.lock

[Service]
Type=oneshot
User=10001
Group=10001
WorkingDirectory=/usr/local/libexec/palimpsest-common-crawl/current
ExecStartPre=/usr/bin/cmp -s /usr/local/libexec/palimpsest-common-crawl/current/REVISION /etc/palimpsest/deployed-commit
ExecStartPre=/bin/sh /usr/local/libexec/palimpsest-common-crawl/current/verify-host-bundle.sh
ExecStartPre=/usr/bin/cmp -s /usr/local/libexec/palimpsest-network-lane/current/REVISION /etc/palimpsest/deployed-commit
ExecStartPre=/bin/sh /usr/local/libexec/palimpsest-network-lane/current/verify-host-bundle.sh
ExecStart=/usr/bin/python3 /usr/local/libexec/palimpsest-common-crawl/current/run_duckdb_filter.py --crawl %i --mirror-config /etc/palimpsest/common-crawl-mirror/%i.json
TimeoutStartSec=12h
UMask=0027
Nice=15
IOSchedulingClass=idle
CPUQuota=200%
TasksMax=64
MemoryHigh=5G
MemoryMax=6G
MemorySwapMax=0
LimitNOFILE=4096
KillMode=control-group

ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/usr/local/libexec/palimpsest-common-crawl /usr/local/libexec/palimpsest-network-lane /usr/local/bin/duckdb /etc/palimpsest/duckdb.sha256 /etc/palimpsest/common-crawl-mirror /etc/palimpsest/deployed-commit /var/lib/palimpsest/network-lane /mnt
ReadWritePaths=/var/lib/palimpsest/common-crawl /var/lib/palimpsest/network-lane/dataset.lock
NoExecPaths=/mnt /var/lib/palimpsest/common-crawl
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
PrivateNetwork=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
