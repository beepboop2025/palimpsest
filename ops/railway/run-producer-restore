    handoff = _expect_keys(
        graph["phase2_handoff"],
        {"receipt", "receipt_sha256"},
        label="resume handoff reference",
    )
    failure = _expect_keys(
        receipt["failure"],
        {"error_class", "error_message", "exit_code", "resume_main_sha", "run_id"},
        label="resume failure evidence",
    )
    resume = _expect_keys(
        receipt["resume"], {"receipt", "receipt_sha256"}, label="resume ancestry"
    )
    authority = _expect_keys(
        receipt["authority"],
        {
            "exclusive_writer_ack",
            "hourly_publication_enabled",
            "in_flight_run_id",
            "reconciled_run",
            "resume_main_sha",
            "workflow_states",
        },
        label="resume cleanup authority",
    )
    if (
        receipt["schema_version"] != "palimpsest.github-producer-restore.v2"
        or receipt["status"] != "failed-closed"
        or receipt["repository"] != repository
        or authority
        != {
            "exclusive_writer_ack": "absent",
            "hourly_publication_enabled": "false",
            "in_flight_run_id": None,
            "reconciled_run": authority["reconciled_run"],
            "resume_main_sha": receipt["final_main_sha"],
            "workflow_states": {
                spec.filename: "disabled_manually" for spec in WORKFLOWS
            },
        }
        or graph["host_sha"] != host_sha
        or graph["publication_sha"] != publication_sha
        or graph["public_release_sha"] != public_release_sha
        or phase3["receipt_sha256"] != phase3_sha256
        or proof["receipt_sha256"] != proof_sha256
        or handoff["receipt_sha256"] != handoff_sha256
        or not _is_sha40(receipt["final_main_sha"])
        or receipt["final_main_sha"] != failure["resume_main_sha"]
        or not isinstance(receipt["attempt_id"], str)
        or NONCE32.fullmatch(receipt["attempt_id"]) is None
        or not isinstance(receipt["evidence_directory"], str)
        or not Path(receipt["evidence_directory"]).is_absolute()
        or not isinstance(failure["exit_code"], int)
        or failure["exit_code"] == 0
        or not isinstance(failure["error_class"], str)
        or not isinstance(failure["error_message"], str)
        or (failure["run_id"] is not None and not _positive_int(failure["run_id"]))
        or resume["receipt"] is not None
        and not isinstance(resume["receipt"], str)
        or resume["receipt_sha256"] is not None
        and not _is_sha256(resume["receipt_sha256"])
    ):
        raise RestoreError(
            "producer restore resume receipt is not exact failed-closed authority"
        )
    if authority["reconciled_run"] is not None:
        reconciled = _expect_keys(
            authority["reconciled_run"],
            {"conclusion", "run_attempt", "run_id", "status"},
            label="reconciled producer run",
        )
        if (
            reconciled["status"] != "completed"
            or not _positive_int(reconciled["run_id"])
            or not _positive_int(reconciled["run_attempt"])
            or not isinstance(reconciled["conclusion"], str)
        ):
            raise RestoreError("resume reconciled run evidence is invalid")
    stages = receipt["completed_stages"]
    if not isinstance(stages, list) or len(stages) > len(WORKFLOWS):
        raise RestoreError("resume completed stage inventory is invalid")
    for index, reference in enumerate(stages):
        item = _expect_keys(
            reference,
            {
                "file",
                "id",
                "main_after",
                "main_before",
                "order",
                "outcome",
                "receipt",
                "receipt_sha256",
                "run_id",
            },
            label="resume stage reference",
        )
        spec = WORKFLOWS[index]
        stage_path = Path(item["receipt"] if isinstance(item["receipt"], str) else "")
        if (
            item["file"] != spec.filename
            or item["id"] != spec.workflow_id
            or item["order"] != spec.order
            or not _is_sha40(item["main_before"])
            or not _is_sha40(item["main_after"])
            or not _is_sha256(item["receipt_sha256"])
            or not _positive_int(item["run_id"])
            or not stage_path.is_absolute()
        ):
            raise RestoreError("resume stage reference semantics are invalid")
        stage_raw, stage_document = _read_private_canonical(
            stage_path, label="prior producer stage receipt", maximum=MAX_RECEIPT_BYTES
        )
        if (
            hashlib.sha256(stage_raw).hexdigest() != item["receipt_sha256"]
            or stage_document.get("schema_version")
            != "palimpsest.github-producer-stage.v1"
            or stage_document.get("status") != "verified"
            or stage_document.get("main_before") != item["main_before"]
            or stage_document.get("main_after") != item["main_after"]
        ):
            raise RestoreError("resume stage receipt linkage is invalid")
    _utc(receipt["terminal_at"], label="resume receipt terminal_at")
    if (
        hashlib.sha256(raw).hexdigest()
        != hashlib.sha256(_canonical_json(receipt)).hexdigest()
    ):
        raise RestoreError("producer restore resume receipt bytes are not canonical")
    return receipt["final_main_sha"]


def _load_prerequisites(
    *,
    expected_host_sha: str,
    expected_public_release_sha: str,
    phase3_path: Path,
    proof_complete_path: Path,
    handoff_path: Path,
    resume_path: Path | None,
    repository: str,
) -> Prerequisites:
    phase3_raw, phase3 = _read_private_canonical(
        phase3_path, label="Phase 3 finalized receipt", maximum=MAX_RECEIPT_BYTES
    )
    transaction, finalized_at, host_proof_path, expected_proof_sha, recovery = (
        _validate_phase3(phase3, expected_host_sha=expected_host_sha)
    )
    proof_raw, proof = _read_private_canonical(
        proof_complete_path,
        label="Phase 3 proof-complete receipt",
        maximum=MAX_RECEIPT_BYTES,
    )
    proof_sha = hashlib.sha256(proof_raw).hexdigest()
    if (
        proof_sha != expected_proof_sha
        or proof_complete_path.name != Path(host_proof_path).name
    ):
        raise RestoreError(
            "Phase 3 proof-complete copy does not match finalized authority"
        )
    handoff_raw, handoff = _read_private_canonical(
        handoff_path, label="Phase 2 v2 handoff receipt", maximum=64 * 1024
    )
    publication_sha, handoff = _validate_handoff(
        handoff,
        host_sha=expected_host_sha,
        public_release_sha=expected_public_release_sha,
    )
    handoff_sha = hashlib.sha256(handoff_raw).hexdigest()
    proof_generated_at = _validate_proof_complete(
        proof,
        host_sha=expected_host_sha,
        transaction=transaction,
        handoff=handoff,
        handoff_sha256=handoff_sha,
        recovery_binding=recovery,
    )
    if handoff_raw != _canonical_json(proof["publication"]["handoff"]):
        raise RestoreError(
            "Phase 2 handoff bytes do not equal proof-complete embedded handoff"
        )
    if _utc(proof_generated_at, label="proof-complete generated_at") > _utc(
        finalized_at, label="Phase 3 finalized_at"
    ):
        raise RestoreError("proof-complete receipt post-dates Phase 3 finalization")
    restore_base_sha = expected_public_release_sha
    resume_sha: str | None = None
    if resume_path is not None:
        resume_raw, resume = _read_private_canonical(
            resume_path,
            label="producer restore resume receipt",
            maximum=MAX_RECEIPT_BYTES,
        )
        restore_base_sha = _validate_resume_receipt(
            resume_raw,
            resume,
            repository=repository,
            host_sha=expected_host_sha,
            publication_sha=publication_sha,
            public_release_sha=expected_public_release_sha,
            phase3_sha256=hashlib.sha256(phase3_raw).hexdigest(),
            proof_sha256=proof_sha,
            handoff_sha256=handoff_sha,
        )
        resume_sha = hashlib.sha256(resume_raw).hexdigest()
    return Prerequisites(
        host_sha=expected_host_sha,
        public_release_sha=expected_public_release_sha,
        publication_sha=publication_sha,
        phase3_path=phase3_path,
        phase3_sha256=hashlib.sha256(phase3_raw).hexdigest(),
        phase3_transaction=transaction,
        phase3_finalized_at=finalized_at,
        proof_complete_path=proof_complete_path,
        proof_complete_sha256=proof_sha,
        proof_complete_generated_at=proof_generated_at,
        handoff_path=handoff_path,
        handoff_sha256=handoff_sha,
        resume_path=resume_path,
        resume_sha256=resume_sha,
        restore_base_sha=restore_base_sha,
    )


def _workflow_metadata(
    deadline: Deadline, repository: str, spec: WorkflowSpec
) -> dict[str, Any]:
    value = _strict_json_text(
        _gh(
            deadline,
            "api",
            f"repos/{repository}/actions/workflows/{spec.workflow_id}",
            label=f"inspect {spec.filename}",
        ),
        label=f"{spec.filename} metadata",
    )
    if not isinstance(value, dict):
        raise RestoreError(f"{spec.filename} metadata is not an object")
    selected = {key: value.get(key) for key in ("id", "name", "path", "state")}
    if selected != {
        "id": spec.workflow_id,
        "name": spec.display_name,
        "path": f".github/workflows/{spec.filename}",
        "state": selected["state"],
    } or selected["state"] not in {"active", "disabled_manually"}:
        raise RestoreError(f"{spec.filename} workflow identity is not exact")
    return selected


def _workflow_states(deadline: Deadline, repository: str) -> list[str]:
    return [
        _workflow_metadata(deadline, repository, spec)["state"] for spec in WORKFLOWS
    ]


def _require_stage_states(
    deadline: Deadline, repository: str, *, active_index: int | None
) -> list[str]:
    states = _workflow_states(deadline, repository)
    expected = [
        "active" if index == active_index else "disabled_manually" for index in range(3)
    ]
    if states != expected:
        raise RestoreError(
            f"producer workflow states are not exact: expected {expected}, received {states}"
        )
    return states


def _require_activation_prefix(
    deadline: Deadline, repository: str, *, active_count: int
) -> list[str]:
    states = _workflow_states(deadline, repository)
    expected = [
        "active" if index < active_count else "disabled_manually" for index in range(3)
    ]
    if states != expected:
        raise RestoreError(
            "producer activation boundary states are not exact: "
            f"expected {expected}, received {states}"
        )
    return states


def _parse_dispatch_inputs(raw: str, *, filename: str) -> tuple[str, ...]:
    if "\t" in raw or "\r" in raw:
        raise RestoreError(f"{filename} YAML uses unsupported framing")
    lines = raw.splitlines()
    try:
        on_index = next(index for index, line in enumerate(lines) if line == "on:")
    except StopIteration as error:
        raise RestoreError(f"{filename} has no exact top-level on block") from error
    dispatch_index: int | None = None
    inline = ""
    for index in range(on_index + 1, len(lines)):
        line = lines[index]
        if line and not line.startswith(" ") and not line.lstrip().startswith("#"):
            break
        match = re.fullmatch(r"  workflow_dispatch:\s*(.*)", line)
        if match:
            if dispatch_index is not None:
                raise RestoreError(f"{filename} repeats workflow_dispatch")
            dispatch_index = index
            inline = match.group(1)
    if dispatch_index is None:
        raise RestoreError(f"{filename} does not support workflow_dispatch")
    if inline:
        if inline != "{}":
            raise RestoreError(f"{filename} has unsupported inline dispatch syntax")
        return ()
    inputs_index: int | None = None
    for index in range(dispatch_index + 1, len(lines)):
        line = lines[index]
        if (
            line
            and len(line) - len(line.lstrip(" ")) <= 2
            and not line.lstrip().startswith("#")
        ):
            break
        if line == "    inputs:":
            inputs_index = index
            break
    if inputs_index is None:
        return ()
    names: list[str] = []
    index = inputs_index + 1
    while index < len(lines):
        line = lines[index]
        if (
            line
            and len(line) - len(line.lstrip(" ")) <= 4
            and not line.lstrip().startswith("#")
        ):
            break
        match = re.fullmatch(r"      ([a-z][a-z0-9_]*):", line)
        if not match:
            index += 1
            continue
        name = match.group(1)
        if name in names:
            raise RestoreError(f"{filename} repeats dispatch input {name}")
        fields: dict[str, str] = {}
        index += 1
        while index < len(lines):
            child = lines[index]
            if re.fullmatch(r"      [a-z][a-z0-9_]*:", child):
                break
            if (
                child
                and len(child) - len(child.lstrip(" ")) <= 4
                and not child.lstrip().startswith("#")
            ):
                break
            field = re.fullmatch(r"        (required|type):\s*(\S+)\s*", child)
            if field:
                fields[field.group(1)] = field.group(2)
            index += 1
        if fields != {"required": "true", "type": "string"}:
            raise RestoreError(
                f"{filename} dispatch input {name} is not required string"
            )
        names.append(name)
    return tuple(names)


def _workflow_contract(
    deadline: Deadline, repository: str, spec: WorkflowSpec, source_sha: str
) -> str:
    raw = _gh(
        deadline,
        "api",
        "-H",
        "Accept: application/vnd.github.raw+json",
        f"repos/{repository}/contents/.github/workflows/{spec.filename}?ref={source_sha}",
        label=f"read {spec.filename} YAML",
        maximum=MAX_WORKFLOW_BYTES,
    )
    inputs = _parse_dispatch_inputs(raw, filename=spec.filename)
    if inputs != spec.dispatch_inputs:
        raise RestoreError(
            f"{spec.filename} dispatch inputs changed: expected {spec.dispatch_inputs}, got {inputs}"
        )
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()


def _run_snapshot(
    deadline: Deadline, repository: str, spec: WorkflowSpec
) -> dict[int, dict[str, Any]]:
    value = _strict_json_text(
        _gh(
            deadline,
            "api",
            f"repos/{repository}/actions/workflows/{spec.workflow_id}/runs?per_page=100",
            label=f"snapshot {spec.filename} runs",
        ),
        label=f"{spec.filename} run inventory",
    )
    if not isinstance(value, dict) or not isinstance(value.get("workflow_runs"), list):
        raise RestoreError(f"{spec.filename} run inventory is malformed")
    result: dict[int, dict[str, Any]] = {}
    for raw in value["workflow_runs"]:
        if not isinstance(raw, dict):
            raise RestoreError(
                f"{spec.filename} run inventory contains a malformed run"
            )
        selected = {
            key: raw.get(key)
            for key in (
                "id",
                "event",
                "head_sha",
                "head_branch",
                "run_attempt",
                "status",
                "conclusion",
                "created_at",
                "name",
                "path",
            )
        }
        run_id = selected["id"]
        if not _positive_int(run_id) or run_id in result:
            raise RestoreError(
                f"{spec.filename} run inventory has duplicate/invalid IDs"
            )
        result[run_id] = selected
    return result


def _all_run_snapshots(
    deadline: Deadline, repository: str
) -> list[dict[int, dict[str, Any]]]:
    return [_run_snapshot(deadline, repository, spec) for spec in WORKFLOWS]


def _mark_producer_runs_unproved(run_state: RunState) -> None:
    previous_mask = signal.pthread_sigmask(
        signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}
    )
    try:
        run_state.producer_runs_unproved = True
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)


def _validate_attempt_run_set(
    run_state: RunState,
    snapshots: list[dict[int, dict[str, Any]]],
    *,
    require_completed: bool,
) -> list[list[int]]:
    baseline = run_state.attempt_run_snapshots
    if baseline is None or len(baseline) != len(WORKFLOWS):
        _mark_producer_runs_unproved(run_state)
        raise RestoreError("producer attempt run baseline is unavailable")
    additions: list[list[int]] = []
    for index, spec in enumerate(WORKFLOWS):
        current = snapshots[index]
        new_ids = sorted(set(current) - set(baseline[index]))
        expected = sorted(
            run_id
            for run_id, (bound_index, _head_sha) in run_state.bound_runs.items()
            if bound_index == index
        )
        expected_ids = set(baseline[index]) | set(expected)
        baseline_changed = any(
            current.get(run_id) != snapshot
            for run_id, snapshot in baseline[index].items()
        )
        if set(current) != expected_ids or new_ids != expected or baseline_changed:
            _mark_producer_runs_unproved(run_state)
            raise RestoreError(
                f"post-attempt {spec.filename} run set is not exact: "
                f"expected {expected}, received {new_ids}"
            )
        for run_id in new_ids:
            run = current[run_id]
            _bound_index, expected_sha = run_state.bound_runs[run_id]
            if (
                run.get("id") != run_id
                or run.get("event") != "workflow_dispatch"
                or run.get("head_sha") != expected_sha
                or run.get("head_branch") != "main"
                or run.get("run_attempt") != 1
                or run.get("name") != spec.display_name
                or run.get("path") != f".github/workflows/{spec.filename}"
                or run.get("status")
                not in (
                    {"completed"}
                    if require_completed
                    else ACTIVE_RUN_STATES | {"completed"}
                )
                or (
                    run.get("status") == "completed"
                    and not isinstance(run.get("conclusion"), str)
                )
            ):
                _mark_producer_runs_unproved(run_state)
                raise RestoreError(
                    f"post-attempt run {run_id} is not the exact bound producer run"
                )
        additions.append(new_ids)
    return additions


def _require_initial_run_quiet(
    run_state: RunState, snapshots: list[dict[int, dict[str, Any]]]
) -> None:
    for index, spec in enumerate(WORKFLOWS):
        active = sorted(
            run_id
            for run_id, run in snapshots[index].items()
            if run.get("status") in ACTIVE_RUN_STATES
        )
        if active:
            _mark_producer_runs_unproved(run_state)
            raise RestoreError(f"{spec.filename} has active pre-attempt runs: {active}")


def _validate_bound_run(
    run: dict[str, Any],
    *,
    spec: WorkflowSpec,
    run_id: int,
    expected_sha: str,
    not_before: datetime,
) -> None:
    created_at = _utc(run.get("created_at"), label=f"run {run_id} created_at")
    now = datetime.now(UTC)
    if (
        run.get("id") != run_id
        or run.get("event") != "workflow_dispatch"
        or run.get("head_sha") != expected_sha
        or run.get("head_branch") != "main"
        or run.get("run_attempt") != 1
        or run.get("name") != spec.display_name
        or run.get("path") != f".github/workflows/{spec.filename}"
        or created_at < not_before - timedelta(seconds=RUN_CREATION_SKEW_SECONDS)
        or created_at > now + timedelta(seconds=RUN_CREATION_SKEW_SECONDS)
    ):
        raise RestoreError(
            f"new {spec.filename} run is not the exact manual transaction"
        )


def _poll_new_manual_run(
    deadline: Deadline,
    *,
    repository: str,
    spec: WorkflowSpec,
    before: dict[int, dict[str, Any]],
    expected_sha: str,
    not_before: datetime,
) -> tuple[int, dict[str, Any]]:
    while True:
        current = _run_snapshot(deadline, repository, spec)
        new_ids = sorted(set(current) - set(before))
        if len(new_ids) > 1:
            raise RestoreError(
                f"{spec.filename} gained multiple runs; schedule/dispatch race rejected"
            )
        if new_ids:
            run_id = new_ids[0]
            _validate_bound_run(
                current[run_id],
                spec=spec,
                run_id=run_id,
                expected_sha=expected_sha,
                not_before=not_before,
            )
            return run_id, current[run_id]
        deadline.sleep()


def _run_view(
    deadline: Deadline, repository: str, spec: WorkflowSpec, run_id: int
) -> dict[str, Any]:
    value = _strict_json_text(
        _gh(
            deadline,
            "api",
            f"repos/{repository}/actions/runs/{run_id}",
            label=f"inspect run {run_id}",
        ),
        label=f"run {run_id}",
    )
    if not isinstance(value, dict):
        raise RestoreError(f"run {run_id} metadata is malformed")
    selected = {
        key: value.get(key)
        for key in (
            "id",
            "event",
            "head_sha",
            "head_branch",
            "run_attempt",
            "status",
            "conclusion",
            "created_at",
            "updated_at",
            "name",
            "path",
        )
    }
    _validate_bound_run(
        selected,
        spec=spec,
        run_id=run_id,
        expected_sha=selected.get("head_sha", ""),
        not_before=_utc(selected.get("created_at"), label=f"run {run_id} created_at"),
    )
    return selected


def _wait_success(
    deadline: Deadline,
    *,
    repository: str,
    spec: WorkflowSpec,
    run_id: int,
    expected_sha: str,
    not_before: datetime,
) -> dict[str, Any]:
    while True:
        run = _run_view(deadline, repository, spec, run_id)
        _validate_bound_run(
            run,
            spec=spec,
            run_id=run_id,
            expected_sha=expected_sha,
            not_before=not_before,
        )
        if run["status"] == "completed":
            if run["conclusion"] != "success":
                raise RestoreError(f"run {run_id} did not conclude successfully")
            _utc(run["updated_at"], label=f"run {run_id} updated_at")
            return run
        if run["status"] not in ACTIVE_RUN_STATES:
            raise RestoreError(f"run {run_id} has unsupported status {run['status']!r}")
        deadline.sleep()


def _validate_jobs(
    deadline: Deadline, repository: str, spec: WorkflowSpec, run_id: int
) -> list[dict[str, Any]]:
    value = _strict_json_text(
        _gh(
            deadline,
            "api",
            f"repos/{repository}/actions/runs/{run_id}/jobs?filter=latest&per_page=100",
            label=f"inspect run {run_id} jobs",
        ),
        label=f"run {run_id} jobs",
    )
    if (
        not isinstance(value, dict)
        or value.get("total_count") != 1
        or not isinstance(value.get("jobs"), list)
        or len(value["jobs"]) != 1
    ):
        raise RestoreError(f"run {run_id} does not have its one exact meaningful job")
    raw = value["jobs"][0]
    if not isinstance(raw, dict) or raw.get("name") != spec.job_name:
        raise RestoreError(f"run {run_id} job identity is invalid")
    steps = raw.get("steps")
    if not isinstance(steps, list) or not steps:
        raise RestoreError(f"run {run_id} has no meaningful step evidence")
    selected_steps: list[dict[str, Any]] = []
    success_count = 0
    for step in steps:
        if not isinstance(step, dict):
            raise RestoreError(f"run {run_id} contains a malformed step")
        selected = {
            "conclusion": step.get("conclusion"),
            "name": step.get("name"),
            "number": step.get("number"),
            "status": step.get("status"),
        }
        if (
            not isinstance(selected["name"], str)
            or not _positive_int(selected["number"])
            or selected["status"] != "completed"
            or selected["conclusion"] not in {"success", "skipped"}
        ):
            raise RestoreError(f"run {run_id} has an incomplete or failed step")
        success_count += selected["conclusion"] == "success"
        selected_steps.append(selected)
    if not success_count:
        raise RestoreError(f"run {run_id} has no successful meaningful step")
    if (
        raw.get("status") != "completed"
        or raw.get("conclusion") != "success"
        or raw.get("run_attempt") != 1
    ):
        raise RestoreError(f"run {run_id} job did not succeed on attempt one")
    return [
        {
            "conclusion": "success",
            "name": spec.job_name,
            "run_attempt": 1,
            "steps": selected_steps,
        }
    ]


def _post_run_race_check(
    deadline: Deadline,
    *,
    repository: str,
    before: list[dict[int, dict[str, Any]]],
    current_index: int,
    bound_run_id: int,
    run_state: RunState,
) -> list[list[int]]:
    after = _all_run_snapshots(deadline, repository)
    new_ids: list[list[int]] = []
    for index in range(3):
        additions = sorted(set(after[index]) - set(before[index]))
        expected = [bound_run_id] if index == current_index else []
        if additions != expected:
            _mark_producer_runs_unproved(run_state)
            raise RestoreError(
                f"producer run race detected for {WORKFLOWS[index].filename}: {additions}"
            )
        new_ids.append(additions)
    return new_ids


def _commit_lineage(
    deadline: Deadline,
    *,
    repository: str,
    before: str,
    after: str,
    prefix: str,
) -> dict[str, Any]:
    value = _strict_json_text(
        _gh(
            deadline,
            "api",
            f"repos/{repository}/compare/{before}...{after}",
            label="verify producer commit lineage",
        ),
        label="producer commit comparison",
    )
    if not isinstance(value, dict) or not isinstance(value.get("commits"), list):
        raise RestoreError("producer commit comparison is malformed")
    commits = value["commits"]
    if (
        value.get("status") != "ahead"
        or value.get("ahead_by") != 1
        or value.get("behind_by") != 0
        or value.get("total_commits") != 1
        or len(commits) != 1
    ):
        raise RestoreError("producer main advance is not exactly one commit")
    commit = commits[0]
    parents = commit.get("parents") if isinstance(commit, dict) else None
    message = (
        commit.get("commit", {}).get("message")
        if isinstance(commit, dict) and isinstance(commit.get("commit"), dict)
        else None
    )
    if (
        commit.get("sha") != after
        or not isinstance(parents, list)
        or [item.get("sha") for item in parents if isinstance(item, dict)] != [before]
        or not isinstance(message, str)
        or not message.startswith(prefix)
    ):
        raise RestoreError("producer commit identity is not exact")
    return {"message": message, "parent": before, "sha": after}


def _require_ancestry(
    deadline: Deadline, *, repository: str, ancestor: str, descendant: str, label: str
) -> str:
    value = _strict_json_text(
        _gh(
            deadline,
            "api",
            f"repos/{repository}/compare/{ancestor}...{descendant}",
            label=label,
        ),
        label=label,
    )
    if (
        not isinstance(value, dict)
        or value.get("status") not in {"ahead", "identical"}
        or not isinstance(value.get("ahead_by"), int)
        or value.get("behind_by") != 0
        or (
            ancestor == descendant
            and (value.get("status"), value.get("ahead_by")) != ("identical", 0)
        )
        or (
            ancestor != descendant
            and (value.get("status") != "ahead" or value.get("ahead_by", 0) < 1)
        )
    ):
        raise RestoreError(f"{label} did not prove descendant-or-identical lineage")
    return value["status"]


def _artifact_inventory(
    deadline: Deadline, repository: str, run_id: int
) -> list[dict[str, Any]]:
    value = _strict_json_text(
        _gh(
            deadline,
            "api",
            f"repos/{repository}/actions/runs/{run_id}/artifacts?per_page=100",
            label=f"inspect run {run_id} artifacts",
        ),
        label=f"run {run_id} artifacts",
    )
    if not isinstance(value, dict) or not isinstance(value.get("artifacts"), list):
        raise RestoreError(f"run {run_id} artifact inventory is malformed")
    result: list[dict[str, Any]] = []
    for item in value["artifacts"]:
        if not isinstance(item, dict):
            raise RestoreError(f"run {run_id} artifact inventory is malformed")
        result.append(item)
    return result


def _download_exact_artifact(
    deadline: Deadline,
    *,
    repository: str,
    run_id: int,
    artifact_name: str,
    expected_filename: str,
    temporary_directory: Path,
) -> tuple[bytes, dict[str, Any]]:
    matches = [
        item
        for item in _artifact_inventory(deadline, repository, run_id)
        if item.get("name") == artifact_name
    ]
    if len(matches) != 1:
        raise RestoreError(f"run {run_id} lacks its one exact {artifact_name} artifact")
    item = matches[0]
    workflow_run = item.get("workflow_run")
    if (
        not _positive_int(item.get("id"))
        or item.get("expired") is not False
        or not _positive_int(item.get("size_in_bytes"))
        or not isinstance(workflow_run, dict)
        or workflow_run.get("id") != run_id
    ):
        raise RestoreError(f"run {run_id} artifact metadata is not exact")
    destination = temporary_directory / f"artifact-{run_id}"
    destination.mkdir(mode=0o700)
    _gh(
        deadline,
        "run",
        "download",
        str(run_id),
        "--repo",
        repository,
        "--name",
        artifact_name,
        "--dir",
        str(destination),
        label=f"download {artifact_name}",
    )
    entries = list(destination.iterdir())
    if len(entries) != 1 or entries[0].name != expected_filename:
        raise RestoreError(f"{artifact_name} contents are not exact")
    path = entries[0]
    details = path.lstat()
    if not stat.S_ISREG(details.st_mode) or details.st_nlink != 1:
        raise RestoreError(f"{artifact_name} contains an unsafe receipt")
    raw = path.read_bytes()
    return raw, {
        "artifact_id": item["id"],
        "file": expected_filename,
        "name": artifact_name,
        "receipt_sha256": hashlib.sha256(raw).hexdigest(),
        "size_in_bytes": len(raw),
    }


def _validate_osint_artifact(
    raw: bytes,
    *,
    run_id: int,
    head_sha: str,
    nonce: str,
    main_after: str,
    repository: str,
) -> tuple[str, dict[str, Any]]:
    value = _strict_json(raw, label="OSINT manual outcome", maximum=MAX_JSON_BYTES)
    if raw != _canonical_json(value):
        raise RestoreError("OSINT manual outcome is not canonical")
    receipt = _expect_keys(
        value,
        {
            "acquisition_base_sha",
            "base_sha",
            "candidate_changed",
            "candidate_sha",
            "current_main_sha",
            "event",
            "expected_deploy_sha",
            "head_sha",
            "output_parents",
            "output_sha",
            "publication_commit",
            "push_exit_code",
            "push_outcome",
            "recorded_at",
            "release_nonce",
            "repository",
            "result",
            "retry_candidate_changed",
            "retry_candidate_sha",
            "retry_exit_code",
            "retry_outcome",
            "run_attempt",
            "run_id",
            "schema_version",
            "synchronized_candidate_changed",
            "workflow",
            "workflow_name",
        },
        label="OSINT manual outcome",
    )
    _utc(receipt["recorded_at"], label="OSINT manual outcome recorded_at")
    if not (
        _positive_int(receipt["run_id"])
        and _positive_int(receipt["run_attempt"])
        and _is_sha40(receipt["candidate_sha"])
        and (
            receipt["retry_candidate_sha"] is None
            or _is_sha40(receipt["retry_candidate_sha"])
        )
        and (
            receipt["synchronized_candidate_changed"] is None
            or isinstance(receipt["synchronized_candidate_changed"], bool)
        )
        and (
            receipt["retry_candidate_changed"] is None
            or isinstance(receipt["retry_candidate_changed"], bool)
        )
        and (
            receipt["push_exit_code"] is None
            or (
                isinstance(receipt["push_exit_code"], int)
                and not isinstance(receipt["push_exit_code"], bool)
            )
        )
        and (
            receipt["retry_exit_code"] is None
            or (
                isinstance(receipt["retry_exit_code"], int)
                and not isinstance(receipt["retry_exit_code"], bool)
            )
        )
        and receipt["push_outcome"] in {"success", "failure", "skipped"}
        and receipt["retry_outcome"] in {"success", "failure", "skipped"}
        and receipt["schema_version"] == "palimpsest.osint-manual-outcome.v1"
        and receipt["repository"] == repository
        and receipt["workflow"] == ".github/workflows/osint-china-v2-refresh.yml"
        and receipt["workflow_name"] == "Refresh OSINT China roll-up v2"
        and receipt["event"] == "workflow_dispatch"
        and receipt["run_id"] == run_id
        and receipt["run_attempt"] == 1
        and receipt["head_sha"] == head_sha
        and receipt["expected_deploy_sha"] == head_sha
        and receipt["acquisition_base_sha"] == head_sha
        and receipt["base_sha"] == head_sha
        and receipt["release_nonce"] == nonce
        and receipt["current_main_sha"] == main_after
        and receipt["publication_commit"] == main_after
        and receipt["result"] in {"committed", "no_change"}
    ):
        raise RestoreError("OSINT manual outcome authority is invalid")
    if receipt["result"] == "no_change":
        if not (
            receipt["candidate_changed"] is False
            and receipt["candidate_sha"] == head_sha
            and receipt["output_sha"] == head_sha == main_after
            and receipt["output_parents"] == []
            and receipt["synchronized_candidate_changed"] is None
            and receipt["retry_candidate_changed"] is None
            and receipt["retry_candidate_sha"] is None
            and receipt["push_exit_code"] is None
            and receipt["retry_exit_code"] is None
            and receipt["push_outcome"] == "skipped"
            and receipt["retry_outcome"] == "skipped"
        ):
            raise RestoreError("OSINT no-change outcome is not exact")
        return "no_change", receipt
    if not (
        receipt["candidate_changed"] is True
        and receipt["output_sha"] == main_after
        and receipt["output_parents"] == [head_sha]
        and (
            (
                receipt["candidate_sha"] == main_after
                and (
                    receipt["synchronized_candidate_changed"] is None
                    or receipt["synchronized_candidate_changed"] is True
                )
                and receipt["retry_candidate_changed"] is None
                and receipt["retry_candidate_sha"] is None
                and (
                    (
                        receipt["push_exit_code"] == 0
                        and receipt["push_outcome"] == "success"
                    )
                    or (
                        receipt["push_exit_code"] == 76
                        and receipt["push_outcome"] == "failure"
                    )
                )
                and receipt["retry_exit_code"] is None
                and receipt["retry_outcome"] == "skipped"
            )
            or (
                receipt["push_exit_code"] == 75
                and receipt["push_outcome"] == "failure"
                and receipt["retry_candidate_changed"] is True
                and receipt["retry_candidate_sha"] == main_after
                and (
                    (
                        receipt["retry_exit_code"] == 0
                        and receipt["retry_outcome"] == "success"
                    )
                    or (
                        receipt["retry_exit_code"] == 76
                        and receipt["retry_outcome"] == "failure"
                    )
                )
            )
        )
    ):
        raise RestoreError("OSINT committed outcome is not exact-child authority")
    return "published", receipt


