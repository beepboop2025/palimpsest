# Explicit, reviewable authorization. Both flags are required for the known
# fixed Hetzner host; removing either causes the prober to refuse active work.
BLEEDTHROUGH_LIVE=1
BLEEDTHROUGH_ALLOW_BOX=1

# Publish only coarse provenance. Never put a hostname, IP, or provider account
# identifier in these fields.
BLEEDTHROUGH_VANTAGE_KIND="single fixed-IP VPS outside China"
BLEEDTHROUGH_VANTAGE_COUNTRY=DE

# Immutable application code and operator-owned mutable state are separate.
PALIMPSEST_STATE_ROOT=/var/lib/palimpsest
PALIMPSEST_KILLFILE=/var/lib/palimpsest/readings/state/STOP
PALIMPSEST_DEPLOYED_COMMIT_FILE=/etc/palimpsest/deployed-commit
BLEEDTHROUGH_PREFIXES=/var/lib/palimpsest/bleedthrough/prefixes.json
BLEEDTHROUGH_TARGETS=/var/lib/palimpsest/bleedthrough/targets.json
BLEEDTHROUGH_STORE=/var/lib/palimpsest/bleedthrough/baselines
BLEEDTHROUGH_LOCKFILE=/var/lib/palimpsest/bleedthrough/round.lock
BLEEDTHROUGH_READINGS=/var/lib/palimpsest/readings
BLEEDTHROUGH_OUT=/var/lib/palimpsest/readings/bleedthrough-latest.json
BLEEDTHROUGH_HIST=/var/lib/palimpsest/readings/bleedthrough-history.jsonl

# Structural traffic limits. One token is consumed before every DNS query;
# the kill file is re-checked before every query as well as at startup.
BLEEDTHROUGH_RATE=5
BLEEDTHROUGH_BURST=24
BLEEDTHROUGH_WAIT=1.2
BLEEDTHROUGH_FETCH_THROTTLE=1.0

# Stable candidate selection makes a round reproducible and avoids silently
# changing the target population merely because the timer fired again.
BLEEDTHROUGH_SEED=20260811
