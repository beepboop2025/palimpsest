        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"measurement-lab"},"feed_url":{"const":"https://www.measurementlab.net/feed.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"myanmar-now"},"feed_url":{"const":"https://myanmar-now.org/en/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"new-bloom"},"feed_url":{"const":"https://newbloommag.net/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"ooni"},"feed_url":{"const":"https://ooni.org/index.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"pandaily"},"feed_url":{"const":"https://pandaily.com/feed"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"rfa-mandarin"},"feed_url":{"const":"https://www.rfa.org/arc/outboundfeeds/mandarin/rss/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"rfi-chinese"},"feed_url":{"const":"https://www.rfi.fr/cn/rss"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"ripe-labs"},"feed_url":{"const":"https://labs.ripe.net/feed.xml"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"rthk-finance"},"feed_url":{"const":"https://rthk9.rthk.hk/rthk/news/rss/e_expressnews_efinance.xml"}}},"minContains":1,"maxContains":1},
