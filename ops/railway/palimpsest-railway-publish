    raise SystemExit("structured newsroom section inventory is invalid")
for section in sections:
    nonempty(section["dek"], f"section {section['id']} dek", 1000)
rows = document.get("stories")
if not isinstance(rows, list) or len(rows) != 39 or not all(
    isinstance(row, dict) for row in rows
):
    raise SystemExit("structured newsroom lacks its exact story inventory")
stories = {row.get("signal_id"): row for row in rows}
if (
    len(stories) != 39
    or tuple(row.get("signal_id") for row in rows) != EXPECTED_ORDER
):
    raise SystemExit("structured newsroom signal inventory is invalid")

kinds = [story_kind(story, document["generated_at"]) for story in rows]
measurement_count = kinds.count("measurement")
availability_count = kinds.count("availability")

for signal_id in RESTRICTED:
    story = stories.get(signal_id)
    evidence = story.get("evidence") if isinstance(story, dict) else None
    source = evidence.get("input") if isinstance(evidence, dict) else None
    statement = (
        f"No current finding is published for {LABELS[signal_id]} because public "
        "value publication is restricted by the active source policy."
    )
    claim_core = {
        "claim_type": "availability",
        "metric": NULL_METRIC,
        "signal_id": signal_id,
        "statement": statement,
        "status": "degraded",
    }
    claim_fingerprint = "sha256:" + hashlib.sha256(
        json.dumps(
            claim_core,
            allow_nan=False,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
    ).hexdigest()
    if (
        not isinstance(story, dict)
        or set(story) != STORY_FIELDS
        or story.get("id") != f"palimpsest-news:{signal_id}"
        or story.get("slug") != SLUGS[signal_id]
        or story.get("url") != f"https://palimpsest.info/news/{SLUGS[signal_id]}/"
        or story.get("headline") != f"{LABELS[signal_id]}: public value unavailable"
        or story.get("dek")
        != (
            "This route remains available, but its current result is withheld until "
            "the source policy records an effective public-value grant."
        )
        or story.get("status") != "degraded"
        or story.get("metric") != NULL_METRIC
        or story.get("claims")
        != [{"type": "availability", "statement": statement}]
        or story.get("claim_fingerprint") != claim_fingerprint
        or story.get("published_at") != document["generated_at"]
        or story.get("modified_at") != document["generated_at"]
        or {
            key: story.get(key)
            for key in ("section", "order", "type", "priority", "related_signal_ids")
        }
        != EDITORIAL[signal_id]
        or story.get("method")
        != {
            "summary": (
                "Availability-only public projection under the active China "
                "economic source policy"
            ),
            "version": 1,
        }
        or story.get("limitations")
        != [
            "Current finding withheld: public value publication is restricted",
            "Availability is not a zero, a normal reading, or evidence of direction.",
        ]
        or evidence
        != {
            "url": RIGHTS_URL,
            "input": {
                "filename": f"{signal_id}-latest.json",
                "sha256": None,
                "bytes": None,
            },
            "source_timestamp": None,
        }
        or not isinstance(source, dict)
    ):
        raise SystemExit(
            f"structured newsroom has an unsafe rights availability record: {signal_id}"
        )
if measurement_count + availability_count != 39:
    raise SystemExit("structured newsroom record counts do not close")
coverage = document.get("coverage")
status_counts = {
    status: sum(story["status"] == status for story in rows)
    for status in ("live", "degraded", "stale", "missing", "corrupt")
}
if (
    not isinstance(coverage, dict)
    or set(coverage) != {"counts", "live", "reporting", "status", "total"}
    or any(
        type(coverage.get(key)) is not int
        for key in ("live", "reporting", "total")
    )
    or not isinstance(coverage.get("counts"), dict)
    or any(type(value) is not int or value < 0 for value in coverage["counts"].values())
    or coverage.get("total") != 39
    or coverage.get("live") != measurement_count
    or coverage.get("reporting")
    != status_counts["live"] + status_counts["degraded"] + status_counts["stale"]
    or coverage.get("status") != "degraded"
    or coverage.get("counts") != status_counts
):
    raise SystemExit("structured newsroom coverage is not bound to its stories")
print(measurement_count, availability_count, sep="\t")
PY
}

measurement_evidence_inventory() {
  local newsroom_path="$1" timeout_seconds="${2:-}" command
  if [[ -n "$timeout_seconds" ]]; then
    [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || {
      log "measurement evidence inventory timeout is invalid" >&2
      return 1
    }
    command=("$TIMEOUT_BIN" --signal=TERM --kill-after=5s "${timeout_seconds}s" \
      "$PYTHON_BIN" -I -S - "$newsroom_path")
  else
    command=("$PYTHON_BIN" -I -S - "$newsroom_path")
  fi
  "${command[@]}" <<'PY'
import json
import re
import sys
from pathlib import Path

MEASUREMENT_CLAIMS = {"finding", "integrity", "method", "observation"}
SHA256 = re.compile(r"^[0-9a-f]{64}$")
FILENAME = re.compile(r"^[a-z0-9][a-z0-9.-]{0,126}\.json$")
UTC_CLOCK = re.compile(
    r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
)
MAX_SAFE_INTEGER = 9_007_199_254_740_991
MAX_MEASUREMENT_EVIDENCE = 64 * 1024 * 1024


def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("measurement evidence newsroom has a duplicate JSON key")
        value[key] = item
    return value


try:
    document = json.loads(
        Path(sys.argv[1]).read_bytes().decode("utf-8", "strict"),
        object_pairs_hook=strict_object,
        parse_constant=lambda item: (_ for _ in ()).throw(
            ValueError(f"non-finite JSON value: {item}")
        ),
    )
except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as exc:
    raise SystemExit("measurement evidence newsroom is not strict JSON") from exc
stories = document.get("stories") if isinstance(document, dict) else None
if not isinstance(stories, list):
    raise SystemExit("measurement evidence newsroom story inventory is invalid")

inventory = {}
for story in stories:
    claims = story.get("claims") if isinstance(story, dict) else None
    if (
        not isinstance(claims, list)
        or len(claims) != 1
        or not isinstance(claims[0], dict)
        or claims[0].get("type") not in MEASUREMENT_CLAIMS
        or story.get("status") != "live"
    ):
        continue
    signal_id = story.get("signal_id")
    evidence = story.get("evidence")
    source = evidence.get("input") if isinstance(evidence, dict) else None
    if not isinstance(signal_id, str) or not signal_id or not isinstance(source, dict):
        raise SystemExit("measurement evidence story identity is invalid")
    filename = source.get("filename")
    digest = source.get("sha256")
    size = source.get("bytes")
    published_at = story.get("published_at")
    if (
        not isinstance(filename, str)
        or FILENAME.fullmatch(filename) is None
        or not isinstance(digest, str)
        or SHA256.fullmatch(digest) is None
        or type(size) is not int
        or not 1 <= size <= min(MAX_SAFE_INTEGER, MAX_MEASUREMENT_EVIDENCE)
        or not isinstance(published_at, str)
        or UTC_CLOCK.fullmatch(published_at) is None
        or evidence.get("source_timestamp") != published_at
        or evidence.get("url")
        != f"https://palimpsest.info/readings/{filename}"
    ):
        raise SystemExit(
            f"measurement evidence claim is invalid: {signal_id}"
        )
    relative = f"readings/{filename}"
    identity = (digest, size)
    if relative in inventory and inventory[relative] != identity:
        raise SystemExit(
            f"measurement evidence path has conflicting claims: {relative}"
        )
    inventory[relative] = identity

for relative in sorted(inventory):
    digest, size = inventory[relative]
    print(relative, digest, size, sep="\t")
PY
}

validate_measurement_evidence_local() {
  local newsroom_path="$1" manifest_path="$2" release_root="$3"
  local expected_count="$4" timeout_seconds="${5:-}" inventory inventory_count
  local relative story_sha256 story_bytes
  local manifest_identity manifest_sha256 manifest_bytes
  [[ "$expected_count" =~ ^[0-9]+$ ]] || {
    log "measurement evidence expected count is invalid" >&2
    return 1
  }
  inventory="$(measurement_evidence_inventory "$newsroom_path" \
    "$timeout_seconds")" || return 1
  if [[ -z "$inventory" ]]; then
    inventory_count=0
  else
    inventory_count="$(awk 'END { print NR }' <<<"$inventory")"
  fi
  [[ "$inventory_count" == "$expected_count" ]] || {
    log "measurement evidence inventory count differs from the newsroom" >&2
    return 1
  }
  [[ -z "$inventory" ]] && return 0
  while IFS=$'\t' read -r relative story_sha256 story_bytes; do
    [[ -n "$relative" && "$story_sha256" =~ ^[0-9a-f]{64}$ \
      && "$story_bytes" =~ ^[1-9][0-9]*$ ]] || {
      log "measurement evidence inventory row is invalid" >&2
      return 1
    }
    manifest_identity="$(manifest_artifact_identity "$manifest_path" \
      "$relative")" || {
      log "$relative measurement evidence is absent from the release manifest" >&2
      return 1
    }
    IFS=$'\t' read -r manifest_sha256 manifest_bytes \
      <<<"$manifest_identity"
    [[ "$manifest_sha256" == "$story_sha256" \
      && "$manifest_bytes" == "$story_bytes" ]] || {
      log "$relative manifest identity differs from its newsroom evidence claim" >&2
      return 1
    }
    validate_manifest_bound_local "$manifest_path" "$relative" \
      "$release_root/$relative" || return 1
  done <<<"$inventory"
}

