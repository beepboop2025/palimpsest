      "$combined_rss_path" "$instrument_json_path" "$instrument_rss_path" \
      "$wire_path")
  fi
  "${command[@]}" <<'PY'
import email.utils
import hashlib
import json
import re
import sys
import xml.etree.ElementTree as ET
from datetime import UTC, datetime
from pathlib import Path

RIGHTS_URL = "https://palimpsest.info/readings/china-publication-rights-latest.json"
RESTRICTED = {
    "board-alarm",
    "event-flags",
    "coverage-guard",
    "forecast-ledger",
    "cross-layer",
    "china-econ",
    "cny-fix-gap",
    "data-darkness",
}
JSON_FEED_FIELDS = {
    "authors",
    "description",
    "feed_url",
    "home_page_url",
    "items",
    "language",
    "title",
    "version",
}
JSON_ITEM_FIELDS = {
    "_palimpsest",
    "attachments",
    "content_text",
    "date_modified",
    "date_published",
    "external_url",
    "id",
    "summary",
    "tags",
    "title",
    "url",
}
SOURCE_REPORT_DESKS = {
    "economy": "Economy",
    "politics": "Politics & law",
    "rights": "Rights",
    "security": "Security",
    "censorship": "Censorship",
    "connectivity": "Connectivity & networks",
    "technology": "Technology",
}


def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("newsroom feed proof contains a duplicate JSON key")
        value[key] = item
    return value


def load_json(path, label):
    try:
        value = json.loads(
            Path(path).read_bytes().decode("utf-8", "strict"),
            object_pairs_hook=strict_object,
            parse_constant=lambda item: (_ for _ in ()).throw(
                ValueError(f"non-finite JSON value: {item}")
            ),
        )
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as exc:
        raise SystemExit(f"{label} is not strict JSON") from exc
    if not isinstance(value, dict):
        raise SystemExit(f"{label} is not a JSON object")
    return value


def revision_id(story):
    raw = json.dumps(
        story,
        allow_nan=False,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return "storyv-" + hashlib.sha256(raw).hexdigest()[:24]


def instrument_json_item(story, section_title):
    availability = story["claims"][0]["type"] == "availability"
    restricted = story["signal_id"] in RESTRICTED
    kind = "availability" if availability else "measurement"
    attachment = {
        "url": story["evidence"]["url"],
        "mime_type": "application/json",
        "title": (
            "china-publication-rights-latest.json"
            if restricted
            else story["evidence"]["input"]["filename"]
        ),
    }
    if story["evidence"]["input"]["bytes"] is not None:
        attachment["size_in_bytes"] = story["evidence"]["input"]["bytes"]
    metadata = {
        "kind": f"instrument_{kind}",
        "revision_id": revision_id(story),
        "verification_status": (
            "public_value_unavailable"
            if restricted
            else (
                "current_result_unavailable"
                if availability
                else "palimpsest_measurement"
            )
        ),
    }
    if restricted:
        metadata.update(
            {
                "signal_id": story["signal_id"],
                "publication_disposition": "rights-restricted-availability-v1",
                "value_state": "withheld",
            }
        )
    result_label = "Availability" if availability else "Result"
    return {
        "id": story["id"] + ":" + story["claim_fingerprint"],
        "url": story["url"],
        "external_url": story["evidence"]["url"],
        "title": f"[Palimpsest {kind}] {story['headline']}",
        "summary": (
            f"Palimpsest {kind}"
            + (" notice" if availability else "")
            + f". {story['dek']}"
        ),
        "content_text": "\n\n".join(
            [
                f"ITEM TYPE: PALIMPSEST {kind.upper()}",
                f"{result_label}: {story['claims'][0]['statement']}",
                "Limit: " + " ".join(story["limitations"]),
                "Evidence: " + story["evidence"]["url"],
            ]
        ),
        "date_published": story["published_at"],
        "date_modified": story["modified_at"],
        "tags": [
            f"palimpsest-{kind}",
            section_title,
            story["signal_id"],
            story["status"],
        ],
        "attachments": [attachment],
        "_palimpsest": metadata,
    }


def rss_clock(value):
    if not isinstance(value, str) or re.fullmatch(
        r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", value
    ) is None:
        raise SystemExit("newsroom feed contains an invalid UTC clock")
    parsed = datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
    return email.utils.format_datetime(parsed, usegmt=True)


def rss_items(path, label):
    try:
        raw = Path(path).read_bytes()
    except OSError as exc:
        raise SystemExit(f"{label} cannot be read") from exc
    if b"<!DOCTYPE" in raw.upper() or b"<!ENTITY" in raw.upper():
        raise SystemExit(f"{label} contains a prohibited XML declaration")
    try:
        root = ET.fromstring(raw)
    except ET.ParseError as exc:
        raise SystemExit(f"{label} is not strict XML") from exc
    channels = root.findall("channel")
    if root.tag != "rss" or root.attrib != {"version": "2.0"} or len(channels) != 1:
        raise SystemExit(f"{label} root identity is invalid")
    return channels[0], channels[0].findall("item")


def only(item, tag, label):
    rows = item.findall(tag)
    if len(rows) != 1:
        raise SystemExit(f"{label} has an invalid {tag} inventory")
    return rows[0]


def validate_rss_channel(
    channel,
    items,
    *,
    label,
    title,
    link,
    description,
    self_url,
    expected_build_at,
):
    channel_title = only(channel, "title", label)
    channel_link = only(channel, "link", label)
    channel_description = only(channel, "description", label)
    language = only(channel, "language", label)
    last_build = only(channel, "lastBuildDate", label)
    atom = channel.findall("{http://www.w3.org/2005/Atom}link")
    try:
        build_at = email.utils.parsedate_to_datetime(last_build.text or "")
    except (TypeError, ValueError) as exc:
        raise SystemExit(f"{label} build clock is invalid") from exc
    if build_at.tzinfo is None:
        raise SystemExit(f"{label} build clock has no timezone")
    if (
        len(list(channel)) != 6 + len(items)
        or (channel_title.text or "") != title
        or (channel_link.text or "") != link
        or (channel_description.text or "") != description
        or (language.text or "") != "en"
        or build_at.astimezone(UTC) != expected_build_at
        or len(atom) != 1
        or atom[0].attrib
        != {"href": self_url, "rel": "self", "type": "application/rss+xml"}
    ):
        raise SystemExit(f"{label} channel identity is invalid")


def xml_record(element):
    return (
        element.tag,
        tuple(sorted(element.attrib.items())),
        element.text or "",
        tuple(xml_record(child) for child in element),
    )


def validate_instrument_rss(item, story, label):
    availability = story["claims"][0]["type"] == "availability"
    restricted = story["signal_id"] in RESTRICTED
    item_type = "Palimpsest availability" if availability else "Palimpsest measurement"
    result_label = "Availability" if availability else "Result"
    expected_description = (
        f"Item type: {item_type}. {result_label}: "
        + story["claims"][0]["statement"]
        + " Limit: "
        + " ".join(story["limitations"])
        + " Evidence: "
        + story["evidence"]["url"]
    )
    title = only(item, "title", label)
    link = only(item, "link", label)
    guid = only(item, "guid", label)
    published = only(item, "pubDate", label)
    description = only(item, "description", label)
    categories = item.findall("category")
    source = only(item, "source", label)
    namespace = "{https://palimpsest.info/ns/publication/1.0}"
    kind = item.findall(namespace + "kind")
    signal = item.findall(namespace + "signal")
    disposition = item.findall(namespace + "publicationDisposition")
    value_state = item.findall(namespace + "valueState")
    if (
        (title.text or "") != f"[{item_type}] {story['headline']}"
        or (link.text or "") != story["url"]
        or guid.attrib != {"isPermaLink": "false"}
        or (guid.text or "") != story["id"] + ":" + story["claim_fingerprint"]
        or (published.text or "") != rss_clock(story["published_at"])
        or (description.text or "") != expected_description
        or len(categories) != 1
        or (categories[0].text or "") != story["section"]
        or source.attrib != {"url": story["evidence"]["url"]}
        or (source.text or "") != story["signal_id"]
        or [(row.text or "") for row in kind]
        != (["instrument_availability"] if availability else [])
        or [(row.text or "") for row in signal]
        != ([story["signal_id"]] if availability else [])
        or [(row.text or "") for row in disposition]
        != (["rights-restricted-availability-v1"] if restricted else [])
        or [(row.text or "") for row in value_state]
        != (["withheld"] if restricted else [])
        or len(list(item)) != 7 + (2 if availability else 0) + (2 if restricted else 0)
    ):
        raise SystemExit(f"{label} does not bind its structured story")


def json_feed(path, label):
    document = load_json(path, label)
    if (
        set(document) != JSON_FEED_FIELDS
        or document.get("version") != "https://jsonfeed.org/version/1.1"
        or document.get("language") != "en"
        or document.get("authors")
        != [{"name": "Palimpsest Observatory", "url": "https://palimpsest.info/"}]
        or not isinstance(document.get("description"), str)
        or not isinstance(document.get("items"), list)
    ):
        raise SystemExit(f"{label} identity is invalid")
    return document


def wire_source_item(event, index):
    label = f"private wire event {index}"
    if not isinstance(event, dict):
        raise SystemExit(f"{label} is not an object")
    event_id = event.get("event_id")
    version_id = event.get("version_id")
    headline = event.get("headline")
    url = event.get("url")
    published_at = event.get("published_at")
    updated_at = event.get("updated_at")
    desk = event.get("desk")
    strength = event.get("evidence_strength")
    groups = event.get("evidence_groups")
    refs = event.get("evidence_refs")
    topics = event.get("topics")
    if (
        not isinstance(event_id, str)
        or re.fullmatch(r"event-[0-9a-f]{24}", event_id) is None
        or not isinstance(version_id, str)
        or re.fullmatch(r"eventv-[0-9a-f]{24}", version_id) is None
        or not isinstance(headline, str)
        or not headline.strip()
        or url != f"https://palimpsest.info/news/wire/{event_id}/"
        or not isinstance(published_at, str)
        or not isinstance(updated_at, str)
        or desk not in SOURCE_REPORT_DESKS
        or not isinstance(strength, str)
        or not strength
        or not isinstance(groups, list)
        or not groups
        or any(not isinstance(group, dict) or not group for group in groups)
        or not isinstance(refs, list)
        or not refs
        or not isinstance(topics, list)
        or any(not isinstance(topic, str) or not topic for topic in topics)
    ):
        raise SystemExit(f"{label} cannot be projected canonically")
    rss_clock(published_at)
    rss_clock(updated_at)
