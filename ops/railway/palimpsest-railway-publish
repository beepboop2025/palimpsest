        tzinfo=UTC
    )
    if updated < published:
        raise SystemExit(f"{label} clocks are out of order")
    for ref in refs:
        if (
            not isinstance(ref, dict)
            or not isinstance(ref.get("source_name"), str)
            or not ref["source_name"].strip()
            or not isinstance(ref.get("title"), str)
            or not ref["title"].strip()
            or not isinstance(ref.get("url"), str)
            or not ref["url"].startswith("https://")
        ):
