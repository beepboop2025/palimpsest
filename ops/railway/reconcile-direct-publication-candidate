class ReconciliationError(RuntimeError):
    def __init__(self, message: str, *, code: str = "reconciliation_failed") -> None:
        super().__init__(message)
        self.code = code


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req: Any, fp: Any, code: int, msg: str, headers: Any, newurl: str) -> None:
        del req, fp, code, msg, headers, newurl
        return None


def _digest(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def _decode(raw: bytes, label: str) -> Any:
    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in rows:
            if key in result:
                raise ReconciliationError(f"{label} contains a duplicate key")
            result[key] = value
        return result

    try:
        return json.loads(
            raw.decode("utf-8", "strict"),
            object_pairs_hook=pairs,
            parse_constant=lambda value: (_ for _ in ()).throw(ReconciliationError(f"{label} contains {value}")),
        )
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise ReconciliationError(f"{label} is not strict JSON") from exc


def _object(raw: bytes, label: str) -> dict[str, Any]:
    value = _decode(raw, label)
    if not isinstance(value, dict):
        raise ReconciliationError(f"{label} is not an object")
    return value


def _keys(value: dict[str, Any], expected: set[str], label: str) -> None:
    if set(value) != expected:
        raise ReconciliationError(f"{label} does not match its closed schema")


def _sha40(value: Any, label: str) -> str:
    if not isinstance(value, str) or SHA40.fullmatch(value) is None:
        raise ReconciliationError(f"{label} is invalid")
    return value


def _sha256(value: Any, label: str) -> str:
    if not isinstance(value, str) or SHA256.fullmatch(value) is None:
        raise ReconciliationError(f"{label} is invalid")
    return value


def _uuid(value: Any, label: str) -> str:
    if not isinstance(value, str) or UUID.fullmatch(value) is None:
        raise ReconciliationError(f"{label} is invalid")
    return value


def _positive(value: Any, label: str) -> int:
    if not isinstance(value, int) or isinstance(value, bool) or value < 1:
        raise ReconciliationError(f"{label} is invalid")
    return value


def _timestamp(value: Any, label: str) -> datetime:
    if not isinstance(value, str) or not 1 <= len(value) <= 64:
        raise ReconciliationError(f"{label} is invalid")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ReconciliationError(f"{label} is invalid") from exc
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise ReconciliationError(f"{label} has no timezone")
    parsed = parsed.astimezone(UTC)
    if parsed > datetime.now(UTC) + timedelta(seconds=120):
        raise ReconciliationError(f"{label} is in the future")
    return parsed


def _deadline_timestamp(value: Any, label: str) -> datetime:
    if not isinstance(value, str) or UTC_CLOCK.fullmatch(value) is None:
        raise ReconciliationError(f"{label} is not a strict UTC clock")
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
    except ValueError as exc:
        raise ReconciliationError(f"{label} is invalid") from exc


def _candidate_receipt_deadline(candidate: dict[str, Any]) -> datetime:
    prepared = _timestamp(candidate["prepared_at"], "candidate prepared_at")
    wire = _timestamp(candidate["wire_generated_at"], "candidate wire_generated_at")
    deadline = _deadline_timestamp(
        candidate["receipt_deadline_at"], "candidate receipt_deadline_at"
    )
    if deadline <= prepared:
        raise ReconciliationError("candidate receipt deadline does not follow preparation")
    if deadline > prepared + timedelta(seconds=MAX_MUTATION_TO_RECEIPT_SECONDS):
        raise ReconciliationError("candidate receipt deadline exceeds the mutation bound")
    if deadline > wire + timedelta(
        seconds=WIRE_FRESHNESS_BUDGET_SECONDS - DESIRED_LIVE_MARGIN_SECONDS
    ):
        raise ReconciliationError("candidate receipt deadline consumes the live wire margin")
    return deadline


def _candidate_adoption_is_timely(
    candidate: dict[str, Any],
    *,
    now: datetime | None = None,
    reserve_seconds: int = 0,
) -> bool:
    if not isinstance(reserve_seconds, int) or isinstance(reserve_seconds, bool) or reserve_seconds < 0:
        raise ReconciliationError("candidate receipt reserve is invalid")
    checked_at = datetime.now(UTC) if now is None else now.astimezone(UTC)
    return checked_at + timedelta(seconds=reserve_seconds) <= _candidate_receipt_deadline(
        candidate
    )


def _receipt_was_prepared_in_window(
    receipt: dict[str, Any], candidate: dict[str, Any]
) -> bool:
    recorded = _timestamp(receipt.get("recorded_at"), "receipt recorded_at")
    prepared = _timestamp(candidate["prepared_at"], "candidate prepared_at")
    return prepared <= recorded <= _candidate_receipt_deadline(candidate)


def _stable_metadata(metadata: os.stat_result) -> tuple[int, ...]:
    """Return fields that cannot legitimately change as a side effect of read(2)."""
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_mode,
        metadata.st_nlink,
        metadata.st_uid,
        metadata.st_gid,
        metadata.st_size,
        metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    )


def _read(path: Path, *, uid: int, gid: int, mode: int, maximum: int = MAX_JSON, empty: bool = False, single_link: bool = False) -> bytes:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as exc:
        raise ReconciliationError(f"cannot open {path} without following links") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) != mode
            or (single_link and metadata.st_nlink != 1)
            or metadata.st_size > maximum
            or (metadata.st_size == 0 and not empty)
        ):
            raise ReconciliationError(f"unsafe metadata for {path}")
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        if len(raw) > maximum or (not raw and not empty):
            raise ReconciliationError(f"unsafe byte size for {path}")
        pathname = os.stat(path, follow_symlinks=False)
        if (
            _stable_metadata(os.fstat(descriptor)) != _stable_metadata(metadata)
            or metadata.st_dev != pathname.st_dev
            or metadata.st_ino != pathname.st_ino
        ):
            raise ReconciliationError(f"metadata changed while reading {path}")
        return raw
    finally:
        os.close(descriptor)


def _directory(path: Path, *, uid: int, gid: int, mode: int = 0o700) -> None:
    metadata = path.lstat()
    if not stat.S_ISDIR(metadata.st_mode) or path.is_symlink() or metadata.st_uid != uid or metadata.st_gid != gid or stat.S_IMODE(metadata.st_mode) != mode:
        raise ReconciliationError(f"unsafe directory metadata for {path}")


def _ensure_directory(path: Path, *, uid: int, gid: int) -> None:
    try:
        path.mkdir(mode=0o700)
        os.chown(path, uid, gid)
        parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    except FileExistsError:
        pass
    _directory(path, uid=uid, gid=gid)


def _canonical(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, allow_nan=False, separators=(",", ":"), sort_keys=True).encode() + b"\n"


def _atomic(path: Path, raw: bytes, *, uid: int, gid: int, mode: int, replace: bool) -> None:
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    temporary: str | None = None
    descriptor: int | None = None
    try:
        descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, uid, gid)
        with os.fdopen(descriptor, "wb", closefd=False) as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
        staged = os.fstat(descriptor)
        staged_name = Path(temporary).name
        named = os.stat(staged_name, dir_fd=directory, follow_symlinks=False)
        if (named.st_dev, named.st_ino) != (staged.st_dev, staged.st_ino):
            raise ReconciliationError("atomic staging inode changed before promotion")
        if replace:
            os.replace(staged_name, path.name, src_dir_fd=directory, dst_dir_fd=directory)
        else:
            os.link(staged_name, path.name, src_dir_fd=directory, dst_dir_fd=directory, follow_symlinks=False)
            os.unlink(staged_name, dir_fd=directory)
        promoted = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory)
        try:
            promoted_metadata = os.fstat(promoted)
            if (promoted_metadata.st_dev, promoted_metadata.st_ino) != (
                staged.st_dev,
                staged.st_ino,
            ):
                raise ReconciliationError("atomic destination is not the staged inode")
            chunks: list[bytes] = []
            remaining = len(raw) + 1
            while remaining:
                chunk = os.read(promoted, min(65536, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            if b"".join(chunks) != raw:
                raise ReconciliationError("atomic destination bytes changed during promotion")
        finally:
            os.close(promoted)
        os.fsync(directory)
        temporary = None
    except FileExistsError as exc:
        raise ReconciliationError(f"durable proof already exists: {path}") from exc
    finally:
        if descriptor is not None:
            os.close(descriptor)
        if temporary is not None:
            try:
                os.unlink(Path(temporary).name, dir_fd=directory)
            except FileNotFoundError:
                pass
        os.close(directory)


def _unlink(path: Path) -> None:
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        try:
            os.unlink(path.name, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.fsync(directory)
    finally:
        os.close(directory)


def _pin_kind(pin: dict[str, Any]) -> str:
    schema = pin.get("schema_version")
    if schema == PIN_SCHEMA:
        return "verified_transition"
    if schema == SUCCESSOR_PIN_SCHEMA:
        return "verified_successor"
    raise ReconciliationError("publication base pin schema is unsupported")


def _validate_transition_pin(pin: dict[str, Any]) -> None:
    _keys(pin, {"incident_id", "installed", "origins", "previous", "recorded_at", "schema_version", "status", "target"}, "publication base pin")
    if pin["schema_version"] != PIN_SCHEMA or pin["incident_id"] != PIN_INCIDENT or pin["status"] != "verified":
        raise ReconciliationError("publication base pin identity is invalid")
    _timestamp(pin["recorded_at"], "publication base recorded_at")
    installed, origins, previous, target = (pin.get(key) for key in ("installed", "origins", "previous", "target"))
    if not all(isinstance(value, dict) for value in (installed, origins, previous, target)):
        raise ReconciliationError("publication base proof objects are invalid")
    _keys(installed, {"publisher_service_sha256", "publisher_sha256", "reconciler_sha256", "transition_helper_sha256", "watchdog_service_sha256", "watchdog_sha256", "watchdog_timer_sha256"}, "publication base installed proof")
    for key, value in installed.items():
        _sha256(value, f"installed.{key}")
    if origins != {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN}:
        raise ReconciliationError("publication base origins changed")
    expected_previous = {
        "canonical_head": INCIDENT_BASE,
        "deployed_commit": INCIDENT_BASE,
        "live_manifest_sha256": INCIDENT_MANIFEST,
        "live_release_sha": INCIDENT_RELEASE,
        "live_tree_sha256": INCIDENT_TREE,
        "publication_input_sha256": INCIDENT_INPUT,
        "publication_receipt_sha256": INCIDENT_RECEIPT,
        "railway_deployment_id": INCIDENT_DEPLOYMENT,
    }
    if previous != expected_previous:
        raise ReconciliationError("publication base predecessor is not the exact incident")
    _keys(target, {"base_sha", "public_main_sha"}, "publication base target")
    if _sha40(target["base_sha"], "publication base target") != target["public_main_sha"]:
        raise ReconciliationError("publication base is not exact public main")


def _validate_reference(value: Any, label: str) -> None:
    if not isinstance(value, dict):
        raise ReconciliationError(f"{label} is invalid")
    _keys(value, {"bytes", "path", "sha256"}, label)
    _positive(value["bytes"], f"{label} bytes")
    _sha256(value["sha256"], f"{label} digest")
    if not isinstance(value["path"], str) or not value["path"]:
        raise ReconciliationError(f"{label} path is invalid")


def _receipt_matches_pin_lineage(pin: dict[str, Any], receipt: dict[str, Any]) -> bool:
    """Bind a carried receipt to the root pin's immutable ancestor chain.

    The candidate authenticates the root pin bytes. Each archived parent is
    then read with the existing root ownership and no-follow checks and matched
    to its content digest before it supplies the next link. A rotation can
    preserve a receipt from an older generation without changing that receipt.
    """
    wanted = _sha256(receipt.get("publication_base_sha256"), "receipt pin digest")
    base = _sha40(receipt.get("base_sha"), "receipt pin base")
    history = CONTROL_ROOT / "base-rotation-history" / "pins"
    current = pin
    seen: set[str] = set()
    for _ in range(MAX_PIN_GENERATIONS):
        proof = current["predecessor"]["pin"]
        _keys(proof, {"generation", "path", "schema_version", "sha256", "target_sha"}, "receipt ancestor pin")
        generation = proof.get("generation")
        digest = _sha256(proof.get("sha256"), "receipt ancestor digest")
        target = _sha40(proof.get("target_sha"), "receipt ancestor target")
        path = history / f"{digest}.json"
        if (isinstance(generation, bool) or not isinstance(generation, int)
                or generation != current["generation"] - 1 or generation < 0
                or proof.get("path") != str(path) or digest in seen):
            return False
        seen.add(digest)
        # The immediate parent projection is already authenticated by the pin.
        if digest == wanted:
            return target == base
        if generation == 0:
            return False
        try:
            raw = _read(path, uid=0, gid=grp.getgrnam("palimpsest").gr_gid, mode=0o640)
        except (ReconciliationError, KeyError):
            return False
        if _digest(raw) != digest:
            return False
        parent = _object(raw, "receipt ancestor pin")
        _keys(parent, set(pin), "receipt ancestor pin")
        if (proof["schema_version"] != SUCCESSOR_PIN_SCHEMA
                or parent.get("schema_version") != SUCCESSOR_PIN_SCHEMA
                or parent.get("status") != "verified"
                or parent.get("generation") != generation
                or parent.get("target") != {"base_sha": target, "public_main_sha": target}
                or parent.get("anchor") != pin["anchor"]
                or parent.get("host") != pin["host"]):
            return False
        _keys(parent.get("predecessor"), {"pin", "publication_receipt"}, "receipt ancestor predecessor")
        current = parent
    return False


def _validate_successor_pin(pin: dict[str, Any]) -> None:
    """Validate the closed v2 pin before using it as recovery authority.

    The root-owned active pin was already proved recursively by the publisher
    before it crossed the mutation boundary. Recovery still revalidates its
    complete shape, protected incident anchor, target, and all identities that
    bind the active generation; the candidate then binds these exact bytes by
    SHA-256.
    """

    _keys(
        pin,
        {
            "anchor",
            "generation",
            "host",
            "installed",
            "live",
            "origins",
            "predecessor",
            "railway",
            "recorded_at",
            "rotation_record_path",
            "schema_version",
            "status",
            "target",
        },
        "successor publication base pin",
    )
    generation = pin.get("generation")
    if (
        pin.get("schema_version") != SUCCESSOR_PIN_SCHEMA
        or pin.get("status") != "verified"
        or isinstance(generation, bool)
        or not isinstance(generation, int)
        or generation < 1
        or generation > MAX_PIN_GENERATIONS
    ):
        raise ReconciliationError("successor publication base pin identity is invalid")
    _timestamp(pin["recorded_at"], "successor publication base recorded_at")

    proof_names = (
        "anchor",
        "host",
        "installed",
        "live",
        "origins",
        "predecessor",
        "railway",
        "target",
    )
    if not all(isinstance(pin.get(name), dict) for name in proof_names):
        raise ReconciliationError("successor publication base proof objects are invalid")

    history = CONTROL_ROOT / "base-rotation-history"
    anchor = pin["anchor"]
    _keys(anchor, {"path", "schema_version", "sha256", "target_sha"}, "successor anchor")
    expected_anchor = history / "pins" / f"{INCIDENT_PIN_SHA256}.json"
    if anchor != {
        "path": str(expected_anchor),
        "schema_version": PIN_SCHEMA,
        "sha256": INCIDENT_PIN_SHA256,
        "target_sha": INCIDENT_PIN_TARGET,
    }:
        raise ReconciliationError("successor anchor identity is invalid")

    host = pin["host"]
    _keys(host, {"canonical_head", "deployed_commit"}, "successor host proof")
    if host != {"canonical_head": INCIDENT_BASE, "deployed_commit": INCIDENT_BASE}:
        raise ReconciliationError("successor pin changed the protected host identity")

    installed = pin["installed"]
    _keys(installed, SUCCESSOR_INSTALLED_KEYS, "successor installed proof")
    for key, value in installed.items():
        _sha256(value, f"successor installed {key}")

    if pin["origins"] != {"provider": PROVIDER_ORIGIN, "public": PUBLIC_ORIGIN}:
        raise ReconciliationError("successor publication base origins changed")

    target = pin["target"]
    _keys(target, {"base_sha", "public_main_sha"}, "successor target")
    target_sha = _sha40(target["base_sha"], "successor target")
    if target["public_main_sha"] != target_sha:
        raise ReconciliationError("successor publication base is not exact public main")

    predecessor = pin["predecessor"]
    _keys(predecessor, {"pin", "publication_receipt"}, "successor predecessor")
    predecessor_pin = predecessor.get("pin")
    receipt = predecessor.get("publication_receipt")
    if not isinstance(predecessor_pin, dict) or not isinstance(receipt, dict):
        raise ReconciliationError("successor predecessor proof is invalid")
    _keys(
        predecessor_pin,
        {"generation", "path", "schema_version", "sha256", "target_sha"},
        "successor predecessor pin",
    )
    prior_generation = predecessor_pin.get("generation")
    prior_digest = _sha256(predecessor_pin.get("sha256"), "predecessor pin digest")
    _sha40(predecessor_pin.get("target_sha"), "predecessor pin target")
    if (
        isinstance(prior_generation, bool)
        or not isinstance(prior_generation, int)
        or prior_generation != generation - 1
        or predecessor_pin.get("schema_version") not in {PIN_SCHEMA, SUCCESSOR_PIN_SCHEMA}
        or predecessor_pin.get("path")
        != str(history / "pins" / f"{prior_digest}.json")
    ):
        raise ReconciliationError("successor predecessor pin identity is invalid")

    _keys(
        receipt,
        {
            "base_sha",
            "deployment_id",
            "host_deployed_sha",
            "input_sha256",
            "manifest_sha256",
            "path",
            "publication_base_sha256",
            "release_sha",
            "schema_version",
            "sha256",
            "tree_sha256",
            "wire_generated_at",
        },
        "successor predecessor receipt",
    )
    receipt_digest = _sha256(receipt.get("sha256"), "predecessor receipt digest")
    if (
        receipt.get("schema_version") != V2_SCHEMA
        or receipt.get("path") != str(history / "receipts" / f"{receipt_digest}.json")
        or not _receipt_matches_pin_lineage(pin, receipt)
        or receipt.get("host_deployed_sha") != INCIDENT_BASE
    ):
        raise ReconciliationError("successor predecessor receipt identity is invalid")
    for key in ("base_sha", "host_deployed_sha", "release_sha"):
        _sha40(receipt[key], f"predecessor receipt {key}")
    for key in (
        "input_sha256",
        "manifest_sha256",
        "publication_base_sha256",
        "sha256",
        "tree_sha256",
    ):
        _sha256(receipt[key], f"predecessor receipt {key}")
    _uuid(receipt["deployment_id"], "predecessor receipt deployment")
    _timestamp(receipt["wire_generated_at"], "predecessor receipt wire_generated_at")

    live = pin["live"]
    _keys(
        live,
        {
            "file_count",
            "provider_manifest",
            "public_manifest",
            "release_sha",
            "total_bytes",
            "tree_sha256",
        },
        "successor live proof",
    )
    _positive(live["file_count"], "successor live file_count")
    _positive(live["total_bytes"], "successor live total_bytes")
    _sha40(live["release_sha"], "successor live release")
    _sha256(live["tree_sha256"], "successor live tree")
    for origin in ("provider", "public"):
        reference = live[f"{origin}_manifest"]
        _validate_reference(reference, f"successor {origin} manifest")
        if reference["path"] != str(
            history / "manifests" / origin / f"{reference['sha256']}.json"
        ):
            raise ReconciliationError(f"successor {origin} manifest path is not canonical")
    if (
        live["release_sha"] != receipt["release_sha"]
        or live["tree_sha256"] != receipt["tree_sha256"]
        or live["provider_manifest"]["sha256"] != receipt["manifest_sha256"]
        or live["public_manifest"]["sha256"] != receipt["manifest_sha256"]
    ):
        raise ReconciliationError("successor live proof differs from predecessor receipt")

    railway = pin["railway"]
    _keys(
        railway,
        {
            "created_at",
            "deployment_id",
            "environment_id",
            "image_digest",
            "project_id",
            "reason",
            "service_id",
            "topology",
        },
        "successor Railway proof",
    )
    for key, expected in (
        ("project_id", PROJECT_ID),
        ("environment_id", ENVIRONMENT_ID),
        ("service_id", SERVICE_ID),
    ):
        if _uuid(railway.get(key), f"successor Railway {key}") != expected:
            raise ReconciliationError(f"successor Railway {key} changed")
    if _uuid(railway.get("deployment_id"), "successor Railway deployment") != receipt["deployment_id"]:
        raise ReconciliationError("successor Railway deployment differs from receipt")
    if (
        not isinstance(railway.get("image_digest"), str)
        or IMAGE.fullmatch(railway["image_digest"]) is None
        or railway.get("reason") not in {"deploy", "deploymentRollback", "rollback"}
    ):
        raise ReconciliationError("successor Railway deployment identity is invalid")
    _timestamp(railway["created_at"], "successor Railway created_at")
    _validate_reference(railway["topology"], "successor Railway topology")
    if railway["topology"]["path"] != str(
        history / "topologies" / f"{railway['topology']['sha256']}.json"
    ):
        raise ReconciliationError("successor Railway topology path is not canonical")

    expected_rotation = history / "rotations" / (
        f"{generation}-{target_sha}-{receipt_digest}.json"
    )
    if pin.get("rotation_record_path") != str(expected_rotation):
        raise ReconciliationError("successor rotation-record path is not canonical")


def _validate_pin(pin: dict[str, Any]) -> None:
    if pin.get("schema_version") == PIN_SCHEMA:
        _validate_transition_pin(pin)
        return
    if pin.get("schema_version") == SUCCESSOR_PIN_SCHEMA:
        _validate_successor_pin(pin)
        return
    raise ReconciliationError("publication base pin schema is unsupported")


def _validate_candidate_pin_binding(
    candidate: dict[str, Any], pin: dict[str, Any], pin_raw: bytes
) -> None:
    expected = {
        "kind": _pin_kind(pin),
        "path": str(BASE_PIN),
        "sha256": _digest(pin_raw),
    }
    if candidate.get("publication_base") != expected:
        raise ReconciliationError("candidate publication base pin changed")
    if pin["target"]["base_sha"] != candidate["base_sha"]:
        raise ReconciliationError("candidate publication base target changed")


def _validate_candidate(candidate: dict[str, Any]) -> None:
    _keys(candidate, {"base_sha", "host_deployed_sha", "input_sha256", "message", "news_source_tail", "predecessor", "prepared_at", "publication_base", "receipt_deadline_at", "release_bundle", "release_manifest", "release_sha", "rollback_evidence", "schema_version", "status", "submission_id", "wire_canonical_sha256", "wire_generated_at"}, "candidate journal")
    if candidate["schema_version"] != CANDIDATE_SCHEMA or candidate["status"] != "mutation_unresolved":
        raise ReconciliationError("candidate identity is invalid")
    prepared = _timestamp(candidate["prepared_at"], "candidate prepared_at")
    wire = _timestamp(candidate["wire_generated_at"], "candidate wire_generated_at")
    if wire > prepared + timedelta(seconds=120):
        raise ReconciliationError("candidate wire timestamp follows preparation")
    _candidate_receipt_deadline(candidate)
    _sha256(candidate["input_sha256"], "candidate input")
    _sha256(candidate["wire_canonical_sha256"], "candidate wire canonical digest")
    source_tail = candidate.get("news_source_tail")
    if not isinstance(source_tail, dict):
        raise ReconciliationError("candidate news source tail is invalid")
    _keys(source_tail, {"count", "sha256"}, "candidate news source tail")
    if (
        not isinstance(source_tail.get("count"), int)
        or isinstance(source_tail["count"], bool)
        or source_tail["count"] < 0
    ):
        raise ReconciliationError("candidate news source tail count is invalid")
    _sha256(source_tail.get("sha256"), "candidate news source tail digest")
    _sha40(candidate["host_deployed_sha"], "candidate host deployment")
    _sha40(candidate["base_sha"], "candidate base")
    release = _sha40(candidate["release_sha"], "candidate release")
    submission_id = candidate.get("submission_id")
    if not isinstance(submission_id, str) or re.fullmatch(r"[0-9a-f]{32}", submission_id) is None:
        raise ReconciliationError("candidate submission identity is invalid")
    if candidate["message"] != f"palimpsest-hetzner-{release[:12]}-{candidate['input_sha256'][:12]}-{submission_id}":
        raise ReconciliationError("candidate message is not deterministic")

    base = candidate.get("publication_base")
    bundle = candidate.get("release_bundle")
    release_manifest = candidate.get("release_manifest")
    predecessor = candidate.get("predecessor")
    evidence = candidate.get("rollback_evidence")
    if not all(isinstance(value, dict) for value in (base, bundle, release_manifest, predecessor, evidence)):
        raise ReconciliationError("candidate proof objects are invalid")
    _keys(base, {"kind", "path", "sha256"}, "candidate publication base")
    if base["kind"] not in {"verified_transition", "verified_successor"}:
        raise ReconciliationError("candidate publication base kind is invalid")
    _sha256(base["sha256"], "candidate base pin")
    _keys(bundle, {"bytes", "metadata_path", "metadata_sha256", "path", "sha256"}, "candidate bundle")
    _positive(bundle["bytes"], "candidate bundle bytes")
    _sha256(bundle["sha256"], "candidate bundle digest")
    _sha256(bundle["metadata_sha256"], "candidate bundle metadata digest")
    if any(not isinstance(bundle[key], str) or not bundle[key] for key in ("path", "metadata_path")):
        raise ReconciliationError("candidate bundle path is invalid")
    _keys(release_manifest, {"bytes", "file_count", "path", "sha256", "total_bytes", "tree_sha256"}, "candidate release manifest")
    _positive(release_manifest["bytes"], "candidate release manifest bytes")
    _positive(release_manifest["file_count"], "candidate release manifest file_count")
    _positive(release_manifest["total_bytes"], "candidate release manifest total_bytes")
    _sha256(release_manifest["sha256"], "candidate release manifest digest")
    _sha256(release_manifest["tree_sha256"], "candidate release manifest tree")
    if not isinstance(release_manifest["path"], str) or not release_manifest["path"]:
        raise ReconciliationError("candidate release manifest path is invalid")

    _keys(predecessor, {"archive_path", "base_sha", "deployment_id", "input_sha256", "manifest_sha256", "receipt_sha256", "release_sha", "schema_version", "tree_sha256", "wire_generated_at"}, "candidate predecessor")
    if predecessor["schema_version"] not in {V1_SCHEMA, V2_SCHEMA}:
        raise ReconciliationError("predecessor schema is invalid")
    _timestamp(predecessor["wire_generated_at"], "predecessor wire_generated_at")
    for key in ("input_sha256", "manifest_sha256", "receipt_sha256", "tree_sha256"):
        _sha256(predecessor[key], f"predecessor {key}")
    _sha40(predecessor["base_sha"], "predecessor base")
    _sha40(predecessor["release_sha"], "predecessor release")
    _uuid(predecessor["deployment_id"], "predecessor deployment")

    _keys(evidence, {"captured_at", "provider_manifest", "public_manifest", "schema_version", "topology"}, "rollback evidence")
    if evidence["schema_version"] != ROLLBACK_EVIDENCE_SCHEMA:
        raise ReconciliationError("rollback evidence schema is invalid")
    if _timestamp(evidence["captured_at"], "rollback captured_at") > prepared + timedelta(seconds=120):
        raise ReconciliationError("rollback evidence follows candidate preparation")
    for label in ("provider_manifest", "public_manifest"):
        proof = evidence.get(label)
        if not isinstance(proof, dict):
            raise ReconciliationError(f"rollback {label} is invalid")
        _keys(proof, {"bytes", "path", "sha256"}, f"rollback {label}")
        _positive(proof["bytes"], f"rollback {label} bytes")
        _sha256(proof["sha256"], f"rollback {label} digest")
        if not isinstance(proof["path"], str) or not proof["path"]:
            raise ReconciliationError(f"rollback {label} path is invalid")
    topology = evidence.get("topology")
    if not isinstance(topology, dict):
        raise ReconciliationError("rollback topology is invalid")
    _keys(topology, {"bytes", "created_at", "deployment_id", "environment_id", "image_digest", "path", "project_id", "reason", "service_id", "sha256"}, "rollback topology")
    _positive(topology["bytes"], "rollback topology bytes")
    _sha256(topology["sha256"], "rollback topology digest")
    _timestamp(topology["created_at"], "rollback topology created_at")
    for key in ("project_id", "environment_id", "service_id", "deployment_id"):
        _uuid(topology[key], f"rollback topology {key}")
    if not isinstance(topology["image_digest"], str) or IMAGE.fullmatch(topology["image_digest"]) is None or topology["reason"] not in {"deploy", "deploymentRollback", "rollback"}:
        raise ReconciliationError("rollback topology deployment identity is invalid")
    if not isinstance(topology["path"], str) or not topology["path"]:
        raise ReconciliationError("rollback topology path is invalid")


def _validate_manifest(raw: bytes, *, release: str, tree: str | None = None, digest: str | None = None) -> dict[str, Any]:
    if digest is not None and _digest(raw) != digest:
        raise ReconciliationError("manifest digest differs from durable proof")
    document = _object(raw, "Railway release manifest")
    _keys(
        document,
        {
            "built_at",
            "critical_files",
            "deployment_source",
            "file_count",
            "github_required",
            "schema_version",
            "source_commit",
            "state",
            "total_bytes",
            "tree_sha256",
        },
        "Railway release manifest",
    )
    if (
        document.get("schema_version") != "palimpsest.railway-static-release.v1"
        or document.get("source_commit") != release
        or document.get("deployment_source") != "local-git-archive"
        or document.get("github_required") is not False
        or document.get("state") != "artifact_ready"
        or SHA256.fullmatch(str(document.get("tree_sha256"))) is None
        or not isinstance(document.get("critical_files"), dict)
        or not document["critical_files"]
    ):
        raise ReconciliationError("Railway release manifest identity is invalid")
    _positive(document.get("file_count"), "Railway manifest file_count")
    _positive(document.get("total_bytes"), "Railway manifest total_bytes")
    _timestamp(document.get("built_at"), "Railway manifest built_at")
    if tree is not None and document["tree_sha256"] != tree:
        raise ReconciliationError("manifest tree differs from durable proof")
    return document


def _edges(value: Any, label: str) -> list[dict[str, Any]]:
    if not isinstance(value, dict) or set(value) != {"edges"} or not isinstance(value["edges"], list) or len(value["edges"]) > 100:
        raise ReconciliationError(f"Railway {label} edge inventory is invalid")
    if any(not isinstance(row, dict) or not isinstance(row.get("node"), dict) for row in value["edges"]):
        raise ReconciliationError(f"Railway {label} edge is invalid")
    return [row["node"] for row in value["edges"]]


def _one(rows: list[dict[str, Any]], key: str, expected: str, label: str) -> dict[str, Any]:
    matches = [row for row in rows if row.get(key) == expected]
    if len(matches) != 1:
        raise ReconciliationError(f"Railway {label} is not singular")
    return matches[0]


def _topology(raw: bytes, *, deployment: str | None = None, image: str | None = None, reason: str | None = None) -> dict[str, Any]:
    if not 1 <= len(raw) <= MAX_TOPOLOGY:
        raise ReconciliationError("Railway topology byte size is invalid")
    document = _object(raw, "Railway topology")
    if document.get("id") != _uuid(PROJECT_ID, "configured project"):
        raise ReconciliationError("Railway topology project differs")
    service = _one(_edges(document.get("services"), "services"), "id", SERVICE_ID, "service")
    if service.get("name") != "palimpsest-publication":
        raise ReconciliationError("Railway topology service name differs")
    environment = _one(_edges(document.get("environments"), "environments"), "id", ENVIRONMENT_ID, "environment")
    if environment.get("deletedAt") is not None or environment.get("canAccess") is not True or _edges(environment.get("volumeInstances"), "volumes"):
        raise ReconciliationError("Railway environment topology is unsafe")
    instance = _one(_edges(environment.get("serviceInstances"), "service instances"), "serviceId", SERVICE_ID, "service instance")
    if instance.get("environmentId") != ENVIRONMENT_ID or instance.get("serviceName") != "palimpsest-publication":
        raise ReconciliationError("Railway service instance differs")
    if "source" not in instance or instance["source"] not in (None, {"image": None, "repo": None}):
        raise ReconciliationError("Railway service has an attached source")
    if "cronSchedule" not in instance or instance["cronSchedule"] is not None or "nextCronRunAt" not in instance or instance["nextCronRunAt"] is not None:
        raise ReconciliationError("Railway service scheduling is unsafe")
    latest = instance.get("latestDeployment")
    if not isinstance(latest, dict) or latest.get("status") != "SUCCESS" or latest.get("deploymentStopped") is not False:
        raise ReconciliationError("Railway latest deployment is not successful")
    deployment_id = _uuid(latest.get("id"), "Railway latest deployment")
    instances = latest.get("instances")
    if not isinstance(instances, list) or len(instances) != 1 or not isinstance(instances[0], dict) or instances[0].get("status") != "RUNNING":
        raise ReconciliationError("Railway latest deployment is not singular and running")
    meta = latest.get("meta")
    if not isinstance(meta, dict) or meta.get("buildOnly") is not False or meta.get("reason") not in {"deploy", "deploymentRollback", "rollback"}:
        raise ReconciliationError("Railway deployment metadata is unsafe")
    image_digest = meta.get("imageDigest")
    if not isinstance(image_digest, str) or IMAGE.fullmatch(image_digest) is None or meta.get("volumeMounts") != []:
        raise ReconciliationError("Railway deployment image or mounts are unsafe")
    service_manifest = meta.get("serviceManifest")
    if not isinstance(service_manifest, dict) or not isinstance(service_manifest.get("build"), dict) or not isinstance(service_manifest.get("deploy"), dict):
        raise ReconciliationError("Railway service manifest is invalid")
    build, deploy = service_manifest["build"], service_manifest["deploy"]
    if build.get("builder") != "DOCKERFILE" or build.get("dockerfilePath") != "ops/railway/Dockerfile.static":
        raise ReconciliationError("Railway static builder differs")
    if deploy.get("healthcheckPath") != "/healthz" or deploy.get("numReplicas") != 1 or "cronSchedule" not in deploy or deploy["cronSchedule"] is not None or "requiredMountPath" not in deploy or deploy["requiredMountPath"] is not None:
        raise ReconciliationError("Railway static deployment topology differs")
    created_at = latest.get("createdAt")
    _timestamp(created_at, "Railway deployment created_at")
    if deployment is not None and deployment_id != deployment:
        raise ReconciliationError("Railway active deployment differs")
    if image is not None and image_digest != image:
        raise ReconciliationError("Railway active image differs")
    if reason is not None and meta["reason"] != reason:
        raise ReconciliationError("Railway active reason differs")
    return {"created_at": created_at, "deployment_id": deployment_id, "image_digest": image_digest, "reason": meta["reason"]}


def _fetch(
    url: str, *, maximum: int = MAX_JSON, accept: str = "application/json"
) -> bytes:
    request = urllib.request.Request(url, headers={"Accept": accept, "Cache-Control": "no-cache, no-store", "User-Agent": "palimpsest-candidate-reconciler/2"})
    try:
        with urllib.request.build_opener(_NoRedirect()).open(request, timeout=30) as response:
            if response.status != 200 or response.geturl() != url:
                raise ReconciliationError("live response is not exact")
            raw = response.read(maximum + 1)
    except (OSError, urllib.error.URLError) as exc:
        if isinstance(exc, ReconciliationError):
            raise
        raise ReconciliationError(f"cannot fetch {url}") from exc
    if not raw or len(raw) > maximum:
        raise ReconciliationError(f"live response byte size is invalid: {url}")
    return raw


def _critical_file_identity(
    manifest: dict[str, Any], relative: str
) -> tuple[int, str]:
    critical = manifest.get("critical_files")
    proof = critical.get(relative) if isinstance(critical, dict) else None
    if not isinstance(proof, dict):
        raise ReconciliationError(f"manifest omits critical live path: {relative}")
    _keys(proof, {"bytes", "sha256"}, f"manifest critical path {relative}")
    return (
        _positive(proof["bytes"], f"manifest critical path {relative} bytes"),
        _sha256(proof["sha256"], f"manifest critical path {relative} digest"),
    )


def _validate_live_attestations(
    provider_raw: bytes,
    public_raw: bytes,
    *,
    manifest: dict[str, Any],
    candidate: dict[str, Any],
) -> dict[str, Any]:
    if provider_raw != public_raw:
        raise ReconciliationError(
            "provider and public freshness attestations differ"
        )
    expected_bytes, expected_digest = _critical_file_identity(
        manifest, FRESHNESS_ATTESTATION_PATH
    )
    if (
        len(public_raw) != expected_bytes
        or _digest(public_raw) != expected_digest
    ):
        raise ReconciliationError(
            "live freshness attestation is not byte-bound to the candidate manifest"
        )

    document = _object(public_raw, "live freshness attestation")
    _keys(
        document,
        {
            "artifacts",
            "attested_at",
            "limitations",
            "mode",
            "publication_allowed",
            "publication_sha",
            "rights_status",
            "schema_version",
        },
        "live freshness attestation",
    )
    artifacts = document.get("artifacts")
    rights_status = document.get("rights_status")
    if not isinstance(artifacts, dict) or not isinstance(rights_status, dict):
        raise ReconciliationError("live freshness attestation identity is invalid")
    _keys(
        artifacts,
        {"china_situation", "newswire"},
        "live freshness attestation artifacts",
    )
    newswire = artifacts.get("newswire")
    situation = artifacts.get("china_situation")
    if not isinstance(newswire, dict) or not isinstance(situation, dict):
        raise ReconciliationError("live freshness attestation artifacts are invalid")
    _keys(
        newswire,
        {"canonical_sha256", "generated_at", "path", "schema_version"},
        "live freshness attestation Newswire",
    )
    _keys(
        situation,
        {
            "canonical_sha256",
            "generated_at",
            "inputs",
            "path",
            "schema_version",
        },
        "live freshness attestation China situation",
    )
    inputs = situation.get("inputs")
    if not isinstance(inputs, dict):
        raise ReconciliationError(
            "live freshness attestation China situation inputs are invalid"
        )
    _keys(
        inputs,
        {"newswire_canonical_sha256", "newswire_generated_at"},
        "live freshness attestation China situation inputs",
    )
    _keys(
        rights_status,
        {"bytes", "path", "sha256"},
        "live freshness attestation rights status",
    )
    rights_bytes, rights_digest = _critical_file_identity(
        manifest, RIGHTS_STATUS_PATH
    )
    expected_wire = {
        "canonical_sha256": candidate["wire_canonical_sha256"],
        "generated_at": candidate["wire_generated_at"],
        "path": "readings/newswire-latest.json",
        "schema_version": "palimpsest-newswire.v1",
    }
    _sha256(
        situation.get("canonical_sha256"),
        "live freshness attestation China situation digest",
    )
    if (
        document.get("schema_version")
        != "palimpsest.publication-freshness-attestation.v1"
        or document.get("publication_sha") != candidate["release_sha"]
        or document.get("mode") != "rights-suppressed"
        or document.get("publication_allowed") is not False
        or document.get("limitations") != list(FRESHNESS_ATTESTATION_LIMITATIONS)
        or newswire != expected_wire
        or situation.get("path") != "readings/china-situation-latest.json"
        or situation.get("schema_version") != "palimpsest-china-situation.v1"
        or inputs
        != {
            "newswire_canonical_sha256": candidate["wire_canonical_sha256"],
            "newswire_generated_at": candidate["wire_generated_at"],
        }
        or rights_status
        != {
            "bytes": rights_bytes,
            "path": RIGHTS_STATUS_PATH,
            "sha256": rights_digest,
        }
    ):
        raise ReconciliationError(
            "live freshness attestation is not bound to the candidate identity"
        )
    wire_at = _deadline_timestamp(
        newswire["generated_at"], "live freshness attestation Newswire generated_at"
    )
    situation_at = _deadline_timestamp(
        situation.get("generated_at"),
        "live freshness attestation China situation generated_at",
    )
    attested_at = _deadline_timestamp(
        document.get("attested_at"), "live freshness attestation attested_at"
    )
    built_at = _deadline_timestamp(
        manifest.get("built_at"), "candidate manifest built_at"
    )
    if not wire_at <= situation_at <= attested_at <= built_at:
        raise ReconciliationError(
            "live freshness attestation clocks violate publication causality"
        )
    return document


def _validate_live_freshness_proofs(
    provider_raw: bytes,
    public_raw: bytes,
    *,
    manifest: dict[str, Any],
    candidate: dict[str, Any],
    attestation: dict[str, Any],
    now: datetime | None = None,
) -> None:
    top_keys = {
        "checked_at",
        "clocks",
        "rights",
        "schema_version",
        "service",
        "source_commit",
        "status",
        "tree_sha256",
    }
    clock_keys = {"age_seconds", "freshness_budget_seconds", "generated_at", "status"}
    checked_now = datetime.now(UTC) if now is None else now.astimezone(UTC)
    attested_wire = attestation["artifacts"]["newswire"]["generated_at"]
    if attested_wire != candidate["wire_generated_at"]:
        raise ReconciliationError(
            "dynamic freshness does not match the candidate attestation"
        )
    expected = {
        "wire": (
            attested_wire,
            WIRE_FRESHNESS_BUDGET_SECONDS,
        ),
        "publication": (manifest["built_at"], 3600),
    }
    checked_at_values: list[datetime] = []
    for label, raw in (("provider", provider_raw), ("public", public_raw)):
        proof = _object(raw, f"{label} live freshness proof")
        _keys(proof, top_keys, f"{label} live freshness proof")
        if (
            proof.get("schema_version") != "palimpsest.publication-freshness.v1"
            or proof.get("status") != "fresh"
            or proof.get("service") != "palimpsest-publication"
            or proof.get("source_commit") != candidate["release_sha"]
            or proof.get("tree_sha256") != manifest["tree_sha256"]
            or proof.get("rights")
            != {"mode": "rights-suppressed", "publication_allowed": False}
        ):
            raise ReconciliationError(
                f"{label} live freshness proof has the wrong release identity"
            )
        checked_at = _deadline_timestamp(
            proof.get("checked_at"), f"{label} live freshness checked_at"
        )
        if (
            abs((checked_now - checked_at).total_seconds())
            > LIVE_PROOF_CLOCK_SKEW_SECONDS
        ):
            raise ReconciliationError(
                f"{label} live freshness proof is not current"
            )
        checked_at_values.append(checked_at)
        clocks = proof.get("clocks")
        if not isinstance(clocks, dict) or set(clocks) != set(expected):
            raise ReconciliationError(
                f"{label} live freshness clock inventory is invalid"
            )
        for name, (generated_text, budget) in expected.items():
            row = clocks.get(name)
            if not isinstance(row, dict):
                raise ReconciliationError(
                    f"{label} {name} freshness clock is invalid"
                )
            _keys(row, clock_keys, f"{label} {name} freshness clock")
            generated = _deadline_timestamp(
                row.get("generated_at"), f"{label} {name} generated_at"
            )
            expected_age = max(0, int((checked_at - generated).total_seconds()))
            if (
                row.get("generated_at") != generated_text
                or type(row.get("age_seconds")) is not int
                or row["age_seconds"] != expected_age
                or row["age_seconds"] > budget
                or row.get("freshness_budget_seconds") != budget
                or row.get("status") != "fresh"
            ):
                raise ReconciliationError(
                    f"{label} {name} freshness proof is not live and bound"
                )
    if (
        abs((checked_at_values[0] - checked_at_values[1]).total_seconds())
        > LIVE_PROOF_CLOCK_SKEW_SECONDS
    ):
        raise ReconciliationError(
            "provider and public freshness proofs are not contemporaneous"
        )


def _strict_availability_story(story: dict[str, Any], generated_at: str) -> bool:
    signal_id = story.get("signal_id")
    if signal_id not in RESTRICTED_AVAILABILITY_SIGNALS:
        return False
    label = AVAILABILITY_LABELS[signal_id]
    slug = AVAILABILITY_SLUGS[signal_id]
    statement = (
        f"No current finding is published for {label} because public value "
        "publication is restricted by the active source policy."
    )
    claims = story.get("claims")
    evidence = story.get("evidence")
    source = evidence.get("input") if isinstance(evidence, dict) else None
    claim_core = {
        "claim_type": "availability",
        "metric": NULL_METRIC,
        "signal_id": signal_id,
        "statement": statement,
        "status": "degraded",
    }
    claim_fingerprint = "sha256:" + _digest(
        json.dumps(
            claim_core,
            allow_nan=False,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
    )
    return (
        set(story) == NEWSROOM_STORY_FIELDS
        and story.get("id") == f"palimpsest-news:{signal_id}"
        and story.get("slug") == slug
        and story.get("url") == f"https://palimpsest.info/news/{slug}/"
        and story.get("headline") == f"{label}: public value unavailable"
        and story.get("dek") == AVAILABILITY_DEK
        and story.get("status") == "degraded"
        and story.get("metric") == NULL_METRIC
        and isinstance(claims, list)
        and len(claims) == 1
        and isinstance(claims[0], dict)
        and set(claims[0]) == {"statement", "type"}
        and claims[0].get("type") == "availability"
        and claims[0].get("statement") == statement
        and isinstance(evidence, dict)
        and set(evidence) == {"input", "source_timestamp", "url"}
        and evidence.get("url") == RIGHTS_EVIDENCE_URL
        and evidence.get("source_timestamp") is None
        and isinstance(source, dict)
        and set(source) == {"bytes", "filename", "sha256"}
        and source.get("filename") == f"{signal_id}-latest.json"
        and source.get("sha256") is None
        and source.get("bytes") is None
        and story.get("published_at") == generated_at
        and story.get("modified_at") == generated_at
        and story.get("claim_fingerprint") == claim_fingerprint
        and story.get("method") == AVAILABILITY_METHOD
        and story.get("limitations") == AVAILABILITY_LIMITATIONS
        and {
            key: story.get(key)
            for key in ("section", "order", "type", "priority", "related_signal_ids")
        }
        == AVAILABILITY_EDITORIAL[signal_id]
    )


def _nonempty_text(value: Any, label: str, *, maximum: int) -> str:
    if (
        type(value) is not str
        or not value.strip()
        or len(value) > maximum
        or any(ord(character) < 32 or ord(character) == 127 for character in value)
    ):
        raise ReconciliationError(f"{label} is not bounded non-empty text")
    return value


def _story_revision_id(story: dict[str, Any]) -> str:
    payload = json.dumps(
        story,
        allow_nan=False,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return "storyv-" + _digest(payload)[:24]


def _newsroom_story_kind(story: dict[str, Any], generated_at: str) -> str:
    signal_id = story.get("signal_id")
    label = signal_id if isinstance(signal_id, str) else "unknown"
    identity = NEWSROOM_IDENTITY.get(signal_id)
    if (
        set(story) != NEWSROOM_STORY_FIELDS
        or identity is None
        or story.get("id") != f"palimpsest-news:{signal_id}"
        or story.get("slug") != identity["slug"]
        or story.get("url")
        != f"https://palimpsest.info/news/{identity['slug']}/"
        or type(story.get("order")) is not int
        or {
            key: story.get(key)
            for key in (
                "section",
                "order",
                "type",
                "priority",
                "related_signal_ids",
            )
        }
        != {
            key: value for key, value in identity.items() if key != "slug"
        }
    ):
        raise ReconciliationError(
            f"live structured newsroom story identity is invalid: {label}"
        )
    _nonempty_text(story.get("headline"), f"story {label} headline", maximum=160)
    _nonempty_text(story.get("dek"), f"story {label} dek", maximum=1000)
    published_text = story.get("published_at")
    modified_text = story.get("modified_at")
    published = _deadline_timestamp(published_text, f"story {label} published_at")
    modified = _deadline_timestamp(modified_text, f"story {label} modified_at")
    edition = _deadline_timestamp(generated_at, "live structured newsroom generated_at")
    if published != modified or published > edition:
        raise ReconciliationError(
            f"live structured newsroom story timestamps are invalid: {label}"
        )
    claims = story.get("claims")
    metric = story.get("metric")
    evidence = story.get("evidence")
    method = story.get("method")
    limitations = story.get("limitations")
    if (
        not isinstance(claims, list)
        or len(claims) != 1
        or not isinstance(claims[0], dict)
        or set(claims[0]) != {"statement", "type"}
        or not isinstance(claims[0].get("statement"), str)
        or not claims[0]["statement"].strip()
        or not isinstance(metric, dict)
        or set(metric) != {"denominator", "label", "unit", "value"}
        or not isinstance(metric.get("denominator"), dict)
        or set(metric["denominator"]) != {"label", "value"}
        or not isinstance(evidence, dict)
        or set(evidence) != {"input", "source_timestamp", "url"}
        or not isinstance(evidence.get("input"), dict)
        or set(evidence["input"]) != {"bytes", "filename", "sha256"}
        or not isinstance(method, dict)
        or set(method) != {"summary", "version"}
        or not isinstance(limitations, list)
        or not 1 <= len(limitations) <= 9
        or any(type(item) is not str for item in limitations)
        or len(limitations) != len(set(limitations))
    ):
        raise ReconciliationError(
            f"live structured newsroom story has invalid semantic shape: {label}"
        )

    _nonempty_text(claims[0]["statement"], f"story {label} claim", maximum=1000)
    _nonempty_text(method.get("summary"), f"story {label} method", maximum=8192)
    method_version = method.get("version")
    if not (
        method_version is None
        or type(method_version) is int
        and 1 <= method_version <= MAX_SAFE_INTEGER
        or type(method_version) is str
        and 1 <= len(method_version) <= 100
        and not any(
            ord(character) < 32 or ord(character) == 127
            for character in method_version
        )
    ):
        raise ReconciliationError(
            f"live structured newsroom story method version is invalid: {label}"
        )
    for limitation in limitations:
        _nonempty_text(limitation, f"story {label} limitation", maximum=1000)

    source = evidence["input"]
    filename = source.get("filename")
    source_sha = source.get("sha256")
    source_bytes = source.get("bytes")
    source_timestamp = evidence.get("source_timestamp")
    rights_evidence = (
        signal_id in RESTRICTED_AVAILABILITY_SIGNALS
        and evidence.get("url") == RIGHTS_EVIDENCE_URL
        and source_sha is None
        and source_bytes is None
        and source_timestamp is None
    )
    if (
        type(filename) is not str
        or re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,126}\.json", filename) is None
        or not rights_evidence
        and (
            evidence.get("url")
            != f"https://palimpsest.info/readings/{filename}"
            or (source_sha is None) != (source_bytes is None)
            or source_sha is not None
            and (
                type(source_sha) is not str
                or SHA256.fullmatch(source_sha) is None
                or type(source_bytes) is not int
                or not 0 <= source_bytes <= MAX_SAFE_INTEGER
            )
            or source_timestamp is not None
            and _deadline_timestamp(
                source_timestamp, f"story {label} evidence source_timestamp"
            )
            != published
            or source_timestamp is None
            and published != edition
            or story.get("status") == "missing"
            and (source_sha is not None or source_bytes is not None or source_timestamp is not None)
        )
    ):
        raise ReconciliationError(
            f"live structured newsroom story evidence is invalid: {label}"
        )

    claim_type = claims[0]["type"]
    if (
        claim_type in MEASUREMENT_CLAIM_TYPES
        and story.get("status") == "live"
        and (
            evidence.get("url")
            != f"https://palimpsest.info/readings/{filename}"
            or type(source_sha) is not str
            or SHA256.fullmatch(source_sha) is None
            or type(source_bytes) is not int
            or not 1 <= source_bytes <= MAX_SAFE_INTEGER
            or type(source_timestamp) is not str
            or source_timestamp != published_text
        )
    ):
        raise ReconciliationError(
            f"live structured newsroom measurement evidence is invalid: {label}"
        )
    claim_core = {
        "claim_type": claim_type,
        "metric": metric,
        "signal_id": signal_id,
        "statement": claims[0]["statement"],
        "status": story.get("status"),
    }
    expected_fingerprint = "sha256:" + _digest(
        json.dumps(
            claim_core,
            allow_nan=False,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
    )
    if story.get("claim_fingerprint") != expected_fingerprint:
        raise ReconciliationError(
            f"live structured newsroom story fingerprint is invalid: {label}"
        )

    if (
        claim_type == "availability"
        and story.get("status") in AVAILABILITY_STATUSES
        and metric == NULL_METRIC
    ):
        if len(limitations) < 2:
            raise ReconciliationError(
                f"live structured newsroom availability limitations are invalid: {label}"
            )
        if signal_id not in RESTRICTED_AVAILABILITY_SIGNALS:
            serialized = json.dumps(story, ensure_ascii=False, sort_keys=True).casefold()
            for marker in (
                RIGHTS_EVIDENCE_URL.casefold(),
                "rights-restricted-availability-v1",
                "public value publication is restricted",
                "active china economic source policy",
            ):
                if marker in serialized:
                    raise ReconciliationError(
                        "ordinary availability carries a rights-only marker: "
                        f"{label}"
                    )
        return "availability"

    value = metric.get("value")
    denominator_label = metric["denominator"].get("label")
    denominator_value = metric["denominator"].get("value")
    metric_label = metric.get("label")
    metric_unit = metric.get("unit")
    if (
        claim_type in MEASUREMENT_CLAIM_TYPES
        and story.get("status") == "live"
        and type(metric_label) is str
        and type(metric_unit) is str
        and isinstance(value, (int, float))
        and not isinstance(value, bool)
        and math.isfinite(value)
        and -MAX_SAFE_INTEGER <= value <= MAX_SAFE_INTEGER
        and (
            denominator_label is None
            or (
                type(denominator_label) is str
            )
        )
        and (
            denominator_value is None
            or (
                isinstance(denominator_value, int)
                and not isinstance(denominator_value, bool)
                and 0 <= denominator_value <= MAX_SAFE_INTEGER
            )
        )
    ):
        _nonempty_text(metric_label, f"story {label} metric label", maximum=1000)
        _nonempty_text(metric_unit, f"story {label} metric unit", maximum=1000)
        if denominator_label is not None:
            _nonempty_text(
                denominator_label,
                f"story {label} denominator label",
                maximum=1000,
            )
        return "measurement"
    raise ReconciliationError(
        f"live structured newsroom story mixes claim and metric semantics: {label}"
    )


def _validate_live_newsroom(
    raw: bytes,
    *,
    expected_wire_generated_at: str,
    manifest_built_at: str,
) -> tuple[int, int]:
    document = _object(raw, "live structured newsroom")
    _keys(
        document,
        {
            "coverage",
            "feed_id",
            "generated_at",
            "headline",
            "method",
            "n_stories",
            "schema_version",
            "scope",
            "sections",
            "source",
            "source_commit",
            "stories",
            "title",
            "url",
        },
        "live structured newsroom",
    )
    generated_at = document.get("generated_at")
    newsroom_at = _deadline_timestamp(
        generated_at, "live structured newsroom generated_at"
    )
    wire_at = _deadline_timestamp(
        expected_wire_generated_at, "candidate wire generated_at"
    )
    manifest_at = _deadline_timestamp(
        manifest_built_at, "Railway manifest built_at"
    )
    if not wire_at <= newsroom_at <= manifest_at:
        raise ReconciliationError(
            "live structured newsroom clocks are not causally ordered"
        )
    if (
        document.get("feed_id") != "palimpsest-china-newsroom"
        or document.get("title") != "Palimpsest China Newsroom"
        or document.get("url") != "https://palimpsest.info/news/"
        or document.get("source")
        != "https://palimpsest.info/readings/osint-china-latest.json"
        or type(document.get("source_commit")) is not str
        or SHA40.fullmatch(document["source_commit"]) is None
        or type(document.get("headline")) is not str
        or not document["headline"].strip()
        or type(document.get("method")) is not str
        or not document["method"].strip()
        or type(document.get("scope")) is not str
        or not document["scope"].strip()
    ):
        raise ReconciliationError("live structured newsroom identity is invalid")
    _nonempty_text(
        document["headline"], "live structured newsroom headline", maximum=1000
    )
    _nonempty_text(
        document["method"], "live structured newsroom method", maximum=8192
    )
    _nonempty_text(
        document["scope"], "live structured newsroom scope", maximum=8192
    )
    sections = document.get("sections")
    if (
        not isinstance(sections, list)
        or len(sections) != len(SECTION_IDENTITIES)
        or any(
            not isinstance(section, dict)
            or set(section) != {"dek", "id", "order", "title"}
            or section.get("id") not in SECTION_IDENTITIES
            or type(section.get("order")) is not int
            or (section.get("order"), section.get("title"))
            != SECTION_IDENTITIES[section["id"]]
            or type(section.get("dek")) is not str
            or not section["dek"].strip()
            for section in sections
        )
        or [section["id"] for section in sections]
        != [
            section_id
            for section_id, _identity in sorted(
                SECTION_IDENTITIES.items(), key=lambda row: row[1][0]
            )
        ]
    ):
        raise ReconciliationError(
            "live structured newsroom section inventory is invalid"
        )
    for section in sections:
        _nonempty_text(
            section["dek"],
            f"live structured newsroom section {section['id']} dek",
            maximum=1000,
        )
    stories = document.get("stories")
    if (
        document.get("schema_version") != "palimpsest-news.v1"
        or type(document.get("n_stories")) is not int
        or document.get("n_stories") != 39
        or not isinstance(stories, list)
        or len(stories) != 39
        or any(not isinstance(story, dict) for story in stories)
    ):
        raise ReconciliationError(
            "live structured newsroom lacks its exact story inventory"
        )
    signal_ids = [story.get("signal_id") for story in stories]
    if tuple(signal_ids) != EXPECTED_NEWSROOM_ORDER:
        raise ReconciliationError(
            "live structured newsroom signal inventory is invalid"
        )
    by_signal = {story["signal_id"]: story for story in stories}
    for signal_id in RESTRICTED_AVAILABILITY_SIGNALS:
        if not _strict_availability_story(by_signal[signal_id], generated_at):
            raise ReconciliationError(
                f"live structured newsroom has an unsafe availability record: {signal_id}"
            )
    kinds = [_newsroom_story_kind(story, generated_at) for story in stories]
    availability_count = kinds.count("availability")
    measurement_count = kinds.count("measurement")
    if measurement_count + availability_count != 39:
        raise ReconciliationError(
            "live structured newsroom has an invalid semantic story count"
        )
    coverage = document.get("coverage")
    status_counts = {
        status: sum(story["status"] == status for story in stories)
        for status in ("live", "degraded", "stale", "missing", "corrupt")
    }
    if (
        not isinstance(coverage, dict)
        or set(coverage) != {"counts", "live", "reporting", "status", "total"}
        or any(
            type(coverage.get(key)) is not int
            for key in ("live", "reporting", "total")
        )
        or not isinstance(coverage.get("counts"), dict)
        or any(
            type(value) is not int or value < 0
            for value in coverage["counts"].values()
        )
        or coverage.get("total") != 39
        or coverage.get("live") != measurement_count
        or coverage.get("reporting")
        != status_counts["live"]
        + status_counts["degraded"]
        + status_counts["stale"]
        or coverage.get("status") != "degraded"
        or coverage.get("counts") != status_counts
    ):
        raise ReconciliationError(
            "live structured newsroom coverage is not bound to its stories"
        )
    return measurement_count, availability_count


def _validate_live_newsroom_proofs(
    provider_raw: bytes,
    public_raw: bytes,
    *,
    manifest: dict[str, Any],
    expected_wire_generated_at: str,
) -> tuple[int, int]:
    if provider_raw != public_raw:
        raise ReconciliationError("provider and public structured newsrooms differ")
    expected_bytes, expected_digest = _critical_file_identity(manifest, NEWSROOM_PATH)
    if (
        len(public_raw) != expected_bytes
        or _digest(public_raw) != expected_digest
    ):
        raise ReconciliationError(
            "live structured newsroom is not byte-bound to the candidate manifest"
        )
    return _validate_live_newsroom(
        public_raw,
        expected_wire_generated_at=expected_wire_generated_at,
        manifest_built_at=manifest.get("built_at"),
    )


def _measurement_evidence_specs(
    newsroom_raw: bytes, *, expected_count: int
) -> dict[str, tuple[int, str]]:
    document = _object(newsroom_raw, "measurement evidence newsroom")
    stories = document.get("stories")
    if not isinstance(stories, list):
        raise ReconciliationError(
            "measurement evidence newsroom story inventory is invalid"
        )
    specs: dict[str, tuple[int, str]] = {}
    for story in stories:
        claims = story.get("claims") if isinstance(story, dict) else None
        if (
            not isinstance(claims, list)
            or len(claims) != 1
            or not isinstance(claims[0], dict)
            or claims[0].get("type") not in MEASUREMENT_CLAIM_TYPES
            or story.get("status") != "live"
        ):
            continue
        signal_id = story.get("signal_id")
        evidence = story.get("evidence")
        source = evidence.get("input") if isinstance(evidence, dict) else None
        if not isinstance(source, dict):
            raise ReconciliationError(
                f"measurement evidence claim is invalid: {signal_id}"
            )
        filename = source.get("filename")
        digest = source.get("sha256")
        size = source.get("bytes")
        published_at = story.get("published_at")
        if (
            not isinstance(filename, str)
            or re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,126}\.json", filename)
            is None
            or not isinstance(digest, str)
            or SHA256.fullmatch(digest) is None
            or type(size) is not int
            or not 1 <= size <= MAX_MEASUREMENT_EVIDENCE
            or not isinstance(published_at, str)
            or UTC_CLOCK.fullmatch(published_at) is None
            or evidence.get("source_timestamp") != published_at
            or evidence.get("url")
            != f"https://palimpsest.info/readings/{filename}"
        ):
            raise ReconciliationError(
                f"measurement evidence claim is invalid: {signal_id}"
            )
        relative = f"readings/{filename}"
        identity = (size, digest)
        if relative in specs and specs[relative] != identity:
            raise ReconciliationError(
                f"measurement evidence path has conflicting claims: {relative}"
            )
        specs[relative] = identity
    if len(specs) != expected_count:
        raise ReconciliationError(
            "measurement evidence inventory count differs from the newsroom"
        )
    return dict(sorted(specs.items()))


def _validate_live_newsroom_html(
    raw: bytes, *, measurement_count: int, availability_count: int
) -> None:
    try:
        text = raw.decode("utf-8", "strict")
    except UnicodeError as exc:
        raise ReconciliationError("live newsroom HTML is not UTF-8") from exc
    expected = (str(measurement_count), str(availability_count))
    strong_counts = re.findall(
        r"<strong>([0-9]+)</strong> measurements · "
        r"<strong>([0-9]+)</strong> availability notices in this edition",
        text,
    )
    plain_counts = re.findall(
        r"(?<![0-9])([0-9]+) measurements · "
        r"([0-9]+) availability notices ·",
        text,
    )
    if (
        text.count("<strong>Edition generated</strong>") != 1
        or strong_counts != [expected]
        or plain_counts != [expected]
    ):
        raise ReconciliationError(
            "live newsroom is not exactly bound to its structured counts"
        )
    if "measurements live" in text:
        raise ReconciliationError(
            "live newsroom falsely labels snapshot measurements as continuously live"
        )


