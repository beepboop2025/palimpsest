[Unit]
Description=Create and independently verify a backup of the current Palimpsest API node
Requires=docker.service
After=docker.service
RequiresMountsFor=/home/palimpsest/backups
AssertFileIsExecutable=/usr/local/sbin/palimpsest-runtime-backup
AssertFileIsExecutable=/usr/local/libexec/palimpsest-runtime-backup/source/ops/backup/palimpsest-backup.sh

[Service]
Type=oneshot
User=palimpsest
Group=palimpsest
StateDirectory=palimpsest-runtime-backup
StateDirectoryMode=0700
EnvironmentFile=/etc/palimpsest/runtime-backup.env
ExecStart=/usr/local/sbin/palimpsest-runtime-backup
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/palimpsest/backups/runtime-node
ReadOnlyPaths=/usr/local/libexec/palimpsest-runtime-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
