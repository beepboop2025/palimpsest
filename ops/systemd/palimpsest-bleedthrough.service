[Unit]
Description=Measure GFW DNS-injector telemetry from the Palimpsest Hetzner vantage
Documentation=file:///usr/local/libexec/palimpsest-network-lane/current/README.md
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/libexec/palimpsest-network-lane/current/ops/bleedthrough_prober.sh
ConditionFileIsExecutable=/usr/local/libexec/palimpsest-network-lane/current/network_lane.py
ConditionFileIsExecutable=/usr/local/libexec/palimpsest-network-lane/current/verify-host-bundle.sh
ConditionPathExists=/usr/local/libexec/palimpsest-network-lane/current/MANIFEST.sha256
ConditionPathExists=/usr/local/libexec/palimpsest-network-lane/current/REVISION
ConditionPathExists=/etc/palimpsest/deployed-commit
ConditionPathExists=/etc/palimpsest/bleedthrough.env
ConditionPathIsDirectory=/var/lib/palimpsest/network-lane

[Service]
Type=oneshot
User=palimpsest
Group=palimpsest
WorkingDirectory=/usr/local/libexec/palimpsest-network-lane/current
EnvironmentFile=/etc/palimpsest/bleedthrough.env
ExecStartPre=/usr/bin/cmp -s /usr/local/libexec/palimpsest-network-lane/current/REVISION /etc/palimpsest/deployed-commit
ExecStartPre=/bin/sh /usr/local/libexec/palimpsest-network-lane/current/verify-host-bundle.sh
ExecStart=/usr/bin/python3 /usr/local/libexec/palimpsest-network-lane/current/network_lane.py --state-dir /var/lib/palimpsest/network-lane bleedthrough --quiet-seconds 900
SuccessExitStatus=75

# Direct-probe receive windows overlap under the unchanged 5-query/s token bucket:
# 216 targets × ((24 / 5) + 1.2s) is roughly 22 minutes before BGP refresh,
# curation, and network variance. The durable flock separately prevents a manual
# start from overlapping the timer while the three-hour safety envelope is active.
TimeoutStartSec=3h
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TasksMax=32
MemoryMax=512M

# Code and host configuration are read-only. Only private BLEEDTHROUGH state and
# sanitized reading artifacts are writable by this service.
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/usr/local/libexec/palimpsest-network-lane /etc/palimpsest/deployed-commit
ReadWritePaths=/var/lib/palimpsest/bleedthrough /var/lib/palimpsest/readings /var/lib/palimpsest/network-lane/lane.lock /var/lib/palimpsest/network-lane/state /var/lib/palimpsest/network-lane/receipts
NoExecPaths=/var/lib/palimpsest/bleedthrough /var/lib/palimpsest/readings /var/lib/palimpsest/network-lane/state /var/lib/palimpsest/network-lane/receipts
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private

# AF_INET/AF_INET6 carry RIPE HTTPS and stateless DNS. AF_UNIX is retained for
# libc/systemd-resolved name resolution and local process plumbing.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
