# local ops logs (not part of the site)
logs/
*.log
deploy_retry.sh

# python / macOS cruft
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
**/.DS_Store

# local scraped data cache (published output goes to readings/, not here)
data/
# ...except the China brief's novelty baseline, which is a published input, not a cache.
# Novelty is scored against it, so if the refresh workflow cannot commit it every term
# reads as new on every run. The directory must be re-included before the file can be:
# git cannot un-ignore a path whose parent directory is still excluded.
!demo/data/
demo/data/*
!demo/data/cdt_history.json

# arXiv paper draft — identity-binding, must NEVER ship to this public repo
paper/

# local launchd-era logs
deploy_retry*.log
logs/

# validation coding sheets in progress — published only when the study completes
validation/out/

# demo output — the README's ten-second command writes this next to the demo script,
# so every reader who tries it would otherwise get a dirty working tree
demo/report.html

# BLEEDTHROUGH prober-generated artifacts (real prefixes/targets + baselines are built on
# the prober from config/bleedthrough_asns.json; only the seed map + examples are source)
config/bleedthrough_prefixes.json
config/bleedthrough_targets.json
data/bleedthrough_baselines/

# Local operator config. Stays untracked: this repository is published in full.
.scrub-strings.local
/ops/docker/.env

# Runtime evidence intake. Capsules are reviewed/exported through the
# ScamShield integration scripts and must not dirty the public source tree.
var/
