def _exact(document: dict[str, Any], keys: set[str], label: str) -> None:
    if set(document) != keys:
        raise LiveAnalysisError(f"{label} does not match its closed schema")


def _strict_object(raw: bytes, label: str) -> dict[str, Any]:
    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        document: dict[str, Any] = {}
        for key, value in rows:
            if key in document:
                raise LiveAnalysisError(f"{label} contains a duplicate key")
            document[key] = value
        return document

    try:
        parsed = json.loads(
            raw,
            object_pairs_hook=pairs,
            parse_constant=lambda value: (_ for _ in ()).throw(
                LiveAnalysisError(f"{label} contains {value}")
            ),
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise LiveAnalysisError(f"{label} is not strict JSON") from exc
    if type(parsed) is not dict:
        raise LiveAnalysisError(f"{label} must be an object")
    return parsed


def _read_regular(
    path: Path,
    *,
    label: str,
    uid: int,
    gid: int | None,
    mode: int | None,
    maximum: int,
    forbid_group_other_write: bool = False,
) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise LiveAnalysisError(f"cannot open {label}") from exc
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != uid
            or (gid is not None and before.st_gid != gid)
            or (mode is not None and stat.S_IMODE(before.st_mode) != mode)
            or (
                forbid_group_other_write
                and bool(stat.S_IMODE(before.st_mode) & 0o022)
            )
            or before.st_nlink != 1
            or before.st_size <= 0
            or before.st_size > maximum
        ):
            raise LiveAnalysisError(f"{label} metadata is unsafe")
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        try:
            pathname = os.stat(path, follow_symlinks=False)
        except OSError as exc:
            raise LiveAnalysisError(f"{label} pathname changed") from exc
        def identity(item: os.stat_result) -> tuple[int, ...]:
            return (
                item.st_dev,
                item.st_ino,
                item.st_mode,
                item.st_uid,
                item.st_gid,
                item.st_nlink,
                item.st_size,
                item.st_mtime_ns,
            )
        if (
            len(raw) > maximum
            or identity(before) != identity(after)
            or before.st_dev != pathname.st_dev
            or before.st_ino != pathname.st_ino
        ):
            raise LiveAnalysisError(f"{label} changed while reading")
        return raw
    finally:
        os.close(descriptor)


def _read_pin(path: Path, *, uid: int, gid: int) -> bytes:
    return _read_regular(
        path,
        label="publication-base pin",
        uid=uid,
        gid=gid,
        mode=0o640,
        maximum=MAX_PIN_BYTES,
    )


def _acquire_publication_boundary(
    config: RuntimeConfig, *, pin_gid: int
) -> int:
    """Hold the shared root interlock across the final pin check and replace."""

    path = config.control_root / "publish.lock"
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise LiveAnalysisError("cannot open root publication lock") from exc
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != config.pin_uid
            or before.st_gid != pin_gid
            or stat.S_IMODE(before.st_mode) != 0o640
            or before.st_nlink != 1
        ):
            raise LiveAnalysisError("root publication lock metadata is unsafe")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise LiveAnalysisError("publication mutation is active") from exc
        after = os.fstat(descriptor)
        pathname = os.stat(path, follow_symlinks=False)
        if (
            _file_identity(before) != _file_identity(after)
            or before.st_dev != pathname.st_dev
            or before.st_ino != pathname.st_ino
        ):
            raise LiveAnalysisError("root publication lock changed while locking")
        return descriptor
    except (OSError, LiveAnalysisError):
        os.close(descriptor)
        raise


def _validate_directory(
    path: Path, *, label: str, uid: int, gid: int, mode: int
) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise LiveAnalysisError(f"cannot inspect {label}") from exc
    if (
        not path.is_absolute()
        or path.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != uid
        or metadata.st_gid != gid
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise LiveAnalysisError(f"{label} metadata is unsafe")


def _history_root(config: RuntimeConfig) -> Path:
    return config.control_root / "base-rotation-history"


def _validate_history_layout(config: RuntimeConfig, *, pin_gid: int) -> Path:
    _validate_directory(
        config.control_root,
        label="rotation control root",
        uid=config.pin_uid,
        gid=pin_gid,
        mode=0o750,
    )
    root = _history_root(config)
    _validate_directory(
        root,
        label="base-rotation history root",
        uid=config.pin_uid,
        gid=pin_gid,
        mode=0o750,
    )
    for category in (
        "pins",
        "receipts",
        "manifests",
        "manifests/provider",
        "manifests/public",
        "topologies",
        "rotations",
    ):
        _validate_directory(
            root / category,
            label=f"base-rotation {category} directory",
            uid=config.pin_uid,
            gid=pin_gid,
            mode=0o750,
        )
    return root


