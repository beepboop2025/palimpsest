        raise RestoreError("RAILWAY_PUBLICATION_ENABLED is not exactly false")
    if _exclusive_ack(deadline, repository) != EXCLUSIVE_WRITER_ACK:
        raise RestoreError("protected Railway writer acknowledgement is not exact")


def _ack_inventory(raw: str) -> str:
    value = _strict_json_text(raw, label="protected environment variables")
    if not isinstance(value, list):
        return "unproved"
    matches: list[Any] = []
    for item in value:
        if not isinstance(item, dict) or set(item) != {"name", "value"}:
            return "unproved"
        if item.get("name") == ACK_VARIABLE:
            matches.append(item.get("value"))
    if not matches:
        return "absent"
    if matches == [EXCLUSIVE_WRITER_ACK]:
        return "exact"
    return "unexpected"


def _ack_absent(raw: str) -> bool:
    value = _strict_json_text(raw, label="protected environment variable names")
    return isinstance(value, list) and all(
        isinstance(item, dict)
        and set(item) == {"name"}
        and item.get("name") != ACK_VARIABLE
        for item in value
    )


def _failure_cleanup(
    repository: str, run_state: RunState
) -> tuple[bool, dict[str, Any]]:
    cleanup_ok = True
    run_id = run_state.current_run_id
    states: dict[str, str] = {}
    for spec in WORKFLOWS:
        try:
            _cleanup_gh(
                "workflow",
                "disable",
                str(spec.workflow_id),
                "--repo",
                repository,
            )
            state = _workflow_metadata(
                Deadline.start(COMMAND_TIMEOUT_SECONDS), repository, spec
            )["state"]
            if state != "disabled_manually":
                raise RestoreError(
                    f"cleanup did not prove {spec.filename} disabled_manually"
                )
            states[spec.filename] = state
        except RestoreError as error:
            print(str(error), file=sys.stderr)
            cleanup_ok = False
            states[spec.filename] = "unproved"
    gate = "unproved"
    try:
        _cleanup_gh(
            "variable",
            "set",
            GATE_VARIABLE,
            "--body",
            "false",
            "--repo",
            repository,
        )
        gate = _exact_text(
            _cleanup_gh("variable", "get", GATE_VARIABLE, "--repo", repository),
            label="cleanup Railway hourly gate",
        )
        if gate != "false":
            raise RestoreError("cleanup did not prove the Railway gate closed")
    except RestoreError as error:
        print(str(error), file=sys.stderr)
        cleanup_ok = False
    ack = "unproved"
    try:
        state = _ack_inventory(
            _cleanup_gh(
                "variable",
                "list",
                "--repo",
                repository,
                "--env",
                PRODUCTION_ENVIRONMENT,
                "--json",
                "name,value",
            )
        )
        if state == "exact":
            _cleanup_gh(
                "variable",
                "delete",
                ACK_VARIABLE,
                "--repo",
                repository,
                "--env",
                PRODUCTION_ENVIRONMENT,
            )
        elif state != "absent":
            raise RestoreError(
                "refusing to delete an unfamiliar Railway writer acknowledgement"
            )
        if not _ack_absent(
            _cleanup_gh(
                "variable",
                "list",
                "--repo",
                repository,
                "--env",
                PRODUCTION_ENVIRONMENT,
                "--json",
                "name",
            )
        ):
            raise RestoreError("cleanup did not prove writer acknowledgement absent")
        ack = "absent"
    except RestoreError as error:
        print(str(error), file=sys.stderr)
        cleanup_ok = False
    reconciled_run: dict[str, Any] | None = None
    if run_id is not None:
        print(
            f"Reconcile producer run {run_id}; cleanup deliberately did not cancel it.",
            file=sys.stderr,
        )
        deadline = Deadline.start(900)
        try:
            while True:
                value = _strict_json_text(
                    _gh(
                        deadline,
                        "api",
                        f"repos/{repository}/actions/runs/{run_id}",
                        label=f"reconcile producer run {run_id}",
                    ),
                    label=f"reconcile producer run {run_id}",
                )
                if not isinstance(value, dict) or value.get("id") != run_id:
                    raise RestoreError("cleanup run reconciliation is malformed")
                if value.get("status") == "completed":
                    reconciled_run = {
                        "conclusion": value.get("conclusion"),
                        "run_attempt": value.get("run_attempt"),
                        "run_id": run_id,
                        "status": "completed",
                    }
                    break
                if value.get("status") not in ACTIVE_RUN_STATES:
                    raise RestoreError("cleanup run has an unsupported terminal state")
                deadline.sleep()
        except RestoreError as error:
            print(str(error), file=sys.stderr)
            cleanup_ok = False
    if run_state.attempt_run_snapshots is not None:
        quiet_snapshot: list[dict[int, dict[str, Any]]] | None = None
        for sample in range(CLEANUP_QUIET_SAMPLES):
            try:
                current = _all_run_snapshots(
                    Deadline.start(COMMAND_TIMEOUT_SECONDS * len(WORKFLOWS)),
                    repository,
                )
                _validate_attempt_run_set(run_state, current, require_completed=True)
                if quiet_snapshot is not None and current != quiet_snapshot:
                    _mark_producer_runs_unproved(run_state)
                    raise RestoreError(
                        "cleanup producer run inventory did not remain quiet"
                    )
                quiet_snapshot = current
            except RestoreError as error:
                print(str(error), file=sys.stderr)
                cleanup_ok = False
            if sample + 1 < CLEANUP_QUIET_SAMPLES:
                time.sleep(CLEANUP_QUIET_INTERVAL_SECONDS)
    else:
        cleanup_ok = False
    main_sha: str | None = None
    try:
        main_sha = _exact_text(
            _cleanup_gh("api", f"repos/{repository}/commits/main", "--jq", ".sha"),
            label="cleanup public main",
        )
        if not _is_sha40(main_sha):
            raise RestoreError("cleanup did not prove an exact public main SHA")
    except RestoreError as error:
        print(str(error), file=sys.stderr)
        cleanup_ok = False
    return cleanup_ok, {
        "exclusive_writer_ack": ack,
        "hourly_publication_enabled": gate,
        "in_flight_run_id": None if reconciled_run is not None else run_id,
        "reconciled_run": reconciled_run,
        "resume_main_sha": main_sha,
        "workflow_states": states,
    }


def _validate_celery(value: Any) -> None:
    receipt = _expect_keys(
        value,
        {
            "cancellations",
            "consumer_state",
            "drain_samples",
            "final",
            "generated_at",
            "required_zero_samples",
            "samples_observed",
            "schema_version",
            "status",
            "topology",
            "topology_sha256",
        },
        label="Phase 3 restored Celery receipt",
    )
    topology = receipt["topology"]
    if not isinstance(topology, list) or len(topology) not in {3, 4}:
        raise RestoreError("Phase 3 restored Celery topology is invalid")
    nodes: dict[str, str] = {}
    for item in topology:
        pair = _expect_keys(item, {"node", "queue"}, label="Celery topology pair")
        if (
            not isinstance(pair["node"], str)
            or not isinstance(pair["queue"], str)
            or pair["node"] in nodes
            or pair["queue"] in nodes.values()
        ):
            raise RestoreError("Phase 3 Celery topology pair is invalid")
        nodes[pair["node"]] = pair["queue"]
    final = _expect_keys(
        receipt["final"],
        {"active_queues", "broker_depth", "task_counts", "unacknowledged"},
        label="Phase 3 restored Celery final sample",
    )
    if (
        receipt["schema_version"] != "palimpsest-celery-release-gate.v1"
        or receipt["status"] != "quiet"
        or receipt["consumer_state"] != "consuming"
        or receipt["required_zero_samples"] != 2
        or not _positive_int(receipt["samples_observed"])
        or receipt["drain_samples"] != 0
        or receipt["cancellations"] != []
        or not _is_sha256(receipt["topology_sha256"])
    ):
        raise RestoreError("Phase 3 restored Celery semantics are invalid")
    _utc(receipt["generated_at"], label="Phase 3 Celery generated_at")
    task_counts = final["task_counts"]
    active_queues = final["active_queues"]
    if not isinstance(task_counts, dict) or set(task_counts) != set(nodes):
        raise RestoreError("Phase 3 Celery task-count inventory is invalid")
    if not isinstance(active_queues, dict) or set(active_queues) != set(nodes):
        raise RestoreError("Phase 3 Celery active-queue inventory is invalid")
    for node, queue in nodes.items():
        counts = _expect_keys(
            task_counts[node], {"active", "reserved", "scheduled"}, label="task counts"
        )
        if counts != {"active": 0, "reserved": 0, "scheduled": 0}:
            raise RestoreError("Phase 3 Celery has pending tasks")
        if active_queues[node] != [queue]:
            raise RestoreError("Phase 3 Celery worker is not on its exact queue")
    broker = final["broker_depth"]
    unacknowledged = final["unacknowledged"]
    if (
        not isinstance(broker, dict)
        or set(broker) != BROKER_QUEUES
        or any(value != 0 for value in broker.values())
        or unacknowledged != {"hash": 0, "index": 0}
    ):
        raise RestoreError("Phase 3 restored broker is not exactly empty")


def _validate_phase3(
    value: Any, *, expected_host_sha: str
) -> tuple[str, str, str, str, dict[str, Any] | None]:
    base = {
        "backup_on_success",
        "backup_release_quiesce_present",
        "deployed_sha",
        "finalized_at",
        "previous_checkout_sha",
        "previous_deployment_receipt_sha",
        "proof_complete_receipt",
        "proof_complete_receipt_sha256",
        "release_proof_present",
        "restored_activators",
        "restored_beat",
        "restored_celery",
        "restored_compose_writers",
        "schema_version",
        "status",
        "transaction_id",
        "writers_restored",
    }
    recovery = {
        "interrupted_phase1_completion_receipt",
        "interrupted_phase1_completion_required",
        "interrupted_phase1_resume",
    }
    if not isinstance(value, dict) or frozenset(value) not in {
        frozenset(base),
        frozenset(base | recovery),
    }:
        raise RestoreError("Phase 3 finalized receipt does not have its exact schema")
    finalized_at = _utc(value["finalized_at"], label="Phase 3 finalized_at")
    if (
        value["schema_version"] != "palimpsest-host-release-finalization.v1"
        or value["status"] != "finalized"
        or value["deployed_sha"] != expected_host_sha
        or not _is_sha40(value["previous_checkout_sha"])
        or not _is_sha40(value["previous_deployment_receipt_sha"])
        or not isinstance(value["transaction_id"], str)
        or TRANSACTION.fullmatch(value["transaction_id"]) is None
        or not isinstance(value["proof_complete_receipt"], str)
        or not Path(value["proof_complete_receipt"]).is_absolute()
        or not _is_sha256(value["proof_complete_receipt_sha256"])
        or value["release_proof_present"] is not False
        or value["writers_restored"] is not True
        or value["backup_release_quiesce_present"] is not False
        or not isinstance(value["backup_on_success"], str)
    ):
        raise RestoreError("Phase 3 finalized receipt semantics are invalid")
    activators = value["restored_activators"]
    if not isinstance(activators, dict) or set(activators) != RELEASE_ACTIVATORS:
        raise RestoreError("Phase 3 restored activator inventory is invalid")
    for unit, raw in activators.items():
        item = _expect_keys(
            raw,
            {"active_state", "before_enablement", "enablement", "was_active"},
            label=f"Phase 3 activator {unit}",
        )
        if (
            not isinstance(item["was_active"], bool)
            or item["before_enablement"]
            not in {"disabled", "enabled", "enabled-runtime", "not-found", "static"}
            or item["enablement"]
            not in {"disabled", "enabled", "enabled-runtime", "not-found", "static"}
            or item["active_state"]
            not in {"active", "failed", "inactive", "unknown", ""}
        ):
            raise RestoreError(f"Phase 3 activator {unit} is malformed")
    compose = value["restored_compose_writers"]
    if not isinstance(compose, dict) or set(compose) != COMPOSE_WRITERS:
        raise RestoreError("Phase 3 restored Compose inventory is invalid")
    for service, raw in compose.items():
        item = _expect_keys(
            raw,
            {"container_id", "hostname", "image_id", "state", "was_running"},
            label=f"Phase 3 Compose writer {service}",
        )
        if (
            not isinstance(item["was_running"], bool)
            or item["state"] not in {"absent", "exited", "running"}
            or (
                item["container_id"] is not None
                and (
                    not isinstance(item["container_id"], str)
                    or SHA256.fullmatch(item["container_id"]) is None
                )
            )
            or (
                item["image_id"] is not None
                and (
                    not isinstance(item["image_id"], str)
                    or re.fullmatch(r"sha256:[0-9a-f]{64}", item["image_id"]) is None
                )
            )
            or (item["hostname"] is not None and not isinstance(item["hostname"], str))
        ):
            raise RestoreError(f"Phase 3 Compose writer {service} is malformed")
        if item["was_running"] and item["state"] != "running":
            raise RestoreError(f"Phase 3 Compose writer {service} was not restored")
    if value["restored_beat"] != compose["beat"]:
        raise RestoreError("Phase 3 restored Beat binding is invalid")
    _validate_celery(value["restored_celery"])
    if recovery <= set(value):
        binding = value["interrupted_phase1_resume"]
        binding_keys = {
            "backup",
            "broker_empty_receipt",
            "broker_empty_receipt_sha256",
            "broker_queue_sha256",
            "compose_environment_sha256",
            "failed_target_commit",
            "hybrid_fingerprint_sha256",
            "incident_id",
            "manifest",
            "manifest_sha256",
            "migration_receipt",
            "minimum_recovery_ancestor",
            "prepared_receipt",
            "prepared_receipt_path",
            "prepared_receipt_sha256",
            "recovery_controller_commit",
            "restore_profile_sha256",
            "schema_version",
            "target_commit",
            "transaction_id",
        }
        binding = _expect_keys(
            binding, binding_keys, label="interrupted Phase 1 binding"
        )
        if (
            value["interrupted_phase1_completion_required"] is not True
            or not isinstance(value["interrupted_phase1_completion_receipt"], str)
            or not Path(value["interrupted_phase1_completion_receipt"]).is_absolute()
            or binding["schema_version"] != "palimpsest-interrupted-phase1-binding.v2"
            or binding["transaction_id"] != value["transaction_id"]
            or binding["target_commit"] != expected_host_sha
            or binding["recovery_controller_commit"] != expected_host_sha
        ):
            raise RestoreError("interrupted Phase 1 recovery binding is invalid")
    return (
        value["transaction_id"],
        finalized_at.isoformat().replace("+00:00", "Z"),
        value["proof_complete_receipt"],
        value["proof_complete_receipt_sha256"],
        value.get("interrupted_phase1_resume"),
    )


