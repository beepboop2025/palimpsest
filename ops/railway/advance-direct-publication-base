        type=Path,
        default=Path("/etc/systemd/system/palimpsest-direct-watchdog.timer"),
    )
    parser.add_argument("--publisher-user", default="palimpsest")
    parser.add_argument("--publisher-group", default="palimpsest")
    return parser


def main(argv: list[str] | None = None) -> int:
    try:
        document = perform_transition(_parser().parse_args(argv))
    except TransitionError as exc:
        print(f"base transition refused: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(document, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
