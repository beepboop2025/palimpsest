          .live_manifest.tree_sha256 == $pin[0].predecessor.publication_receipt.tree_sha256 and
          .railway.deployment_id == $pin[0].predecessor.publication_receipt.deployment_id
          ' "$bridge_receipt_path" >/dev/null || {
          log "archived predecessor receipt differs from successor pin" >&2
          return 1
        }

        provider_history_path="$(jq -er '.live.provider_manifest.path' "$PUBLICATION_BASE_FILE")"
        provider_history_sha="$(jq -er '.live.provider_manifest.sha256' "$PUBLICATION_BASE_FILE")"
        provider_history_bytes="$(jq -er '.live.provider_manifest.bytes' "$PUBLICATION_BASE_FILE")"
        public_history_path="$(jq -er '.live.public_manifest.path' "$PUBLICATION_BASE_FILE")"
        public_history_sha="$(jq -er '.live.public_manifest.sha256' "$PUBLICATION_BASE_FILE")"
        public_history_bytes="$(jq -er '.live.public_manifest.bytes' "$PUBLICATION_BASE_FILE")"
        topology_history_path="$(jq -er '.railway.topology.path' "$PUBLICATION_BASE_FILE")"
        topology_history_sha="$(jq -er '.railway.topology.sha256' "$PUBLICATION_BASE_FILE")"
        topology_history_bytes="$(jq -er '.railway.topology.bytes' "$PUBLICATION_BASE_FILE")"
        validate_rotation_history_file "$provider_history_path" \
          "$BASE_ROTATION_HISTORY_ROOT/manifests/provider/$provider_history_sha.json" \
          "$provider_history_sha" "$expected_group_gid"
        validate_rotation_history_file "$public_history_path" \
          "$BASE_ROTATION_HISTORY_ROOT/manifests/public/$public_history_sha.json" \
          "$public_history_sha" "$expected_group_gid"
        validate_rotation_history_file "$topology_history_path" \
          "$BASE_ROTATION_HISTORY_ROOT/topologies/$topology_history_sha.json" \
          "$topology_history_sha" "$expected_group_gid"
        [[ "$(stat -c '%s' "$provider_history_path")" == "$provider_history_bytes" \
          && "$(stat -c '%s' "$public_history_path")" == "$public_history_bytes" \
          && "$(stat -c '%s' "$topology_history_path")" == "$topology_history_bytes" \
          && "$provider_history_sha" == "$public_history_sha" ]] || {
          log "successor live/topology archive identity differs" >&2
          return 1
        }

        rotation_record_path="$(jq -er '.rotation_record_path' "$PUBLICATION_BASE_FILE")"
        base_sha="$(jq -er '.target.base_sha' "$PUBLICATION_BASE_FILE")"
        base_pin_generation="$(jq -er '.generation' "$PUBLICATION_BASE_FILE")"
        expected_rotation_record_path="$BASE_ROTATION_HISTORY_ROOT/rotations/${base_pin_generation}-${base_sha}-${bridge_receipt_sha}.json"
        [[ "$rotation_record_path" == "$expected_rotation_record_path" ]] || {
          log "successor rotation-record path is not canonical" >&2
          return 1
        }
        [[ -f "$rotation_record_path" && ! -L "$rotation_record_path" \
          && "$(stat -c '%u:%g:%a' "$rotation_record_path")" == "0:${expected_group_gid}:640" ]] || {
          log "successor rotation record is unsafe" >&2
          return 1
        }
        base_pin_sha256="$(sha256_file "$PUBLICATION_BASE_FILE")"
        jq -e \
          --slurpfile pin "$PUBLICATION_BASE_FILE" \
          --arg schema "$BASE_ROTATION_SCHEMA" \
          --arg pin_sha "$base_pin_sha256" \
          --arg predecessor_pin "$predecessor_pin_sha" \
          --arg predecessor_receipt "$bridge_receipt_sha" '
          type == "object" and
          keys == ["generation","next_pin","next_pin_sha256","predecessor_pin_sha256","predecessor_receipt_sha256","recorded_at","schema_version","status","target_base_sha"] and
          .schema_version == $schema and .status == "verified" and
          .generation == $pin[0].generation and
          .recorded_at == $pin[0].recorded_at and
          .target_base_sha == $pin[0].target.base_sha and
          .predecessor_pin_sha256 == $predecessor_pin and
          .predecessor_receipt_sha256 == $predecessor_receipt and
          .next_pin_sha256 == $pin_sha and .next_pin == $pin[0]
          ' "$rotation_record_path" >/dev/null || {
          log "successor rotation record differs from the active pin" >&2
          return 1
        }

        validate_installed_transition_artifact \
          continuity_guard_sha256 "$INSTALLED_CONTINUITY_GUARD" 755
        validate_installed_transition_artifact \
          continuity_guard_service_sha256 "$INSTALLED_CONTINUITY_GUARD_SERVICE" 644
        validate_installed_transition_artifact \
          continuity_guard_timer_sha256 "$INSTALLED_CONTINUITY_GUARD_TIMER" 644
        validate_installed_transition_artifact \
          event_analysis_wrapper_sha256 "$INSTALLED_EVENT_ANALYSIS_WRAPPER" 755
        validate_installed_transition_artifact \
          event_analysis_service_sha256 "$INSTALLED_EVENT_ANALYSIS_SERVICE" 644
        validate_installed_transition_artifact \
          event_analysis_publish_dropin_sha256 "$INSTALLED_EVENT_ANALYSIS_PUBLISH_DROPIN" 644
        validate_installed_transition_artifact \
          publisher_sha256 "$INSTALLED_PUBLISHER" 755
        validate_installed_transition_artifact \
          transition_helper_sha256 "$INSTALLED_TRANSITION_HELPER" 755
        validate_installed_transition_artifact \
          rotation_helper_sha256 "$INSTALLED_ROTATION_HELPER" 755
        validate_installed_transition_artifact \
          reconciler_sha256 "$INSTALLED_RECONCILER" 755
        validate_installed_transition_artifact \
          watchdog_sha256 "$INSTALLED_WATCHDOG" 755
        validate_installed_transition_artifact \
          publisher_service_sha256 "$INSTALLED_PUBLISHER_SERVICE" 644
        validate_installed_transition_artifact \
          watchdog_service_sha256 "$INSTALLED_WATCHDOG_SERVICE" 644
        validate_installed_transition_artifact \
          watchdog_timer_sha256 "$INSTALLED_WATCHDOG_TIMER" 644
        PALIMPSEST_RAILWAY_STATE_ROOT="$STATE_ROOT" \
          PALIMPSEST_RAILWAY_CONTROL_ROOT="$CONTROL_ROOT" \
          PALIMPSEST_RAILWAY_BASE_FILE="$PUBLICATION_BASE_FILE" \
          PALIMPSEST_PUBLICATION_RECEIPT="$SUCCESS_RECEIPT" \
          "$PYTHON_BIN" "$INSTALLED_WATCHDOG" --lineage-only >/dev/null || {
          log "complete successor lineage verification failed" >&2
          return 1
        }
        pin_host_canonical_sha="$(jq -er '.host.canonical_head' "$PUBLICATION_BASE_FILE")"
        pin_host_deployed_sha="$(jq -er '.host.deployed_commit' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_base_sha="$(jq -er '.predecessor.publication_receipt.base_sha' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_pin_sha256="$(jq -er '.predecessor.publication_receipt.publication_base_sha256' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_host_sha="$(jq -er '.predecessor.publication_receipt.host_deployed_sha' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_release_sha="$(jq -er '.predecessor.publication_receipt.release_sha' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_input_sha256="$(jq -er '.predecessor.publication_receipt.input_sha256' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_wire_generated_at="$(jq -er '.predecessor.publication_receipt.wire_generated_at' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_manifest_sha256="$(jq -er '.predecessor.publication_receipt.manifest_sha256' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_tree_sha256="$(jq -er '.predecessor.publication_receipt.tree_sha256' "$PUBLICATION_BASE_FILE")"
        bridge_receipt_deployment_id="$(jq -er '.predecessor.publication_receipt.deployment_id' "$PUBLICATION_BASE_FILE")"
        base_pin_kind="verified_successor"
        ;;
      *)
        log "publication base pin schema is unsupported" >&2
        return 1
        ;;
    esac
    base_pin_path="$PUBLICATION_BASE_FILE"
  else
    log "verified publication transition pin is mandatory before direct publication" >&2
    return 1
  fi

  [[ "$base_sha" =~ ^[0-9a-f]{40}$ ]] || {
    log "invalid publication base commit" >&2
    return 1
  }
  base_pin_sha256="$(sha256_file "$base_pin_path")"
  [[ "$base_pin_sha256" =~ ^[0-9a-f]{64}$ ]] || {
    log "cannot hash publication base pin" >&2
    return 1
  }
}

persist_release_bundle() {
  local release_ref verify_repo verify_base_ref listed_heads expected_tree actual_tree
  local bundle_created_at

  release_ref="refs/palimpsest/releases/$release_sha"
  verify_base_ref="refs/palimpsest/verification-base/$base_sha"
  verify_repo="$work_root/bundle-verifier.git"
  bundle_created_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  mkdir -p "$RELEASE_BUNDLE_ROOT"
  chmod 0700 "$RELEASE_BUNDLE_ROOT"
  fsync_paths_and_directory "$STATE_ROOT"
  release_bundle_path="$RELEASE_BUNDLE_ROOT/$release_sha.bundle"
  release_bundle_metadata_path="$RELEASE_BUNDLE_ROOT/$release_sha.json"
  [[ ! -e "$release_bundle_path" && ! -L "$release_bundle_path" ]] || {
    log "release bundle destination already exists: $release_bundle_path" >&2
    return 1
  }
  [[ ! -e "$release_bundle_metadata_path" && ! -L "$release_bundle_metadata_path" ]] || {
    log "release bundle metadata destination already exists" >&2
    return 1
  }

  git update-ref "$release_ref" "$release_sha"
  bundle_tmp="$(mktemp "$RELEASE_BUNDLE_ROOT/.release-bundle.XXXXXX")"
  git bundle create "$bundle_tmp" "$release_ref" "^$base_sha" >/dev/null
  chmod 0600 "$bundle_tmp"

  listed_heads="$(git bundle list-heads "$bundle_tmp")"
  [[ "$listed_heads" == "$release_sha $release_ref" ]] || {
    log "incremental release bundle exposes an unexpected ref" >&2
    return 1
  }

  git init --quiet --bare "$verify_repo"
  git -C "$verify_repo" fetch --quiet "$checkout" "$base_sha:$verify_base_ref"
  [[ ! -e "$verify_repo/objects/info/alternates" ]] || {
    log "fresh release-bundle verifier unexpectedly uses alternates" >&2
    return 1
  }
  git -C "$verify_repo" bundle verify "$bundle_tmp" >/dev/null
  git -C "$verify_repo" fetch --quiet "$bundle_tmp" "$release_ref:$release_ref"
  [[ "$(git -C "$verify_repo" rev-list --parents -n 1 "$release_ref")" == "$release_sha $base_sha" ]] || {
    log "release bundle is not the exact one-commit successor of its base" >&2
    return 1
  }
  expected_tree="$(git rev-parse "$release_sha^{tree}")"
  actual_tree="$(git -C "$verify_repo" rev-parse "$release_ref^{tree}")"
  [[ "$actual_tree" == "$expected_tree" ]] || {
    log "release bundle verification produced a different tree" >&2
    return 1
  }

  release_bundle_sha256="$(sha256_file "$bundle_tmp")"
  release_bundle_bytes="$(stat -c '%s' "$bundle_tmp")"
  [[ "$release_bundle_sha256" =~ ^[0-9a-f]{64}$ && "$release_bundle_bytes" =~ ^[1-9][0-9]*$ ]] || {
    log "invalid release bundle identity" >&2
    return 1
  }

  # A hard link is an atomic, no-clobber promotion on this state filesystem.
  ln "$bundle_tmp" "$release_bundle_path"
  unlink "$bundle_tmp"
  bundle_tmp=""
  [[ "$(stat -c '%a' "$release_bundle_path")" == 600 ]] || {
    log "persisted release bundle is not mode 0600" >&2
    return 1
  }
  [[ "$(sha256_file "$release_bundle_path")" == "$release_bundle_sha256" ]] || {
    log "persisted release bundle digest changed during promotion" >&2
    return 1
  }

  bundle_metadata_tmp="$(mktemp "$RELEASE_BUNDLE_ROOT/.release-metadata.XXXXXX")"
  jq -n \
    --arg created_at "$bundle_created_at" \
    --arg path "$release_bundle_path" \
    --arg sha256 "$release_bundle_sha256" \
    --argjson bytes "$release_bundle_bytes" \
    --arg base_sha "$base_sha" \
    --arg release_sha "$release_sha" \
    '{schema_version:"palimpsest.incremental-release-bundle.v1",status:"verified",created_at:$created_at,path:$path,sha256:$sha256,bytes:$bytes,base_sha:$base_sha,release_sha:$release_sha}' \
    >"$bundle_metadata_tmp"
  chmod 0600 "$bundle_metadata_tmp"
  ln "$bundle_metadata_tmp" "$release_bundle_metadata_path"
  unlink "$bundle_metadata_tmp"
  bundle_metadata_tmp=""
  release_bundle_metadata_sha256="$(sha256_file "$release_bundle_metadata_path")"

  fsync_paths_and_directory \
    "$release_bundle_path" "$release_bundle_metadata_path" "$RELEASE_BUNDLE_ROOT"
  log "persisted and independently verified release bundle $release_bundle_sha256"
}

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [[ "$newsroom_check_pid" =~ ^[1-9][0-9]*$ ]] \
    && kill -0 "$newsroom_check_pid" 2>/dev/null; then
    kill "$newsroom_check_pid" 2>/dev/null || true
    wait "$newsroom_check_pid" 2>/dev/null || true
  fi
  for build_pid in "$bri_build_pid" "$situation_build_pid"; do
    if [[ "$build_pid" =~ ^[1-9][0-9]*$ ]] \
      && kill -0 "$build_pid" 2>/dev/null; then
      kill "$build_pid" 2>/dev/null || true
      wait "$build_pid" 2>/dev/null || true
    fi
  done
  if (( status != 0 )) \
    && [[ -f "$PENDING_CANDIDATE" && ! -L "$PENDING_CANDIDATE" ]]; then
    log "candidate remains fail-closed in $PENDING_CANDIDATE; run the exact root reconciler before any later publication" >&2
  fi
  if [[ -n "$work_root" && "$work_root" == "$STATE_ROOT"/work.* && -d "$work_root" ]]; then
    chmod -R u+w "$work_root" 2>/dev/null || true
    rm -rf --one-file-system -- "$work_root"
  fi
  if [[ -n "$bundle_tmp" && "$bundle_tmp" == "$RELEASE_BUNDLE_ROOT"/.release-bundle.* ]]; then
    rm -f -- "$bundle_tmp"
  fi
  if [[ -n "$bundle_metadata_tmp" && "$bundle_metadata_tmp" == "$RELEASE_BUNDLE_ROOT"/.release-metadata.* ]]; then
    rm -f -- "$bundle_metadata_tmp"
  fi
  if [[ -n "$candidate_tmp" && "$candidate_tmp" == "$STATE_ROOT"/.pending-candidate.* ]]; then
    rm -f -- "$candidate_tmp"
  fi
  if [[ -n "$preparation_tmp" && "$preparation_tmp" == "$STATE_ROOT"/.pending-preparation.* ]]; then
    rm -f -- "$preparation_tmp"
  fi
  if [[ -n "$release_manifest_tmp" && "$release_manifest_tmp" == "$RELEASE_MANIFEST_ROOT"/.release-manifest.* ]]; then
    rm -f -- "$release_manifest_tmp"
  fi
  if [[ -n "$receipt_tmp" && "$receipt_tmp" == "$STATE_ROOT"/.latest-success.* ]]; then
    rm -f -- "$receipt_tmp"
  fi
  exit "$status"
}

