def _bounded_bytes(
    arguments: Sequence[str],
    *,
    timeout: float,
    label: str,
    maximum: int = MAX_JSON_BYTES * 8,
) -> bytes:
    if timeout <= 0:
        raise CanaryError(f"{label} has no remaining command budget")
    process: subprocess.Popen[bytes] | None = None
    expires_at = time.monotonic() + timeout
    try:
        executable = _trusted_executable(arguments[0])
        process = subprocess.Popen(
            [executable, *arguments[1:]],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=_command_environment(executable),
            start_new_session=True,
        )
        remaining = expires_at - time.monotonic()
        if remaining <= 0:
            raise subprocess.TimeoutExpired(arguments, timeout)
        stdout, _stderr = process.communicate(timeout=remaining)
    except subprocess.TimeoutExpired as error:
        if process is not None:
            _terminate_process_group(process)
        raise CommandError(f"bounded {label}", 124) from error
    except BaseException:
        if process is not None:
            _terminate_process_group(process)
        raise
    if process.returncode is None:
        _terminate_process_group(process)
        raise CommandError(label, 125)
    if _process_group_exists(process.pid):
        _terminate_process_group(process)
        raise CommandError(f"{label} left a surviving child process", 125)
    if process.returncode != 0:
        raise CommandError(label, process.returncode)
    if len(stdout) > maximum:
        raise CanaryError(f"{label} emitted excessive output")
    return stdout


def _bounded_command(
    arguments: Sequence[str],
    *,
    timeout: float,
    label: str,
) -> str:
    stdout = _bounded_bytes(arguments, timeout=timeout, label=label)
    try:
        return stdout.decode("utf-8", "strict")
    except UnicodeError as error:
        raise CanaryError(f"{label} emitted non-UTF-8 output") from error


def _gh(
    deadline: Deadline, *arguments: str, ceiling: int = COMMAND_TIMEOUT_SECONDS
) -> str:
    return _bounded_command(
        ("gh", *arguments),
        timeout=deadline.command_timeout(ceiling),
        label="GitHub command",
    )


def _cleanup_gh(*arguments: str) -> str:
    return _bounded_command(
        ("gh", *arguments),
        timeout=COMMAND_TIMEOUT_SECONDS,
        label="GitHub cleanup command",
    )


def _exact_text(text: str, *, label: str) -> str:
    value = text.rstrip("\r\n")
    if not value or "\n" in value or "\r" in value:
        raise CanaryError(f"{label} is not one exact line")
    return value


def _run_list(
    deadline: Deadline,
    repository: str,
    workflow: str,
    event: str,
    *,
    release: bool,
) -> list[dict[str, Any]]:
    fields = (
        "databaseId,event,headSha,workflowName"
        if release
        else "databaseId,event,headSha"
    )
    raw = _gh(
        deadline,
        "run",
        "list",
        "--repo",
        repository,
        "--workflow",
        workflow,
        "--event",
        event,
        "--limit",
        "100",
        "--json",
        fields,
    )
    value = _strict_json_text(raw, label=f"{workflow} run inventory")
    if not isinstance(value, list):
        raise CanaryError(f"{workflow} run inventory is not a list")
    expected_fields = {"databaseId", "event", "headSha"}
    if release:
        expected_fields.add("workflowName")
    seen: set[int] = set()
    for item in value:
        if not isinstance(item, dict) or set(item) != expected_fields:
            raise CanaryError(f"{workflow} run inventory has an unexpected row")
        run_id = item.get("databaseId")
        if type(run_id) is not int or run_id <= 0 or run_id in seen:
            raise CanaryError(f"{workflow} run inventory has an invalid identity")
        if not isinstance(item.get("event"), str) or not isinstance(
            item.get("headSha"), str
        ):
            raise CanaryError(f"{workflow} run inventory has invalid fields")
        if release and not isinstance(item.get("workflowName"), str):
            raise CanaryError(f"{workflow} run inventory has an invalid workflow name")
        seen.add(run_id)
    return value


def _select_one_new_run(
    *,
    before: list[dict[str, Any]],
    after: list[dict[str, Any]],
    expected_sha: str,
    expected_event: str,
    expected_workflow_name: str | None,
    label: str,
) -> int | None:
    before_ids = {item["databaseId"] for item in before}
    new_rows = [item for item in after if item["databaseId"] not in before_ids]
    if not new_rows:
        return None
    if len(new_rows) != 1:
        raise CanaryError(f"expected exactly one new {label} run")
    candidate = new_rows[0]
    if (
        candidate.get("event") != expected_event
        or candidate.get("headSha") != expected_sha
    ):
        raise CanaryError(f"the new {label} run is not causally bound")
    if (
        expected_workflow_name is not None
        and candidate.get("workflowName") != expected_workflow_name
    ):
        raise CanaryError(f"the new {label} run has the wrong workflow")
    return int(candidate["databaseId"])


def _poll_new_run(
    deadline: Deadline,
    *,
    repository: str,
    workflow: str,
    event: str,
    before: list[dict[str, Any]],
    expected_sha: str,
    expected_workflow_name: str | None,
    label: str,
) -> int:
    while True:
        after = _run_list(
            deadline,
            repository,
            workflow,
            event,
            release=expected_workflow_name is not None,
        )
        selected = _select_one_new_run(
            before=before,
            after=after,
            expected_sha=expected_sha,
            expected_event=event,
            expected_workflow_name=expected_workflow_name,
            label=label,
        )
        if selected is not None:
            return selected
        deadline.sleep()


def _run_view(deadline: Deadline, repository: str, run_id: int) -> dict[str, Any]:
    fields = "databaseId,event,workflowName,headBranch,headSha,status,conclusion"
    value = _strict_json_text(
        _gh(
            deadline,
            "run",
            "view",
            str(run_id),
            "--repo",
            repository,
            "--json",
            fields,
        ),
        label=f"run {run_id} identity",
    )
    expected = {
        "databaseId",
        "event",
        "workflowName",
        "headBranch",
        "headSha",
        "status",
        "conclusion",
    }
    if not isinstance(value, dict) or set(value) != expected:
        raise CanaryError(f"run {run_id} identity is malformed")
    return value


def _validate_run(
    value: dict[str, Any],
    *,
    run_id: int,
    event: str,
    workflow_name: str,
    expected_sha: str,
) -> None:
    if (
        value.get("databaseId") != run_id
        or value.get("event") != event
        or value.get("workflowName") != workflow_name
        or value.get("headBranch") != "main"
        or value.get("headSha") != expected_sha
    ):
        raise CanaryError(f"run {run_id} changed its exact identity")
    if value.get("status") not in {
        "requested",
        "queued",
        "pending",
        "waiting",
        "in_progress",
        "completed",
    }:
        raise CanaryError(f"run {run_id} has an unexpected status")
    conclusion = value.get("conclusion")
    if value["status"] == "completed":
        if not isinstance(conclusion, str) or not conclusion:
            raise CanaryError(f"run {run_id} has an invalid conclusion")
    elif conclusion not in {None, ""}:
        raise CanaryError(f"unfinished run {run_id} has an unexpected conclusion")


def _wait_for_success(
    deadline: Deadline,
    *,
    repository: str,
    run_id: int,
    event: str,
    workflow_name: str,
    expected_sha: str,
) -> dict[str, Any]:
    while True:
        value = _run_view(deadline, repository, run_id)
        _validate_run(
            value,
            run_id=run_id,
            event=event,
            workflow_name=workflow_name,
            expected_sha=expected_sha,
        )
        if value["status"] == "completed":
            if value["conclusion"] != "success":
                raise CanaryError(f"run {run_id} did not conclude successfully")
            return value
        deadline.sleep()


def _run_attempt(deadline: Deadline, repository: str, run_id: int) -> int:
    value = _exact_text(
        _gh(
            deadline,
            "api",
            f"repos/{repository}/actions/runs/{run_id}",
            "--jq",
            ".run_attempt",
        ),
        label=f"run {run_id} attempt",
    )
    if not value.isdecimal() or int(value) <= 0:
        raise CanaryError(f"run {run_id} attempt is invalid")
    return int(value)


