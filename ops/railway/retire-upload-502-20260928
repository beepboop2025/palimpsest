JOURNAL = "e06381214a2c40495a83daa38d2137586a140bc5d525cd480c10a37abb87ae02"
HOLD = "070575e1202df0fc15956a53491b2c9e61b75b44c2e34f2a17e6d4c874af4a4c"
PIN = "17a018bf67a056d35fe04da7c9ca95c26c58b646127b5572ec5cd319f9d9fd65"
UPLOAD = "448710321ecd2687b1912117c80b116171042d09ecc67d7973de5e8659b13a2d"
