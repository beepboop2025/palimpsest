class RotationError(RuntimeError):
    """Raised when a successor-base proof is absent or ambiguous."""


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(
        self,
        req: urllib.request.Request,
        fp: Any,
        code: int,
        msg: str,
        headers: Any,
        newurl: str,
    ) -> None:
        del req, fp, code, msg, headers, newurl
        return None


def _sha256(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def _canonical_bytes(document: dict[str, Any]) -> bytes:
    return (
        json.dumps(
            document,
            allow_nan=False,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        ).encode("utf-8")
        + b"\n"
    )


def _strict_json(raw: bytes, label: str) -> dict[str, Any]:
    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        value: dict[str, Any] = {}
        for key, item in rows:
            if key in value:
                raise RotationError(f"{label} contains a duplicate key")
            value[key] = item
        return value

    try:
        parsed = json.loads(
            raw,
            object_pairs_hook=pairs,
            parse_constant=lambda value: (_ for _ in ()).throw(
                RotationError(f"{label} contains {value}")
            ),
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RotationError(f"{label} is not strict JSON") from exc
    if not isinstance(parsed, dict):
        raise RotationError(f"{label} must be a JSON object")
    return parsed


def _require_keys(document: dict[str, Any], expected: set[str], label: str) -> None:
    if set(document) != expected:
        raise RotationError(f"{label} does not match its closed schema")


def _require_sha(value: Any, *, length: int, label: str) -> str:
    expression = SHA40 if length == 40 else SHA256
    if not isinstance(value, str) or expression.fullmatch(value) is None:
        raise RotationError(f"{label} is invalid")
    return value


def _require_uuid(value: Any, label: str) -> str:
    if not isinstance(value, str) or UUID.fullmatch(value) is None:
        raise RotationError(f"{label} is invalid")
    return value


def _require_timestamp(value: Any, label: str) -> str:
    if not isinstance(value, str) or TIMESTAMP.fullmatch(value) is None:
        raise RotationError(f"{label} is invalid")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise RotationError(f"{label} is invalid") from exc
    if parsed.utcoffset() != UTC.utcoffset(parsed) or parsed > datetime.now(UTC):
        raise RotationError(f"{label} is invalid")
    return value


def _descriptor_identity(metadata: os.stat_result) -> tuple[int, ...]:
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_mode,
        metadata.st_uid,
        metadata.st_gid,
        metadata.st_nlink,
        metadata.st_size,
        metadata.st_mtime_ns,
    )


def _read_regular(
    path: Path,
    *,
    max_bytes: int,
    uid: int | None = None,
    gid: int | None = None,
    mode: int | None = None,
    single_link: bool = True,
) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise RotationError(f"cannot open required file: {path}") from exc
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or (single_link and before.st_nlink != 1)
            or (not single_link and before.st_nlink < 1)
            or (uid is not None and before.st_uid != uid)
            or (gid is not None and before.st_gid != gid)
            or (mode is not None and stat.S_IMODE(before.st_mode) != mode)
            or before.st_size > max_bytes
        ):
            raise RotationError(f"required file metadata is unsafe: {path}")
        chunks: list[bytes] = []
        remaining = max_bytes + 1
        while remaining:
            chunk = os.read(descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        try:
            pathname = os.stat(path, follow_symlinks=False)
        except OSError as exc:
            raise RotationError(f"required file pathname changed: {path}") from exc
        if (
            len(raw) > max_bytes
            or _descriptor_identity(before) != _descriptor_identity(after)
            or before.st_dev != pathname.st_dev
            or before.st_ino != pathname.st_ino
        ):
            raise RotationError(f"required file changed while reading: {path}")
        return raw
    except OSError as exc:
        raise RotationError(f"cannot read required file: {path}") from exc
    finally:
        os.close(descriptor)


def _validate_file(
    path: Path,
    *,
    uid: int,
    gid: int,
    mode: int,
    label: str,
    single_link: bool = True,
) -> None:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise RotationError(f"cannot inspect {label}") from exc
    try:
        metadata = os.fstat(descriptor)
        pathname = os.stat(path, follow_symlinks=False)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) != mode
            or (single_link and metadata.st_nlink != 1)
            or (not single_link and metadata.st_nlink < 1)
            or metadata.st_dev != pathname.st_dev
            or metadata.st_ino != pathname.st_ino
        ):
            raise RotationError(f"{label} ownership or mode is unsafe")
    except OSError as exc:
        raise RotationError(f"cannot inspect {label}") from exc
    finally:
        os.close(descriptor)


def _validate_directory(
    path: Path,
    *,
    uid: int,
    gid: int,
    mode: int,
    label: str,
) -> None:
    try:
        descriptor = os.open(
            path, os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW
        )
    except OSError as exc:
        raise RotationError(f"cannot inspect {label}") from exc
    try:
        metadata = os.fstat(descriptor)
        pathname = os.stat(path, follow_symlinks=False)
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) != mode
            or metadata.st_dev != pathname.st_dev
            or metadata.st_ino != pathname.st_ino
        ):
            raise RotationError(f"{label} ownership or mode is unsafe")
    except OSError as exc:
        raise RotationError(f"cannot inspect {label}") from exc
    finally:
        os.close(descriptor)


def _create_control_file(path: Path, *, uid: int, gid: int, mode: int) -> None:
    directory = os.open(
        path.parent, os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW
    )
    try:
        try:
            descriptor = os.open(
                path.name,
                os.O_WRONLY | os.O_CLOEXEC | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                mode,
                dir_fd=directory,
            )
        except FileExistsError:
            return
        try:
            os.fchmod(descriptor, mode)
            os.fchown(descriptor, uid, gid)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.fsync(directory)
    finally:
        os.close(directory)


def _ensure_control_root(root: Path, *, group_gid: int) -> Path:
    if not root.is_absolute() or root.absolute() != root:
        raise RotationError("rotation control root path is not canonical")
    try:
        resolved_parent = root.parent.resolve(strict=True)
    except OSError as exc:
        raise RotationError("cannot resolve rotation control parent") from exc
    if resolved_parent != root.parent:
        raise RotationError("rotation control parent path is not canonical")
    try:
        parent = root.parent.lstat()
    except OSError as exc:
        raise RotationError("cannot inspect rotation control parent") from exc
    if (
        not stat.S_ISDIR(parent.st_mode)
        or root.parent.is_symlink()
        or parent.st_uid != 0
        or bool(stat.S_IMODE(parent.st_mode) & 0o022)
    ):
        raise RotationError("rotation control parent is not root-owned and stable")
    if not root.exists() and not root.is_symlink():
        try:
            root.mkdir(mode=0o750)
            os.chown(root, 0, group_gid)
            os.chmod(root, 0o750)
            _fsync_directory(root.parent)
        except OSError as exc:
            raise RotationError("cannot create rotation control root") from exc
    try:
        if root.resolve(strict=True) != root:
            raise RotationError("rotation control root path is not canonical")
    except OSError as exc:
        raise RotationError("cannot resolve rotation control root") from exc
    _validate_directory(
        root,
        uid=0,
        gid=group_gid,
        mode=0o750,
        label="rotation control root",
    )
    lock_path = root / "publish.lock"
    _create_control_file(lock_path, uid=0, gid=group_gid, mode=0o640)
    _validate_file(
        lock_path,
        uid=0,
        gid=group_gid,
        mode=0o640,
        label="root publication lock",
    )
    return lock_path


def _acquire_lock(
    path: Path, *, uid: int, gid: int, mode: int, label: str
) -> int:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise RotationError(f"cannot open {label}") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) != mode
            or metadata.st_nlink != 1
        ):
            raise RotationError(f"{label} metadata is unsafe")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RotationError("direct publisher is active") from exc
        pathname = os.stat(path, follow_symlinks=False)
        if metadata.st_dev != pathname.st_dev or metadata.st_ino != pathname.st_ino:
            raise RotationError(f"{label} pathname changed while locking")
        return descriptor
    except (OSError, RotationError):
        os.close(descriptor)
        raise


def _verify_locked_path(path: Path, descriptor: int, *, label: str) -> None:
    try:
        opened = os.fstat(descriptor)
        pathname = os.stat(path, follow_symlinks=False)
    except OSError as exc:
        raise RotationError(f"cannot reverify {label}") from exc
    if (
        opened.st_dev != pathname.st_dev
        or opened.st_ino != pathname.st_ino
        or opened.st_nlink != 1
    ):
        raise RotationError(f"{label} pathname changed after locking")


def _seal_legacy_state_root(
    path: Path, *, publisher_uid: int, publisher_gid: int
) -> None:
    try:
        descriptor = os.open(
            path, os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW
        )
    except OSError as exc:
        raise RotationError("cannot open publication state root") from exc
    try:
        metadata = os.fstat(descriptor)
        allowed = {
            (publisher_uid, publisher_gid, 0o700),
            (publisher_uid, publisher_gid, 0o750),
            (0, publisher_gid, 0o700),
            (0, publisher_gid, 0o750),
        }
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or (metadata.st_uid, metadata.st_gid, stat.S_IMODE(metadata.st_mode))
            not in allowed
        ):
            raise RotationError("publication state root cannot be safely sealed")
        os.fchown(descriptor, 0, publisher_gid)
        os.fchmod(descriptor, 0o750)
        os.fsync(descriptor)
        pathname = os.stat(path, follow_symlinks=False)
        after = os.fstat(descriptor)
        if after.st_dev != pathname.st_dev or after.st_ino != pathname.st_ino:
            raise RotationError("publication state root changed while sealing")
    except OSError as exc:
        raise RotationError("cannot seal publication state root") from exc
    finally:
        os.close(descriptor)


def _restore_legacy_state_root(
    path: Path, *, publisher_uid: int, publisher_gid: int
) -> None:
    descriptor = os.open(
        path, os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW
    )
    try:
        metadata = os.fstat(descriptor)
        if (
            metadata.st_uid != 0
            or metadata.st_gid != publisher_gid
            or stat.S_IMODE(metadata.st_mode) != 0o750
        ):
            raise RotationError("sealed publication state root metadata changed")
        # Keep the crash-intermediate state root-owned.  A retry can safely
        # normalize root:group 0700, whereas publisher:group 0750 would reopen
        # the legacy lock namespace before the durable intent is cleared.
        os.fchmod(descriptor, 0o700)
        os.fsync(descriptor)
        os.fchown(descriptor, publisher_uid, publisher_gid)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _ensure_history_directories(root: Path, *, group_gid: int) -> None:
    directories = (
        root,
        root / "pins",
        root / "receipts",
        root / "manifests",
        root / "manifests" / "provider",
        root / "manifests" / "public",
        root / "topologies",
        root / "rotations",
    )
    for directory in directories:
        if not directory.exists() and not directory.is_symlink():
            try:
                directory.mkdir(mode=0o750)
                os.chown(directory, 0, group_gid)
                os.chmod(directory, 0o750)
                _fsync_directory(directory.parent)
            except OSError as exc:
                raise RotationError(f"cannot create history directory: {directory}") from exc
        _validate_directory(
            directory,
            uid=0,
            gid=group_gid,
            mode=0o750,
            label=f"history directory {directory}",
        )


def _archive_bytes(path: Path, raw: bytes, *, group_gid: int) -> None:
    if path.exists() or path.is_symlink():
        _validate_file(
            path,
            uid=0,
            gid=group_gid,
            mode=0o640,
            label=f"archived evidence {path}",
        )
        if _read_regular(path, max_bytes=max(len(raw), 1)) != raw:
            raise RotationError(f"content-addressed archive conflicts: {path}")
        return
    descriptor, temporary = tempfile.mkstemp(prefix=".archive.", dir=path.parent)
    temporary_path = Path(temporary)
    directory_fd = os.open(
        path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    )
    try:
        os.fchmod(descriptor, 0o640)
        os.fchown(descriptor, 0, group_gid)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(
                temporary_path.name,
                path.name,
                src_dir_fd=directory_fd,
                dst_dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except FileExistsError:
            _validate_file(
                path,
                uid=0,
                gid=group_gid,
                mode=0o640,
                label=f"archived evidence {path}",
            )
            if _read_regular(path, max_bytes=max(len(raw), 1)) != raw:
                raise RotationError(f"content-addressed archive raced: {path}")
        os.fsync(directory_fd)
    finally:
        try:
            os.unlink(temporary_path.name, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        os.close(directory_fd)


def _atomic_replace_pin(
    path: Path,
    raw: bytes,
    *,
    expected_previous: bytes,
    group_gid: int,
) -> None:
    _validate_directory(
        path.parent,
        uid=0,
        gid=0,
        mode=0o755,
        label="publication base-pin directory",
    )
    if _read_regular(path, max_bytes=MAX_PIN_BYTES) != expected_previous:
        raise RotationError("publication base pin changed before replacement")
    descriptor, temporary = tempfile.mkstemp(prefix=".publication-base.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        os.fchmod(descriptor, 0o640)
        os.fchown(descriptor, 0, group_gid)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_path, path)
        _fsync_directory(path.parent)
    finally:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


def _validate_rotation_intent(document: dict[str, Any]) -> None:
    _require_keys(
        document,
        {
            "evidence",
            "installed",
            "predecessor",
            "schema_version",
            "started_at",
            "status",
            "target",
        },
        "rotation intent",
    )
    if (
        document["schema_version"] != ROTATION_INTENT_SCHEMA
        or document["status"] != "prepared"
    ):
        raise RotationError("rotation intent identity is invalid")
    _require_timestamp(document["started_at"], "rotation intent started_at")
    predecessor = document.get("predecessor")
    evidence = document.get("evidence")
    target = document.get("target")
    installed = document.get("installed")
    if (
        not isinstance(predecessor, dict)
        or not isinstance(evidence, dict)
        or not isinstance(target, dict)
    ):
        raise RotationError("rotation intent proof is invalid")
    if not isinstance(installed, dict) or not installed:
        raise RotationError("rotation intent installed proof is invalid")
    if set(installed) != SUCCESSOR_INSTALLED_KEYS:
        raise RotationError("rotation intent installed proof is incomplete")
    _require_keys(
        predecessor,
        {"generation", "pin_sha256", "receipt_sha256", "target_sha"},
        "rotation intent predecessor",
    )
    if (
        type(predecessor["generation"]) is not int
        or predecessor["generation"] < 0
        or predecessor["generation"] >= MAX_PIN_GENERATIONS
    ):
        raise RotationError("rotation intent predecessor generation is invalid")
    _require_sha(
        predecessor["pin_sha256"],
        length=64,
        label="rotation intent predecessor pin",
    )
    _require_sha(
        predecessor["receipt_sha256"],
        length=64,
        label="rotation intent predecessor receipt",
    )
    _require_sha(
        predecessor["target_sha"],
        length=40,
        label="rotation intent predecessor target",
    )
    _require_keys(
        evidence,
        {
            "provider_manifest_sha256",
            "public_manifest_sha256",
            "topology_sha256",
        },
        "rotation intent evidence",
    )
    for key, value in evidence.items():
        _require_sha(value, length=64, label=f"rotation intent evidence {key}")
    _require_keys(target, {"base_sha", "public_main_sha"}, "rotation intent target")
    for key in target:
        _require_sha(target[key], length=40, label=f"rotation intent target {key}")
    if target["base_sha"] != target["public_main_sha"]:
        raise RotationError("rotation intent did not capture an exact public-main tip")
    for key, value in installed.items():
        if not isinstance(key, str) or not key.endswith("_sha256"):
            raise RotationError("rotation intent installed key is invalid")
        _require_sha(value, length=64, label=f"rotation intent installed {key}")


def _read_rotation_intent(path: Path, *, group_gid: int) -> tuple[dict[str, Any], bytes] | None:
    try:
        raw = _read_regular(
            path,
            max_bytes=MAX_PIN_BYTES,
            uid=0,
            gid=group_gid,
            mode=0o640,
        )
    except RotationError as exc:
        try:
            os.stat(path, follow_symlinks=False)
        except FileNotFoundError:
            return None
        except OSError:
            pass
        raise exc
    document = _strict_json(raw, "rotation intent")
    _validate_rotation_intent(document)
    if raw != _canonical_bytes(document):
        raise RotationError("rotation intent is not canonical JSON")
    return document, raw


def _persist_rotation_intent(
    path: Path, document: dict[str, Any], *, group_gid: int
) -> bytes:
    _validate_rotation_intent(document)
    raw = _canonical_bytes(document)
    existing = _read_rotation_intent(path, group_gid=group_gid)
    if existing is not None:
        if existing != (document, raw):
            raise RotationError("a different rotation transaction is already prepared")
        return raw
    descriptor, temporary = tempfile.mkstemp(prefix=".rotation-intent.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        os.fchmod(descriptor, 0o640)
        os.fchown(descriptor, 0, group_gid)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_path, path)
        _fsync_directory(path.parent)
    finally:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass
    persisted = _read_rotation_intent(path, group_gid=group_gid)
    if persisted != (document, raw):
        raise RotationError("persisted rotation intent changed")
    return raw


def _clear_rotation_intent(path: Path, *, expected: bytes, group_gid: int) -> None:
    current = _read_rotation_intent(path, group_gid=group_gid)
    if current is None or current[1] != expected:
        raise RotationError("rotation intent changed before completion")
    try:
        path.unlink()
    except OSError as exc:
        raise RotationError("cannot clear completed rotation intent") from exc
    _fsync_directory(path.parent)


def _run(
    command: list[str],
    *,
    user: pwd.struct_passwd | None = None,
    environment: dict[str, str] | None = None,
    text: bool = True,
) -> subprocess.CompletedProcess[Any]:
    def demote() -> None:
        assert user is not None
        os.setgroups([user.pw_gid])
        os.setgid(user.pw_gid)
        os.setuid(user.pw_uid)

    clean_environment = {
        "PATH": "/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_TERMINAL_PROMPT": "0",
    }
    if user is not None:
        clean_environment.update(
            HOME=user.pw_dir,
            LOGNAME=user.pw_name,
            USER=user.pw_name,
        )
    if environment is not None:
        clean_environment.update(environment)
    try:
        return subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=text,
            timeout=120,
            env=clean_environment,
            preexec_fn=demote if user is not None else None,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        detail = ""
        if isinstance(exc, subprocess.CalledProcessError):
            detail = str(exc.stderr).strip()[:1024]
        raise RotationError(
            f"command failed: {' '.join(command)}" + (f": {detail}" if detail else "")
        ) from exc


def _require_service_inactive(unit: str) -> None:
    load_state = _run(
        [
            "/usr/bin/systemctl",
            "show",
            "--property=LoadState",
            "--value",
            unit,
        ]
    ).stdout.strip()
    active_state = _run(
        [
            "/usr/bin/systemctl",
            "show",
            "--property=ActiveState",
            "--value",
            unit,
        ]
    ).stdout.strip()
    if load_state != "loaded" or active_state not in {"inactive", "failed"}:
        raise RotationError(f"{unit} must be loaded and inactive for base rotation")


def _require_no_rotation_blockers(*, state_root: Path, data_hold: Path) -> None:
    for blocked, label in (
        (state_root / "pending-candidate.json", "pending candidate"),
        (state_root / "pending-preparation.json", "pending preparation"),
        (data_hold, "DATA HOLD"),
    ):
        if blocked.exists() or blocked.is_symlink():
            raise RotationError(f"{label} blocks base rotation")


def _git(
    repository: Path,
    arguments: list[str],
    *,
    user: pwd.struct_passwd,
    text: bool = True,
) -> subprocess.CompletedProcess[Any]:
    return _run(
        ["/usr/bin/git", "-C", str(repository), *arguments],
        user=user,
        text=text,
    )


def _validate_target_blob(
    repository: Path,
    target_sha: str,
    repository_path: str,
    installed_path: Path,
    *,
    owner: pwd.struct_passwd,
    git_mode: str = "100755",
    installed_mode: int = 0o755,
) -> str:
    _validate_file(
        installed_path,
        uid=0,
        gid=0,
        mode=installed_mode,
        label=f"installed {repository_path}",
    )
    row = _git(
        repository,
        ["ls-tree", target_sha, "--", repository_path],
        user=owner,
    ).stdout.strip()
    if not row.startswith(f"{git_mode} blob ") or not row.endswith(
        f"\t{repository_path}"
    ):
        raise RotationError(f"target does not contain {repository_path}")
    expected = _git(
        repository,
        ["show", f"{target_sha}:{repository_path}"],
        user=owner,
        text=False,
    ).stdout
    actual = _read_regular(installed_path, max_bytes=4 * 1024 * 1024)
    if actual != expected:
        raise RotationError(f"installed {repository_path} differs from target Git")
    return _sha256(actual)


