def _validate_source_tail(
    json_items: list[Any], rss_items: list[ET.Element]
) -> tuple[int, str]:
    if len(json_items) != len(rss_items):
        raise ReconciliationError("combined JSON/RSS source-report tails differ")
    json_fields = {
        "_palimpsest",
        "attachments",
        "content_text",
        "date_modified",
        "date_published",
        "external_url",
        "id",
        "summary",
        "tags",
        "title",
        "url",
    }
    metadata_fields = {
        "evidence_strength",
        "independent_groups",
        "kind",
        "verification_status",
        "version_id",
    }
    for index, (json_item, rss_item) in enumerate(zip(json_items, rss_items)):
        label = f"combined source-report item {index}"
        if not isinstance(json_item, dict) or set(json_item) != json_fields:
            raise ReconciliationError(f"{label} JSON shape is invalid")
        metadata = json_item.get("_palimpsest")
        attachments = json_item.get("attachments")
        tags = json_item.get("tags")
        if (
            not isinstance(metadata, dict)
            or set(metadata) != metadata_fields
            or metadata.get("kind") != "publisher_source_record"
            or type(metadata.get("independent_groups")) is not int
            or metadata["independent_groups"] < 1
            or not isinstance(attachments, list)
            or not attachments
            or any(
                not isinstance(row, dict)
                or set(row) != {"mime_type", "title", "url"}
                or row.get("mime_type") != "text/html"
                or not isinstance(row.get("title"), str)
                or ": " not in row["title"]
                or not all(part.strip() for part in row["title"].split(": ", 1))
                or not isinstance(row.get("url"), str)
                or not row["url"].startswith("https://")
                for row in attachments
            )
            or not isinstance(tags, list)
            or len(tags) < 4
            or tags[0] != "source-report"
            or not all(isinstance(value, str) and value for value in tags)
            or len(tags) != len(set(tags))
            or not all(
                isinstance(json_item.get(key), str) and json_item[key]
                for key in (
                    "content_text",
                    "date_modified",
                    "date_published",
                    "external_url",
                    "id",
                    "summary",
                    "title",
                    "url",
                )
            )
        ):
            raise ReconciliationError(f"{label} JSON identity is invalid")
        published_at = _deadline_timestamp(
            json_item["date_published"], f"{label} published clock"
        )
        modified_at = _deadline_timestamp(
            json_item["date_modified"], f"{label} modified clock"
        )
        independent_groups = metadata["independent_groups"]
        if independent_groups > 1:
            title_prefix = "[Corroborated source report] "
            source_label = (
                f"Source report · {independent_groups} independent publisher groups"
            )
            boundary = (
                f"{independent_groups} independent publisher groups reported related "
                "facts. That is corroborated reporting, not proof of truth, intent, "
                "impact or causation."
            )
            verification_tag = "multiple-independent-source-groups"
            verification_status = "multiple_independent_source_groups"
        else:
            title_prefix = "[Source report] "
            source_label = "Single-source report · not independently verified by Palimpsest"
            boundary = (
                "This record indexes one publisher group. Palimpsest has not "
                "independently verified or refuted the publisher's claims."
            )
            verification_tag = "not-independently-verified"
            verification_status = "not_independently_verified"
        publishers = ", ".join(
            dict.fromkeys(row["title"].split(": ", 1)[0] for row in attachments)
        )
        expected_content = "\n\n".join(
            [
                "ITEM TYPE: " + source_label,
                "Published by: " + publishers,
                (
                    "Palimpsest adds: source grouping, timestamps, topic "
                    "classification and a revision record."
                ),
                "Verification status: " + boundary,
                "Read the original: " + json_item["external_url"],
            ]
        )
        if (
            modified_at < published_at
            or re.fullmatch(r"event-[0-9a-f]{24}", json_item["id"]) is None
            or not isinstance(metadata.get("version_id"), str)
            or re.fullmatch(r"eventv-[0-9a-f]{24}", metadata["version_id"])
            is None
            or not isinstance(metadata.get("evidence_strength"), str)
            or not metadata["evidence_strength"]
            or metadata.get("verification_status") != verification_status
            or tags[1] != verification_tag
            or tags[3] != metadata["evidence_strength"]
            or json_item["external_url"] != attachments[0]["url"]
            or json_item["summary"] != boundary
            or json_item["content_text"] != expected_content
            or not json_item["title"].startswith(title_prefix)
            or not json_item["title"][len(title_prefix) :].strip()
            or not json_item["url"].startswith(
                "https://palimpsest.info/news/wire/event-"
            )
        ):
            raise ReconciliationError(f"{label} JSON source contract is invalid")
        title = _only_child(rss_item, "title", label)
        link = _only_child(rss_item, "link", label)
        guid = _only_child(rss_item, "guid", label)
        published = _only_child(rss_item, "pubDate", label)
        description = _only_child(rss_item, "description", label)
        categories = rss_item.findall("category")
        source = _only_child(rss_item, "source", label)
        desk = categories[1].text or "" if len(categories) == 2 else ""
        expected_description = (
            "Item type: "
            + source_label
            + ". Published by: "
            + publishers
            + ". Palimpsest adds source grouping, timestamps, topic "
            "classification and a revision record. Verification status: "
            + boundary
            + " Read original: "
            + json_item["external_url"]
        )
        if (
            len(list(rss_item)) != 8
            or (title.text or "") != json_item["title"]
            or (link.text or "") != json_item["url"]
            or guid.attrib != {"isPermaLink": "false"}
            or (guid.text or "") != json_item["id"]
            or (published.text or "") != _rss_clock(json_item["date_published"])
            or (description.text or "") != expected_description
            or len(categories) != 2
            or (categories[0].text or "") != "source-report"
            or desk not in SOURCE_REPORT_DESKS
            or tags[2] != SOURCE_REPORT_DESKS.get(desk)
            or source.attrib != {"url": json_item["external_url"]}
            or (source.text or "") != attachments[0]["title"].split(": ", 1)[0]
        ):
            raise ReconciliationError(
                f"{label} is not cross-bound between JSON and RSS"
            )
    canonical = _canonical(json_items)
    return len(json_items), _digest(canonical)


def _validate_live_newsroom_feeds(
    provider: dict[str, bytes],
    public: dict[str, bytes],
    *,
    manifest: dict[str, Any],
    newsroom_raw: bytes,
) -> tuple[int, str]:
    if set(provider) != set(NEWSROOM_FEED_PATHS) or set(public) != set(
        NEWSROOM_FEED_PATHS
    ):
        raise ReconciliationError("live newsroom feed proof inventory is invalid")
    bound = {
        path: _manifest_bound_pair(
            provider[path], public[path], manifest=manifest, relative=path
        )
        for path in NEWSROOM_FEED_PATHS
    }
    newsroom = _object(newsroom_raw, "feed-bound structured newsroom")
    stories = newsroom.get("stories")
    sections = newsroom.get("sections")
    if not isinstance(stories, list) or not isinstance(sections, list):
        raise ReconciliationError("feed-bound structured newsroom is invalid")
    section_titles = {section["id"]: section["title"] for section in sections}
    expected_items = [
        _instrument_json_item(story, section_titles[story["section"]])
        for story in stories
    ]
    availability_count = sum(
        story["claims"][0]["type"] == "availability" for story in stories
    )
    measurement_count = len(stories) - availability_count
    instrument_description = (
        f"{measurement_count} Palimpsest measurements and {availability_count} "
        "explicit no-result availability notices, each with a receipt, edition-time "
        "state and limitation attached."
    )
    combined_description = (
        f"{measurement_count} Palimpsest measurements and {availability_count} "
        "availability notices, followed by clearly labeled publisher source records. "
        "Source reports remain attributed and are not independently verified unless "
        "the item states otherwise."
    )

    instrument_json = _json_feed(
        bound["news/instruments/feed.json"], label="instrument JSON Feed"
    )
    combined_json = _json_feed(bound["news/feed.json"], label="combined JSON Feed")
    if (
        instrument_json.get("title") != "Palimpsest instrument records"
        or instrument_json.get("home_page_url")
        != "https://palimpsest.info/news/#instruments"
        or instrument_json.get("feed_url")
        != "https://palimpsest.info/news/instruments/feed.json"
        or instrument_json.get("description") != instrument_description
        or instrument_json["items"] != expected_items
        or combined_json.get("title")
        != "Palimpsest source index + instrument records"
        or combined_json.get("home_page_url") != "https://palimpsest.info/news/"
        or combined_json.get("feed_url") != "https://palimpsest.info/news/feed.json"
        or combined_json.get("description") != combined_description
        or combined_json["items"][:39] != instrument_json["items"]
    ):
        raise ReconciliationError(
            "JSON feeds do not bind the exact newsroom instrument prefix"
        )

    instrument_channel, instrument_rss = _rss_items(
        bound["news/instruments/feed.xml"], label="instrument RSS"
    )
    combined_channel, combined_rss = _rss_items(
        bound["news/feed.xml"], label="combined RSS"
    )
    if (
        len(instrument_rss) != 39
        or len(combined_rss) < 39
    ):
        raise ReconciliationError("newsroom RSS channel identity is invalid")
    newsroom_at = _deadline_timestamp(
        newsroom.get("generated_at"), "feed-bound newsroom generated_at"
    )
    _validate_rss_channel(
        instrument_channel,
        instrument_rss,
        label="instrument RSS",
        title="Palimpsest instrument records",
        link="https://palimpsest.info/news/#instruments",
        description=(
            f"{measurement_count} Palimpsest measurements and {availability_count} "
            "explicit no-result availability notices, each with its receipt, "
            "edition-time state and limitation."
        ),
        self_url="https://palimpsest.info/news/instruments/feed.xml",
        expected_build_at=newsroom_at,
    )
    _validate_rss_channel(
        combined_channel,
        combined_rss,
        label="combined RSS",
        title="Palimpsest source index + instrument records",
        link="https://palimpsest.info/news/",
        description=(
            f"{measurement_count} Palimpsest measurements and {availability_count} "
            "availability notices, followed by clearly labeled publisher source "
            "records. Source reports remain attributed and are not independently "
            "verified unless stated."
        ),
        self_url="https://palimpsest.info/news/feed.xml",
        expected_build_at=newsroom_at,
    )
    for index, (item, story) in enumerate(zip(instrument_rss, stories)):
        _validate_instrument_rss_item(
            item, story, label=f"instrument RSS item {index}"
        )
    for index, (item, story) in enumerate(zip(combined_rss[:39], stories)):
        _validate_instrument_rss_item(
            item, story, label=f"combined RSS instrument item {index}"
        )
    if [_xml_record(item) for item in combined_rss[:39]] != [
        _xml_record(item) for item in instrument_rss
    ]:
        raise ReconciliationError(
            "combined RSS instrument prefix differs from instrument RSS"
        )
    return _validate_source_tail(combined_json["items"][39:], combined_rss[39:])


