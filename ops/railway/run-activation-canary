class CanaryError(RuntimeError):
    """A fail-closed activation-canary error."""


class CommandError(CanaryError):
    """A bounded external command failed."""

    def __init__(self, label: str, returncode: int) -> None:
        super().__init__(f"{label} failed with exit status {returncode}")
        self.returncode = returncode


class PromptExpired(CanaryError):
    """The bounded approval prompt expired."""


class SignalAbort(CanaryError):
    """A terminating signal that still requires authority cleanup."""

    def __init__(self, signum: int) -> None:
        super().__init__(f"activation canary interrupted by signal {signum}")
        self.signum = signum


