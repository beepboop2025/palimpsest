def _validate_handoff(
    value: Any, *, host_sha: str, public_release_sha: str
) -> tuple[str, dict[str, Any]]:
    handoff = _expect_keys(value, HANDOFF_KEYS, label="Phase 2 v2 handoff")
    digests = {
        "artifact_sha256",
        "ledger_sha256",
        "public_ledger_sha256",
        "public_manifest_sha256",
        "public_osint_stub_sha256",
        "public_rights_status_sha256",
        "workflow_receipt_sha256",
    }
    if (
        handoff["schema"] != "palimpsest-public-osint-release-proof.v2"
        or handoff["expected_deploy_sha"] != host_sha
        or handoff["workflow_head_sha"] != host_sha
        or handoff["fetched_main"] != public_release_sha
        or handoff["public_release_commit"] != public_release_sha
        or not _is_sha40(handoff["publication_commit"])
        or not isinstance(handoff["resume_token"], str)
        or TRANSACTION.fullmatch(handoff["resume_token"]) is None
        or not all(_is_sha256(handoff[field]) for field in digests)
        or handoff["public_osint_stub_sha256"] == handoff["artifact_sha256"]
        or not all(
            _positive_int(handoff[field])
            for field in (
                "railway_canary_run_id",
                "workflow_run_attempt",
                "workflow_run_id",
            )
        )
    ):
        raise RestoreError("Phase 2 v2 handoff semantics are invalid")
    return handoff["publication_commit"], handoff


def _validate_sync_receipt(
    value: Any, *, host_sha: str, handoff: dict[str, Any], handoff_sha256: str
) -> None:
    receipt = _expect_keys(value, SYNC_KEYS, label="Phase 3 OSINT sync receipt")
    if (
        receipt["schema"] != "palimpsest-public-osint-sync.v3"
        or receipt["status"] != "installed"
        or receipt["sync_mode"] != "release-pinned"
        or receipt["deployed_commit"] != host_sha
        or receipt["fetched_main"] != handoff["fetched_main"]
        or receipt["publication_commit"] != handoff["publication_commit"]
        or receipt["public_release_commit"] != handoff["public_release_commit"]
        or receipt["artifact_sha256"] != handoff["artifact_sha256"]
        or receipt["ledger_sha256"] != handoff["ledger_sha256"]
        or receipt["public_manifest_sha256"] != handoff["public_manifest_sha256"]
        or receipt["public_osint_stub_sha256"] != handoff["public_osint_stub_sha256"]
        or receipt["public_rights_status_sha256"]
        != handoff["public_rights_status_sha256"]
        or receipt["public_ledger_sha256"] != handoff["public_ledger_sha256"]
        or receipt["release_proof_sha256"] != handoff_sha256
        or not _is_sha40(receipt["input_commit"])
        or not _is_sha256(receipt["artifact_canonical_sha256"])
        or not _is_sha256(receipt["ledger_head"])
        or not _positive_int(receipt["ledger_entries"])
    ):
        raise RestoreError("Phase 3 OSINT sync receipt semantics are invalid")
    _utc(receipt["installed_at"], label="OSINT sync installed_at")
    _utc(receipt["generated_at"], label="OSINT sync generated_at")


def _validate_proof_complete(
    value: Any,
    *,
    host_sha: str,
    transaction: str,
    handoff: dict[str, Any],
    handoff_sha256: str,
    recovery_binding: dict[str, Any] | None,
) -> str:
    base = {
        "backup",
        "celery",
        "compose_before",
        "controller_manifest_sha256",
        "deployment",
        "generated_at",
        "installed_unit_sha256",
        "observers",
        "publication",
        "recovery",
        "release_proof_present",
        "schema_version",
        "status",
        "transaction_id",
        "writers_restored",
    }
    if recovery_binding is not None:
        base.add("interrupted_phase1_resume")
    proof = _expect_keys(value, base, label="Phase 3 proof-complete receipt")
    generated_at = _utc(proof["generated_at"], label="proof-complete generated_at")
    if (
        proof["schema_version"] != "palimpsest-host-release.v1"
        or proof["status"] != "proof-complete"
        or proof["transaction_id"] != transaction
        or handoff["resume_token"] != transaction
        or proof["release_proof_present"] is not True
        or proof["writers_restored"] is not False
        or (
            recovery_binding is not None
            and proof["interrupted_phase1_resume"] != recovery_binding
        )
    ):
        raise RestoreError("Phase 3 proof-complete authority is invalid")
    deployment = _expect_keys(
        proof["deployment"],
        {
            "candidate_image_id",
            "candidate_render_gateway_image_id",
            "controller_sha",
            "controller_tree_sha256",
            "deployed_sha",
            "direction",
            "previous_checkout_sha",
            "previous_deployment_receipt_sha",
        },
        label="proof-complete deployment",
    )
    if (
        deployment["direction"] != "forward"
        or deployment["deployed_sha"] != host_sha
        or not _is_sha40(deployment["previous_checkout_sha"])
        or not _is_sha40(deployment["previous_deployment_receipt_sha"])
        or not _is_sha40(deployment["controller_sha"])
        or not _is_sha256(deployment["controller_tree_sha256"])
        or not isinstance(deployment["candidate_image_id"], str)
        or (
            deployment["candidate_render_gateway_image_id"] is not None
            and not isinstance(deployment["candidate_render_gateway_image_id"], str)
        )
    ):
        raise RestoreError("proof-complete deployment semantics are invalid")
    publication = _expect_keys(
        proof["publication"],
        {
            "bleedthrough_normalized_sha256",
            "handoff",
            "ledger_sha256",
            "osint_sha256",
            "sync_receipt",
        },
        label="proof-complete publication",
    )
    if (
        publication["handoff"] != handoff
        or publication["osint_sha256"] != handoff["artifact_sha256"]
        or publication["ledger_sha256"] != handoff["ledger_sha256"]
        or not _is_sha256(publication["bleedthrough_normalized_sha256"])
    ):
        raise RestoreError("proof-complete publication linkage is invalid")
    _validate_sync_receipt(
        publication["sync_receipt"],
        host_sha=host_sha,
        handoff=handoff,
        handoff_sha256=handoff_sha256,
    )
    backup = _expect_keys(
        proof["backup"],
        {
            "core_snapshot",
            "legacy_witness_status",
            "pre_change_v4_snapshot",
            "verification",
        },
        label="proof-complete backup",
    )
    legacy = _expect_keys(
        backup["legacy_witness_status"],
        {"path", "preserved", "sha256"},
        label="legacy witness status",
    )
    if (
        not isinstance(backup["core_snapshot"], str)
        or not isinstance(backup["pre_change_v4_snapshot"], str)
        or not isinstance(backup["verification"], dict)
        or not isinstance(legacy["preserved"], bool)
        or (
            legacy["preserved"]
            and (
                not isinstance(legacy["path"], str) or not _is_sha256(legacy["sha256"])
            )
        )
        or (
            not legacy["preserved"]
            and (legacy["path"] is not None or legacy["sha256"] is not None)
        )
    ):
        raise RestoreError("proof-complete backup semantics are invalid")
    observers = _expect_keys(
        proof["observers"], {"policy_sha256", "watchdog", "witness"}, label="observers"
    )
    if not _is_sha256(observers["policy_sha256"]):
        raise RestoreError("proof-complete observer policy digest is invalid")
    for name in ("watchdog", "witness"):
        observer = _expect_keys(
            observers[name], {"baseline_token_sha256", "exit_pair", "proof"}, label=name
        )
        if (
            not _is_sha256(observer["baseline_token_sha256"])
            or not isinstance(observer["exit_pair"], str)
            or not isinstance(observer["proof"], dict)
        ):
            raise RestoreError(f"proof-complete {name} evidence is invalid")
    celery = _expect_keys(
        proof["celery"],
        {"candidate_consuming", "candidate_fenced", "pre_change", "v4_backup_fenced"},
        label="proof-complete Celery",
    )
    if any(not isinstance(celery[name], dict) for name in celery):
        raise RestoreError("proof-complete Celery evidence is invalid")
    compose = proof["compose_before"]
    if not isinstance(compose, dict) or set(compose) != COMPOSE_WRITERS:
        raise RestoreError("proof-complete Compose inventory is invalid")
    for service, raw in compose.items():
        item = _expect_keys(
            raw, {"container_id", "image_id", "was_running"}, label=service
        )
        if not isinstance(item["was_running"], bool):
            raise RestoreError("proof-complete Compose state is invalid")
    units = proof["installed_unit_sha256"]
    if (
        not isinstance(units, dict)
        or set(units) != UNIT_PATHS
        or not all(_is_sha256(digest) for digest in units.values())
        or not _is_sha256(proof["controller_manifest_sha256"])
        or not isinstance(proof["recovery"], dict)
    ):
        raise RestoreError("proof-complete installed evidence is invalid")
    return generated_at.isoformat().replace("+00:00", "Z")


def _validate_resume_receipt(
