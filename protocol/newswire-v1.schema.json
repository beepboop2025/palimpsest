        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"foreign-policy-china"},"feed_url":{"const":"https://foreignpolicy.com/tag/china/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"gfw-report"},"feed_url":{"const":"https://gfw.report/index.xml"}}},"minContains":1,"maxContains":1},
