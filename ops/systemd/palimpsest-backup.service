[Unit]
Description=Create and validate a Palimpsest node backup
Documentation=file:///home/deploy/palimpsest/ops/backup/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/home/deploy/palimpsest/ops/backup/palimpsest-backup.sh

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/palimpsest
EnvironmentFile=-/etc/palimpsest/backup.env
ExecStart=/home/deploy/palimpsest/ops/backup/palimpsest-backup.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/var/lib/palimpsest-analysis /var/lib/palimpsest/newswire
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
