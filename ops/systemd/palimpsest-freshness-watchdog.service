[Unit]
Description=Out-of-band Palimpsest node and evidence freshness watchdog
Documentation=file:///opt/palimpsest/ops/watchdog/README.md
After=network-online.target palimpsest-public-osint-sync.service
Wants=network-online.target palimpsest-public-osint-sync.service
ConditionFileIsExecutable=/usr/bin/python3
ConditionPathExists=/opt/palimpsest/ops/watchdog/palimpsest_freshness_watchdog.py

[Service]
Type=oneshot
User=palimpsest
Group=palimpsest
WorkingDirectory=/var/lib/palimpsest-watchdog
Environment=PYTHONDONTWRITEBYTECODE=1
# This file supplies only the optional webhook. Explicit arguments pin every
# release-safety input even if a legacy file still contains old path values.
EnvironmentFile=-/etc/palimpsest/freshness-watchdog.env
ExecStart=/usr/bin/python3 /opt/palimpsest/ops/watchdog/palimpsest_freshness_watchdog.py \
  --status-url http://127.0.0.1:8010/api/v1/node/status \
  --osint-path /var/lib/palimpsest/readings/osint-china-latest.json \
  --output /var/lib/palimpsest-watchdog/status.json \
  --state /var/lib/palimpsest-watchdog/alert-state.json \
  --bundle-max-age-seconds 21600 \
  --required-publication-mode rights-suppressed
TimeoutStartSec=45s
UMask=0077
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TasksMax=32
MemoryMax=192M
StateDirectory=palimpsest-watchdog
StateDirectoryMode=0700

# The evidence tree and deployed code are inputs only. The service can mutate
# only its systemd-owned state directory and can never advance a reading.
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/home/palimpsest/palimpsest
ReadOnlyPaths=-/var/lib/palimpsest/readings
BindReadOnlyPaths=/var/lib/palimpsest-public-osint-sync/authoritative/osint-china-latest.json:/var/lib/palimpsest/readings/osint-china-latest.json
BindReadOnlyPaths=/var/lib/palimpsest-public-osint-sync/authoritative/readings-ledger.jsonl:/var/lib/palimpsest/readings/readings-ledger.jsonl
NoExecPaths=/var/lib/palimpsest-watchdog
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Exit 2 means the watchdog ran correctly and found an incident. It remains a
# failed unit state so systemctl/journald is an alert path independent of any
# optional webhook. The next healthy invocation clears the unit failure state.
SuccessExitStatus=0
