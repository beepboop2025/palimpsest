[Unit]
Description=Build live per-event analysis from the 30-minute evidence wire
Documentation=file:///home/palimpsest/palimpsest/ops/newswire/README.md
After=palimpsest-evidence-wire.service
ConditionFileIsExecutable=/usr/bin/python3
ConditionPathExists=/var/lib/palimpsest/newswire/newswire-latest.json

[Service]
Type=oneshot
User=palimpsest
Group=palimpsest
WorkingDirectory=/home/palimpsest/palimpsest
ExecStart=/usr/bin/python3 -m scripts.event_analysis_live --wire /var/lib/palimpsest/newswire/newswire-latest.json --readings /var/lib/palimpsest/readings --output /var/lib/palimpsest/newswire/event-analysis-latest.json
TimeoutStartSec=20m
UMask=0027
Nice=10
TasksMax=32
MemoryMax=1G

ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/palimpsest/palimpsest /var/lib/palimpsest/readings /var/lib/palimpsest/common-crawl/derived
ReadWritePaths=/var/lib/palimpsest/newswire
NoExecPaths=/var/lib/palimpsest/newswire
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
