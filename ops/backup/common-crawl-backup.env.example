# Root-only environment for palimpsest-common-crawl-backup.service.
PALIMPSEST_CC_BACKUP_BUCKET=replace-with-private-object-lock-bucket
PALIMPSEST_CC_BACKUP_PREFIX=palimpsest/common-crawl
PALIMPSEST_CC_BACKUP_RCLONE_REMOTE=anchor
PALIMPSEST_CC_BACKUP_REQUIRE_OBJECT_LOCK=1
PALIMPSEST_CC_BACKUP_RETENTION_MODE=COMPLIANCE
PALIMPSEST_CC_BACKUP_RETENTION_DAYS=90
PALIMPSEST_CC_BACKUP_WAREHOUSE=/var/lib/palimpsest/common-crawl
PALIMPSEST_CC_BACKUP_WORK_DIR=/var/cache/palimpsest-common-crawl-backup
PALIMPSEST_CC_BACKUP_STATUS_PATH=/var/lib/palimpsest-common-crawl-backup/status.json
PALIMPSEST_CC_BACKUP_REVISION_FILE=/etc/palimpsest/deployed-commit
PALIMPSEST_CC_BACKUP_PASSPHRASE_FILE=/etc/palimpsest/common-crawl-backup.passphrase
PALIMPSEST_CC_BACKUP_MIN_FREE_MB=1024
