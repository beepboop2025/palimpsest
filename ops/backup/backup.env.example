# Optional overrides read by palimpsest-backup.service.
# The defaults match the Hetzner runbook and are repeated here for visibility.
PALIMPSEST_ROOT=/home/deploy/palimpsest
PALIMPSEST_STATE_ROOT=/var/lib/palimpsest
PALIMPSEST_BACKUP_DIR=/home/deploy/backups/palimpsest
PALIMPSEST_BACKUP_RETENTION_DAYS=14
PALIMPSEST_BACKUP_MIN_FREE_MB=1024
PALIMPSEST_COMPOSE_PROJECT=palimpsest

# Optional mounted remote (NFS/SSHFS/rclone mount). The backup script refuses
# to create this directory, preventing a missing mount from being mistaken for
# an off-host copy destination.
# PALIMPSEST_BACKUP_COPY_DIR=/mnt/palimpsest-offsite

# Optional absolute path to an executable uploader. It receives:
#   $1 = completed local backup directory, $2 = UTC snapshot id
# The script is invoked directly; shell snippets are not evaluated.
# PALIMPSEST_BACKUP_HOOK=/home/deploy/bin/upload-palimpsest-backup
