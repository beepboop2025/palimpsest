{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narcoscope.com/data/narcoscope-palimpsest-corridors-v2.schema.json",
  "title": "NarcoScope public China-Pakistan-Myanmar aggregate for Palimpsest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "artifactId",
    "dataAsOf",
    "geographies",
    "disclosure",
    "datasets",
    "exclusions",
    "limitations"
  ],
  "properties": {
    "$schema": { "const": "./narcoscope-palimpsest-corridors-v2.schema.json" },
    "schemaVersion": { "const": "narcoscope.palimpsest.corridor-aggregate.v2" },
    "artifactId": { "const": "narcoscope.china-pakistan-myanmar.official-coverage" },
    "dataAsOf": { "type": ["string", "null"], "format": "date" },
    "geographies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/geography" }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "sourcePolicy",
        "subjectEntityDisclosure",
        "exactAddressDisclosure",
        "preciseCoordinateDisclosure",
        "identifierDisclosure",
        "illustrativeDataIncluded",
        "runtimeCoupling",
        "joinPolicy",
        "politicalOrArmedActorInference"
      ],
      "properties": {
        "level": { "const": "public_country_aggregate" },
        "sourcePolicy": { "const": "official_only" },
        "subjectEntityDisclosure": { "const": "none" },
        "exactAddressDisclosure": { "const": "none" },
        "preciseCoordinateDisclosure": { "const": "none" },
        "identifierDisclosure": { "const": "none" },
        "illustrativeDataIncluded": { "const": false },
        "runtimeCoupling": { "const": "none_static_artifact" },
        "joinPolicy": { "const": "geography_and_time_only" },
        "politicalOrArmedActorInference": { "const": "prohibited" }
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retailDrugPrices",
        "drugSeizures",
        "precursorCorridorIncidents",
        "ofacDesignations",
        "wildlifeConfiscations"
      ],
      "properties": {
        "retailDrugPrices": {
          "allOf": [
            { "$ref": "#/$defs/dataset" },
            { "properties": { "datasetId": { "const": "retail_drug_prices" } } }
          ]
        },
        "drugSeizures": {
          "allOf": [
            { "$ref": "#/$defs/dataset" },
            { "properties": { "datasetId": { "const": "drug_seizures" } } }
          ]
        },
        "precursorCorridorIncidents": {
          "allOf": [
            { "$ref": "#/$defs/dataset" },
            {
              "properties": {
                "datasetId": { "const": "precursor_corridor_incidents" },
                "data": { "$ref": "#/$defs/precursorData" }
              }
            }
          ]
        },
        "ofacDesignations": {
          "allOf": [
            { "$ref": "#/$defs/dataset" },
            { "properties": { "datasetId": { "const": "ofac_designations" } } }
          ]
        },
        "wildlifeConfiscations": {
          "allOf": [
            { "$ref": "#/$defs/dataset" },
            { "properties": { "datasetId": { "const": "wildlife_confiscations" } } }
          ]
        }
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "limitations": { "$ref": "#/$defs/limitations" }
  },
  "$defs": {
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "iso2", "iso3"],
      "properties": {
        "country": { "enum": ["China", "Myanmar", "Pakistan"] },
        "iso2": { "enum": ["CN", "MM", "PK"] },
        "iso3": { "enum": ["CHN", "MMR", "PAK"] }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "topic",
        "sourceStatus",
        "measurement",
        "temporalCoverage",
        "provenance",
        "data",
        "limitations"
      ],
      "properties": {
        "datasetId": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "sourceStatus": { "const": "official" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "temporalCoverage": { "$ref": "#/$defs/temporalCoverage" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "data": { "type": "object" },
        "limitations": { "$ref": "#/$defs/limitations" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "valueType", "method", "unit", "grain"],
      "properties": {
        "status": { "enum": ["official_reported", "official_action_record"] },
        "valueType": {
          "enum": ["statistical_measurement", "administrative_measurement", "administrative_action"]
        },
        "method": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "grain": { "type": "string", "minLength": 1 }
      }
    },
    "temporalCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fromYear", "toYear", "snapshotDate"],
      "properties": {
        "kind": { "enum": ["year_range", "snapshot"] },
        "fromYear": { "type": ["integer", "null"] },
        "toYear": { "type": ["integer", "null"] },
        "snapshotDate": { "type": ["string", "null"], "format": "date" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "title", "url", "sourceEdition", "localDataDate", "input"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "sourceEdition": { "type": "string", "minLength": 1 },
        "localDataDate": { "type": ["string", "null"], "format": "date" },
        "documentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "precursorData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includedQuantitativeRecordCount",
        "includedContextRecordCount",
        "crossTargetBilateralRecordCount",
        "quantityAggregation",
        "corridors",
        "contextRecords"
      ],
      "properties": {
        "includedQuantitativeRecordCount": { "type": "integer", "minimum": 0 },
        "includedContextRecordCount": { "type": "integer", "minimum": 0 },
        "crossTargetBilateralRecordCount": { "const": 0 },
        "quantityAggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summedQuantityKg", "reason"],
          "properties": {
            "status": { "const": "not_computed_mixed_claim_semantics" },
            "summedQuantityKg": { "const": null },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "corridors": { "type": "array", "items": { "$ref": "#/$defs/precursorRecord" } },
        "contextRecords": { "type": "array", "items": { "type": "object" } }
      }
    },
    "precursorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geographyMatches",
        "reportedOrigin",
        "transit",
        "destination",
        "seizureLocation",
        "year",
        "precursor",
        "quantityKg",
        "quantityRelation",
        "quantityBasis",
        "recordKind",
        "aggregationEligibility",
        "aggregationGroup",
        "incidentCount",
        "sourceLocator"
      ],
      "properties": {
        "geographyMatches": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["CHN", "MMR", "PAK"] },
          "uniqueItems": true
        },
        "reportedOrigin": { "type": "string", "minLength": 1 },
        "transit": { "type": ["string", "null"] },
        "destination": { "type": "string", "minLength": 1 },
        "seizureLocation": { "type": ["string", "null"] },
        "year": { "type": "integer" },
        "precursor": { "type": "string", "minLength": 1 },
        "quantityKg": { "type": "number", "minimum": 0 },
        "quantityRelation": { "enum": ["exact", "approx", "less_than", "greater_than"] },
        "quantityBasis": { "type": "string", "minLength": 1 },
        "recordKind": {
          "enum": ["single_incident", "multi_incident_aggregate", "annual_aggregate", "derived_subtotal"]
        },
        "aggregationEligibility": {
          "enum": ["eligible", "ineligible_non_exact", "ineligible_derived", "ineligible_incompatible_basis"]
        },
        "aggregationGroup": { "type": ["string", "null"] },
        "incidentCount": { "type": ["integer", "null"], "minimum": 1 },
        "sourceLocator": { "$ref": "#/$defs/sourceLocator" }
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdfPage", "printedPage", "paragraph"],
      "properties": {
        "pdfPage": { "type": "integer", "minimum": 1 },
        "printedPage": { "type": "integer", "minimum": 1 },
        "paragraph": { "type": "integer", "minimum": 1 }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "classification", "reason"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": [
            "illustrative_or_constructed",
            "licensed_conflict_data",
            "out_of_scope",
            "privacy_minimized",
            "safety_minimized"
          ]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
