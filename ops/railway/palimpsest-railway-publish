bounded_deadline_timeout() {
  local ceiling="$1" reserve="${2:-0}" now remaining usable
  [[ "$mutation_proof_deadline_epoch" =~ ^[1-9][0-9]*$ \
    && "$ceiling" =~ ^[1-9][0-9]*$ \
    && "$reserve" =~ ^[0-9]+$ ]] || {
    log "mutation proof deadline is not initialized" >&2
    return 1
  }
  now="$(date +%s)"
  remaining=$((mutation_proof_deadline_epoch - now))
  usable=$((remaining - reserve))
  (( usable > 0 )) || {
    log "mutation-to-receipt freshness deadline expired; exact candidate reconciliation is required" >&2
    return 1
  }
  if (( usable < ceiling )); then
    printf '%s\n' "$usable"
  else
    printf '%s\n' "$ceiling"
  fi
}

bounded_deadline_sleep() {
  local ceiling="$1" reserve="${2:-0}" remaining
  remaining="$(bounded_deadline_timeout "$ceiling" "$reserve")" || return 1
  sleep "$remaining"
}

run_with_deadline() {
  local ceiling="$1" reserve="$2" timeout_seconds
  shift 2
  timeout_seconds="$(bounded_deadline_timeout "$ceiling" "$reserve")" \
    || return 1
  "$TIMEOUT_BIN" --signal=TERM --kill-after=5s "${timeout_seconds}s" "$@"
}

curl_with_deadline() {
  local ceiling="$1" reserve="$2" timeout_seconds
  shift 2
  timeout_seconds="$(bounded_deadline_timeout "$ceiling" "$reserve")" \
    || return 1
  curl --max-time "$timeout_seconds" "$@"
}

sha256_file() {
  sha256sum "$1" | awk '{print $1}'
}

validate_owned_regular_path() {
  local path="$1" label="$2" allowed_modes="$3" metadata uid gid mode links
  [[ -f "$path" && ! -L "$path" ]] || {
    log "$label is not a regular non-symbolic-link file: $path" >&2
    return 1
  }
  metadata="$(stat -c '%u:%g:%a:%h' "$path")"
  IFS=: read -r uid gid mode links <<<"$metadata"
  [[ "$uid" == "$(id -u)" && "$gid" == "$(id -g)" && "$links" == 1 \
    && " $allowed_modes " == *" $mode "* ]] || {
    log "$label has unsafe ownership, mode, or link count: $path" >&2
    return 1
  }
}

validate_shared_lock_descriptor() {
  local path="$1" descriptor="$2" label="$3" path_identity descriptor_identity
  path_identity="$(stat -c '%d:%i' "$path")"
  descriptor_identity="$(stat -Lc '%d:%i' "/proc/$$/fd/$descriptor")"
  [[ "$descriptor_identity" == "$path_identity" ]] || {
    log "$label descriptor differs from its authenticated path" >&2
    return 1
  }
}

stage_snapshot_file() {
  local source="$1" destination="$2" label="$3"
  local source_before source_after snapshot_sha
  [[ -f "$source" && ! -L "$source" \
    && ! -e "$destination" && ! -L "$destination" ]] || {
    log "$label cannot be staged from a regular unique source" >&2
    return 1
  }
  mkdir -p "${destination%/*}"
  source_before="$(sha256_file "$source")"
  cp --reflink=never --no-dereference --preserve=timestamps -- \
    "$source" "$destination"
  chmod 0400 "$destination"
  source_after="$(sha256_file "$source")"
  snapshot_sha="$(sha256_file "$destination")"
  [[ -f "$source" && ! -L "$source" \
    && -f "$destination" && ! -L "$destination" \
    && "$(stat -c '%u:%g:%a:%h' "$destination")" \
      == "$(id -u):$(id -g):400:1" \
    && "$source_before" == "$source_after" \
    && "$source_after" == "$snapshot_sha" ]] || {
    log "$label changed while its immutable snapshot was staged" >&2
    return 1
  }
}

validate_newswire_snapshot_receipt() {
  local status_path="$1" wire_path="$2" observed_at="$3"
  "$PYTHON_BIN" -I -S - "$status_path" "$wire_path" "$observed_at" <<'PY'
import hashlib
import json
import re
import sys
from datetime import UTC, datetime, timedelta
from pathlib import Path

EXPECTED_STATUS_KEYS = {
    "attempted_at",
    "completed_at",
    "failure_class",
    "fresh_sources",
    "output_generated_at",
    "output_sha256",
    "schema_version",
    "status",
}
CLOCK = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")


def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("newswire snapshot contains a duplicate JSON key")
        value[key] = item
    return value


def parse_document(path):
    try:
        return json.loads(
            path.read_bytes().decode("utf-8", "strict"),
            object_pairs_hook=strict_object,
            parse_constant=lambda value: (_ for _ in ()).throw(
                ValueError(f"non-finite JSON value: {value}")
            ),
        )
    except (UnicodeError, ValueError, json.JSONDecodeError) as exc:
        raise SystemExit(f"newswire snapshot is not strict JSON: {path.name}") from exc


def clock(value, label):
    if not isinstance(value, str) or CLOCK.fullmatch(value) is None:
        raise SystemExit(f"{label} is not a strict UTC clock")
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
    except ValueError as exc:
        raise SystemExit(f"{label} is not a valid UTC clock") from exc


status_path, wire_path = map(Path, sys.argv[1:3])
observed_at = clock(sys.argv[3], "snapshot observed_at")
status = parse_document(status_path)
wire_raw = wire_path.read_bytes()
wire = parse_document(wire_path)
if not isinstance(status, dict) or set(status) != EXPECTED_STATUS_KEYS:
    raise SystemExit("newswire status receipt does not have its exact schema")
if (
    status.get("schema_version") != "palimpsest-evidence-wire-attempt.v1"
    or status.get("status") != "success"
    or status.get("failure_class") is not None
    or type(status.get("fresh_sources")) is not int
    or status["fresh_sources"] < 1
):
    raise SystemExit("newswire status receipt is not a successful fresh-source run")
if not isinstance(wire, dict):
    raise SystemExit("newswire latest snapshot is not an object")
attempted = clock(status.get("attempted_at"), "newswire attempted_at")
completed = clock(status.get("completed_at"), "newswire completed_at")
output_at = clock(status.get("output_generated_at"), "newswire output_generated_at")
wire_at = clock(wire.get("generated_at"), "newswire generated_at")
if not attempted <= output_at <= completed <= observed_at + timedelta(seconds=120):
    raise SystemExit("newswire status receipt clocks are not causally ordered")
if output_at != wire_at or status["output_generated_at"] != wire["generated_at"]:
    raise SystemExit("newswire status receipt clock does not bind the frozen latest output")
output_sha256 = status.get("output_sha256")
if (
    not isinstance(output_sha256, str)
    or re.fullmatch(r"[0-9a-f]{64}", output_sha256) is None
    or output_sha256 != hashlib.sha256(wire_raw).hexdigest()
):
    raise SystemExit("newswire status receipt digest does not bind the frozen latest output")
print(
    status["output_generated_at"],
    status["completed_at"],
    status["fresh_sources"],
    sep="\t",
)
PY
}

require_pre_mutation_freshness_reserve() {
  local wire_clock="$1" result remaining deadline
  result="$("$PYTHON_BIN" -I -S - "$wire_clock" \
    "$WIRE_FRESHNESS_BUDGET_SECONDS" "$MAX_MUTATION_TO_RECEIPT_SECONDS" \
    "$DESIRED_LIVE_MARGIN_SECONDS" <<'PY'
import sys
from datetime import UTC, datetime, timedelta

wire = datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
budget, mutation, margin = map(int, sys.argv[2:5])
if min(budget, mutation, margin) < 1 or mutation + margin >= budget:
    raise SystemExit("publication freshness reserve constants are invalid")
now = datetime.now(UTC)
if wire > now + timedelta(seconds=120):
    raise SystemExit("captured newswire clock is implausibly future-dated")
remaining = int((wire + timedelta(seconds=budget) - now).total_seconds())
required = mutation + margin
if remaining < required:
    raise SystemExit(
        "captured newswire lacks the declared mutation-to-receipt bound plus "
        "the desired live margin"
    )
proof_deadline = min(
    now + timedelta(seconds=mutation),
    wire + timedelta(seconds=budget - margin),
)
print(remaining, int(proof_deadline.timestamp()), sep="\t")
PY
)"
  IFS=$'\t' read -r remaining deadline <<<"$result"
  [[ "$remaining" =~ ^[0-9]+$ && "$deadline" =~ ^[1-9][0-9]*$ ]] || {
    log "pre-mutation freshness reserve did not return a bounded deadline" >&2
    return 1
  }
  mutation_proof_deadline_epoch="$deadline"
  log "pre-mutation freshness reserve accepted: ${remaining}s remain; receipt proof deadline=$deadline"
}

validate_live_freshness_proofs() {
  local provider_path="$1" public_path="$2" manifest_path="$3"
  local expected_release="$4" expected_tree="$5" expected_wire="$6"
  "$PYTHON_BIN" -I -S - "$provider_path" "$public_path" "$manifest_path" \
    "$expected_release" "$expected_tree" "$expected_wire" <<'PY'
import json
import re
import sys
from datetime import UTC, datetime, timedelta
from pathlib import Path

CLOCK = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")
TOP_KEYS = {
    "checked_at",
    "clocks",
    "rights",
    "schema_version",
    "service",
    "source_commit",
    "status",
    "tree_sha256",
}
CLOCK_KEYS = {"age_seconds", "freshness_budget_seconds", "generated_at", "status"}


def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("live freshness proof contains a duplicate JSON key")
        value[key] = item
    return value


def document(path):
    try:
        value = json.loads(
            path.read_bytes().decode("utf-8", "strict"),
            object_pairs_hook=strict_object,
            parse_constant=lambda item: (_ for _ in ()).throw(
                ValueError(f"non-finite JSON value: {item}")
            ),
        )
    except (UnicodeError, ValueError, json.JSONDecodeError) as exc:
        raise SystemExit(f"live proof is not strict JSON: {path.name}") from exc
    if not isinstance(value, dict):
        raise SystemExit(f"live proof is not an object: {path.name}")
    return value


def clock(value, label):
    if not isinstance(value, str) or CLOCK.fullmatch(value) is None:
        raise SystemExit(f"{label} is not a strict UTC clock")
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
    except ValueError as exc:
        raise SystemExit(f"{label} is not a valid UTC clock") from exc


provider_path, public_path, manifest_path = map(Path, sys.argv[1:4])
expected_release, expected_tree, expected_wire = sys.argv[4:7]
manifest = document(manifest_path)
expected_publication = manifest.get("built_at")
clock(expected_publication, "release built_at")
proofs = {
    "provider": document(provider_path),
    "public": document(public_path),
}
checked = []
now = datetime.now(UTC)
for label, proof in proofs.items():
    if set(proof) != TOP_KEYS:
        raise SystemExit(f"{label} freshness proof does not have its exact schema")
    if (
        proof.get("schema_version") != "palimpsest.publication-freshness.v1"
        or proof.get("status") != "fresh"
        or proof.get("service") != "palimpsest-publication"
        or proof.get("source_commit") != expected_release
        or proof.get("tree_sha256") != expected_tree
        or proof.get("rights")
        != {"mode": "rights-suppressed", "publication_allowed": False}
    ):
        raise SystemExit(f"{label} freshness proof has the wrong release identity")
    clocks = proof.get("clocks")
    if not isinstance(clocks, dict) or set(clocks) != {"publication", "wire"}:
        raise SystemExit(f"{label} freshness clock inventory is invalid")
    checked_at = clock(proof.get("checked_at"), f"{label} checked_at")
    if checked_at > now + timedelta(seconds=120):
        raise SystemExit(f"{label} freshness proof is implausibly future-dated")
    if checked_at < now - timedelta(seconds=120):
        raise SystemExit(f"{label} freshness proof is a cached or delayed response")
    checked.append(checked_at)
    for name, generated, budget in (
        ("wire", expected_wire, 1800),
        ("publication", expected_publication, 3600),
    ):
        row = clocks.get(name)
        if not isinstance(row, dict) or set(row) != CLOCK_KEYS:
            raise SystemExit(f"{label} {name} freshness clock is not exact")
        generated_at = clock(row.get("generated_at"), f"{label} {name} generated_at")
        age = row.get("age_seconds")
        expected_age = max(0, int((checked_at - generated_at).total_seconds()))
        if (
            row.get("generated_at") != generated
            or type(age) is not int
            or age != expected_age
            or age > budget
            or row.get("freshness_budget_seconds") != budget
            or row.get("status") != "fresh"
        ):
            raise SystemExit(f"{label} {name} freshness proof is not live and bound")
if abs((checked[0] - checked[1]).total_seconds()) > 120:
    raise SystemExit("provider and public freshness proofs are not contemporaneous")
PY
}

validate_release_freshness_attestation() {
  local wire_path="$1" attestation_path="$2" expected_release="$3"
  local expected_wire="$4"
  "$PYTHON_BIN" -I -S - "$wire_path" "$attestation_path" \
    "$expected_release" "$expected_wire" <<'PY'
import hashlib
import json
import re
import sys
from datetime import UTC, datetime
from pathlib import Path

CLOCK = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
TOP_KEYS = {
    "artifacts",
    "attested_at",
    "limitations",
    "mode",
    "publication_allowed",
    "publication_sha",
    "rights_status",
    "schema_version",
}


def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("publication freshness attestation contains a duplicate key")
        value[key] = item
    return value


def document(path):
    try:
        raw = path.read_bytes()
        value = json.loads(
            raw.decode("utf-8", "strict"),
            object_pairs_hook=strict_object,
            parse_constant=lambda item: (_ for _ in ()).throw(
                ValueError(f"non-finite JSON value: {item}")
            ),
        )
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as exc:
        raise SystemExit(f"publication freshness input is not strict JSON: {path.name}") from exc
    if not isinstance(value, dict):
        raise SystemExit(f"publication freshness input is not an object: {path.name}")
    return raw, value


def clock(value, label):
    if not isinstance(value, str) or CLOCK.fullmatch(value) is None:
