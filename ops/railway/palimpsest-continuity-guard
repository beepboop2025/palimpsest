        )


def maintenance_end(
    *,
    transaction_id: str,
    controller_commit: str,
    expected_fragments: dict[str, str],
    expected_drop_ins: dict[str, tuple[Path, str] | None],
    finalized_receipt: Path,
    finalized_sha256: str,
) -> str:
    if SHA256.fullmatch(finalized_sha256) is None:
        raise GuardError("finalized receipt digest is invalid")
    with _maintenance_lock():
        return _maintenance_end_unlocked(
            transaction_id=transaction_id,
            controller_commit=controller_commit,
            expected_fragments=expected_fragments,
            expected_drop_ins=expected_drop_ins,
            finalized_receipt=finalized_receipt,
            finalized_sha256=finalized_sha256,
        )


def maintenance_reconcile_finalized(
    *,
    transaction_id: str,
    controller_commit: str,
    expected_fragments: dict[str, str],
    expected_drop_ins: dict[str, tuple[Path, str] | None],
) -> tuple[Path, str]:
    with _maintenance_lock():
        if TRANSACTION_ID.fullmatch(transaction_id) is None:
            raise GuardError("maintenance transaction id is invalid")
        if SHA40.fullmatch(controller_commit) is None:
            raise GuardError("maintenance controller commit is invalid")
        _maintenance_assert_unlocked(
            transaction_id=transaction_id,
            controller_commit=controller_commit,
        )
        candidates = _matching_finalized_receipts(
            transaction_id=transaction_id, controller_commit=controller_commit
        )
        if len(candidates) != 1:
            raise GuardError("finalized receipt authority is absent or ambiguous")
        digest = _maintenance_end_unlocked(
            transaction_id=transaction_id,
            controller_commit=controller_commit,
            expected_fragments=expected_fragments,
            expected_drop_ins=expected_drop_ins,
            finalized_receipt=candidates[0],
            finalized_sha256=None,
        )
        return candidates[0], digest


def _expected_fragment_arguments(values: list[str]) -> dict[str, str]:
    profile: dict[str, str] = {}
    for value in values:
        unit, separator, digest = value.partition("=")
        if not separator or unit in profile:
            raise GuardError("reviewed timer fragment argument is invalid")
        profile[unit] = digest
    if set(profile) != set(TIMERS):
        raise GuardError("reviewed timer fragment argument inventory is invalid")
    return profile


def _expected_drop_in_arguments(
    values: list[str],
) -> dict[str, tuple[Path, str] | None]:
    profile: dict[str, tuple[Path, str] | None] = {}
    for value in values:
        unit, separator, authority = value.partition("=")
        if not separator or unit in profile:
            raise GuardError("reviewed timer drop-in argument is invalid")
        if authority == "absent":
            profile[unit] = None
            continue
        raw_path, digest_separator, digest = authority.rpartition("=")
        path = Path(raw_path)
        if (
            not digest_separator
            or not path.is_absolute()
            or SHA256.fullmatch(digest) is None
        ):
            raise GuardError("reviewed timer drop-in argument is invalid")
        profile[unit] = (path, digest)
    if set(profile) != set(TIMERS):
        raise GuardError("reviewed timer drop-in argument inventory is invalid")
    return profile


def _safety_marker_present(path: Path) -> bool:
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        return False
    except OSError as exc:
        raise GuardError(f"cannot inspect safety marker: {path}") from exc
    if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
        raise GuardError(f"safety marker is not a regular file: {path}")
    return True


def _lock_is_held(path: Path) -> bool:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except FileNotFoundError:
        return False
    except OSError as exc:
        raise GuardError(f"cannot inspect publication lock: {path}") from exc
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        return False
    finally:
        os.close(descriptor)


def _blockers(now: datetime) -> list[str]:
    blockers = [str(path) for path in SAFETY_MARKERS if _safety_marker_present(path)]
    for path in PUBLICATION_LOCKS:
        if _lock_is_held(path):
            blockers.append(f"held-lock:{path}")
    proof_units = _systemctl(
        "list-units",
        "--type=service",
        "--state=activating,active",
        "--plain",
        "--no-legend",
        "palimpsest-release-proof-*.service",
    )
    if proof_units.returncode != 0:
        raise GuardError("cannot inspect active release-proof services")
    if proof_units.stdout.strip():
        blockers.append("active-release-proof-service")
    try:
        hold = _read_maintenance_hold(now=now, require_effective=True)
    except FileNotFoundError:
        return blockers
    blockers.append(f"maintenance-hold:{hold['status']}")
    return blockers


def _write_status(document: dict[str, Any]) -> None:
    STATUS_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(
        prefix=".status.", dir=STATUS_PATH.parent
    )
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(_canonical(document))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, STATUS_PATH)
        directory = os.open(STATUS_PATH.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def _run_guard() -> int:
    now = datetime.now(UTC)
    exit_code = 0
    repairs: list[str] = []
    problems: list[str] = []
    blockers: list[str] = []
    states: list[TimerState] = []
    try:
        with _maintenance_lock():
            states = _timer_states()
            blockers = _blockers(now)
            for unit in repair_candidates(states, blockers=blockers):
                if _systemctl("reset-failed", unit).returncode not in {0, 1}:
                    problems.append(f"cannot reset failed state for {unit}")
                    continue
                start = _systemctl("start", unit)
                if (
                    start.returncode != 0
                    or _property(unit, "ActiveState") != "active"
                ):
                    problems.append(f"cannot restore {unit}")
                else:
                    repairs.append(unit)
            if repairs:
                states = _timer_states()
            unsafe_states = [
                item.unit
                for item in states
                if item.load_state != "loaded"
                or item.unit_file_state
                not in {"enabled", "enabled-runtime", "disabled"}
                or item.active_state not in {"active", "inactive", "failed"}
            ]
            problems.extend(
                f"ambiguous timer state: {unit}" for unit in unsafe_states
            )
            if not blockers:
                problems.extend(
                    f"steady-state timer is disabled: {item.unit}"
                    for item in states
                    if item.unit_file_state == "disabled"
                )
    except GuardError as exc:
        problems.append(str(exc))
    if problems:
        status = "degraded"
        exit_code = 1
    elif blockers:
        status = "abstained"
    elif repairs:
        status = "repaired"
    else:
        status = "healthy"
    document = {
        "schema_version": SCHEMA_VERSION,
        "status": status,
        "checked_at": _clock(now),
        "timers": [asdict(item) for item in states],
        "repairs": repairs,
        "blockers": blockers,
        "problems": problems,
    }
    try:
        _write_status(document)
    except OSError as exc:
        print(f"palimpsest-continuity-guard cannot write status: {exc}")
        return 1
    print(
        "palimpsest-continuity-guard "
        f"status={status} repairs={len(repairs)} blockers={len(blockers)} "
        f"problems={len(problems)}"
    )
    return exit_code


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Guard Palimpsest publication continuity and release maintenance"
    )
    subcommands = parser.add_subparsers(dest="command")
    subcommands.add_parser("capabilities", help="print the exact CLI contract")
    subcommands.add_parser("check", help="check and repair steady-state timers")
    subcommands.add_parser(
        "maintenance-inspect", help="validate and print the current maintenance hold"
    )
    for name in ("maintenance-begin", "maintenance-fail-closed"):
        command = subcommands.add_parser(name)
        command.add_argument("--transaction-id", required=True)
        command.add_argument("--controller-commit", required=True)
        command.add_argument("--reason-code", required=True)
    for name in (
        "maintenance-assert",
        "maintenance-end",
        "maintenance-reconcile-finalized",
    ):
        command = subcommands.add_parser(name)
        command.add_argument("--transaction-id", required=True)
        command.add_argument("--controller-commit", required=True)
        if name in {"maintenance-end", "maintenance-reconcile-finalized"}:
            command.add_argument(
                "--expected-fragment", action="append", required=True
            )
            command.add_argument(
                "--expected-drop-in", action="append", required=True
            )
        if name == "maintenance-end":
            command.add_argument("--finalized-receipt", required=True)
            command.add_argument("--finalized-sha256", required=True)
    return parser


def main(argv: list[str] | None = None) -> int:
    arguments = _parser().parse_args([] if argv is None else argv)
    if arguments.command in {None, "check"}:
        return _run_guard()
    if arguments.command == "capabilities":
        document = {
            "schema_version": CAPABILITIES_SCHEMA,
            "hold_schema": HOLD_SCHEMA,
            "commands": list(CAPABILITY_COMMANDS),
        }
        print(_canonical(document).decode("utf-8"), end="")
        return 0
    if os.geteuid() != 0:
        print("palimpsest-continuity-guard maintenance commands require root", file=sys.stderr)
        return 1
    try:
        if arguments.command == "maintenance-begin":
            document = maintenance_begin(
                transaction_id=arguments.transaction_id,
                controller_commit=arguments.controller_commit,
                reason_code=arguments.reason_code,
            )
        elif arguments.command == "maintenance-fail-closed":
            document = maintenance_fail_closed(
                transaction_id=arguments.transaction_id,
                controller_commit=arguments.controller_commit,
                reason_code=arguments.reason_code,
            )
        elif arguments.command == "maintenance-assert":
            document = maintenance_assert(
                transaction_id=arguments.transaction_id,
                controller_commit=arguments.controller_commit,
            )
        elif arguments.command == "maintenance-inspect":
            document = maintenance_inspect()
            print(_canonical(document).decode("utf-8"), end="")
            return 0
        elif arguments.command == "maintenance-end":
            maintenance_end(
                transaction_id=arguments.transaction_id,
                controller_commit=arguments.controller_commit,
                expected_fragments=_expected_fragment_arguments(
                    arguments.expected_fragment
                ),
                expected_drop_ins=_expected_drop_in_arguments(
                    arguments.expected_drop_in
                ),
                finalized_receipt=Path(arguments.finalized_receipt),
                finalized_sha256=arguments.finalized_sha256,
            )
            print(
                "palimpsest-continuity-guard maintenance-end "
                f"transaction={arguments.transaction_id} status=restored"
            )
            return 0
        elif arguments.command == "maintenance-reconcile-finalized":
            finalized_path, finalized_sha256 = maintenance_reconcile_finalized(
                transaction_id=arguments.transaction_id,
                controller_commit=arguments.controller_commit,
                expected_fragments=_expected_fragment_arguments(
                    arguments.expected_fragment
                ),
                expected_drop_ins=_expected_drop_in_arguments(
                    arguments.expected_drop_in
                ),
            )
            print(
                "palimpsest-continuity-guard maintenance-reconcile-finalized "
                f"transaction={arguments.transaction_id} status=restored "
                f"finalized_receipt={finalized_path} "
                f"finalized_sha256={finalized_sha256}"
            )
            return 0
        else:  # pragma: no cover - argparse owns command validation.
            raise GuardError("unsupported maintenance command")
    except (GuardError, OSError) as exc:
        print(f"palimpsest-continuity-guard {arguments.command} failed: {exc}", file=sys.stderr)
        return 1
    print(
        f"palimpsest-continuity-guard {arguments.command} "
        f"transaction={document['transaction_id']} status={document['status']}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
