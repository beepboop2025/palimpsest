#!/usr/bin/env bash
# Run the production stack with one authoritative environment file for both
# Compose interpolation and container runtime configuration.

set -Eeuo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
env_file="${PALIMPSEST_ENV_FILE:-$script_dir/.env}"

if [[ "$env_file" != /* ]]; then
  env_file="$(cd "$(dirname "$env_file")" && pwd -P)/$(basename "$env_file")"
fi
if [[ ! -r "$env_file" ]]; then
  printf 'palimpsest: production env is not readable: %s\n' "$env_file" >&2
  exit 1
fi

export PALIMPSEST_ENV_FILE="$env_file"
repo_root="$(cd "$script_dir/../.." && pwd -P)"

# `git -C` still honors repository-redirection variables inherited from the
# caller.  Do not let those variables certify some other clean tree while
# Docker builds this checkout.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE
# This wrapper deploys the local Hetzner daemon.  A developer's inherited
# Docker context must not redirect the build while the local receipt is later
# used by systemd.
unset DOCKER_CONTEXT DOCKER_TLS_VERIFY DOCKER_CERT_PATH
export DOCKER_HOST="unix:///var/run/docker.sock"

# Image provenance is security state for the private analysis cascade.  Keep
# these probes fail closed: an empty value must never mean that Git itself
# failed.  `all` also catches untracked files nested below an untracked folder.
if ! revision="$(
  git -c "safe.directory=$repo_root" -C "$repo_root" \
    rev-parse --verify HEAD 2>/dev/null
)"; then
  printf 'palimpsest: cannot resolve the checked-out Git revision\n' >&2
  exit 1
fi
if ! checkout_status="$(
  git -c "safe.directory=$repo_root" -C "$repo_root" \
    status --porcelain=v1 --untracked-files=all 2>/dev/null
)"; then
  printf 'palimpsest: cannot verify that the Git checkout is clean\n' >&2
  exit 1
fi
if [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  printf 'palimpsest: refusing a malformed Git revision\n' >&2
  exit 1
fi
if [[ -n "$checkout_status" ]]; then
  printf 'palimpsest: refusing to build from a modified or untracked checkout\n' >&2
  exit 1
fi
if [[ -n "${PALIMPSEST_IMAGE_REVISION:-}" \
      && "$PALIMPSEST_IMAGE_REVISION" != "$revision" ]]; then
  printf 'palimpsest: PALIMPSEST_IMAGE_REVISION does not match checked-out HEAD\n' >&2
  exit 1
fi
export PALIMPSEST_IMAGE_REVISION="$revision"
exec docker compose \
  --project-name "${COMPOSE_PROJECT_NAME:-palimpsest}" \
  --env-file "$env_file" \
  -f "$script_dir/docker-compose.prod.yml" \
  "$@"
