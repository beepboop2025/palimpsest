    if any(not isinstance(row, dict) or not isinstance(row.get("node"), dict) for row in rows):
        raise SystemExit(f"Railway {label} edge is invalid")
    return [row["node"] for row in rows]

def one(rows, key, expected, label):
    matches = [row for row in rows if row.get(key) == expected]
    if len(matches) != 1:
        raise SystemExit(f"Railway {label} is not singular")
    return matches[0]

raw = Path(sys.argv[1]).read_bytes()
try:
    document = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=strict_object)
except (UnicodeError, json.JSONDecodeError) as exc:
    raise SystemExit("Railway topology is not strict JSON") from exc
project_id, environment_id, service_id, deployment_id = sys.argv[2:6]
if not isinstance(document, dict) or document.get("id") != project_id:
    raise SystemExit("Railway topology project identity is invalid")
service = one(edges(document.get("services"), "services"), "id", service_id, "service")
if service.get("name") != "palimpsest-publication":
    raise SystemExit("Railway topology service name is invalid")
environment = one(edges(document.get("environments"), "environments"), "id", environment_id, "environment")
if environment.get("deletedAt") is not None or environment.get("canAccess") is not True:
    raise SystemExit("Railway topology environment is inaccessible")
if edges(environment.get("volumeInstances"), "volumes"):
    raise SystemExit("Railway topology unexpectedly has volumes")
instance = one(edges(environment.get("serviceInstances"), "service instances"), "serviceId", service_id, "service instance")
if instance.get("environmentId") != environment_id or instance.get("serviceName") != "palimpsest-publication":
    raise SystemExit("Railway topology service instance identity is invalid")
if instance.get("source") not in (None, {"image": None, "repo": None}):
    raise SystemExit("Railway topology has an attached source")
if "source" not in instance or instance.get("cronSchedule") is not None or instance.get("nextCronRunAt") is not None:
    raise SystemExit("Railway topology scheduling/source contract is invalid")
latest = instance.get("latestDeployment")
if not isinstance(latest, dict) or latest.get("id") != deployment_id or latest.get("status") != "SUCCESS" or latest.get("deploymentStopped") is not False:
    raise SystemExit("Railway latest deployment identity is invalid")
instances = latest.get("instances")
if not isinstance(instances, list) or len(instances) != 1 or not isinstance(instances[0], dict) or instances[0].get("status") != "RUNNING":
    raise SystemExit("Railway latest deployment is not singular and running")
metadata = latest.get("meta")
if not isinstance(metadata, dict) or metadata.get("buildOnly") is not False or metadata.get("reason") not in {"deploy", "deploymentRollback", "rollback"}:
    raise SystemExit("Railway latest deployment metadata is invalid")
image = metadata.get("imageDigest")
if not isinstance(image, str) or re.fullmatch(r"sha256:[0-9a-f]{64}", image) is None or metadata.get("volumeMounts") != []:
    raise SystemExit("Railway latest deployment image/mount identity is invalid")
manifest = metadata.get("serviceManifest")
if not isinstance(manifest, dict) or not isinstance(manifest.get("build"), dict) or not isinstance(manifest.get("deploy"), dict):
    raise SystemExit("Railway service manifest is invalid")
build, deploy = manifest["build"], manifest["deploy"]
if build.get("builder") != "DOCKERFILE" or build.get("dockerfilePath") != "ops/railway/Dockerfile.static":
    raise SystemExit("Railway static builder identity is invalid")
if deploy.get("healthcheckPath") != "/healthz" or deploy.get("numReplicas") != 1 or deploy.get("cronSchedule") is not None or deploy.get("requiredMountPath") is not None:
    raise SystemExit("Railway static deployment topology is invalid")
created = latest.get("createdAt")
if not isinstance(created, str) or len(created) > 64:
    raise SystemExit("Railway deployment timestamp is invalid")
try:
    parsed = datetime.fromisoformat(created.replace("Z", "+00:00"))
except ValueError as exc:
    raise SystemExit("Railway deployment timestamp is invalid") from exc
if parsed.tzinfo is None or parsed.utcoffset() is None or parsed.astimezone(UTC) > datetime.now(UTC):
    raise SystemExit("Railway deployment timestamp is invalid")
print(image, metadata["reason"], created, sep="\t")
