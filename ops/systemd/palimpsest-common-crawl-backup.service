[Unit]
Description=Encrypt, upload, and restore-verify Palimpsest Common Crawl evidence
Documentation=file:///usr/local/libexec/palimpsest-common-crawl/current/README.md
After=network-online.target var-lib-palimpsest-common\x2dcrawl.mount
Wants=network-online.target
RequiresMountsFor=/var/lib/palimpsest/common-crawl
ConditionFileIsExecutable=/usr/local/libexec/palimpsest-common-crawl/current/backup/palimpsest-common-crawl-offsite-backup.sh
ConditionPathExists=/root/.config/anchor/object-storage.env
ConditionPathExists=/etc/palimpsest/common-crawl-backup.env
ConditionPathExists=/etc/palimpsest/common-crawl-backup.passphrase
ConditionPathExists=/var/lib/palimpsest/common-crawl/.common-crawl.lock

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/usr/local/libexec/palimpsest-common-crawl/current
EnvironmentFile=/root/.config/anchor/object-storage.env
EnvironmentFile=/etc/palimpsest/common-crawl-backup.env
ExecStartPre=/bin/sh /usr/local/libexec/palimpsest-common-crawl/current/verify-host-bundle.sh
ExecStartPre=/usr/bin/cmp -s /usr/local/libexec/palimpsest-common-crawl/current/REVISION /etc/palimpsest/deployed-commit
ExecStart=/usr/bin/bash /usr/local/libexec/palimpsest-common-crawl/current/backup/palimpsest-common-crawl-offsite-backup.sh
TimeoutStartSec=12h
UMask=0077
Nice=15
IOSchedulingClass=idle
TasksMax=64
MemoryMax=2G

ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/usr/local/libexec/palimpsest-common-crawl /etc/palimpsest /var/lib/palimpsest/common-crawl
ReadWritePaths=/var/cache/palimpsest-common-crawl-backup /var/lib/palimpsest-common-crawl-backup
CacheDirectory=palimpsest-common-crawl-backup
CacheDirectoryMode=0700
StateDirectory=palimpsest-common-crawl-backup
StateDirectoryMode=0700
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
NoNewPrivileges=true
# The evidence files are owned by the locked analytical identity and may be
# mode 0600.  This read-only capability permits the root backup process to copy
# them while ProtectSystem/ReadOnlyPaths still prohibit warehouse mutation.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
