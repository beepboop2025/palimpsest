def _validate_watchdog_artifact(
    raw: bytes,
    *,
    run_id: int,
    head_sha: str,
    repository: str,
) -> tuple[str, dict[str, Any]]:
    value = _strict_json(
        raw, label="watchdog recovery artifact", maximum=MAX_JSON_BYTES
    )
    if raw != _canonical_json(value):
        raise RestoreError("watchdog recovery artifact is not canonical")
    keys = {
        "actor",
        "checkout_sha",
        "dispatch_step_outcome",
        "dispatches",
        "event",
        "event_sha",
        "final_main_sha",
        "observed_at",
        "observed_main_sha",
        "plan",
        "plan_sha256",
        "repository",
        "run_attempt",
        "run_id",
        "schema_version",
        "status",
        "workflow",
        "workflow_name",
    }
    receipt = _expect_keys(value, keys, label="watchdog recovery artifact")
    plan = _expect_keys(
        receipt["plan"],
        {
            "bundle_generated_at",
            "bundle_stale",
            "dispatch",
            "escalations",
            "generated_at",
            "problems",
            "schema_version",
        },
        label="watchdog recovery plan",
    )
    _utc(receipt["observed_at"], label="watchdog receipt observed_at")
    _utc(plan["generated_at"], label="watchdog plan generated_at")
    if plan["bundle_generated_at"] is not None:
        _utc(plan["bundle_generated_at"], label="watchdog bundle generated_at")
    if (
        receipt["schema_version"] != "palimpsest.collector-health-watchdog-receipt.v1"
        or receipt["run_id"] != run_id
        or receipt["run_attempt"] != 1
        or receipt["checkout_sha"] != head_sha
        or receipt["event_sha"] != head_sha
        or receipt["observed_main_sha"] != head_sha
        or receipt["final_main_sha"] != head_sha
        or receipt["event"] != "workflow_dispatch"
        or receipt["repository"] != repository
        or receipt["workflow"] != ".github/workflows/collector-health-watchdog.yml"
        or receipt["workflow_name"] != "Recover stale collector publications"
        or receipt["status"] != "success"
        or receipt["dispatch_step_outcome"] != "success"
        or not isinstance(receipt["actor"], str)
        or not 1 <= len(receipt["actor"]) <= 100
        or plan["schema_version"] != "collector-watchdog-plan.v2"
        or plan["generated_at"] != receipt["observed_at"]
        or not isinstance(plan["bundle_stale"], bool)
        or plan["dispatch"] != []
        or plan["escalations"] != []
        or plan["problems"] != []
        or receipt["dispatches"] != []
        or receipt["plan_sha256"] != hashlib.sha256(_canonical_json(plan)).hexdigest()
    ):
        raise RestoreError("watchdog recovery artifact is not an exact abstention")
    return "abstained", receipt


def _stage_outcome(
    deadline: Deadline,
    *,
    repository: str,
    spec: WorkflowSpec,
    run_id: int,
    main_before: str,
    main_after: str,
    dispatch_inputs: dict[str, str],
    temporary_directory: Path,
) -> tuple[str, dict[str, Any]]:
    if spec.order == 1:
        artifact_name = f"newswire-manual-outcome-{run_id}-1"
        raw, artifact = _download_exact_artifact(
            deadline,
            repository=repository,
            run_id=run_id,
            artifact_name=artifact_name,
            expected_filename="newswire-manual-outcome.json",
            temporary_directory=temporary_directory,
        )
        outcome, receipt = _validate_newswire_artifact(
            raw,
            run_id=run_id,
            head_sha=main_before,
            main_after=main_after,
            repository=repository,
        )
        evidence: dict[str, Any] = {
            "artifact": artifact,
            "kind": "artifact",
            "result": receipt["result"],
        }
        if outcome == "published":
            assert spec.commit_prefix is not None
            evidence["commit"] = _commit_lineage(
                deadline,
                repository=repository,
                before=main_before,
                after=main_after,
                prefix=spec.commit_prefix,
            )
        elif main_after != main_before:
            raise RestoreError("Newswire no-change artifact disagrees with public main")
        return outcome, evidence
    if spec.order == 2:
        artifact_name = f"osint-manual-outcome-{run_id}-1"
        raw, artifact = _download_exact_artifact(
            deadline,
            repository=repository,
            run_id=run_id,
            artifact_name=artifact_name,
            expected_filename="osint-manual-outcome.json",
            temporary_directory=temporary_directory,
        )
        outcome, receipt = _validate_osint_artifact(
            raw,
            run_id=run_id,
            head_sha=main_before,
            nonce=dispatch_inputs["release_nonce"],
            main_after=main_after,
            repository=repository,
        )
        evidence = {
            "artifact": artifact,
            "kind": "artifact",
            "result": receipt["result"],
        }
        if outcome == "published":
            assert spec.commit_prefix is not None
            evidence["commit"] = _commit_lineage(
                deadline,
                repository=repository,
                before=main_before,
                after=main_after,
                prefix=spec.commit_prefix,
            )
        elif main_after != main_before:
            raise RestoreError("OSINT no-change artifact disagrees with public main")
        return outcome, evidence
    if main_after != main_before:
        raise RestoreError(
            "watchdog changed main despite read-only contents permission"
        )
    artifact_name = f"collector-health-watchdog-receipt-{run_id}-1"
    raw, artifact = _download_exact_artifact(
        deadline,
        repository=repository,
        run_id=run_id,
        artifact_name=artifact_name,
        expected_filename="collector-health-watchdog-receipt.json",
        temporary_directory=temporary_directory,
    )
    outcome, receipt = _validate_watchdog_artifact(
        raw,
        run_id=run_id,
        head_sha=main_before,
        repository=repository,
    )
    return outcome, {
        "artifact": artifact,
        "kind": "artifact",
        "plan_sha256": hashlib.sha256(_canonical_json(receipt["plan"])).hexdigest(),
    }


def _dispatch_arguments(
    spec: WorkflowSpec, *, main_sha: str
) -> tuple[list[str], dict[str, str]]:
    inputs: dict[str, str] = {}
    if spec.order == 2:
        inputs = {
            "expected_deploy_sha": main_sha,
            "release_nonce": secrets.token_hex(16),
        }
    arguments = [
        "workflow",
        "run",
        str(spec.workflow_id),
        "--repo",
        "__REPOSITORY__",
        "--ref",
        "main",
    ]
    for name in spec.dispatch_inputs:
        arguments.extend(("-f", f"{name}={inputs[name]}"))
    return arguments, inputs


def _run_stage(
    *,
    repository: str,
    spec: WorkflowSpec,
    current_index: int,
    main_before: str,
    workflow_sha256: str,
    evidence_directory: Path,
    temporary_directory: Path,
    run_state: RunState,
) -> tuple[dict[str, Any], str, str]:
    deadline = Deadline.start(spec.budget_seconds)
    _require_closed_authority(deadline, repository)
    _require_stage_states(deadline, repository, active_index=None)
    if _main_sha(deadline, repository) != main_before:
        raise RestoreError("public main changed before producer stage snapshot")
    if _workflow_contract(deadline, repository, spec, main_before) != workflow_sha256:
        raise RestoreError(f"{spec.filename} YAML changed between producer stages")
    before = _all_run_snapshots(deadline, repository)
    _validate_attempt_run_set(run_state, before, require_completed=True)
    stage_started_at = _now()
    _gh(
        deadline,
        "workflow",
        "enable",
        str(spec.workflow_id),
        "--repo",
        repository,
        label=f"enable {spec.filename}",
    )
    _require_stage_states(deadline, repository, active_index=current_index)
    _require_closed_authority(deadline, repository)
    if _main_sha(deadline, repository) != main_before:
        raise RestoreError("public main changed while enabling producer stage")
    arguments, dispatch_inputs = _dispatch_arguments(spec, main_sha=main_before)
    arguments[arguments.index("__REPOSITORY__")] = repository
    dispatch_started = datetime.now(UTC)
    previous_mask = signal.pthread_sigmask(
        signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}
    )
    try:
        run_state.dispatch_unbound = True
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
    _gh(deadline, *arguments, label=f"dispatch {spec.filename}")
    _require_closed_authority(deadline, repository)
    run_id, _listed = _poll_new_manual_run(
        deadline,
        repository=repository,
        spec=spec,
        before=before[current_index],
        expected_sha=main_before,
        not_before=dispatch_started,
    )
    previous_mask = signal.pthread_sigmask(
        signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}
    )
    try:
        run_state.current_run_id = run_id
        run_state.bound_runs[run_id] = (current_index, main_before)
        run_state.dispatch_unbound = False
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
    run = _wait_success(
        deadline,
        repository=repository,
        spec=spec,
        run_id=run_id,
        expected_sha=main_before,
        not_before=dispatch_started,
    )
    jobs = _validate_jobs(deadline, repository, spec, run_id)
    _require_closed_authority(deadline, repository)
    _require_stage_states(deadline, repository, active_index=current_index)
    main_after = _main_sha(deadline, repository)
    additions = _post_run_race_check(
        deadline,
        repository=repository,
        before=before,
        current_index=current_index,
        bound_run_id=run_id,
        run_state=run_state,
    )
    outcome, evidence = _stage_outcome(
        deadline,
        repository=repository,
        spec=spec,
        run_id=run_id,
        main_before=main_before,
        main_after=main_after,
        dispatch_inputs=dispatch_inputs,
        temporary_directory=temporary_directory,
    )
    _require_closed_authority(deadline, repository)
    _require_stage_states(deadline, repository, active_index=current_index)
    if _main_sha(deadline, repository) != main_after:
        raise RestoreError("public main changed during producer outcome proof")
    _validate_attempt_run_set(
        run_state,
        _all_run_snapshots(deadline, repository),
        require_completed=True,
    )
    _gh(
        deadline,
        "workflow",
        "disable",
        str(spec.workflow_id),
        "--repo",
        repository,
        label=f"refreeze {spec.filename} after manual proof",
    )
    _require_stage_states(deadline, repository, active_index=None)
    _require_closed_authority(deadline, repository)
    if _main_sha(deadline, repository) != main_after:
        raise RestoreError("public main changed while refreezing producer stage")
    _validate_attempt_run_set(
        run_state,
        _all_run_snapshots(deadline, repository),
        require_completed=True,
    )
    stage = {
        "authority": {
            "exclusive_writer_ack": EXCLUSIVE_WRITER_ACK,
            "hourly_publication_enabled": False,
        },
        "dispatch_inputs": dispatch_inputs,
        "main_after": main_after,
        "main_before": main_before,
        "outcome": outcome,
        "outcome_evidence": evidence,
        "repository": repository,
        "run": {
            "conclusion": run["conclusion"],
            "created_at": run["created_at"],
            "event": run["event"],
            "head_sha": run["head_sha"],
            "jobs": jobs,
            "run_attempt": run["run_attempt"],
            "run_id": run_id,
            "updated_at": run["updated_at"],
        },
        "run_additions": {
            WORKFLOWS[index].filename: value for index, value in enumerate(additions)
        },
        "schema_version": "palimpsest.github-producer-stage.v1",
        "stage_started_at": stage_started_at,
        "status": "verified",
        "verified_at": _now(),
        "workflow": {
            "dispatch_inputs": list(spec.dispatch_inputs),
            "file": spec.filename,
            "id": spec.workflow_id,
            "name": spec.display_name,
            "order": spec.order,
            "state_after": "disabled_manually",
            "state_before": "disabled_manually",
            "yaml_sha256": workflow_sha256,
        },
    }
    stage_path = evidence_directory / f"{spec.order:02d}-{spec.filename[:-4]}.json"
    digest = _exclusive_receipt(stage_path, stage, run_state=run_state)
    reference = {
        "file": spec.filename,
        "id": spec.workflow_id,
        "main_after": stage["main_after"],
        "main_before": stage["main_before"],
        "order": spec.order,
        "outcome": stage["outcome"],
        "receipt": str(stage_path),
        "receipt_sha256": digest,
        "run_id": stage["run"]["run_id"],
    }
    previous_mask = signal.pthread_sigmask(
        signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}
    )
    try:
        assert run_state.completed_stages is not None
        run_state.completed_stages.append(reference)
        run_state.last_proved_main_sha = stage["main_after"]
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
    run_state.current_run_id = None
    return stage, str(stage_path), digest


def _execute(
    *,
    repository: str,
    prerequisites: Prerequisites,
    phase3_path: Path,
    proof_complete_path: Path,
    handoff_path: Path,
    resume_path: Path | None,
    evidence_directory: Path,
    temporary_directory: Path,
    run_state: RunState,
) -> dict[str, Any]:
    preflight = Deadline.start(600)
    _gh(
        preflight,
        "auth",
        "status",
        "--hostname",
        "github.com",
        label="GitHub authentication",
    )
    _require_gh_transport(preflight)
    _require_closed_authority(preflight, repository)
    if _main_sha(preflight, repository) != prerequisites.restore_base_sha:
        raise RestoreError("public main is not the exact restoration source SHA")
    _require_stage_states(preflight, repository, active_index=None)
    run_state.initial_main_sha = prerequisites.restore_base_sha
    run_state.last_proved_main_sha = prerequisites.restore_base_sha
    _require_ancestry(
        preflight,
        repository=repository,
        ancestor=prerequisites.host_sha,
        descendant=prerequisites.publication_sha,
        label="verify host-to-publication lineage",
    )
    _require_ancestry(
        preflight,
        repository=repository,
        ancestor=prerequisites.publication_sha,
        descendant=prerequisites.public_release_sha,
        label="verify publication-to-release lineage",
    )
    workflow_sha256 = [
        _workflow_contract(preflight, repository, spec, prerequisites.restore_base_sha)
        for spec in WORKFLOWS
    ]
    if (
        _load_prerequisites(
            expected_host_sha=prerequisites.host_sha,
            expected_public_release_sha=prerequisites.public_release_sha,
            phase3_path=phase3_path,
            proof_complete_path=proof_complete_path,
            handoff_path=handoff_path,
            resume_path=resume_path,
            repository=repository,
        )
        != prerequisites
    ):
        raise RestoreError("prerequisite receipts changed during preflight")
    main_sha = prerequisites.restore_base_sha
    baseline = _all_run_snapshots(preflight, repository)
    _require_initial_run_quiet(run_state, baseline)
    previous_mask = signal.pthread_sigmask(
        signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}
    )
    try:
        run_state.attempt_run_snapshots = baseline
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
    stages: list[dict[str, Any]] = []
    for index, spec in enumerate(WORKFLOWS):
        if (
            _load_prerequisites(
                expected_host_sha=prerequisites.host_sha,
                expected_public_release_sha=prerequisites.public_release_sha,
                phase3_path=phase3_path,
                proof_complete_path=proof_complete_path,
                handoff_path=handoff_path,
                resume_path=resume_path,
                repository=repository,
            )
            != prerequisites
        ):
            raise RestoreError("prerequisite receipts changed between producer stages")
        stage, _path, _digest = _run_stage(
            repository=repository,
            spec=spec,
            current_index=index,
            main_before=main_sha,
            workflow_sha256=workflow_sha256[index],
            evidence_directory=evidence_directory,
            temporary_directory=temporary_directory,
            run_state=run_state,
        )
        assert run_state.completed_stages is not None
        stages = list(run_state.completed_stages)
        main_sha = stage["main_after"]
    final_deadline = Deadline.start(600)
    _require_closed_authority(final_deadline, repository)
    _require_stage_states(final_deadline, repository, active_index=None)
    if _main_sha(final_deadline, repository) != main_sha:
        raise RestoreError("public main changed before final producer receipt")
    _validate_attempt_run_set(
        run_state,
        _all_run_snapshots(final_deadline, repository),
        require_completed=True,
    )
    if (
        _load_prerequisites(
            expected_host_sha=prerequisites.host_sha,
            expected_public_release_sha=prerequisites.public_release_sha,
            phase3_path=phase3_path,
            proof_complete_path=proof_complete_path,
            handoff_path=handoff_path,
            resume_path=resume_path,
            repository=repository,
        )
        != prerequisites
    ):
        raise RestoreError("prerequisite receipts changed before final receipt")
    for index, spec in enumerate(WORKFLOWS):
        _gh(
            final_deadline,
            "workflow",
            "enable",
            str(spec.workflow_id),
            "--repo",
            repository,
            label=f"activate proved {spec.filename}",
        )
        _require_activation_prefix(final_deadline, repository, active_count=index + 1)
        _require_closed_authority(final_deadline, repository)
        if _main_sha(final_deadline, repository) != main_sha:
            raise RestoreError("public main changed during final producer activation")
        _validate_attempt_run_set(
            run_state,
            _all_run_snapshots(final_deadline, repository),
            require_completed=True,
        )
    quiet_snapshot: list[dict[int, dict[str, Any]]] | None = None
    for sample in range(FINAL_ACTIVATION_QUIET_SAMPLES):
        current = _all_run_snapshots(final_deadline, repository)
        _validate_attempt_run_set(run_state, current, require_completed=True)
        if quiet_snapshot is not None and current != quiet_snapshot:
            _mark_producer_runs_unproved(run_state)
            raise RestoreError("producer run inventory changed at activation boundary")
        quiet_snapshot = current
        if sample + 1 < FINAL_ACTIVATION_QUIET_SAMPLES:
            remaining = final_deadline.remaining()
            if remaining <= FINAL_ACTIVATION_QUIET_INTERVAL_SECONDS:
                raise RestoreError("final producer activation quiet proof timed out")
            time.sleep(FINAL_ACTIVATION_QUIET_INTERVAL_SECONDS)
    _require_activation_prefix(final_deadline, repository, active_count=3)
    _require_closed_authority(final_deadline, repository)
    if _main_sha(final_deadline, repository) != main_sha:
        raise RestoreError("public main changed after final producer activation")
    return {
        "attempt_id": run_state.attempt_id,
        "authority": {
            "exclusive_writer_ack": EXCLUSIVE_WRITER_ACK,
            "hourly_publication_enabled": False,
            "protected_environment": PRODUCTION_ENVIRONMENT,
        },
        "completed_stages": stages,
        "evidence_directory": str(evidence_directory),
        "final_main_sha": main_sha,
        "initial_main_sha": prerequisites.restore_base_sha,
        "repository": repository,
        "resume": {
            "receipt": str(prerequisites.resume_path)
            if prerequisites.resume_path is not None
            else None,
            "receipt_sha256": prerequisites.resume_sha256,
        },
        "schema_version": "palimpsest.github-producer-restore.v2",
        "source_graph": _source_graph(prerequisites),
        "status": "verified",
        "terminal_at": _now(),
    }


def _source_graph(prerequisites: Prerequisites) -> dict[str, Any]:
    return {
        "host_sha": prerequisites.host_sha,
        "phase2_handoff": {
            "receipt": str(prerequisites.handoff_path),
            "receipt_sha256": prerequisites.handoff_sha256,
        },
        "phase3": {
            "finalized_at": prerequisites.phase3_finalized_at,
            "receipt": str(prerequisites.phase3_path),
            "receipt_sha256": prerequisites.phase3_sha256,
            "transaction_id": prerequisites.phase3_transaction,
        },
        "proof_complete": {
            "generated_at": prerequisites.proof_complete_generated_at,
            "receipt": str(prerequisites.proof_complete_path),
            "receipt_sha256": prerequisites.proof_complete_sha256,
        },
        "publication_sha": prerequisites.publication_sha,
        "public_release_sha": prerequisites.public_release_sha,
    }


def _failed_receipt(
    *,
    repository: str,
    prerequisites: Prerequisites | None,
    expected_host_sha: str,
    expected_public_release_sha: str,
    evidence_directory: Path | None,
    run_state: RunState,
    authority: dict[str, Any],
    cleanup_ok: bool,
    error: BaseException,
    exit_code: int,
) -> dict[str, Any]:
    resume_main_sha = authority.get("resume_main_sha")
    failed_closed = (
        cleanup_ok
        and _is_sha40(resume_main_sha)
        and resume_main_sha == run_state.last_proved_main_sha
        and not run_state.dispatch_unbound
        and not run_state.producer_runs_unproved
        and run_state.attempt_run_snapshots is not None
        and authority.get("in_flight_run_id") is None
        and authority.get("hourly_publication_enabled") == "false"
        and authority.get("exclusive_writer_ack") == "absent"
        and authority.get("workflow_states")
        == {spec.filename: "disabled_manually" for spec in WORKFLOWS}
        and prerequisites is not None
        and run_state.initial_main_sha is not None
    )
    graph: dict[str, Any]
    if prerequisites is not None:
        graph = _source_graph(prerequisites)
    else:
        graph = {
            "host_sha": expected_host_sha,
            "phase2_handoff": None,
            "phase3": None,
            "proof_complete": None,
            "publication_sha": None,
            "public_release_sha": expected_public_release_sha,
        }
    completed = list(run_state.completed_stages or [])
    initial_main = run_state.initial_main_sha
    if initial_main is None and prerequisites is not None:
        initial_main = prerequisites.restore_base_sha
    if initial_main is None:
        initial_main = expected_public_release_sha
    final_main = (
        resume_main_sha
        if _is_sha40(resume_main_sha)
        else (run_state.last_proved_main_sha or initial_main)
    )
    return {
        "attempt_id": run_state.attempt_id,
        "authority": {
            "exclusive_writer_ack": authority.get("exclusive_writer_ack", "unproved"),
            "hourly_publication_enabled": authority.get(
                "hourly_publication_enabled", "unproved"
            ),
            "in_flight_run_id": authority.get("in_flight_run_id"),
            "reconciled_run": authority.get("reconciled_run"),
            "resume_main_sha": authority.get("resume_main_sha"),
            "workflow_states": authority.get("workflow_states", {}),
        },
        "completed_stages": completed,
        "evidence_directory": str(evidence_directory)
        if evidence_directory is not None
        else None,
        "failure": {
            "error_class": type(error).__name__,
            "error_message": str(error)[:1000],
            "exit_code": exit_code,
            "resume_main_sha": final_main if failed_closed else None,
            "run_id": run_state.current_run_id,
        },
        "final_main_sha": final_main,
        "initial_main_sha": initial_main,
        "repository": repository,
        "resume": {
            "receipt": str(prerequisites.resume_path)
            if prerequisites is not None and prerequisites.resume_path is not None
            else None,
            "receipt_sha256": prerequisites.resume_sha256
            if prerequisites is not None
            else None,
        },
        "schema_version": "palimpsest.github-producer-restore.v2",
        "source_graph": graph,
        "status": "failed-closed" if failed_closed else "cleanup-unproved",
        "terminal_at": _now(),
    }


def _report_terminal_warning_only(path: Path, digest: str, status: str) -> None:
    message = json.dumps(
        {"receipt": str(path), "receipt_sha256": digest, "status": status},
        separators=(",", ":"),
        sort_keys=True,
    )
    try:
        sys.stdout.write(message + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, OSError, ValueError) as error:
        try:
            print(
                f"producer restoration terminal receipt committed; stdout failed: {error}",
                file=sys.stderr,
            )
        except (BrokenPipeError, OSError, ValueError):
            pass


def main() -> int:
    if len(sys.argv) != 1:
        print("run-producer-restore accepts environment inputs only", file=sys.stderr)
        return 2
    expected_host_sha = os.environ.get("EXPECTED_HOST_SHA", "")
    expected_public_release_sha = os.environ.get("EXPECTED_PUBLIC_RELEASE_SHA", "")
    repository = os.environ.get("PALIMPSEST_REPOSITORY", DEFAULT_REPOSITORY)
    if SHA40.fullmatch(expected_host_sha) is None:
        print("EXPECTED_HOST_SHA must be exactly 40 lowercase hex", file=sys.stderr)
        return 2
    if SHA40.fullmatch(expected_public_release_sha) is None:
        print(
            "EXPECTED_PUBLIC_RELEASE_SHA must be exactly 40 lowercase hex",
            file=sys.stderr,
        )
        return 2
    if REPOSITORY.fullmatch(repository) is None:
        print("PALIMPSEST_REPOSITORY is not an exact repository slug", file=sys.stderr)
        return 2
    run_state = RunState(attempt_id=secrets.token_hex(16), completed_stages=[])
    status = 1
    original_error: BaseException | None = None
    receipt_path: Path | None = None
    evidence_directory: Path | None = None
    temporary_directory: Path | None = None
    prerequisites: Prerequisites | None = None
    receipt_digest = ""
    temporary_removed = False

    def abort(signum: int, _frame: Any) -> NoReturn:
        raise SignalAbort(signum)

    previous = {
        item: signal.getsignal(item)
        for item in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)
    }
    for item in previous:
        signal.signal(item, abort)
    try:
        phase3_path = Path(os.environ.get("PHASE3_FINALIZED_RECEIPT", ""))
        proof_complete_path = Path(os.environ.get("PHASE3_PROOF_COMPLETE_RECEIPT", ""))
        handoff_path = Path(os.environ.get("PHASE2_V2_HANDOFF_RECEIPT", ""))
        resume_text = os.environ.get("PRODUCER_RESTORE_RESUME_RECEIPT", "")
        resume_path = Path(resume_text) if resume_text else None
        receipt_path = _prepare_output(
            os.environ.get("PRODUCER_RESTORE_RECEIPT", ""),
            label="producer restore receipt",
        )
        prerequisites = _load_prerequisites(
            expected_host_sha=expected_host_sha,
            expected_public_release_sha=expected_public_release_sha,
            phase3_path=phase3_path,
            proof_complete_path=proof_complete_path,
            handoff_path=handoff_path,
            resume_path=resume_path,
            repository=repository,
        )
        evidence_directory = _prepare_evidence_directory(
            os.environ.get("PRODUCER_RESTORE_EVIDENCE_DIR", "")
        )
        temporary_directory = Path(
            tempfile.mkdtemp(prefix="palimpsest-producer-restore-")
        )
        temporary_directory.chmod(0o700)
        receipt = _execute(
            repository=repository,
            prerequisites=prerequisites,
            phase3_path=phase3_path,
            proof_complete_path=proof_complete_path,
            handoff_path=handoff_path,
            resume_path=resume_path,
            evidence_directory=evidence_directory,
            temporary_directory=temporary_directory,
            run_state=run_state,
        )
        shutil.rmtree(temporary_directory)
        temporary_removed = True
        receipt_digest = _exclusive_receipt(
            receipt_path,
            receipt,
            run_state=run_state,
            final_receipt=True,
        )
        status = 0
    except SignalAbort as error:
        print(str(error), file=sys.stderr)
        status = 128 + error.signum
        original_error = error
    except KeyboardInterrupt:
        original_error = RestoreError("producer restoration interrupted")
        print(str(original_error), file=sys.stderr)
        status = 130
    except CommandError as error:
        print(str(error), file=sys.stderr)
        status = error.returncode if 1 <= error.returncode <= 125 else 1
        original_error = error
    except (KeyError, OSError, RestoreError, TypeError, ValueError) as error:
        print(str(error), file=sys.stderr)
        status = 1
        original_error = error
    finally:
        previous_mask = signal.pthread_sigmask(
            signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}
        )
        cleanup_error = False
        cleanup_authority: dict[str, Any] = {
            "exclusive_writer_ack": "unproved",
            "hourly_publication_enabled": "unproved",
            "in_flight_run_id": run_state.current_run_id,
            "reconciled_run": None,
            "resume_main_sha": None,
            "workflow_states": {},
        }
        if status != 0 and not run_state.receipt_committed:
            cleanup_ok, cleanup_authority = _failure_cleanup(repository, run_state)
            cleanup_error = not cleanup_ok
        if temporary_directory is not None and not temporary_removed:
            try:
                shutil.rmtree(temporary_directory)
            except OSError as error:
                print(
                    f"failed to remove private producer temporary directory: {error}",
                    file=sys.stderr,
                )
                cleanup_error = True
        if (
            status != 0
            and not run_state.receipt_committed
            and receipt_path is not None
            and original_error is not None
        ):
            try:
                failed = _failed_receipt(
                    repository=repository,
                    prerequisites=prerequisites,
                    expected_host_sha=expected_host_sha,
                    expected_public_release_sha=expected_public_release_sha,
                    evidence_directory=evidence_directory,
                    run_state=run_state,
                    authority=cleanup_authority,
                    cleanup_ok=not cleanup_error,
                    error=original_error,
                    exit_code=status,
                )
                receipt_digest = _exclusive_receipt(
                    receipt_path,
                    failed,
                    run_state=run_state,
                    final_receipt=True,
                )
            except (KeyError, OSError, RestoreError, TypeError, ValueError) as error:
                print(
                    f"failed to commit terminal failure receipt: {error}",
                    file=sys.stderr,
                )
        for item, handler in previous.items():
            signal.signal(item, handler)
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
        if run_state.committed_status == "verified":
            status = 0
    if run_state.receipt_committed:
        assert receipt_path is not None
        assert run_state.committed_status is not None
        _report_terminal_warning_only(
            receipt_path, receipt_digest, run_state.committed_status
        )
    return status


if __name__ == "__main__":
    raise SystemExit(main())
