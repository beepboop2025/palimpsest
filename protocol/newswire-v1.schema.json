        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"scmp-china-economy"},"feed_url":{"const":"https://www.scmp.com/rss/318421/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"scmp-china-tech"},"feed_url":{"const":"https://www.scmp.com/rss/320663/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"shan-news-english"},"feed_url":{"const":"https://english.shannews.org/feed"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"taipei-times"},"feed_url":{"const":"https://www.taipeitimes.com/xml/index.rss"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"taiwan-insight"},"feed_url":{"const":"https://taiwaninsight.org/feed/"}}},"minContains":1,"maxContains":1},
