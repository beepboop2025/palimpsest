[Unit]
Description=Build private Palimpsest investigative leads from a frozen evidence snapshot
Documentation=file:///usr/local/libexec/palimpsest-analysis/current/README.md
Requires=palimpsest-investigative-broker.socket palimpsest-public-osint-sync.service
After=palimpsest-investigative-broker.socket palimpsest-evidence-wire.service palimpsest-public-osint-sync.service
ConditionPathExists=/etc/palimpsest/deployed-commit
ConditionPathExists=/usr/local/libexec/palimpsest-analysis/current/REVISION
ConditionPathIsDirectory=/var/lib/palimpsest/readings
ConditionPathIsDirectory=/var/lib/palimpsest/newswire
StartLimitIntervalSec=10m
StartLimitBurst=3

[Service]
Type=oneshot
User=10001
Group=10001
WorkingDirectory=/var/lib/palimpsest-analysis
ExecStartPre=/bin/sh /usr/local/libexec/palimpsest-analysis/current/verify-host-bundle.sh
ExecStartPre=/usr/bin/cmp -s /usr/local/libexec/palimpsest-analysis/current/REVISION /etc/palimpsest/deployed-commit
ExecStart=/usr/bin/python3 /usr/local/libexec/palimpsest-analysis/current/investigative_analysis_runner.py
TimeoutStartSec=35m
Restart=on-failure
RestartSec=2m
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TasksMax=96
MemoryMax=1536M

# The unprivileged process snapshots local evidence and talks only to the fixed
# root-owned broker socket. It has no Docker-group or daemon-socket authority.
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/usr/local/libexec/palimpsest-analysis /etc/palimpsest/deployed-commit /var/lib/palimpsest/readings /var/lib/palimpsest/newswire
ReadWritePaths=/var/lib/palimpsest-analysis/runs /var/lib/palimpsest-analysis/private /var/lib/palimpsest-analysis/delivery
BindReadOnlyPaths=/var/lib/palimpsest-public-osint-sync/authoritative/osint-china-latest.json:/var/lib/palimpsest/readings/osint-china-latest.json
BindReadOnlyPaths=/var/lib/palimpsest-public-osint-sync/authoritative/readings-ledger.jsonl:/var/lib/palimpsest/readings/readings-ledger.jsonl
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
RestrictAddressFamilies=AF_UNIX
