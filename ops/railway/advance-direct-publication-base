        type=Path,
        default=Path("/etc/palimpsest/railway-publication-base.json"),
    )
    parser.add_argument(
        "--installed-publisher",
        type=Path,
        default=Path("/usr/local/sbin/palimpsest-railway-publish"),
    )
    parser.add_argument(
        "--installed-helper",
