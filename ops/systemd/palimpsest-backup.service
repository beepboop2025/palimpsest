[Unit]
Description=Create and validate a Palimpsest node backup
Documentation=file:///home/palimpsest/palimpsest/ops/backup/README.md
Requires=docker.service
After=docker.service
ConditionFileIsExecutable=/home/palimpsest/palimpsest/ops/backup/palimpsest-backup.sh

[Service]
Type=oneshot
User=palimpsest
Group=palimpsest
WorkingDirectory=/home/palimpsest/palimpsest
EnvironmentFile=-/etc/palimpsest/backup.env
ExecStart=/home/palimpsest/palimpsest/ops/backup/palimpsest-backup.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/var/lib/palimpsest-analysis /var/lib/palimpsest/newswire /home/palimpsest/.palimpsest-witness
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
