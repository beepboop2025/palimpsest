        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"citizen-lab-chat-censorship"},"feed_url":{"const":"https://github.com/citizenlab/chat-censorship/commits/master.atom"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"cloudflare-radar"},"feed_url":{"const":"https://blog.cloudflare.com/tag/cloudflare-radar/rss"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"daily-cpec-china-pakistan"},"feed_url":{"const":"https://thedailycpec.com/category/china-pakistan/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"daily-cpec-gwadar"},"feed_url":{"const":"https://thedailycpec.com/category/gwadar/feed/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"dawn-pakistan"},"feed_url":{"const":"https://www.dawn.com/feeds/pakistan/"}}},"minContains":1,"maxContains":1},
        {"contains":{"required":["source_id","feed_url"],"properties":{"source_id":{"const":"diplomat-china"},"feed_url":{"const":"https://thediplomat.com/tag/china/feed/"}}},"minContains":1,"maxContains":1},
