# Root-only configuration for palimpsest-node-offsite-backup.service.
PALIMPSEST_NODE_OFFSITE_BACKUP_ROOT=/home/palimpsest/backups/node
PALIMPSEST_NODE_OFFSITE_WORK_DIR=/var/cache/palimpsest-node-offsite
PALIMPSEST_NODE_OFFSITE_STATUS_PATH=/var/lib/palimpsest-node-offsite/status.json
PALIMPSEST_NODE_OFFSITE_REVISION_FILE=/etc/palimpsest/deployed-commit
PALIMPSEST_NODE_OFFSITE_BUCKET=replace-with-private-object-lock-bucket
PALIMPSEST_NODE_OFFSITE_PREFIX=palimpsest/node
PALIMPSEST_NODE_OFFSITE_RCLONE_REMOTE=nodevault
PALIMPSEST_NODE_OFFSITE_RETENTION_MODE=COMPLIANCE
PALIMPSEST_NODE_OFFSITE_RETENTION_DAYS=90
PALIMPSEST_NODE_OFFSITE_MIN_FREE_MB=512
PALIMPSEST_NODE_OFFSITE_SOURCE_UID=1001
PALIMPSEST_NODE_OFFSITE_SOURCE_GID=1001
