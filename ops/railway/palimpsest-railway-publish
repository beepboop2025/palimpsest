manifest_artifact_identity() {
  local manifest_path="$1" relative_path="$2"
  jq -er --arg path "$relative_path" '
    .critical_files[$path] |
    select(
      type == "object" and
      keys == ["bytes","sha256"] and
      (.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      (.bytes | type == "number" and . >= 1 and floor == .)
    ) |
    [.sha256, (.bytes | tostring)] | @tsv
  ' "$manifest_path"
}

validate_manifest_bound_local() {
  local manifest_path="$1" relative_path="$2" artifact_path="$3"
  local identity expected_sha256 expected_bytes
  identity="$(manifest_artifact_identity "$manifest_path" "$relative_path")" \
    || return 1
  IFS=$'\t' read -r expected_sha256 expected_bytes <<<"$identity"
  [[ -f "$artifact_path" && ! -L "$artifact_path" \
    && "$(sha256_file "$artifact_path")" == "$expected_sha256" \
    && "$(stat -c '%s' "$artifact_path")" == "$expected_bytes" ]] || {
    log "$relative_path is not byte-bound to the release manifest" >&2
    return 1
  }
}

validate_manifest_bound_pair() {
  local manifest_path="$1" relative_path="$2" provider_path="$3"
  local public_path="$4" local_path="${5:-}" identity expected_sha256
  local expected_bytes
  identity="$(manifest_artifact_identity "$manifest_path" "$relative_path")" \
    || return 1
  IFS=$'\t' read -r expected_sha256 expected_bytes <<<"$identity"
  [[ -f "$provider_path" && ! -L "$provider_path" \
    && -f "$public_path" && ! -L "$public_path" \
    && -s "$provider_path" && -s "$public_path" ]] || {
    log "$relative_path live proof is not a regular non-empty artifact pair" >&2
    return 1
  }
  cmp -s "$provider_path" "$public_path" || {
    log "provider and public $relative_path artifacts are not byte-identical" >&2
    return 1
  }
  if [[ -n "$local_path" ]]; then
    [[ -f "$local_path" && ! -L "$local_path" ]] || {
      log "local $relative_path artifact is unsafe" >&2
      return 1
    }
    cmp -s "$provider_path" "$local_path" || {
      log "live $relative_path differs from the local manifested release" >&2
      return 1
    }
  fi
  for artifact_path in "$provider_path" "$public_path"; do
    [[ "$(sha256_file "$artifact_path")" == "$expected_sha256" \
      && "$(stat -c '%s' "$artifact_path")" == "$expected_bytes" ]] || {
      log "live $relative_path is not byte-bound to the release manifest" >&2
      return 1
    }
  done
  if [[ -n "$local_path" ]]; then
    validate_manifest_bound_local "$manifest_path" "$relative_path" \
      "$local_path" || return 1
  fi
}

fetch_live_artifact_pair() {
  local url_path="$1" provider_path="$2" public_path="$3" nonce="$4"
  local maximum="$5" reserve="$6" accept="${7:-application/octet-stream}"
  local provider_http public_http
  provider_http="$(curl_with_deadline "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
    "$reserve" -sS --proto '=https' --max-redirs 0 \
    --header "Accept: $accept" --max-filesize "$maximum" \
    -o "$provider_path" -w '%{http_code}' \
    "$PROVIDER_ORIGIN/$url_path?receipt=$nonce")" || return 1
  public_http="$(curl_with_deadline "$ORIGIN_REQUEST_TIMEOUT_SECONDS" \
    "$reserve" -sS --proto '=https' --max-redirs 0 \
    --header "Accept: $accept" --max-filesize "$maximum" \
    -o "$public_path" -w '%{http_code}' \
    "$PUBLIC_ORIGIN/$url_path?receipt=$nonce")" || return 1
  [[ "$provider_http" == 200 && "$public_http" == 200 \
    && -s "$provider_path" && -s "$public_path" \
    && "$(stat -c '%s' "$provider_path")" -le "$maximum" \
    && "$(stat -c '%s' "$public_path")" -le "$maximum" ]] || {
    log "provider and public $url_path did not return bounded HTTP 200 artifacts" >&2
    return 1
  }
}

validate_durable_release_manifest() {
  local manifest_path="$1" expected_release="$2" expected_tree="$3"
  local expected_sha256="$4"
  [[ "$manifest_path" == "$RELEASE_MANIFEST_ROOT/$expected_release.json" \
    && -f "$manifest_path" && ! -L "$manifest_path" \
    && "$(stat -c '%a' "$manifest_path")" == 600 \
    && "$(sha256_file "$manifest_path")" == "$expected_sha256" ]] || {
    log "unchanged release manifest anchor is unsafe or changed" >&2
    return 1
  }
  jq -e --arg release "$expected_release" --arg tree "$expected_tree" '
    type == "object" and
    keys == ["built_at","critical_files","deployment_source","file_count","github_required","schema_version","source_commit","state","total_bytes","tree_sha256"] and
    .schema_version == "palimpsest.railway-static-release.v1" and
    .source_commit == $release and .tree_sha256 == $tree and
    .state == "artifact_ready" and .deployment_source == "local-git-archive" and
    .github_required == false and
    (.built_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
    (.critical_files | type == "object") and
    (.file_count | type == "number" and . >= 1 and floor == .) and
    (.total_bytes | type == "number" and . >= 1 and floor == .)
  ' "$manifest_path" >/dev/null || {
    log "unchanged release manifest anchor has an invalid identity" >&2
    return 1
  }
}

prove_unchanged_live_release() {
  local manifest_path="$1" expected_release="$2" expected_tree="$3"
  local expected_manifest_sha256="$4" expected_wire="$5"
  local nonce manifest_built_at counts measurement_count availability_count
  local provider_manifest public_manifest provider_freshness public_freshness
  local provider_attestation public_attestation provider_newsroom public_newsroom
  local provider_html public_html relative url_path accept suffix provider_path
  local public_path provider_wire_sha256 public_wire_sha256 final_nonce
  local final_provider_manifest final_public_manifest newsroom_generated_at

  validate_durable_release_manifest "$manifest_path" "$expected_release" \
    "$expected_tree" "$expected_manifest_sha256" || return 1
  manifest_built_at="$(jq -er '.built_at' "$manifest_path")" || return 1
  nonce="$(date +%s%N)-unchanged"
  provider_manifest="$work_root/unchanged-provider-railway-release.json"
  public_manifest="$work_root/unchanged-public-railway-release.json"
  fetch_live_artifact_pair "railway-release.json" "$provider_manifest" \
    "$public_manifest" "$nonce" 16777216 0 "application/json" || return 1
  if ! cmp -s "$provider_manifest" "$manifest_path" \
    || ! cmp -s "$public_manifest" "$manifest_path"; then
    log "unchanged live manifests differ from the durable release anchor" >&2
    return 1
  fi

  provider_freshness="$work_root/unchanged-provider-freshness.json"
  public_freshness="$work_root/unchanged-public-freshness.json"
  fetch_live_artifact_pair "freshness" "$provider_freshness" \
    "$public_freshness" "$nonce" 65536 0 "application/json" || return 1
  validate_live_freshness_proofs "$provider_freshness" "$public_freshness" \
    "$manifest_path" "$expected_release" "$expected_tree" "$expected_wire" \
    || return 1

  provider_attestation="$work_root/unchanged-provider-attestation.json"
  public_attestation="$work_root/unchanged-public-attestation.json"
  fetch_live_artifact_pair \
    "readings/publication-freshness-attestation-latest.json" \
    "$provider_attestation" "$public_attestation" "$nonce" 1048576 0 \
    "application/json" || return 1
  validate_manifest_bound_pair "$manifest_path" \
    "readings/publication-freshness-attestation-latest.json" \
    "$provider_attestation" "$public_attestation" || return 1
  provider_wire_sha256="$(validate_release_freshness_attestation \
    "$snapshot_wire" "$provider_attestation" "$expected_release" \
    "$expected_wire")" || return 1
  public_wire_sha256="$(validate_release_freshness_attestation \
    "$snapshot_wire" "$public_attestation" "$expected_release" \
    "$expected_wire")" || return 1
  [[ "$provider_wire_sha256" =~ ^[0-9a-f]{64}$ \
    && "$provider_wire_sha256" == "$public_wire_sha256" ]] || {
    log "unchanged live attestations do not bind the same private wire" >&2
    return 1
  }

  provider_newsroom="$work_root/unchanged-provider-newsroom.json"
  public_newsroom="$work_root/unchanged-public-newsroom.json"
  fetch_live_artifact_pair "readings/newsroom-latest.json" \
    "$provider_newsroom" "$public_newsroom" "$nonce" 16777216 0 \
    "application/json" || return 1
  validate_manifest_bound_pair "$manifest_path" "readings/newsroom-latest.json" \
    "$provider_newsroom" "$public_newsroom" || return 1
  counts="$(validate_structured_newsroom "$public_newsroom" "$expected_wire" \
    "$manifest_built_at")" || return 1
  IFS=$'\t' read -r measurement_count availability_count <<<"$counts"
  [[ "$measurement_count" =~ ^[0-9]+$ \
    && "$availability_count" =~ ^[0-9]+$ \
    && $((measurement_count + availability_count)) -eq 39 ]] || {
    log "unchanged live newsroom does not close its 39-record inventory" >&2
    return 1
  }
  newsroom_generated_at="$(jq -er '.generated_at | select(type == "string")' \
    "$public_newsroom")" || return 1
  prove_live_measurement_evidence "$public_newsroom" "$manifest_path" "" \
    "unchanged" "$nonce" 0 "$measurement_count" || return 1

  provider_html="$work_root/unchanged-provider-news-index.html"
  public_html="$work_root/unchanged-public-news-index.html"
  fetch_live_artifact_pair "news/" "$provider_html" "$public_html" "$nonce" \
    16777216 0 "text/html" || return 1
  validate_manifest_bound_pair "$manifest_path" "news/index.html" \
    "$provider_html" "$public_html" || return 1
  validate_newsroom_html "$public_html" "$measurement_count" \
    "$availability_count" || return 1

  for relative in \
    news/feed.json news/feed.xml \
    news/instruments/feed.json news/instruments/feed.xml; do
    suffix="${relative//\//-}"
    provider_path="$work_root/unchanged-provider-$suffix"
    public_path="$work_root/unchanged-public-$suffix"
    if [[ "$relative" == *.json ]]; then
      accept="application/feed+json"
    else
      accept="application/rss+xml"
    fi
    fetch_live_artifact_pair "$relative" "$provider_path" "$public_path" \
      "$nonce" 16777216 0 "$accept" || return 1
    validate_manifest_bound_pair "$manifest_path" "$relative" \
      "$provider_path" "$public_path" || return 1
  done
  validate_newsroom_feeds "$public_newsroom" \
    "$work_root/unchanged-public-news-feed.json" \
    "$work_root/unchanged-public-news-feed.xml" \
    "$work_root/unchanged-public-news-instruments-feed.json" \
    "$work_root/unchanged-public-news-instruments-feed.xml" \
    "$snapshot_wire" >/dev/null || return 1

  for relative in \
    news/china/analysis/feed.json news/china/analysis/feed.xml; do
    suffix="${relative//\//-}"
    provider_path="$work_root/unchanged-provider-$suffix"
    public_path="$work_root/unchanged-public-$suffix"
    if [[ "$relative" == *.json ]]; then
      accept="application/feed+json"
    else
      accept="application/rss+xml"
    fi
    fetch_live_artifact_pair "$relative" "$provider_path" "$public_path" \
      "$nonce" 1048576 0 "$accept" || return 1
    validate_manifest_bound_pair "$manifest_path" "$relative" \
      "$provider_path" "$public_path" || return 1
  done
  validate_denied_china_analysis_feeds \
    "$work_root/unchanged-public-news-china-analysis-feed.json" \
    "$work_root/unchanged-public-news-china-analysis-feed.xml" \
    "$newsroom_generated_at" || return 1

  final_nonce="$(date +%s%N)-unchanged-final"
  final_provider_manifest="$work_root/unchanged-final-provider-manifest.json"
  final_public_manifest="$work_root/unchanged-final-public-manifest.json"
  fetch_live_artifact_pair "railway-release.json" "$final_provider_manifest" \
    "$final_public_manifest" "$final_nonce" 16777216 0 "application/json" \
    || return 1
  if ! cmp -s "$final_provider_manifest" "$manifest_path" \
    || ! cmp -s "$final_public_manifest" "$manifest_path"; then
    log "unchanged live manifest changed during semantic proof" >&2
    return 1
  fi
  bounded_deadline_timeout 1 0 >/dev/null || return 1
}

validate_installed_transition_artifact() {
  local key="$1" path="$2" mode="$3" expected actual
  [[ -f "$path" && ! -L "$path" \
    && "$(stat -c '%u:%g:%a:%h' "$path")" == "0:0:$mode:1" ]] || {
    log "installed transition artifact has unsafe metadata: $path" >&2
    return 1
  }
  expected="$(jq -er --arg key "$key" '.installed[$key]' "$PUBLICATION_BASE_FILE")"
  actual="$(sha256_file "$path")"
  [[ "$actual" == "$expected" ]] || {
    log "installed transition artifact differs from the root-owned pin: $path" >&2
    return 1
  }
}

validate_rotation_history_directory() {
  local path="$1" expected_group_gid="$2"
  [[ -d "$path" && ! -L "$path" \
    && "$(stat -c '%u:%g:%a' "$path")" == "0:${expected_group_gid}:750" ]] || {
    log "base-rotation history directory is unsafe: $path" >&2
    return 1
  }
}

validate_rotation_history_file() {
  local path="$1" expected_path="$2" digest="$3" expected_group_gid="$4"
  [[ "$path" == "$expected_path" \
    && -f "$path" && ! -L "$path" \
    && "$(stat -c '%u:%g:%a:%h' "$path")" == "0:${expected_group_gid}:640:1" \
    && "$(sha256_file "$path")" == "$digest" ]] || {
    log "base-rotation history file is unsafe or changed: $path" >&2
    return 1
  }
}

fsync_paths_and_directory() {
  "$PYTHON_BIN" - "$@" <<'PY'
import os
import sys

for raw_path in sys.argv[1:-1]:
    descriptor = os.open(raw_path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
directory = os.open(sys.argv[-1], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY
}

archive_predecessor_receipt() {
  mkdir -p "$RECEIPT_ARCHIVE_ROOT"
  chmod 0700 "$RECEIPT_ARCHIVE_ROOT"
  fsync_paths_and_directory "$STATE_ROOT"
  receipt_archive_path="$RECEIPT_ARCHIVE_ROOT/$receipt_sha256.json"
  if [[ -e "$receipt_archive_path" || -L "$receipt_archive_path" ]]; then
    [[ -f "$receipt_archive_path" && ! -L "$receipt_archive_path" \
      && "$(stat -c '%a' "$receipt_archive_path")" == 600 \
      && "$(sha256_file "$receipt_archive_path")" == "$receipt_sha256" ]] || {
      log "predecessor receipt archive conflicts with its digest" >&2
      return 1
    }
  else
    # latest-success and its immutable archive live on the same private state
    # filesystem, so a hard link preserves the exact predecessor inode without
    # a copy/replace window.
    ln "$SUCCESS_RECEIPT" "$receipt_archive_path"
  fi
  fsync_paths_and_directory "$receipt_archive_path" "$RECEIPT_ARCHIVE_ROOT"
}

archive_candidate_journal() {
  mkdir -p "$CANDIDATE_ARCHIVE_ROOT"
  chmod 0700 "$CANDIDATE_ARCHIVE_ROOT"
  candidate_archive_path="$CANDIDATE_ARCHIVE_ROOT/$candidate_journal_sha256.json"
  [[ ! -e "$candidate_archive_path" && ! -L "$candidate_archive_path" ]] || {
    log "candidate journal archive unexpectedly already exists" >&2
    return 1
  }
  ln "$PENDING_CANDIDATE" "$candidate_archive_path"
  [[ "$(stat -c '%a' "$candidate_archive_path")" == 600 \
    && "$(sha256_file "$candidate_archive_path")" == "$candidate_journal_sha256" ]] || {
    log "candidate journal archive identity changed" >&2
    return 1
  }
  fsync_paths_and_directory "$candidate_archive_path" "$CANDIDATE_ARCHIVE_ROOT"
}

persist_release_manifest_anchor() {
  local source_manifest="$release/railway-release.json"
  mkdir -p "$RELEASE_MANIFEST_ROOT"
  chmod 0700 "$RELEASE_MANIFEST_ROOT"
  release_manifest_path="$RELEASE_MANIFEST_ROOT/$release_sha.json"
  [[ -f "$source_manifest" && ! -L "$source_manifest" \
    && ! -e "$release_manifest_path" && ! -L "$release_manifest_path" ]] || {
    log "release manifest anchor source/destination is unsafe" >&2
    return 1
  }
  release_manifest_tmp="$(mktemp "$RELEASE_MANIFEST_ROOT/.release-manifest.XXXXXX")"
  cp "$source_manifest" "$release_manifest_tmp"
  chmod 0600 "$release_manifest_tmp"
  "$PYTHON_BIN" -I -S - "$release_manifest_tmp" "$release_sha" <<'PY'
import json
import re
import sys
from datetime import UTC, datetime, timedelta
from pathlib import Path

EXPECTED = {
    "built_at",
    "critical_files",
    "deployment_source",
    "file_count",
    "github_required",
    "schema_version",
    "source_commit",
    "state",
    "total_bytes",
    "tree_sha256",
}


def strict_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise SystemExit("release manifest anchor contains a duplicate key")
        value[key] = item
    return value


try:
    document = json.loads(
        Path(sys.argv[1]).read_bytes().decode("utf-8", "strict"),
        object_pairs_hook=strict_object,
        parse_constant=lambda value: (_ for _ in ()).throw(
            ValueError(f"non-finite JSON value: {value}")
        ),
    )
except (UnicodeError, ValueError, json.JSONDecodeError) as exc:
    raise SystemExit("release manifest anchor is not strict JSON") from exc
if not isinstance(document, dict) or set(document) != EXPECTED:
    raise SystemExit("release manifest anchor document is not closed-schema")
try:
    built_at = datetime.fromisoformat(document["built_at"].replace("Z", "+00:00"))
except (AttributeError, ValueError) as exc:
    raise SystemExit("release manifest built_at is invalid") from exc
if (
    built_at.tzinfo is None
    or built_at.utcoffset() is None
    or built_at.astimezone(UTC) > datetime.now(UTC) + timedelta(seconds=120)
    or document["schema_version"] != "palimpsest.railway-static-release.v1"
    or document["source_commit"] != sys.argv[2]
    or document["deployment_source"] != "local-git-archive"
    or document["github_required"] is not False
    or document["state"] != "artifact_ready"
    or not isinstance(document["tree_sha256"], str)
    or re.fullmatch(r"[0-9a-f]{64}", document["tree_sha256"]) is None
    or not isinstance(document["file_count"], int)
    or isinstance(document["file_count"], bool)
    or document["file_count"] < 1
    or not isinstance(document["total_bytes"], int)
    or isinstance(document["total_bytes"], bool)
    or document["total_bytes"] < 1
    or not isinstance(document["critical_files"], dict)
    or not document["critical_files"]
):
    raise SystemExit("release manifest anchor identity is invalid")
PY
  release_manifest_sha256="$(sha256_file "$release_manifest_tmp")"
  release_manifest_bytes="$(stat -c '%s' "$release_manifest_tmp")"
  release_manifest_tree_sha256="$(jq -er --arg release "$release_sha" '
    select(
      .schema_version == "palimpsest.railway-static-release.v1" and
      .source_commit == $release and
      .deployment_source == "local-git-archive" and
      .github_required == false and
      .state == "artifact_ready"
    ) | .tree_sha256 | select(type == "string" and test("^[0-9a-f]{64}$"))
  ' "$release_manifest_tmp")"
  release_manifest_file_count="$(jq -er '.file_count | select(type == "number" and . >= 1 and floor == .)' "$release_manifest_tmp")"
  release_manifest_total_bytes="$(jq -er '.total_bytes | select(type == "number" and . >= 1 and floor == .)' "$release_manifest_tmp")"
  [[ "$release_manifest_sha256" =~ ^[0-9a-f]{64}$ \
    && "$release_manifest_bytes" =~ ^[1-9][0-9]*$ ]] || {
    log "local release manifest anchor identity is invalid" >&2
    return 1
  }
  ln "$release_manifest_tmp" "$release_manifest_path"
  unlink "$release_manifest_tmp"
  release_manifest_tmp=""
  fsync_paths_and_directory "$release_manifest_path" "$RELEASE_MANIFEST_ROOT"
}

recover_abandoned_preparation() {
  local release bundle metadata evidence manifest
  [[ -e "$PENDING_PREPARATION" || -L "$PENDING_PREPARATION" ]] || return 0
  [[ ! -e "$PENDING_CANDIDATE" && ! -L "$PENDING_CANDIDATE" ]] || return 0
  [[ -f "$PENDING_PREPARATION" && ! -L "$PENDING_PREPARATION" \
    && "$(stat -c '%u:%g:%a' "$PENDING_PREPARATION")" == "$(id -u):$(id -g):600" ]] || {
    log "abandoned preparation journal has unsafe metadata" >&2
    return 1
  }
  jq -e '
    type == "object" and
    keys == ["base_sha","bundle_metadata_path","bundle_path","evidence_directory","input_sha256","prepared_at","release_manifest_path","release_sha","schema_version","status","submission_id"] and
    .schema_version == "palimpsest.direct-publication-preparation.v1" and
    .status == "pre_mutation" and
    (.prepared_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
    ([.base_sha,.release_sha] | all(type == "string" and test("^[0-9a-f]{40}$"))) and
    (.input_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    (.submission_id | type == "string" and test("^[0-9a-f]{32}$"))
  ' "$PENDING_PREPARATION" >/dev/null || {
    log "abandoned preparation journal is not closed-schema" >&2
    return 1
  }
  release="$(jq -er '.release_sha' "$PENDING_PREPARATION")"
  bundle="$(jq -er '.bundle_path' "$PENDING_PREPARATION")"
  metadata="$(jq -er '.bundle_metadata_path' "$PENDING_PREPARATION")"
  evidence="$(jq -er '.evidence_directory' "$PENDING_PREPARATION")"
  manifest="$(jq -er '.release_manifest_path' "$PENDING_PREPARATION")"
  [[ "$bundle" == "$RELEASE_BUNDLE_ROOT/$release.bundle" \
    && "$metadata" == "$RELEASE_BUNDLE_ROOT/$release.json" \
    && "$evidence" == "$PREDECESSOR_EVIDENCE_ROOT/$release" \
    && "$manifest" == "$RELEASE_MANIFEST_ROOT/$release.json" ]] || {
    log "abandoned preparation paths escape their canonical release identity" >&2
    return 1
  }
  for orphan in "$bundle" "$metadata" "$manifest"; do
    if [[ -e "$orphan" || -L "$orphan" ]]; then
      [[ -f "$orphan" && ! -L "$orphan" \
        && "$(stat -c '%u:%g:%a' "$orphan")" == "$(id -u):$(id -g):600" ]] || {
        log "abandoned preparation artifact has unsafe metadata: $orphan" >&2
        return 1
      }
      unlink "$orphan"
    fi
  done
  if [[ -e "$evidence" || -L "$evidence" ]]; then
    [[ -d "$evidence" && ! -L "$evidence" \
      && "$(stat -c '%u:%g:%a' "$evidence")" == "$(id -u):$(id -g):700" \
      && -z "$(find "$evidence" -mindepth 1 -maxdepth 1 \
        ! -name 'provider-railway-release.json' \
        ! -name 'public-railway-release.json' \
        ! -name 'railway-status.json' \
        ! -name '.provider.*' ! -name '.public.*' ! -name '.topology.*' -print -quit)" \
      && -z "$(find "$evidence" -type l -print -quit)" ]] || {
      log "abandoned predecessor evidence directory is unsafe" >&2
      return 1
    }
    rm -rf --one-file-system -- "$evidence"
  fi
  unlink "$PENDING_PREPARATION"
  fsync_paths_and_directory "$STATE_ROOT"
  log "recovered an abandoned pre-mutation preparation without touching Railway"
}

write_preparation_journal() {
  preparation_tmp="$(mktemp "$STATE_ROOT/.pending-preparation.XXXXXX")"
  jq -n \
    --arg prepared_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg input_sha256 "$input_sha256" \
    --arg base_sha "$base_sha" \
    --arg release_sha "$release_sha" \
    --arg submission_id "$candidate_submission_id" \
    --arg bundle_path "$RELEASE_BUNDLE_ROOT/$release_sha.bundle" \
    --arg bundle_metadata_path "$RELEASE_BUNDLE_ROOT/$release_sha.json" \
    --arg evidence_directory "$PREDECESSOR_EVIDENCE_ROOT/$release_sha" \
    --arg release_manifest_path "$RELEASE_MANIFEST_ROOT/$release_sha.json" \
    '{schema_version:"palimpsest.direct-publication-preparation.v1",status:"pre_mutation",prepared_at:$prepared_at,input_sha256:$input_sha256,base_sha:$base_sha,release_sha:$release_sha,submission_id:$submission_id,bundle_path:$bundle_path,bundle_metadata_path:$bundle_metadata_path,evidence_directory:$evidence_directory,release_manifest_path:$release_manifest_path}' \
