{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.info/protocol/bri-wdi-series-v1.schema.json",
  "title": "Palimpsest BRI World Bank WDI series registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "countries", "series"],
  "properties": {
    "schema_version": {"const": "palimpsest.bri-wdi-series.v1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_number",
        "name",
        "publisher",
        "api_base",
        "catalog_url",
        "license",
        "license_url",
        "rights_evidence_url",
        "redistribution_status",
        "attribution",
        "release_time_semantics",
        "context_scope",
        "causality_boundary",
        "indicator_provenance_boundary"
      ],
      "properties": {
        "source_id": {"const": "world_bank_wdi"},
        "source_number": {"const": "2"},
        "name": {"const": "World Development Indicators"},
        "publisher": {"const": "World Bank"},
        "api_base": {"const": "https://api.worldbank.org/v2"},
        "catalog_url": {"const": "https://datacatalog.worldbank.org/search/dataset/0037712/world-development-indicators"},
        "license": {"const": "CC-BY-4.0"},
        "license_url": {"const": "https://creativecommons.org/licenses/by/4.0/"},
        "rights_evidence_url": {"const": "https://datacatalog.worldbank.org/search/dataset/0037712/world-development-indicators"},
        "redistribution_status": {"const": "allowed_with_attribution"},
        "attribution": {"const": "World Bank, World Development Indicators"},
        "release_time_semantics": {"const": "dataset_lastupdated_upper_bound"},
        "context_scope": {"const": "national_economic_context"},
        "causality_boundary": {"const": "not_evidence_of_bri_causality"},
        "indicator_provenance_boundary": {"type": "string", "minLength": 20, "maxLength": 2048}
      }
    },
    "countries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["country_code", "api_country_id", "name"],
          "properties": {
            "country_code": {"const": "CHN"},
            "api_country_id": {"const": "CN"},
            "name": {"const": "China"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["country_code", "api_country_id", "name"],
          "properties": {
            "country_code": {"const": "MMR"},
            "api_country_id": {"const": "MM"},
            "name": {"const": "Myanmar"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["country_code", "api_country_id", "name"],
          "properties": {
            "country_code": {"const": "PAK"},
            "api_country_id": {"const": "PK"},
            "name": {"const": "Pakistan"}
          }
        }
      ],
      "items": false
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "indicator_id",
          "series_id",
          "source_title",
          "name",
          "unit",
          "topic"
        ],
        "properties": {
          "indicator_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,79}$"},
          "series_id": {"type": "string", "pattern": "^bri\\.context\\.wdi\\.[a-z0-9][a-z0-9_]{1,119}$"},
          "source_title": {"type": "string", "minLength": 1, "maxLength": 512},
          "name": {"type": "string", "minLength": 1, "maxLength": 512},
          "unit": {"type": "string", "minLength": 1, "maxLength": 512},
          "topic": {"enum": ["macro", "trade", "finance", "labor", "energy", "environment", "logistics", "digital", "demographics"]}
        }
      }
    }
  }
}
